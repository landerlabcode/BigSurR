  "],ExpressionUUID->"4d225bb0-7937-468f-9b61-1870a66bb7c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HBG", "[", 
   RowBox[{"gno_", ",", " ", "target_"}], "]"}], ":=", "\[IndentingNewLine]", 
  
  RowBox[{"Take", "[", 
   RowBox[{
    RowBox[{"Keys", "[", 
     RowBox[{"ReverseSortBy", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"gno", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "->", 
         RowBox[{"BetweennessCentrality", "[", "\[IndentingNewLine]", 
          RowBox[{"AdjacencyGraph", "[", 
           RowBox[{"gno", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
       "Last"}], "]"}], "]"}], ",", " ", 
    RowBox[{"UpTo", "[", "target", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.879429760074881*^9, 3.879429792047394*^9}, {
  3.879429823796289*^9, 3.879429887486759*^9}, {3.8794299826368847`*^9, 
  3.8794300074821587`*^9}, {3.8794301022767563`*^9, 3.879430119136619*^9}, {
  3.879430305751956*^9, 3.879430368842181*^9}, {3.879430414437675*^9, 
  3.879430417937488*^9}, {3.879430753710869*^9, 3.879430754749714*^9}},
