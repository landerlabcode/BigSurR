Cell[CellGroupData[{

Cell["JoinColumnLeft", "Subsubsection",
 CellChangeTimes->{{3.8322597443178988`*^9, 3.8322597543324823`*^9}, {
  3.832260079814453*^9, 
  3.832260080179804*^9}},ExpressionUUID->"91fcd942-8575-47b5-bdde-\
1797dd0c2e19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JoinColumnLeft", "[", 
   RowBox[{"column_", ",", " ", "matrix_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "column", "]"}], "==", 
     RowBox[{"Length", "[", "matrix", "]"}]}], ",", " ", 
    RowBox[{"Transpose", "[", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "matrix", "]"}], ",", " ", "column"}], "]"}],
      "]"}], ",", " ", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<Cannot join; incorrect dimensions\>\"", "]"}],
      ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.832259757143108*^9, 3.832259807905599*^9}, {
  3.832259898979301*^9, 3.832259899389461*^9}, {3.883910728874205*^9, 
  3.883910737710832*^9}, {3.88391094861722*^9, 3.883911017465961*^9}, {
  3.883911067010994*^9, 3.88391106927254*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[4]:=",ExpressionUUID->"7b04e82f-f130-4fbb-83f7-6a9934e98c65"]
}, Open  ]],

