  3.879128294779901*^9}},ExpressionUUID->"8207799e-acf1-4d89-a94d-\
f6e45922d666"],

Cell["\<\
This endeavors to speed things up a bit by not wasting time plotting the \
zeros.  \
\>", "Text",
 CellChangeTimes->{{3.879128297803193*^9, 
  3.879128312048098*^9}},ExpressionUUID->"21ef49c7-ffec-4192-954d-\
a02658a16f93"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FeaturePlot4", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<PointSize\>\"", "->", " ", "Medium"}], ",", " ", 
     RowBox[{"\"\<CellRange\>\"", "->", " ", "All"}], ",", " ", 
     RowBox[{"\"\<Background\>\"", "->", " ", 
      RowBox[{"{", "}"}]}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"FeaturePlot4", "[", 
    RowBox[{
    "matpacDN_", ",", " ", "gene_", ",", " ", "coordAssn_", ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"matpacDN", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "geneposn", ",", " ", "expressionvalues", ",", " ", "coordinates"}], 
        " ", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"geneposn", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"matpacDN", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "gene"}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"expressionvalues", "=", 
         RowBox[{
          RowBox[{
           FractionBox["#", 
            RowBox[{"Max", "[", "#", "]"}]], "&"}], "@", 
          RowBox[{"Normal", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"matpacDN", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "geneposn", ",", "All"}], "]"}], "]"}], "]"}],
            "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coordinates", "=", 
         RowBox[{
          RowBox[{"matpacDN", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", " ", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Position", "[", 
               RowBox[{"expressionvalues", ",", " ", 
                RowBox[{"x_", "/;", 
                 RowBox[{"x", ">", "0"}]}]}], "]"}], "]"}]}], "]"}], "]"}], "/.", 
          RowBox[{"Flatten", "[", "coordAssn", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<Background\>\"", "]"}], ",", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Values", "[", 
               RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}], ",", 
              RowBox[{"Directive", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"PointSize", "[", 
                  RowBox[{"OptionValue", "[", "\"\<PointSize\>\"", "]"}], 
                  "]"}], ",", "White"}], "}"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"Axes", "\[Rule]", " ", "None"}], ",", 
            RowBox[{"PlotRange", "\[Rule]", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"First", "/@", 
                 RowBox[{"Values", "[", 
                  RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}]}], "]"}], 
               ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"Last", "/@", 
                 RowBox[{"Values", "[", 
                  RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}]}], 
                "]"}]}], "}"}]}]}], "]"}], ",", 
          RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{"Style", ",", " ", 
              RowBox[{"{", 
               RowBox[{"coordinates", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Directive", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"PointSize", "[", 
                    RowBox[{"OptionValue", "[", "\"\<PointSize\>\"", "]"}], 
                    "]"}], ",", 
                    RowBox[{"RGBColor", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"1", "-", "#"}], ",", 
                    RowBox[{"1", "-", "#"}]}], "]"}]}], "}"}], "]"}], "&"}], "/@", 
                 RowBox[{"Cases", "[", 
                  RowBox[{"expressionvalues", ",", 
                   RowBox[{"x_", "/;", 
                    RowBox[{"x", ">", "0"}]}]}], "]"}]}]}], "}"}]}], "]"}], ",",
             " ", 
            RowBox[{"Axes", "\[Rule]", " ", "None"}], ",", 
            RowBox[{"PlotRange", "\[Rule]", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"First", "/@", 
                 RowBox[{"Values", "[", 
                  RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}]}], "]"}], 
               ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"Last", "/@", 
                 RowBox[{"Values", "[", 
                  RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}]}], 
                "]"}]}], "}"}]}]}], "]"}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", " ", 
           RowBox[{"gene", "<>", "\"\< (max = \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"Max", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"matpacDN", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "geneposn", ",", "All"}], "]"}], "]"}], 
               "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}]}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], ",", 
     RowBox[{"Print", "[", "\"\<Gene not found\>\"", "]"}]}], 
    "]"}]}]}]], "Input",
