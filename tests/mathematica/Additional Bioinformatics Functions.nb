Cell[CellGroupData[{

Cell[TextData[{
 "Differentially expressed genes (",
 StyleBox["FindDegs",
  FontColor->GrayLevel[0]],
 ")"
}], "Subsection",
 CellChangeTimes->{{3.917203693906383*^9, 
  3.9172037029039297`*^9}},ExpressionUUID->"503cbd2c-d1f6-4053-9b0f-\
92638c2c91ab"],

Cell["\<\
We will use the modified corrected residuals to do the DEG calculations.  We\
\[CloseCurlyQuote]ll write a code that operates on the residualsmat.  In this \
code, the log2fc is positive if the test is greater than the target, negative \
if the target is greater than the test.  If the log is indeterminate it \
returns zero.  \
\>", "Text",
 CellChangeTimes->{{3.91580559604387*^9, 3.9158056133437634`*^9}, {
  3.915805708129519*^9, 3.915805718251417*^9}, {3.91581224565779*^9, 
  3.9158122481021557`*^9}, {3.915812296549211*^9, 3.915812332574772*^9}, {
  3.917204130350869*^9, 
  3.917204149355048*^9}},ExpressionUUID->"33dcbb5c-7922-4f6f-8f3a-\
2bcdfce6dc1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindDegs", "[", 
   RowBox[{
   "matpac_", ",", " ", "matpacDN_", ",", " ", "residualsmat_", ",", " ", 
    "testcells_", ",", " ", "targetcells_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "testpositions", ",", " ", "targetpositions", ",", " ", 
       "residualscomparison", ",", " ", "pvals", ",", "bhcutoff", ",", " ", 
       "sigposns", ",", " ", "siggenes", ",", " ", "logfclist"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"testpositions", " ", "=", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"matpac", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", "#"}], " ", "]"}], "&"}], "/@",
          "testcells"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"targetpositions", "=", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"matpac", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", "#"}], " ", "]"}], "&"}], "/@",
          "targetcells"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"residualscomparison", "=", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"residualsmat", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "testpositions"}], "]"}], "]"}], ",", 
          " ", 
          RowBox[{"residualsmat", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "targetpositions"}], "]"}], "]"}]}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pvals", "=", 
       RowBox[{"MannWhitneyTest", "/@", "residualscomparison"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bhcutoff", "=", 
       RowBox[{"BHNew", "[", 
        RowBox[{"pvals", ",", " ", "0.05"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sigposns", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"pvals", ",", " ", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", "<", "bhcutoff"}]}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"siggenes", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "sigposns"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"logfclist", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"2", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Mean", "/@", 
              RowBox[{
               RowBox[{"matpacDN", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", 
               RowBox[{"[", " ", 
                RowBox[{"sigposns", ",", "testpositions"}], " ", "]"}], 
               "]"}]}], ")"}], "/", 
            RowBox[{"(", " ", 
             RowBox[{"Mean", "/@", 
              RowBox[{
               RowBox[{"matpacDN", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", 
               RowBox[{"[", " ", 
                RowBox[{"sigposns", ",", "targetpositions"}], " ", "]"}], 
               "]"}]}], ")"}]}]}], "]"}], "/.", 
         RowBox[{"Indeterminate", "->", " ", "0"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Dataset", "[", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"siggenes", "->", " ", 
         RowBox[{"Association", "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"\"\<log2fc\>\"", "->", " ", "#"}], ")"}], "&"}], "/@",
               "logfclist"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"\"\<pValue\>\"", "->", " ", "#"}], ")"}], "&"}], "/@", 
              RowBox[{"ScientificForm", "/@", 
               RowBox[{"pvals", "[", 
                RowBox[{"[", "sigposns", "]"}], "]"}]}]}]}], "}"}], "]"}]}]}],
         "]"}], "]"}]}]}], "]"}], "[", 
   RowBox[{"SortBy", "[", "\"\<pValue\>\"", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.915809970636009*^9, 3.915810079554305*^9}, {
  3.9158101114541683`*^9, 3.915810124102776*^9}, {3.915810167084282*^9, 
  3.915810331360063*^9}, {3.91581036256336*^9, 3.915810526411622*^9}, {
  3.915810563705432*^9, 3.915810695015983*^9}, {3.915811002847259*^9, 
  3.9158110249725513`*^9}, {3.915811333967781*^9, 3.915811338553256*^9}, {
  3.915811793298842*^9, 3.915811801723461*^9}, {3.915812202118143*^9, 
  3.915812210253186*^9}, {3.915812272088801*^9, 3.915812280463646*^9}, {
  3.915812871380054*^9, 3.915812877952495*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[191]:=",ExpressionUUID->"ee0daa49-2e5e-4f73-9352-b3b0b6c25ac9"],

Cell["\<\
The following code works with a coordinate Association that associates \
clusters with cellIDs, a matpac that provides the positions of those cellIDs, \
and a matrix that provides values that can be used, such as values coming \
from \[OpenCurlyDoubleQuote]Log1+x\[CloseCurlyDoubleQuote] of \
\[OpenCurlyDoubleQuote]PseudocountsFromResiduals\[CloseCurlyDoubleQuote]

It will provide the DegList for a single cluster, measured against all other \
clusters, as a simple association rather than a dataset.\
\>", "Text",
 CellChangeTimes->{{3.963791820085211*^9, 3.96379192937311*^9}, {
  3.9638256076777077`*^9, 3.963825614174429*^9}, {3.963825650565629*^9, 
  3.963825651599493*^9}, {3.9638258859449463`*^9, 3.963825902933399*^9}, {
  3.9638268931176367`*^9, 
  3.96382691360324*^9}},ExpressionUUID->"6c042bfc-9fa3-4876-ab40-\
6fb72bbcc180"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DegList", "[", 
   RowBox[{
   "matpac_", ",", " ", "coordAssn_", ",", " ", "mat_", ",", " ", "case_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"cellIDs", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", "caseposns", ",", " ", 
      "targetposns", ",", " ", "matrices", ",", " ", "test", ",", " ", 
      "target", ",", " ", "pvals", ",", " ", "bhcutoff", ",", " ", "sigposns",
       ",", " ", "siggenes"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Dimensions", "[", "mat", "]"}], "!=", " ", 
        RowBox[{"Dimensions", "[", 
         RowBox[{"matpac", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<wrong dimensions\>\"", "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}], "!=", " ", 
        RowBox[{"Length", "[", 
         RowBox[{"matpac", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<wrong dimensions\>\"", "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"case", ">", 
        RowBox[{"Length", "[", "coordAssn", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<exceeds cluster number\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"caseposns", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"cellIDs", ",", "#"}], "]"}], "&"}], "/@", 
        RowBox[{"Keys", "[", 
         RowBox[{"coordAssn", "[", 
          RowBox[{"[", "case", "]"}], "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "caseposns", "]"}], "<", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<insufficient cells\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"targetposns", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Width", "[", "mat", "]"}], "]"}], ",", " ", "caseposns"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"test", " ", "=", " ", 
      RowBox[{"mat", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "caseposns"}], "]"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"target", "=", 
      RowBox[{"mat", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "targetposns"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pvals", "=", 
      RowBox[{"MannWhitneyTest", "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"test", ",", " ", "target"}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bhcutoff", "=", 
      RowBox[{"BHNew", "[", 
       RowBox[{"pvals", ",", " ", "0.05"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sigposns", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"pvals", ",", " ", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", "<", "bhcutoff"}]}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"siggenes", "=", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "sigposns"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReverseSortBy", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"siggenes", "->", " ", 
         RowBox[{
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             RowBox[{"Mean", "/@", "test"}], " ", "-", " ", 
             RowBox[{"Mean", "/@", "target"}]}], 
            RowBox[{"Log", "[", "2", "]"}]], ")"}], "[", 
          RowBox[{"[", "sigposns", "]"}], "]"}]}], "]"}], ",", " ", "Last"}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.96379176830652*^9, 3.963791813982395*^9}, {
   3.9637918602795963`*^9, 3.963791865974876*^9}, {3.96379193154951*^9, 
   3.9637921341610537`*^9}, {3.96379216601442*^9, 3.96379221246518*^9}, {
   3.963792253427791*^9, 3.963792270800544*^9}, {3.963824077599823*^9, 
   3.963824089770072*^9}, 3.9638241365249243`*^9, {3.9638241777428017`*^9, 
   3.963824260286618*^9}, {3.963824292414394*^9, 3.963824319631628*^9}, {
   3.963824361161387*^9, 3.9638244666469584`*^9}, {3.963824518620699*^9, 
   3.963824531146948*^9}, 3.9638246794723663`*^9, {3.963824724543195*^9, 
   3.963824755503916*^9}, {3.963824858807146*^9, 3.963825187929681*^9}, {
   3.963825233667519*^9, 3.963825282854191*^9}, 3.9638255366019487`*^9, {
   3.963825591665923*^9, 3.9638256547372427`*^9}, {3.963825723388728*^9, 
   3.9638259058929863`*^9}, {3.963826348400839*^9, 3.9638263579281607`*^9}, {
   3.9638269733642406`*^9, 3.963827023179824*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[192]:=",ExpressionUUID->"151a0555-4c5a-4f08-bb20-7d4c081f4202"]
}, Closed]],

