Cell[CellGroupData[{

Cell["GeneSubset", "Subsubsection",
 CellChangeTimes->{{3.8322854507373734`*^9, 
  3.832285464363207*^9}},ExpressionUUID->"67f63e5e-61b2-4d5e-a5c0-\
b3d37e82040c"],

Cell["\<\
If we have a matrix in the form of a matpac, this code will create a subset \
of it by taking only those rows which match a given gene list.  It takes as \
argument a matpac and a genelist.  If any genes in the gene list aren\
\[CloseCurlyQuote]t in the matpac, they get discarded.  This code was updated \
in 12/2021 to fix the problem that the input gene list was inadvertently \
being sorted alphabetically before being output again (an artifact of using \
\[OpenCurlyDoubleQuote]Intersection\[CloseCurlyDoubleQuote] rather than \
Fold[DeleteCases[#1,#2]&, list, list]).  \
\>", "Text",
 CellChangeTimes->{{3.832285469837207*^9, 3.832285668876472*^9}, {
   3.83228592977925*^9, 3.832285941947095*^9}, {3.8323314008616323`*^9, 
   3.832331452306868*^9}, 3.848939473280744*^9, {3.849008126614509*^9, 
   3.849008212903173*^9}},ExpressionUUID->"4ea3a72a-0d64-4ac0-85d2-\
150dcfd7b347"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneSubset", "[", 
   RowBox[{"matpac_", ",", " ", "genelist_"}], "]"}], ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"genes", " ", "=", 
      RowBox[{"Fold", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", "genelist", ",", " ", 
        
        RowBox[{"Complement", "[", 
         RowBox[{"genelist", ",", 
          RowBox[{"matpac", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"posns", " ", "=", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"matpac", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "#"}], "]"}], "&"}], "/@",
           "genes"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"matpac", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "posns"}], "]"}], "]"}], ",", " ", "genes", ",", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "matpac", "]"}], "<", "4"}], ",", 
          RowBox[{"{", "}"}], ",", 
          RowBox[{"matpac", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.83228559915486*^9, 3.832285620153686*^9}, {
   3.832285686315222*^9, 3.832285690149732*^9}, {3.83228572616949*^9, 
   3.832285806510332*^9}, {3.832285861410471*^9, 3.8322859129966097`*^9}, {
   3.832286071058539*^9, 3.832286074952578*^9}, {3.832291663911189*^9, 
   3.832291669131949*^9}, {3.836953149334544*^9, 3.8369531543202953`*^9}, 
   3.849007909466123*^9, {3.853265000891637*^9, 3.853265015472543*^9}, {
   3.8840007912627583`*^9, 3.884000805243429*^9}, 3.890067757251904*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[27]:=",ExpressionUUID->"cf6a8272-cc32-4655-b7f2-bafea882bd39"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneComplementSubset", "Subsubsection",
 CellChangeTimes->{{3.8322854507373734`*^9, 3.832285464363207*^9}, {
  3.8430629554184027`*^9, 
  3.8430629593978148`*^9}},ExpressionUUID->"22be3915-5f84-41e4-9272-\
a335bc1580a2"],

Cell["\<\
This takes a matpac and deletes those genes specified by a list, returning \
another matpac.  It will ignore any genes not in the list.  \
\>", "Text",
 CellChangeTimes->{{3.843063241872324*^9, 3.843063252735313*^9}, {
  3.843063297367906*^9, 
  3.843063313473907*^9}},ExpressionUUID->"f5c6fac5-5df4-4f87-9447-\
c51d9d3cf95a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneComplementSubset", "[", 
   RowBox[{"matpac_", ",", " ", "genelist_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"positions", " ", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"matpac", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "genelist"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{"matpac", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "\[Rule]", 
         RowBox[{"Part", "[", 
          RowBox[{
           RowBox[{"matpac", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", 
               RowBox[{"matpac", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], ",", 
             "positions"}], " ", "]"}]}], "]"}]}], ",", " ", 
        RowBox[{"2", "\[Rule]", 
         RowBox[{"Part", "[", 
          RowBox[{
           RowBox[{"matpac", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", 
               RowBox[{"matpac", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], ",", 
             "positions"}], " ", "]"}]}], "]"}]}]}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.843062970022374*^9, 3.843063215296715*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[28]:=",ExpressionUUID->"9b7733d1-fe9d-4b99-a157-0ad3006919d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneAppend", "Subsubsection",
 CellChangeTimes->{{3.852464435219565*^9, 
  3.852464445850856*^9}},ExpressionUUID->"ed759f10-b156-4b74-9e4e-\
d77f6b936303"],

Cell["\<\
This takes a matpac and appends a new row, and gives it a new gene name.  The \
slot \[OpenCurlyDoubleQuote]newMetaData\[CloseCurlyDoubleQuote] is used to \
append information about the new gene being added\
\>", "Text",
 CellChangeTimes->{{3.852464448652926*^9, 3.852464471656086*^9}, {
  3.852464627517103*^9, 
  3.852464648433916*^9}},ExpressionUUID->"3fac6dab-acad-4004-896e-\
d536bbaf64a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneAppend", "[", 
   RowBox[{
   "matpac_", ",", " ", "row_", ",", " ", "genename_", ",", " ", 
    "newMetaData_"}], "]"}], ":=", 
  RowBox[{"ReplacePart", "[", 
   RowBox[{"matpac", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "\[Rule]", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"matpac", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", "row"}], "]"}]}], ",", 
      " ", 
      RowBox[{"2", "\[Rule]", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"matpac", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "genename"}], "]"}]}], ",", 
      " ", 
      RowBox[{"4", "\[Rule]", 
       RowBox[{"\"\<Metadata\>\"", "\[Rule]", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"matpac", "[", 
           RowBox[{"[", 
            RowBox[{"4", ",", "2"}], "]"}], "]"}], ",", " ", "newMetaData"}], 
         "]"}]}]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.852464474285512*^9, 3.852464548714282*^9}, {
   3.852464585325087*^9, 3.85246462427334*^9}, {3.85246477076518*^9, 
   3.8524647713107862`*^9}, {3.852464809378241*^9, 3.852464938730323*^9}, 
   3.8524650124696627`*^9, {3.852465330425403*^9, 3.8524653588040524`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[29]:=",ExpressionUUID->"a7b125ed-287e-4b81-a7f3-ee625987145c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneAggregate", "Subsubsection",
 CellChangeTimes->{{3.852464435219565*^9, 3.852464445850856*^9}, {
  3.852465681299953*^9, 
  3.852465683218012*^9}},ExpressionUUID->"59091710-b47c-466e-9235-\
accbce21969b"],

Cell["\<\
This takes a matpac, and replaces a list of genes with a single \
\[OpenCurlyDoubleQuote]aggregate gene\[CloseCurlyDoubleQuote] that sums the \
values from all the genes.  At the end it reorders them in reverse order by \
sparsity\
\>", "Text",
 CellChangeTimes->{{3.852465687098998*^9, 3.852465744998506*^9}, {
  3.85246583387057*^9, 
  3.852465851426429*^9}},ExpressionUUID->"f18e9961-556c-4c35-bb2b-\
ec3cf8f36d4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneAggregate", "[", 
   RowBox[{"matpac_", ",", " ", "genelist_", ",", " ", "groupname_"}], "]"}], 
  ":=", 
  RowBox[{"ReOrderMatPac", "[", 
   RowBox[{
    RowBox[{"GeneAppend", "[", 
     RowBox[{
      RowBox[{"GeneComplementSubset", "[", 
       RowBox[{"matpac", ",", " ", "genelist"}], "]"}], ",", " ", 
      RowBox[{"Total", "[", 
       RowBox[{"First", "[", 
        RowBox[{"GeneSubset", "[", 
         RowBox[{"matpac", ",", "genelist"}], "]"}], "]"}], "]"}], ",", 
      "groupname", ",", " ", 
      RowBox[{"(", 
       RowBox[{"genelist", "\[Rule]", "groupname"}], ")"}]}], "]"}], ",", 
    RowBox[{
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{"#", ",", "1"}], "]"}], ",", "0"}], "]"}], "&"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.852465753942441*^9, 3.852465786563039*^9}, {
  3.852465817969223*^9, 3.852465830260984*^9}, {3.8524660219512157`*^9, 
  3.852466024901979*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[30]:=",ExpressionUUID->"ecc1ceea-32d5-4450-a484-7493d25d3c2d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["CellSubset", "Subsubsection",
 CellChangeTimes->{{3.83228545806938*^9, 
  3.832285466083173*^9}},ExpressionUUID->"82f10472-ef29-4c7a-8115-\
0f7c5e48bb6d"],

Cell["\<\
If we have a matrix in the form of a matpac, this code will create a subset \
of it by taking only those columns which match a given cell name list .  It \
takes as argument a matpac and a cell name list . 
 If any cells  the cell name list aren' t in the matpac, they get discarded.  \
This code was updated in 12/2021 to remove the problem that the final names \
were automatically being alphabetically sorted, so they appeared in a \
different order from the input cell names.  \
\>", "Text",
 CellChangeTimes->{{3.832285924321971*^9, 3.832285984786687*^9}, {
  3.832966562750269*^9, 3.832966564147173*^9}, {3.849006381217956*^9, 
  3.849006384364675*^9}, {3.8490076488266563`*^9, 
  3.8490077093911963`*^9}},ExpressionUUID->"4a114058-17c3-4b28-a107-\
312cb6d88ff0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CellSubset", "[", 
   RowBox[{"matpac_", ",", " ", "cellnames_"}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cells", " ", "=", 
      RowBox[{"Fold", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", "cellnames", ",", 
        RowBox[{"Complement", "[", 
         RowBox[{"cellnames", ",", 
          RowBox[{"GetCellNames", "[", "matpac", "]"}]}], "]"}]}], "]"}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"posns", " ", "=", "  ", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"GetCellNames", "[", "matpac", "]"}], ",", "#"}], "]"}], 
           "&"}], "/@", "cells"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"matpac", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "posns"}], "]"}], "]"}], ",", " ", 
        RowBox[{"GetGeneNames", "[", "matpac", "]"}], ",", " ", "cells", ",", 
        " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "matpac", "]"}], ">", "3"}], ",", 
          RowBox[{"matpac", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "Nothing"}], "]"}]}], "}"}]}],
      "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.832285989769394*^9, 3.832286086772402*^9}, {
  3.832286118855344*^9, 3.832286152738103*^9}, {3.832291699449058*^9, 
  3.8322917129951344`*^9}, {3.836953165244392*^9, 3.836953168356208*^9}, {
  3.849007121907462*^9, 3.8490072273304787`*^9}, {3.849007561103426*^9, 
  3.849007562193932*^9}, {3.871031216069632*^9, 3.871031233312582*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[31]:=",ExpressionUUID->"e6f8a80d-b585-4fc7-b338-f4d98107618c"]
}, Open  ]],

