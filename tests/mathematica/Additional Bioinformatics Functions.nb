Cell[CellGroupData[{

Cell["BHThresholds-RETIRED", "Subsubsection",
 CellChangeTimes->{{3.848591145993264*^9, 3.8485911503555613`*^9}, {
  3.8505598533716183`*^9, 3.850559856543976*^9}},
 FontColor->GrayLevel[
  0.5],ExpressionUUID->"06d47b65-03eb-4136-bc2f-ece70b7e257c"],

Cell["\<\
This finds the p-value threshold for significance of graph elements of higher \
order than just pairs.  
This starts wist a list of all or at least the best pvals, an alpha value, \
and the number of genes in a set being evaluated.  It produces a table in \
which the keys represent the number of connected elements and the number of \
connections between them; the values are the cutoffs.  \
\>", "Text",
 CellChangeTimes->{{3.848591153001232*^9, 
  3.848591340101718*^9}},ExpressionUUID->"aba79ac0-b94e-437f-83eb-\
a56603709300"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"BHThresholds", "[", 
    RowBox[{
    "pvals_", ",", " ", "\[Alpha]_", ",", " ", "genenumber_", ",", " ", 
     "maxcliquesize_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Association", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], "\[Rule]", " ", 
          RowBox[{"BenjaminiHochberg", "[", 
           RowBox[{"pvals", ",", " ", "\[Alpha]", ",", 
            RowBox[{"Binomial", "[", 
             RowBox[{"genenumber", ",", "x"}], "]"}], " ", ",", "y"}], 
           "]"}]}], ")"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", "2", ",", " ", "maxcliquesize"}], "}"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"x", "-", "1"}], ",", 
          RowBox[{"Binomial", "[", 
           RowBox[{"x", ",", "2"}], "]"}]}], "}"}]}], "]"}], ",", "1"}], 
     "]"}], "]"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.8485913454433193`*^9, 3.848591386620406*^9}, {
   3.848591436300555*^9, 3.8485915645661*^9}, {3.848591715711564*^9, 
   3.848591745413526*^9}, {3.848591919331565*^9, 3.848591951320311*^9}, {
   3.848592013606052*^9, 3.8485920377472258`*^9}, 3.848592250254406*^9, {
   3.848592481204472*^9, 3.8485925057516003`*^9}, {3.848592692047641*^9, 
   3.848592696289277*^9}, {3.8505598681395483`*^9, 3.850559871752254*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[236]:=",ExpressionUUID->"8c1cef58-ec04-4414-a646-9eb29a33a7f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["CumulantToRawMoment", "Subsubsection",
 CellChangeTimes->{{3.8712242446507053`*^9, 
  3.871224253915715*^9}},ExpressionUUID->"3951a5ed-36bb-46e1-b539-\
352395b58c38"],

Cell["\<\
This and the next function begin with an ordered list of moments or cumulants \
(or lists of moments or cumulants, or matrices of moments or cumulants), \
beginning with the first and up to 5, and, and converts between raw moments \
and cumulants, or back.  All lists begin with the first moment or cumulant.  \
\
\>", "Text",
 CellChangeTimes->{{3.87122616626996*^9, 3.8712263289424458`*^9}, {
  3.8712263608407583`*^9, 3.871226371522395*^9}, {3.871226456252734*^9, 
  3.871226457182871*^9}},ExpressionUUID->"1e35b87a-1ea8-450e-b861-\
3b874044b52a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CumulantToRawMoment", "[", 
    RowBox[{"\[Kappa]1_", ",", "\[Kappa]2_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\[Kappa]1", ",", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "2"], "+", "\[Kappa]2"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CumulantToRawMoment", "[", 
    RowBox[{"{", 
     RowBox[{"\[Kappa]1_", ",", "\[Kappa]2_", ",", " ", "\[Kappa]3_"}], "}"}],
     "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\[Kappa]1", ",", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "2"], "+", "\[Kappa]2"}], ",", " ", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "3"], "+", 
      RowBox[{"3", " ", "\[Kappa]1", " ", "\[Kappa]2"}], "+", "\[Kappa]3"}]}],
     "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CumulantToRawMoment", "[", 
    RowBox[{"{", 
     RowBox[{
     "\[Kappa]1_", ",", "\[Kappa]2_", ",", " ", "\[Kappa]3_", ",", " ", 
      "\[Kappa]4_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\[Kappa]1", ",", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "2"], "+", "\[Kappa]2"}], ",", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "3"], "+", 
      RowBox[{"3", " ", "\[Kappa]1", " ", "\[Kappa]2"}], "+", "\[Kappa]3"}], ",", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "4"], "+", 
      RowBox[{"6", " ", 
       SuperscriptBox["\[Kappa]1", "2"], " ", "\[Kappa]2"}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox["\[Kappa]2", "2"]}], "+", 
      RowBox[{"4", " ", "\[Kappa]1", " ", "\[Kappa]3"}], "+", "\[Kappa]4"}]}],
     "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CumulantToRawMoment", "[", 
    RowBox[{"{", 
     RowBox[{
     "\[Kappa]1_", ",", "\[Kappa]2_", ",", " ", "\[Kappa]3_", ",", " ", 
      "\[Kappa]4_", ",", " ", "\[Kappa]5_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\[Kappa]1", ",", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "2"], "+", "\[Kappa]2"}], ",", " ", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "3"], "+", 
      RowBox[{"3", " ", "\[Kappa]1", " ", "\[Kappa]2"}], "+", "\[Kappa]3"}], ",", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "4"], "+", 
      RowBox[{"6", " ", 
       SuperscriptBox["\[Kappa]1", "2"], " ", "\[Kappa]2"}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox["\[Kappa]2", "2"]}], "+", 
      RowBox[{"4", " ", "\[Kappa]1", " ", "\[Kappa]3"}], "+", "\[Kappa]4"}], ",", 
     RowBox[{
      SuperscriptBox["\[Kappa]1", "5"], "+", 
      RowBox[{"10", " ", 
       SuperscriptBox["\[Kappa]1", "3"], " ", "\[Kappa]2"}], "+", 
      RowBox[{"10", " ", 
       SuperscriptBox["\[Kappa]1", "2"], " ", "\[Kappa]3"}], "+", 
      RowBox[{"10", " ", "\[Kappa]2", " ", "\[Kappa]3"}], "+", 
      RowBox[{"5", " ", "\[Kappa]1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", 
          SuperscriptBox["\[Kappa]2", "2"]}], "+", "\[Kappa]4"}], ")"}]}], "+",
       "\[Kappa]5"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.871224075512677*^9, 3.871224150946883*^9}, {
  3.871224336841486*^9, 3.87122445887224*^9}, {3.871225216848575*^9, 
  3.871225263251939*^9}, {3.871225295313724*^9, 3.871225370388439*^9}, {
  3.871225813156314*^9, 3.871225936143889*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[237]:=",ExpressionUUID->"195e273f-6ef7-4a4e-9698-8b3c02896d96"]
}, Closed]],

