7975bf29fd8a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Width", "[", "mat_", "]"}], ":=", " ", 
  RowBox[{"Last", "[", 
   RowBox[{"Dimensions", "[", "mat", "]"}], "]"}]}]], "Input",
