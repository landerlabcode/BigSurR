Cell[CellGroupData[{

Cell["TruncateGNO", "Subsubsection",
 CellChangeTimes->{{3.871899676072687*^9, 
  3.871899679856929*^9}},ExpressionUUID->"46a291b6-202c-4faa-91e1-\
85e93688b146"],

Cell["\<\
This truncates a gNO, eliminating correlations that fall below a certain \
threshold of PCC.  Options allow one to also select only the positive or \
negative correlations .  
If the second argument is left out, only the options are applied\
\>", "Text",
 CellChangeTimes->{{3.871900573113618*^9, 3.871900592273279*^9}, {
   3.8719007914311666`*^9, 3.871900804091263*^9}, {3.8727807185852337`*^9, 
   3.872780722177582*^9}, 3.876391667288209*^9, {3.876391703631558*^9, 
   3.876391742418481*^9}, {3.876392879604054*^9, 
   3.876392879766724*^9}},ExpressionUUID->"ccc31d9a-39ed-4333-84cf-\
a1dcfc86680c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "TruncateGNO", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Positive Only\>\"", "->", " ", "False"}], ",", " ", 
      RowBox[{"\"\<Negative Only\>\"", "->", " ", "False"}]}], "}"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TruncateGNO", "[", 
    RowBox[{"gNO_", ",", " ", 
     RowBox[{"ccthreshold_", ":", "0"}], ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hits", ",", " ", "sigmat", ",", " ", "adjustedmatrix"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sigmat", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}], ",", 
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{"gNO", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ">", "ccthreshold"}], "]"}], ",", 
         " ", 
         RowBox[{"OptionValue", "[", "\"\<Negative Only\>\"", "]"}], ",", 
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"gNO", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ">", "ccthreshold"}], "]"}], ",",
          " ", "True", ",", " ", 
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"gNO", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "]"}], ">", "ccthreshold"}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"ArrayRules", "[", "sigmat", "]"}], "]"}], "<", "2"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<no hits found\>\"", "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"adjustedmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"sigmat", "*", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
         RowBox[{"Dimensions", "[", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hits", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Keys", "[", 
           RowBox[{"Drop", "[", 
            RowBox[{
             RowBox[{"ArrayRules", "[", "adjustedmatrix", "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"BoolEval", "[", 
         RowBox[{
          RowBox[{"adjustedmatrix", "\[LeftDoubleBracket]", 
           RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ">",
           "0"}], "]"}], ",", 
        RowBox[{"gNO", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "hits"}], "]"}], "]"}], ",", 
        RowBox[{"adjustedmatrix", "\[LeftDoubleBracket]", 
         RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
        " ", "\[IndentingNewLine]", 
        RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            
            RowBox[{"\"\<From Expression Matrix\>\"", "\[Rule]", 
             " ", "\"\<Metadata\>\""}], "/.", 
            RowBox[{"Last", "[", "gNO", "]"}]}], ",", " ", 
           RowBox[{"\"\<Imposed Abs[cc] cutoff of \>\"", "<>", 
            RowBox[{"ToString", "[", "ccthreshold", "]"}]}]}], "}"}]}]}], 
       "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.871899684153799*^9, 3.871899692971012*^9}, {
  3.871899738886973*^9, 3.871899830514152*^9}, {3.871899878647283*^9, 
  3.871899885882637*^9}, {3.871899938636338*^9, 3.871899976053957*^9}, {
  3.871900015340189*^9, 3.871900015963457*^9}, {3.871900120189477*^9, 
  3.871900194121873*^9}, {3.871900312816313*^9, 3.871900560394291*^9}, {
  3.871900608796007*^9, 3.8719006450938168`*^9}, {3.871900676468605*^9, 
  3.871900781875923*^9}, {3.876391745124301*^9, 3.876391784090085*^9}, {
  3.876391827754765*^9, 3.8763919130697308`*^9}, {3.876392884089764*^9, 
  3.876392888617971*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[79]:=",ExpressionUUID->"ebeb5de0-de0f-46a8-bef8-9525de6f4eda"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RecalculateGNO", "Subsubsection",
 CellChangeTimes->{{3.871899676072687*^9, 3.871899679856929*^9}, {
  3.872780737666727*^9, 
  3.872780746154777*^9}},ExpressionUUID->"e7e2b80f-cbb7-49c8-b327-\
081230e46a54"],

Cell["\<\
This enables one to take an existing GNO along with the files used to make \
it, and recalculate it using different significance threshold criteria\
\>", "Text",
 CellChangeTimes->{{3.8727807489205093`*^9, 
  3.872780780677579*^9}},ExpressionUUID->"91526403-930e-49d4-88ad-\
063a17619965"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RecalculateGNO", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Positive Only\>\"", "->", " ", "False"}], ",", " ", 
     RowBox[{"\"\<Negative Only\>\"", "->", " ", "False"}], ",", " ", 
     RowBox[{"\"\<Threshold\>\"", "->", " ", "\"\<Bonferroni\>\""}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RecalculateGNO", "[", 
   RowBox[{
   "matpac_", ",", "gNO_", ",", " ", "ccthreshold_", ",", "directory_", ",", 
    "filemarker_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "logpvals", ",", "equivPCCs", ",", " ", "sigPCCs", ",", " ", "cutoff"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SetDirectory", "[", 
      RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cutoff", " ", "=", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", " ", "\"\<Threshold\>\"", "]"}], 
         "==", "\"\<Bonferroni\>\""}], ",", 
        RowBox[{"-", 
         RowBox[{"Log10", "[", 
          FractionBox["0.05", 
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"matpac", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "2"}], "]"}]], 
          "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"OptionValue", "[", " ", "\"\<Threshold\>\"", "]"}], "]"}], ",", 
        RowBox[{"-", 
         RowBox[{"Log10", "[", 
          FractionBox[
           RowBox[{"OptionValue", "[", " ", "\"\<Threshold\>\"", "]"}], 
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"matpac", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "2"}], "]"}]], 
          "]"}]}], " ", ",", "\[IndentingNewLine]", "True", ",", " ", 
        RowBox[{"Abort", "[", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"logpvals", "=", 
      RowBox[{"Import", "[", 
       RowBox[{
       "directory", "<>", "\"\</\>\"", "<>", "filemarker", 
        "<>", "\"\<_logpvalues.mx\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"equivPCCs", " ", "=", " ", 
      RowBox[{"Import", "[", 
       RowBox[{
       "directory", "<>", "\"\</\>\"", "<>", "filemarker", 
        "<>", "\"\<_equivalentPCCs.mx\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sigPCCs", "=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", "=", 
          RowBox[{"Length", "[", "equivPCCs", "]"}]}], "}"}], ",", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{"logpvals", ">", "cutoff"}], "]"}], "*", "equivPCCs"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", "m"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", " ", 
      RowBox[{
       RowBox[{
       "directory", "<>", "\"\</\>\"", "<>", "filemarker", 
        "<>", "\"\<REVISED\>\"", "<>", "\"\<_significantPCCs.mx\>\""}], ",", 
       " ", "sigPCCs"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"CreateGNO", "[", 
      RowBox[{"matpac", ",", "sigPCCs"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.872780795000298*^9, 3.872780801472249*^9}, {
  3.8727808364068413`*^9, 3.872780839462079*^9}, {3.872781025871357*^9, 
  3.872781030724897*^9}, {3.872781081679913*^9, 3.8727811157117434`*^9}, {
  3.8727811686992073`*^9, 3.8727811874236917`*^9}, {3.872781219962245*^9, 
  3.872781250922818*^9}, {3.872781338567512*^9, 3.872781589203965*^9}, {
  3.872781631441669*^9, 3.872781685801259*^9}, {3.8727817914339123`*^9, 
  3.872781901822051*^9}, {3.8727819892889347`*^9, 3.872782022393055*^9}, {
  3.877693342738723*^9, 3.877693352579262*^9}, {3.880193066968449*^9, 
  3.880193096444875*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[81]:=",ExpressionUUID->"7a0c3320-f40d-419b-a7b4-3faacb0df34c"]
}, Closed]],

Cell[CellGroupData[{

Cell["PurgeGNO", "Subsubsection",
 CellChangeTimes->{{3.871931194191635*^9, 3.871931199966646*^9}, 
   3.871932221238196*^9},ExpressionUUID->"98117669-2f9b-4ab1-a481-\
5f471a11d20f"],

Cell["This eliminates specified genes from a GNO", "Text",
 CellChangeTimes->{{3.871931203750683*^9, 
  3.87193121297462*^9}},ExpressionUUID->"63e99397-0a14-48e9-a5e9-\
0e49089142cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PurgeGNO", "[", 
   RowBox[{"gNO_", ",", " ", "genes_"}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hits", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"gNO", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
          "genes"}], "]"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"gNO", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "hits", ",", " ", "hits"}], "]"}], "]"}], ",", " ", 
      
      RowBox[{"gNO", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "hits"}], "]"}], "]"}], ",", 
      RowBox[{"gNO", "[", 
       RowBox[{"[", 
        RowBox[{"3", ",", " ", "hits", ",", " ", "hits"}], "]"}], "]"}], " ", 
      ",", " ", 
      RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<From GNO\>\"", "\[Rule]", " ", "\"\<Metadata\>\""}], "/.", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
         RowBox[{"\"\<Having removed \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "genes", "]"}], "]"}], 
          "<>", "\"\< genes\>\""}]}], "}"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.871931220944965*^9, 3.871931335385377*^9}, {
  3.871931368089097*^9, 3.871931488322111*^9}, {3.87193182511465*^9, 
  3.871931825708074*^9}, {3.8719322319935417`*^9, 3.871932233771594*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[83]:=",ExpressionUUID->"3b046a08-b65e-4e61-822c-5f8b855898e0"]
}, Closed]],

Cell[CellGroupData[{

Cell["GeneSubsetGNO", "Subsubsection",
 CellChangeTimes->{{3.8730367802817087`*^9, 
  3.8730367863244953`*^9}},ExpressionUUID->"35f99c87-5bf0-471f-aa43-\
1a2da8f553aa"],

Cell["\<\
This cuts down a GNO to contain only certain genes.  If the list contains \
genes that are not in the gNO they are ignored.  

We are adding an option to this:  When it is set to \
\[OpenCurlyDoubleQuote]Purge\[CloseCurlyDoubleQuote]-> True, it will purge \
from the gNO any genes for which there are no correlations.  Normally this is \
set to False, but for some applications, like NewPlot we need it set to True.

Note that it was noticed on 3/13/23 that with the original form of this \
function, unless the genes were put in the same order as they appear in the \
gNO, the resulting matrix would come out not properly lower-triangularized.  \
All the data were present but sometimes whether it appeared in mainly in \
column or row varied.  This got fixed by restoring the symmetry and then \
lower triangularizing.  It didn\[CloseCurlyQuote]t seem to affect any \
downstream functions.  \
\>", "Text",
 CellChangeTimes->{{3.873036788613863*^9, 3.873036803543167*^9}, {
   3.883497026556128*^9, 3.883497082969308*^9}, 3.883497136132945*^9, {
   3.884087440523278*^9, 3.884087453639999*^9}, {3.884089579614732*^9, 
   3.884089612266101*^9}, {3.884089956070779*^9, 3.88408997201604*^9}, {
   3.8877399511802177`*^9, 
   3.887740114925539*^9}},ExpressionUUID->"2d80a314-f094-4128-a47e-\
9df52292afef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GeneSubsetGNO", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Purge\>\"", "->", " ", "False"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GeneSubsetGNO", "[", 
   RowBox[{"gNO_", ",", " ", "genes_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Intersection", "[", 
      RowBox[{"genes", ",", " ", 
       RowBox[{"gNO", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "==", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"\"\<Metadata\>\"", "->", " ", "\"\<list was empty\>\""}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"hits", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"gNO", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@",
            "genes"}], "]"}]}], ",", "tempgNO", ",", " ", "newhits"}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tempgNO", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"LowerTriangularize", "[", 
           RowBox[{
            RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
             RowBox[{"gNO", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "hits", ",", " ", "hits"}], "]"}], "]"}], 
             "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}], ",", " ", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "hits"}], "]"}], "]"}], ",", 
          RowBox[{"LowerTriangularize", "[", 
           RowBox[{
            RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
             RowBox[{"gNO", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "hits", ",", " ", "hits"}], "]"}], 
              "]"}], "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Purge\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"newhits", " ", "=", 
           RowBox[{"Union", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"tempgNO", "[", 
               RowBox[{"[", "1", "]"}], "]"}], 
              "[", "\"\<ExplicitPositions\>\"", "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"tempgNO", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "newhits", ",", " ", "newhits"}], "]"}], 
             "]"}], ",", " ", 
            RowBox[{"tempgNO", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "newhits"}], "]"}], "]"}], ",", " ", 
            RowBox[{"tempgNO", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", " ", "newhits", ",", " ", "newhits"}], "]"}], 
             "]"}], ",", 
            RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                
                RowBox[{"\"\<From GNO\>\"", "\[Rule]", 
                 " ", "\"\<Metadata\>\""}], "/.", 
                RowBox[{"gNO", "[", 
                 RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
               RowBox[{"\"\<Having subsetted \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"Length", "[", "newhits", "]"}], "]"}], 
                "<>", "\"\< genes\>\""}]}], "}"}]}]}], " ", "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Append", "[", 
          RowBox[{"tempgNO", ",", " ", 
           RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               
               RowBox[{"\"\<From GNO\>\"", "\[Rule]", 
                " ", "\"\<Metadata\>\""}], "/.", 
               RowBox[{"gNO", "[", 
                RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
              RowBox[{"\"\<Having subsetted \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"Length", "[", "hits", "]"}], "]"}], 
               "<>", "\"\< genes\>\""}]}], "}"}]}]}], "]"}]}], "]"}]}]}], 
     "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.873036806849183*^9, 3.873036893847172*^9}, {
   3.8834971029406767`*^9, 3.883497109222474*^9}, {3.883497143626514*^9, 
   3.8834971454330063`*^9}, {3.884089616245758*^9, 3.884089643212865*^9}, {
   3.884089696483109*^9, 3.884089844331859*^9}, {3.884089922501693*^9, 
   3.8840899403018303`*^9}, {3.88409000041*^9, 3.884090002426394*^9}, {
   3.884090484208825*^9, 3.8840904888815737`*^9}, {3.8840905396914454`*^9, 
   3.8840905490896053`*^9}, 3.884090597551406*^9, {3.8840906321221333`*^9, 
   3.884090637099958*^9}, {3.8840907294598837`*^9, 3.884090765054783*^9}, {
   3.88409080673379*^9, 3.884090808950274*^9}, {3.8840908776564198`*^9, 
   3.884090879029138*^9}, {3.884090933162221*^9, 3.884090960637547*^9}, {
   3.884091114231207*^9, 3.884091115049288*^9}, {3.88409117341733*^9, 
   3.884091184206601*^9}, {3.884091310941476*^9, 3.884091354612588*^9}, {
   3.884091474291045*^9, 3.884091698364012*^9}, {3.884091774717923*^9, 
   3.884091776688018*^9}, {3.8877399346788282`*^9, 3.887739940714711*^9}, {
   3.890088365077318*^9, 3.8900884533596773`*^9}, {3.890088503685046*^9, 
   3.890088522842605*^9}, {3.890088558442134*^9, 3.89008855942345*^9}, {
   3.890088639285305*^9, 3.890088655495171*^9}, {3.890088893949603*^9, 
   3.890088913539028*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[84]:=",ExpressionUUID->"5488f59e-6442-427c-b2f0-b7d6b31781ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["CombineGNO", "Subsubsection",
 CellChangeTimes->{{3.8856691665335903`*^9, 
  3.88566916864353*^9}},ExpressionUUID->"621bafaa-c864-4b73-ba11-\
7e1133fec70c"],

Cell["\<\
This code puts two gno\[CloseCurlyQuote]s together into a single one.  It \
considers only the positive entries.  For any genes which are represent in \
both GNOs, it uses whichever correlation value is greatest.  \
\>", "Text",
 CellChangeTimes->{{3.885669196847557*^9, 
  3.8856692570563374`*^9}},ExpressionUUID->"849be975-028e-4230-835d-\
4552ed2c7f23"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CombineGNO", "[", 
   RowBox[{"gno1_", ",", " ", "gno2_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"genes1", "=", 
       RowBox[{"gno1", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
      RowBox[{"genes2", "=", 
       RowBox[{"gno2", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "intersect", ",", " ", 
      "complement1", ",", " ", "complement2", ",", "l1", ",", " ", "l2", ",", 
      " ", "l3", ",", "g1int", ",", " ", "g2int", ",", " ", "gcomp1", ",", 
      " ", "gcomp2", ",", "ltotal", ",", "mat1", ",", " ", "mat2", ",", 
      "block1", ",", " ", "block1a", ",", " ", "block1b", ",", " ", "block2", 
      ",", " ", "block3", ",", " ", "block4", ",", " ", "merged"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"intersect", "=", 
      RowBox[{"Intersection", "[", 
       RowBox[{"genes1", ",", " ", "genes2"}], "]"}]}], ";", " ", 
     RowBox[{"complement1", " ", "=", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{"genes1", ",", " ", "genes2"}], "]"}]}], ";", " ", 
     RowBox[{"complement2", " ", "=", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{"genes2", ",", " ", "genes1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l1", "=", 
      RowBox[{"Length", "[", "intersect", "]"}]}], ";", " ", 
     RowBox[{"l2", "=", 
      RowBox[{"Length", "[", "complement1", "]"}]}], ";", " ", 
     RowBox[{"l3", "=", 
      RowBox[{"Length", "[", "complement2", "]"}]}], ";", " ", 
     RowBox[{"ltotal", "=", 
      RowBox[{"l1", "+", "l2", "+", "l3"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mat1", "=", 
      RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
       RowBox[{
        RowBox[{"BoolEval", "[", 
         RowBox[{
          RowBox[{"gno1", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ">", "0"}], "]"}], "*", 
        RowBox[{"gno1", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", " ", 
     RowBox[{"mat2", "=", 
      RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
       RowBox[{
        RowBox[{"BoolEval", "[", 
         RowBox[{
          RowBox[{"gno2", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ">", "0"}], "]"}], "*", 
        RowBox[{"gno2", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g1int", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gno1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "intersect"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g2int", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gno2", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "intersect"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gcomp1", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gno1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "complement1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gcomp2", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gno2", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "complement2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"block1", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{"Max", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"mat1", "[", 
             RowBox[{"[", 
              RowBox[{"g1int", ",", " ", "g1int"}], "]"}], "]"}], ",", " ", 
            RowBox[{"mat2", "[", 
             RowBox[{"[", 
              RowBox[{"g2int", ",", " ", "g2int"}], "]"}], "]"}]}], "}"}], ",",
           " ", "2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ltotal", ",", " ", "ltotal"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"block1a", " ", "=", 
      RowBox[{"SparseArray", "[", " ", 
       RowBox[{
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"mat1", "[", 
           RowBox[{"[", 
            RowBox[{"gcomp1", ",", " ", 
             RowBox[{"Join", "[", 
              RowBox[{"g1int", ",", " ", "gcomp1"}], "]"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"l1", "+", "l2"}], ")"}]}], ",", 
            RowBox[{"l1", "+", "l2"}]}], " ", "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ltotal", ",", " ", "ltotal"}], "}"}]}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"block1b", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"mat1", "[", 
           RowBox[{"[", 
            RowBox[{"g1int", ",", " ", "gcomp1"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l1", ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"l1", "+", "l2"}], ")"}]}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ltotal", ",", " ", "ltotal"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"block2", " ", "=", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"PadRight", "[", 
        RowBox[{
         RowBox[{"mat2", "[", 
          RowBox[{"[", 
           RowBox[{"gcomp2", ",", "g2int"}], " ", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "ltotal"}], ",", "ltotal"}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"block3", " ", "=", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"PadRight", "[", 
        RowBox[{
         RowBox[{"mat2", "[", 
          RowBox[{"[", 
           RowBox[{"g2int", ",", "gcomp2"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ltotal", ",", 
           RowBox[{"-", "ltotal"}]}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"block4", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"PadRight", "[", 
        RowBox[{
         RowBox[{"mat2", "[", 
          RowBox[{"[", 
           RowBox[{"gcomp2", ",", "gcomp2"}], " ", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "ltotal"}], ",", 
           RowBox[{"-", "ltotal"}]}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"merged", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{
         RowBox[{
         "block1", "+", "block1a", "+", "block1b", "+", " ", "block2", "+", 
          " ", "block3", "+", " ", "block4"}], ",", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"BoolEval", "[", 
          RowBox[{"merged", ">", "0"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ltotal", ",", " ", "ltotal"}], "}"}]}], "]"}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
        "intersect", ",", " ", "complement1", ",", " ", "complement2"}], 
        "]"}], ",", " ", "merged", ",", " ", 
       RowBox[{"\"\<Metadata\>\"", "->", " ", "\"\<Reconstructed\>\""}]}], 
      "}"}]}]}], " ", "]"}]}]], "Input",
 CellChangeTimes->{{3.885660462897767*^9, 3.885660463245595*^9}, {
   3.885660539562842*^9, 3.885660560123712*^9}, {3.885666224996125*^9, 
   3.885666227667417*^9}, {3.885666271833788*^9, 3.885666280150405*^9}, {
   3.885666383791098*^9, 3.885666416672271*^9}, {3.885666616285789*^9, 
   3.885666661484853*^9}, {3.885666760134016*^9, 3.885666771393004*^9}, {
   3.88566699418336*^9, 3.8856670024147*^9}, {3.885667093377396*^9, 
   3.88566715064509*^9}, {3.885667190026108*^9, 3.885667276720895*^9}, {
   3.8856673624107637`*^9, 3.8856673779962177`*^9}, 3.8856674160915823`*^9, {
   3.885667446507876*^9, 3.8856675083252583`*^9}, {3.885667593607069*^9, 
   3.885667643586968*^9}, {3.885667804191738*^9, 3.885667834661675*^9}, {
   3.885667904965762*^9, 3.8856680169563913`*^9}, {3.885668108562537*^9, 
   3.885668330557912*^9}, {3.885668379146451*^9, 3.885668389227029*^9}, {
   3.885668427451398*^9, 3.8856684422095127`*^9}, {3.885668477588435*^9, 
   3.885668516449321*^9}, {3.8856686198189983`*^9, 3.885668641124558*^9}, {
   3.885668909578882*^9, 3.885668912862557*^9}, {3.885668963383122*^9, 
   3.885668989162941*^9}, {3.885669024721394*^9, 3.885669078354653*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[86]:=",ExpressionUUID->"866fc7c9-b2e5-45b9-b8c0-78c780c79232"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Finding Modules in Graphs (",
 StyleBox["FindGroups, FindCommunities, FindCommunitiesRecursive, \
FindSubCommunities, DisplayCommunities, Neighborhood, Single CommunityGraph, \
Single CommunityGraphTrio, NeighborZoom, DirectTargetsPos, DirectTargetsNeg, \
