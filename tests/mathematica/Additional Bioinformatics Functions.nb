d4a399a1ec1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JoinRowTop", "[", 
   RowBox[{"row_", ",", " ", "matrix_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "row", "]"}], "==", 
     RowBox[{"Width", "[", "matrix", "]"}]}], ",", 
    RowBox[{"Prepend", "[", 
     RowBox[{"matrix", ",", " ", "row"}], "]"}], ",", "  ", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<Cannot join; incorrect dimensions\>\"", "]"}],
