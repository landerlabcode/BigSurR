Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "GenesByMultipleCutoff", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Positive Only\>\"", "->", " ", "False"}], "}"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GenesByMultipleCutoff", "[", 
     RowBox[{"gNO_", ",", " ", "genes_", ",", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gno", "=", 
         RowBox[{"GeneSubsetGNO", "[", 
          RowBox[{"gNO", ",", " ", 
           RowBox[{"Flatten", "[", "genes", "]"}]}], "]"}]}], ",", " ", "mat",
         ",", " ", "geneset", ",", " ", "workingmat", ",", "workingposns", ",",
         " ", "q", ",", " ", "lists"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mat", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{
             RowBox[{"gno", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ">", "0"}], "]"}], "*", 
           RowBox[{"gno", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", 
          RowBox[{"gno", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"Quantile", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"mat", "[", "\"\<ExplicitValues\>\"", "]"}], "]"}], ",", 
          RowBox[{"Reverse", "[", 
           RowBox[{"Table", "[", 
            RowBox[{"i", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", "1", ",", " ", "0.1"}], 
              "}"}]}], "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"geneset", "=", 
        RowBox[{"gno", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lists", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"geneset", "[", 
            RowBox[{"[", 
             RowBox[{"Union", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{"SparseArray", "[", 
                 RowBox[{
                  RowBox[{"BoolEval", "[", 
                   RowBox[{
                    RowBox[{"q", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ">=", " ", "mat", ">", 
                    RowBox[{"q", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], "*", 
                  "mat"}], "]"}], "[", "\"\<ExplicitPositions\>\"", "]"}], 
               "]"}], "]"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"TextGrid", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"List", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"q", "[", 
                RowBox[{"[", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", 
                   RowBox[{"i", "+", "1"}]}], "}"}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "10"}], "}"}]}], "]"}], ",", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"lists", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Complement", "[", 
                  RowBox[{
                   RowBox[{"lists", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{"lists", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", 
                    RowBox[{"j", "-", "1"}]}], "]"}], "]"}], "]"}]}], "]"}], ",",
                  " ", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", " ", "2", ",", "10"}], "}"}]}], "]"}]}], 
              "]"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"Frame", "->", "All"}]}], "]"}]}]}], "]"}]}]}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.8832979950462713`*^9, 3.8832980278594637`*^9}, {
   3.883298199993572*^9, 3.883298202813355*^9}, {3.883312540772524*^9, 
   3.8833127062289343`*^9}, {3.883312762529263*^9, 3.883312970199645*^9}, {
   3.88331301809457*^9, 3.883313070592964*^9}, 3.883313111227507*^9, {
   3.883313282968502*^9, 3.883313439940434*^9}, {3.883313493981439*^9, 
