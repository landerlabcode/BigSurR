Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "gNetworkObject2", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Type\>\"", " ", "\[Rule]", "  ", "\"\<PCC\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gNetworkObject2", "[", 
   RowBox[{
   "matpac_", ",", "correlmatpac_", ",", "cutoff_", ",", " ", "minlink_", ",",
     " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", 
        RowBox[{
        "matpac", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "]"}]}], ",", "\[Tau]", ",", "m", ",", "sa", ",", " ", "hits", ",", 
      "  ", "corr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
        "\[Equal]", "\"\<PCC\>\""}], ",", 
       RowBox[{"\[Tau]", "=", "cutoff"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
        "\[Equal]", "\"\<FDR\>\""}], ",", "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cList", "=", 
           RowBox[{"ReverseSort", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Last", "/@", 
              RowBox[{"Drop", "[", 
               RowBox[{
                RowBox[{"ArrayRules", "[", 
                 RowBox[{"correlmatpac", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "Print", "[", "\"\<ready to apply B-H correction\>\"", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "=", 
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"Length", "[", 
                  RowBox[{"correlmatpac", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], "2"], "-", 
                RowBox[{"Length", "[", 
                 RowBox[{"correlmatpac", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}]}]}], ";", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"i", "=", "1"}], ",", " ", 
              RowBox[{
               RowBox[{"i", "\[LessEqual]", 
                RowBox[{"Length", "[", "cList", "]"}]}], " ", "&&", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "cList", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}], "-", 
                 RowBox[{"Tanh", "[", 
                  FractionBox[
                   RowBox[{
                    SqrtBox["2"], " ", 
                    RowBox[{"InverseErfc", "[", 
                    FractionBox[
                    RowBox[{"i", "*", "cutoff"}], "m"], "]"}]}], 
                   SqrtBox[
                    RowBox[{
                    RowBox[{"-", "3"}], "+", "n"}]]], "]"}]}], "\[GreaterEqual]",
                 " ", "0"}]}], ",", " ", 
              RowBox[{"i", "++"}]}], " ", "]"}], ";", "  ", 
            "\[IndentingNewLine]", 
            RowBox[{"\[Tau]", "=", 
             RowBox[{"cList", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ";", " ", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<PCC cutoff = \>\"", ",", "\[Tau]"}], "]"}]}], 
           ")"}]}]}], "]"}], ",", "\[IndentingNewLine]", "True", ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Type option not recognized\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"BoolEval", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "correlmatpac", "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], "<", 
          RowBox[{"-", "\[Tau]"}]}], "||", 
         RowBox[{
          RowBox[{
          "correlmatpac", "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], ">", "\[Tau]"}]}], " ", "]"}], "]"}]}], 
     ";", 
     RowBox[{"hits", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"First", "/@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Tally", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"First", "/@", 
             RowBox[{"Drop", "[", 
              RowBox[{
               RowBox[{"ArrayRules", "[", "sa", "]"}], ",", 
               RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], ">", 
            RowBox[{"minlink", "-", "1"}]}], "&"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"ArrayRules", "[", "sa", "]"}], "]"}], "<", "2"}], ",", 
       RowBox[{"Print", "[", "\"\<no hits found\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sa", "\[LeftDoubleBracket]", 
          RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"correlmatpac", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"correlmatpac", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "hits", ",", " ", "hits"}], 
           "\[RightDoubleBracket]"}], "*", 
          RowBox[{"sa", "\[LeftDoubleBracket]", 
           RowBox[{"hits", ",", "hits"}], "\[RightDoubleBracket]"}]}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             
             RowBox[{"\"\<From Expression Matrix\>\"", "\[Rule]", 
              " ", "\"\<Metadata\>\""}], "/.", 
             RowBox[{"Last", "[", "matpac", "]"}]}], " ", ",", 
            RowBox[{
             
             RowBox[{"\"\<From Correlation Matrix\>\"", "\[Rule]", 
              " ", "\"\<Metadata\>\""}], "/.", 
             RowBox[{"Last", "[", "correlmatpac", "]"}]}], ",", 
            RowBox[{"\"\<Tested_By\>\"", "\[Rule]", "  ", 
             RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}]}], ",", 
            RowBox[{"\"\<FDR_cutoff\>\"", "\[Rule]", 
             RowBox[{"If", "[", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
                "\[Equal]", "\"\<FDR\>\""}], ",", " ", "cutoff", ",", 
               "None"}], "]"}]}], ",", "  ", 
            RowBox[{"\"\<CC_cutoff\>\"", "\[Rule]", " ", "\[Tau]"}], ",", " ", 
            RowBox[{"\"\<Minimum_Linkages\>\"", "\[Rule]", " ", "minlink"}]}],
            "}"}]}]}], "}"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.8400982757513742`*^9, 3.840098314035741*^9}, {
   3.8400994012946863`*^9, 3.8400994083613358`*^9}, 3.840099484247375*^9, {
   3.8400995582707167`*^9, 3.84009956438601*^9}, {3.8400997631787987`*^9, 
   3.840099794910433*^9}, {3.840457795119958*^9, 3.840457819560576*^9}, {
   3.840458208061748*^9, 3.8404582087365837`*^9}, {3.8406413787861767`*^9, 
   3.8406413960928993`*^9}, {3.846529991295575*^9, 3.8465300009822893`*^9}, {
   3.8465300332262173`*^9, 3.846530046119622*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[62]:=",ExpressionUUID->"ffdee072-e37c-4d15-82e6-7c3162a54613"],

Cell["\<\
The BF correction in the above is slightly too generous, because it uses as \
the denominator \[OpenCurlyDoubleQuote]m\[CloseCurlyDoubleQuote] the length \
of the correlmatpac.  But because the correlmatpac may be been generated with \
a minimum correlation, it may actually have fewer elements than were used to \
construct it.  Those elements cut out because they had no correlations at all \
should be included in \[OpenCurlyDoubleQuote]m\[CloseCurlyDoubleQuote].  This \
fixes that, by adding an argument \[OpenCurlyDoubleQuote]subset length\
\[CloseCurlyDoubleQuote] where you fill in the length of the gene subset used \
to create the correlmatpac\
\>", "Text",
 CellChangeTimes->{{3.846530191913813*^9, 3.84653028641779*^9}, {
  3.8465303809852753`*^9, 3.8465303849166317`*^9}, {3.8465305963396606`*^9, 
  3.84653059963763*^9}, {3.8465306446764917`*^9, 
  3.8465306681131268`*^9}},ExpressionUUID->"68f09445-cc48-466a-9c98-\
deb9122dfeae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "gNetworkObject3", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Type\>\"", " ", "\[Rule]", "  ", "\"\<PCC\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gNetworkObject3", "[", 
   RowBox[{
   "matpac_", ",", "correlmatpac_", ",", "subsetlength_", ",", "cutoff_", ",",
     " ", "minlink_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", 
        RowBox[{
        "matpac", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "]"}]}], ",", "\[Tau]", ",", "m", ",", "sa", ",", " ", "hits", ",", 
      "  ", "corr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
        "\[Equal]", "\"\<PCC\>\""}], ",", 
       RowBox[{"\[Tau]", "=", "cutoff"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
        "\[Equal]", "\"\<FDR\>\""}], ",", "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cList", "=", 
           RowBox[{"ReverseSort", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Last", "/@", 
              RowBox[{"Drop", "[", 
               RowBox[{
                RowBox[{"ArrayRules", "[", 
                 RowBox[{"correlmatpac", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "Print", "[", "\"\<ready to apply B-H correction\>\"", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "=", 
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["subsetlength", "2"], "-", "subsetlength"}], 
               ")"}]}]}], ";", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"i", "=", "1"}], ",", " ", 
              RowBox[{
               RowBox[{"i", "\[LessEqual]", 
                RowBox[{"Length", "[", "cList", "]"}]}], " ", "&&", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "cList", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}], "-", 
                 RowBox[{"Tanh", "[", 
                  FractionBox[
                   RowBox[{
                    SqrtBox["2"], " ", 
                    RowBox[{"InverseErfc", "[", 
                    FractionBox[
                    RowBox[{"i", "*", "cutoff"}], "m"], "]"}]}], 
                   SqrtBox[
                    RowBox[{
                    RowBox[{"-", "3"}], "+", "n"}]]], "]"}]}], "\[GreaterEqual]",
                 " ", "0"}]}], ",", " ", 
              RowBox[{"i", "++"}]}], " ", "]"}], ";", "  ", 
            "\[IndentingNewLine]", 
            RowBox[{"\[Tau]", "=", 
             RowBox[{"cList", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ";", " ", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<PCC cutoff = \>\"", ",", "\[Tau]"}], "]"}]}], 
           ")"}]}]}], "]"}], ",", "\[IndentingNewLine]", "True", ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Type option not recognized\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"BoolEval", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "correlmatpac", "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], "<", 
          RowBox[{"-", "\[Tau]"}]}], "||", 
         RowBox[{
          RowBox[{
          "correlmatpac", "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], ">", "\[Tau]"}]}], " ", "]"}], "]"}]}], 
     ";", 
     RowBox[{"hits", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"First", "/@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Tally", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"First", "/@", 
             RowBox[{"Drop", "[", 
              RowBox[{
               RowBox[{"ArrayRules", "[", "sa", "]"}], ",", 
               RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], ">", 
            RowBox[{"minlink", "-", "1"}]}], "&"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"ArrayRules", "[", "sa", "]"}], "]"}], "<", "2"}], ",", 
       RowBox[{"Print", "[", "\"\<no hits found\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sa", "\[LeftDoubleBracket]", 
          RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"correlmatpac", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"correlmatpac", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "hits", ",", " ", "hits"}], 
           "\[RightDoubleBracket]"}], "*", 
          RowBox[{"sa", "\[LeftDoubleBracket]", 
           RowBox[{"hits", ",", "hits"}], "\[RightDoubleBracket]"}]}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             
             RowBox[{"\"\<From Expression Matrix\>\"", "\[Rule]", 
              " ", "\"\<Metadata\>\""}], "/.", 
             RowBox[{"Last", "[", "matpac", "]"}]}], " ", ",", 
            RowBox[{
             
             RowBox[{"\"\<From Correlation Matrix\>\"", "\[Rule]", 
              " ", "\"\<Metadata\>\""}], "/.", 
             RowBox[{"Last", "[", "correlmatpac", "]"}]}], ",", 
            RowBox[{"\"\<Tested_By\>\"", "\[Rule]", "  ", 
             RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}]}], ",", 
            RowBox[{"\"\<FDR_cutoff\>\"", "\[Rule]", 
             RowBox[{"If", "[", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
                "\[Equal]", "\"\<FDR\>\""}], ",", " ", "cutoff", ",", 
               "None"}], "]"}]}], ",", "  ", 
            RowBox[{"\"\<CC_cutoff\>\"", "\[Rule]", " ", "\[Tau]"}], ",", " ", 
            RowBox[{"\"\<Minimum_Linkages\>\"", "\[Rule]", " ", "minlink"}]}],
            "}"}]}]}], "}"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.8400982757513742`*^9, 3.840098314035741*^9}, {
   3.8400994012946863`*^9, 3.8400994083613358`*^9}, 3.840099484247375*^9, {
   3.8400995582707167`*^9, 3.84009956438601*^9}, {3.8400997631787987`*^9, 
   3.840099794910433*^9}, {3.840457795119958*^9, 3.840457819560576*^9}, {
   3.840458208061748*^9, 3.8404582087365837`*^9}, {3.8406413787861767`*^9, 
   3.8406413960928993`*^9}, {3.846529991295575*^9, 3.8465300009822893`*^9}, {
   3.8465300332262173`*^9, 3.846530046119622*^9}, {3.8465305914796963`*^9, 
   3.8465306415457373`*^9}, {3.846530680364972*^9, 3.84653068870883*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[64]:=",ExpressionUUID->"88f40686-449c-4e72-9ca2-921985671fee"]
}, Closed]],

Cell[CellGroupData[{

Cell["PosCorrelOnly", "Subsubsection",
 CellChangeTimes->{{3.849017618977435*^9, 
  3.849017623772563*^9}},ExpressionUUID->"5a0b5564-e89d-4832-8737-\
341cfd88fb97"],

Cell["\<\
This modifies a gNO so that only the positive correlations are kept.   It \
does not, however, delete any rows and columns that had only negative values \
in them; they must remain as rows or columns of all zeros.  The result is, if \
one runs FindCommunities on them, such purely negative genes appear as \
singleton communities.  \
\>", "Text",
 CellChangeTimes->{{3.849017632061761*^9, 
  3.849017669389844*^9}},ExpressionUUID->"4d6c51aa-620f-403a-8712-\
71bf4b487266"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PosCorrelOnly", "[", "gNetworkObject_", "]"}], ":=", 
  RowBox[{"ReplacePart", "[", 
   RowBox[{"gNetworkObject", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "\[Rule]", 
       RowBox[{"BoolEval", "[", 
        RowBox[{
         RowBox[{"gNetworkObject", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ">", "0"}], "]"}]}], " ", ",", 
      RowBox[{"3", "\[Rule]", " ", 
       RowBox[{
        RowBox[{"gNetworkObject", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "*", 
        RowBox[{"BoolEval", "[", 
         RowBox[{
          RowBox[{"gNetworkObject", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ">", "0"}], "]"}]}]}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8490090214883537`*^9, 3.8490091468848133`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[66]:=",ExpressionUUID->"e88d1a59-499e-4ff8-a8d0-7423426adb5d"]
}, Closed]],

Cell[CellGroupData[{

Cell["GraphNetwork", "Subsubsection",
 CellChangeTimes->{{3.832289927327015*^9, 3.832289930317321*^9}, 
   3.832290132878097*^9},
 CellLabel->"In[26]:=",ExpressionUUID->"78a57e5c-e119-4881-96d0-ad57e370141a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GraphNetwork", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<EdgeStyle\>\"", "\[Rule]", " ", "Thin"}], ",", " ", 
     RowBox[{"\"\<VertexSize\>\"", "\[Rule]", " ", "Tiny"}], ",", " ", 
     RowBox[{"\"\<LabelStyle\>\"", "\[Rule]", " ", "Automatic"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GraphNetwork", "[", 
   RowBox[{"gNetObj_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"AdjacencyGraph", "[", 
   RowBox[{
    RowBox[{"gNetObj", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
     ",", 
    RowBox[{"DirectedEdges", "\[Rule]", " ", "False"}], ",", 
    RowBox[{"EdgeStyle", "\[Rule]", 
     RowBox[{"OptionValue", "[", "\"\<EdgeStyle\>\"", "]"}]}], ",", 
    RowBox[{"VertexSize", "\[Rule]", 
     RowBox[{"OptionValue", "[", " ", "\"\<VertexSize\>\"", "]"}]}], ",", 
    RowBox[{"VertexLabelStyle", "\[Rule]", 
     RowBox[{"OptionValue", "[", "\"\<LabelStyle\>\"", "]"}]}], ",", 
    RowBox[{"VertexLabels", "\[Rule]", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", 
         RowBox[{
         "gNetObj", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         "]"}], "]"}], "\[Rule]", " ", 
       RowBox[{
       "gNetObj", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
      "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.832182224480556*^9, 3.832182241552505*^9}, 
   3.8322028244757023`*^9, {3.832289337284178*^9, 3.832289382435834*^9}, {
   3.83228943956487*^9, 3.832289463829542*^9}, {3.832289521448873*^9, 
   3.832289655361408*^9}, {3.832289744731181*^9, 3.832289843296007*^9}, {
   3.8322898790819693`*^9, 3.832289884251197*^9}, {3.832289943432097*^9, 
   3.832289950839026*^9}, {3.832290049337791*^9, 3.832290095260582*^9}, {
   3.833300540924446*^9, 3.8333005476507072`*^9}},
 Background->RGBColor[1, 1, 0],
