Cell[BoxData[
 RowBox[{
  RowBox[{"GenePairStats2", "[", 
   RowBox[{
   "matpac_", ",", " ", "pccmatrix_", ",", "logpvalmatrix_", ",", " ", 
    "genepairs_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"notfound", ",", "posns", ",", " ", "pairs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pairs", "=", "genepairs"}], ";", "\[IndentingNewLine]", 
     RowBox[{"notfound", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", "pairs", "]"}], "]"}], ",", " ", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "notfound", "]"}], ">", "0"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<genes not found: \>\"", ",", "notfound"}], "]"}], ";", 
        " ", 
        RowBox[{"pairs", " ", "=", 
         RowBox[{"Cases", "[", 
          RowBox[{"genepairs", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"notfound", ",", "x"}], "]"}], "==", "False"}], "&&", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"notfound", ",", "y"}], "]"}], "==", "False"}]}]}]}], 
          " ", "]"}]}]}]}], " ", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"posns", "=", 
      RowBox[{"pairs", "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"matpac", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "->", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pairs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "->", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<PCC\>\"", ",", " ", "\"\<-log10P\>\"", 
              ",", "\"\<equivpcc\>\""}], "}"}], "->", "  ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"pccmatrix", "[", 
                 RowBox[{"[", 
                  RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], "@@", 
               RowBox[{"posns", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"logpvalmatrix", "[", 
                 RowBox[{"[", 
                  RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], "@@", 
               RowBox[{"posns", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"Sign", "[", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"pccmatrix", "[", 
                   RowBox[{"[", 
                    RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], "@@", 
                 RowBox[{"posns", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "*", 
               RowBox[{"Tanh", "[", 
                FractionBox[
                 RowBox[{
                  SqrtBox["2"], " ", 
                  RowBox[{"InverseErfc", "[", " ", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"logpvalmatrix", "[", 
                    RowBox[{"[", 
                    RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], "@@", 
                    RowBox[{"posns", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], "]"}]}], 
                 SqrtBox[
                  RowBox[{
                   RowBox[{"-", "3."}], "+", 
                   RowBox[{"Width", "[", 
                    RowBox[{"matpac", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}]]], "]"}]}]}], 
             "}"}]}], "]"}]}], ",", "  ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "pairs", "]"}]}], "}"}]}], "]"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{"genepairs", ",", " ", "pairs"}], "]"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}], "->", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<PCC\>\"", "->", "0"}], ",", " ", 
            RowBox[{"\"\<-log10P\>\"", "->", "0"}], ",", " ", 
            RowBox[{"\"\<equivpcc\>\"", "->", " ", "0"}]}], "|>"}]}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"Complement", "[", 
             RowBox[{"genepairs", ",", " ", "pairs"}], "]"}], "]"}]}], 
          "}"}]}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.87794795788958*^9, 3.877948132969117*^9}, {
   3.8779505100514793`*^9, 3.8779505206921663`*^9}, 3.877950600125482*^9, {
   3.877950659011959*^9, 3.87795067893186*^9}, {3.877950734187367*^9, 
   3.87795090994484*^9}, {3.877950957984551*^9, 3.8779510321199913`*^9}, {
   3.877951224831788*^9, 3.877951235130002*^9}, {3.877951313436995*^9, 
   3.8779513556881523`*^9}, {3.877951413887897*^9, 3.877951434521511*^9}, {
   3.877951480969592*^9, 3.877951510453351*^9}, {3.877951544706905*^9, 
   3.877951593790913*^9}, {3.877979702176805*^9, 3.877979742796853*^9}, {
   3.8779798443111143`*^9, 3.877979889919352*^9}, 3.877980336025873*^9, {
   3.877980498515641*^9, 3.87798061612188*^9}, {3.877980649985553*^9, 
   3.8779806682015057`*^9}, {3.877980850413623*^9, 3.8779808531310787`*^9}, 
   3.877980886049426*^9, {3.878474706847397*^9, 3.8784748103892317`*^9}, {
   3.878476121450794*^9, 3.878476144007568*^9}, {3.8784761992496843`*^9, 
   3.878476289627945*^9}},
