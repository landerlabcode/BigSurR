Cell[BoxData[
 RowBox[{
  RowBox[{"ClusterAnalysis", "[", 
   RowBox[{"gNetObj_", ",", " ", 
    RowBox[{"opt", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"order", ",", "tick1", ",", " ", "htick", ",", " ", "vtick"}], 
     " ", "}"}], ",", 
    RowBox[{
     RowBox[{"order", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"ClusterFlatten", "[", 
        RowBox[{"Agglomerate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Normal", "[", 
            RowBox[{
            "gNetObj", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
             "]"}], "\[Rule]", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"Width", "[", 
             RowBox[{
             "gNetObj", "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}], "]"}], "]"}]}], ",", 
          RowBox[{"Evaluate", "@", 
           RowBox[{"FilterRules", "[", 
            RowBox[{
             RowBox[{"{", "opt", "}"}], ",", 
             RowBox[{"Options", "[", "Agglomerate", "]"}]}], "]"}]}]}], "]"}],
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tick1", " ", "=", " ", 
      RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
       RowBox[{"2", ",", "order"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"htick", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"tick1", "[", 
             RowBox[{"[", "#", "]"}], "]"}], ",", " ", "Black"}], "]"}]}], 
         "}"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "tick1", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
