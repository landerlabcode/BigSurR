Cell[CellGroupData[{

Cell["HCG (Highly Central Genes)", "Subsubsection",
 CellChangeTimes->{{3.87909795168824*^9, 
  3.879097981821876*^9}},ExpressionUUID->"077fdac4-be24-4cef-a4f4-\
a7c9fc9c0064"],

Cell[TextData[{
 "An algorithm to choose \[OpenCurlyDoubleQuote]highly central genes\
\[CloseCurlyDoubleQuote].  These are genes which, by correlations, have a \
high degree centrality.  First we identify communities.  Then we sort the \
genes in each community by their degree centrality in that community.  \n\nWe \
apply two cutoffs here.  ",
 StyleBox["minlength",
  FontSlant->"Italic"],
 " excludes communities that are not of at least a certain length.  \n\n\
Target sets a goal for the maximum number of highly central genes we want to \
find.  If our communities include more genes than that numbers, it \
repetitively selects the most central genes from each community until the \
community is fully used up, or until the target is just exceeded.  In this \
way, if there are a few really huge communities, we only take a certain \
number of HCGs from those, making sure that smaller communities aren\
\[CloseCurlyQuote]t given short shrift.  For example, suppose you have \
community sizes of 8000, 5000, 1000, 200, 100, and you wanted 2500 genes.  \
The algorithm would first set a target of ",
 Cell[BoxData[
  FormBox[
   FractionBox["2500", "5"], TraditionalForm]],ExpressionUUID->
  "3283f973-e66b-4a49-ba8f-50b5548c8ab2"],
 "=500 per community, however that would produce only 1800 genes \
(500+500+500+200+100).  So it would keep raising the target until at least \
2500 genes were obtained.  This would occur at a target of 734, at which we\
\[CloseCurlyQuote]d select 2,502 genes, (734+734+734+200+100).\n"
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQAWIQrRjFp/j1yRvHtZUC2iBaRTXVGkS32FnbgWiBJU4+
IDpj8ZsAEO2XtGrRsqdvHCOdcleC6BnCG9eB6L8bX24A0RKLzLaB6Dl3qz6B
aMEPv76D6FO8AvzLgbTdizRhEC21IFMCRJucr5UF0W5+Ejog2llA3wBEi54I
NwPRe/+rWoHoYqt3DiA6X6fDDUQ/2HXTHURbHVrXCqJFfr1sA9EXVqV3g+j2
3+k9IDroQuhEEH2jZtJiEO2h9f0kiN5m/vI0iD6VE/8VRK9mLfwGoo9sWC2/
Ekj3PJdSB9EzfNTNQfSZzBsVIPrL3feNINqLR7odRAMA9Aa8rg==
  "],ExpressionUUID->"21953c1c-9a4c-4b3a-b778-35560e3e76e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HCG", "[", 
   RowBox[{
   "gno_", ",", " ", "coms_", ",", "minlength_", ",", " ", "target_"}], "]"}],
   ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "sortedlist", ",", " ", "selections"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"selections", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sortedlist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"First", "/@", 
          RowBox[{"ReverseSortBy", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"#", "->", 
              RowBox[{"DegreeCentrality", "[", 
               RowBox[{"AdjacencyGraph", "[", 
                RowBox[{"gno", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"gno", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], 
                    "/@", "#"}], "]"}], ",", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"gno", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], 
                    "/@", "#"}], "]"}]}], "]"}], "]"}], "]"}], "]"}]}], "]"}],
             ",", "Last"}], "]"}]}], ")"}], "&"}], "/@", 
       RowBox[{"Select", "[", 
        RowBox[{"coms", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], ">=", "minlength"}], "&"}]}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Flatten", "[", "sortedlist", "]"}], "]"}], "<=", " ", 
        "target"}], ",", 
       RowBox[{"selections", "=", 
        RowBox[{"Flatten", "[", "sortedlist", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"Ceiling", "[", 
           FractionBox["target", 
            RowBox[{"Length", "[", "sortedlist", "]"}]], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Length", "[", "selections", "]"}], "<", "target"}], ",", 
         RowBox[{"t", "++"}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{"selections", "=", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Take", "[", 
              RowBox[{"#", ",", 
               RowBox[{"UpTo", "[", "t", "]"}]}], "]"}], "&"}], "/@", 
            "sortedlist"}], "]"}]}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "selections", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.878501989656289*^9, 3.878502140394291*^9}, {
   3.878502171026663*^9, 3.878502297405438*^9}, {3.87850244095944*^9, 
   3.878502605522993*^9}, {3.87850264672596*^9, 3.878502647199285*^9}, {
   3.8785026814861307`*^9, 3.878502716722958*^9}, {3.878502775703992*^9, 
   3.878502780610148*^9}, {3.8785030500827503`*^9, 3.878503172355714*^9}, {
   3.878503281443206*^9, 3.8785032829208593`*^9}, {3.878503318993685*^9, 
   3.878503487327908*^9}, {3.878503546667737*^9, 3.878503548188249*^9}, {
   3.8785036054472923`*^9, 3.878503645682654*^9}, {3.878503678985735*^9, 
   3.878503683501198*^9}, {3.87850377060926*^9, 3.878503779891152*^9}, {
   3.878503868613881*^9, 3.878503888419333*^9}, 3.878504085296674*^9, {
   3.8785044755003233`*^9, 3.878504543453649*^9}, {3.878504607924654*^9, 
   3.8785046411022997`*^9}},
 Background->RGBColor[1, 1, 0],
