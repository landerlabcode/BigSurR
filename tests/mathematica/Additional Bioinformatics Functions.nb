Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "FirstDegreeConnections", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Positive Connections\>\"", "->", " ", "True"}], ",", 
      RowBox[{"\"\<Negative Connections\>\"", "->", " ", "False"}]}], " ", 
     "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FirstDegreeConnections", "[", 
     RowBox[{"gNO_", ",", " ", "gene_", ",", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "positions", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"positions", "=", "\[IndentingNewLine]", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Positive Connections\>\"", "]"}], 
           "&&", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<Negative Connections\>\"", "]"}],
             "==", "False"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"Last", "/@", 
           RowBox[{"Keys", "[", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"ArrayRules", "[", 
               RowBox[{"Sign", "[", 
                RowBox[{"gNO", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"gNO", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}],
                     "]"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], "==", "1"}], "&"}]}], "]"}], 
            "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<Positive Connections\>\"", "]"}],
             "==", "False"}], "&&", 
           RowBox[{
           "OptionValue", "[", "\"\<Negative Connections\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Last", "/@", 
           RowBox[{"Keys", "[", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"ArrayRules", "[", 
               RowBox[{"Sign", "[", 
                RowBox[{"gNO", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"gNO", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}],
                     "]"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], "==", 
                RowBox[{"-", "1"}]}], "&"}]}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "True", ",", 
          RowBox[{"Last", "/@", 
           RowBox[{"Keys", "[", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"ArrayRules", "[", 
               RowBox[{"Sign", "[", 
                RowBox[{"gNO", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"gNO", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}],
                     "]"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"Last", "[", "#", "]"}], "]"}], "==", "1"}], "&"}]}],
              "]"}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"gNO", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "positions"}], "]"}], "]"}]}]}], "]"}]}]}], 
  "*)"}]], "Input",
