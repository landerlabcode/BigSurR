Cell[CellGroupData[{

Cell["GeneNetworkGini", "Subsubsection",
 CellChangeTimes->{{3.879336923002297*^9, 
  3.879336947783752*^9}},ExpressionUUID->"3f731ec8-5a9a-44be-beda-\
e9b5f49740b1"],

Cell["\<\
Suppose one detects a network of genes via correlation analysis.  It is \
possible that the genes are correlated because there is one subpopulation \
that expresses all of them and another doesn\[CloseCurlyQuote]t.  Or it\
\[CloseCurlyQuote]s possible that the correlations are all local and, as a \
whole, expression of the network is distributed to all cells.  We can use the \
Gini coefficient to assess these scenarios.  

First we need to find a way to get an aggregate Gini for a group of genes.  \
We will take a slightly different approach.  We will take the residuals mat \
and first extract the rows containing the gene.  Then we will shift them so \
that the smallest residual is zero.  Then we will scale each to its standard \
deviation.  Then we will take the mean of all of them.  Then we will take the \
Gini of that vector\
\>", "Text",
 CellChangeTimes->{{3.8793369352210503`*^9, 3.87933710056182*^9}, {
  3.879345086321992*^9, 3.879345117379941*^9}, {3.879345605056265*^9, 
  3.8793456492558813`*^9}},ExpressionUUID->"d576060b-f3b2-4720-add0-\
4cc67a9fb800"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GeneNetworkGini", "[", 
    RowBox[{"matpac_", ",", " ", "residualsmat_", ",", " ", "genes_"}], "]"}],
    ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"shiftedrows", ",", " ", "mergedrows"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"shiftedrows", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "-", 
           RowBox[{"Min", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
        RowBox[{"residualsmat", "[", 
         RowBox[{"[", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{"matpac", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", "#"}], "]"}], "&"}],
             "/@", "genes"}], "]"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Gini", "[", 
       RowBox[{"Mean", "[", " ", 
        RowBox[{
         RowBox[{
          FractionBox["#", 
           RowBox[{"StandardDeviation", "[", "#", "]"}]], "&"}], "/@", 
         "shiftedrows"}], "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8793371844080763`*^9, 3.879337187773613*^9}, {
  3.879337257382883*^9, 3.8793373169476423`*^9}, {3.879345121325995*^9, 
  3.879345330696835*^9}, {3.879345369948888*^9, 3.879345448887405*^9}, {
  3.87934555784573*^9, 3.8793455865365267`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[198]:=",ExpressionUUID->"6b37ce0b-1352-46e4-a278-34283349a6b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FindGiniOutliers", "Subsubsection",
 CellChangeTimes->{{3.879346681017562*^9, 
  3.879346689811968*^9}},ExpressionUUID->"51542e73-fc25-45aa-bbf4-\
7dfd9e3efa32"],

Cell["\<\
This finds the cells that are responsible for producing a high GeneNetworkGini\
\>", "Text",
 CellChangeTimes->{{3.879346693858873*^9, 
  3.879346722143471*^9}},ExpressionUUID->"73d4c866-95e6-4809-b09e-\
ac432ea9b691"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindGiniOutliers", "[", 
   RowBox[{"matpac_", ",", " ", "residualsmat_", ",", " ", "genes_"}], "]"}], 
  ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"shiftedrows", ",", " ", "mergedrows", ",", "vectorAssn"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"shiftedrows", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "-", 
          RowBox[{"Min", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
       RowBox[{"residualsmat", "[", 
        RowBox[{"[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"matpac", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "#"}], "]"}], "&"}], 
           "/@", "genes"}], "]"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vectorAssn", "=", 
      RowBox[{"ReverseSortBy", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"matpac", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "->", " ", 
          RowBox[{"Mean", "[", " ", 
           RowBox[{
            RowBox[{
             FractionBox["#", 
              RowBox[{"StandardDeviation", "[", "#", "]"}]], "&"}], "/@", 
            "shiftedrows"}], "]"}]}], "]"}], ",", " ", "Last"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<All\>\"", "->", " ", 
          RowBox[{"Gini", "[", 
           RowBox[{"Values", "[", "vectorAssn", "]"}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Last", "[", 
         RowBox[{"Reap", "[", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", " ", 
            RowBox[{"i", "<", 
             RowBox[{"Length", "[", "vectorAssn", "]"}]}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"Drop", "[", 
                  RowBox[{
                   RowBox[{"Values", "[", "vectorAssn", "]"}], ",", "i"}], 
                  "]"}], "]"}], "==", "0"}], ",", " ", 
               RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Gini", "[", 
                 RowBox[{"Drop", "[", 
                  RowBox[{
                   RowBox[{"Values", "[", "vectorAssn", "]"}], ",", "i"}], 
                  "]"}], "]"}], ">=", " ", "0.1"}], ",", 
               RowBox[{"Sow", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Keys", "[", "vectorAssn", "]"}], "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "->", " ", 
                 RowBox[{"Gini", "[", 
                  RowBox[{"Drop", "[", 
                   RowBox[{
                    RowBox[{"Values", "[", "vectorAssn", "]"}], ",", "i"}], 
                   "]"}], "]"}]}], "]"}], ",", " ", 
               RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "]"}], "]"}], 
         "]"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.8793467940383787`*^9, 3.8793468316770163`*^9}, {
   3.879346863530652*^9, 3.879346866930429*^9}, {3.879346902664015*^9, 
   3.8793469543081293`*^9}, {3.879346992203162*^9, 3.87934708152195*^9}, {
   3.8793471252233963`*^9, 3.8793471678220167`*^9}, {3.879347222653327*^9, 
