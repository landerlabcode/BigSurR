7470df6be258"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PseudocountsFromResiduals", "[", 
   RowBox[{"residualsmatrix_", ",", " ", "matpac_"}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"means", ",", " ", "ta", ",", "  ", "ba"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"means", "=", 
      RowBox[{"Mean", "/@", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"ta", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"residualsmatrix", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "*", 
          SqrtBox[
           RowBox[{"means", "[", 
            RowBox[{"[", "i", "]"}], "]"}]]}], " ", "+", " ", 
         RowBox[{"means", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "means", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ba", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"BoolEval", "[", 
        RowBox[{"ta", "<=", " ", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ba", "[", "\"\<ExplicitLength\>\"", "]"}], "==", "0"}], ",", 
       " ", "ta", ",", 
       RowBox[{
        RowBox[{"ta", 
         RowBox[{"(", 
          RowBox[{"1", "-", "ba"}], ")"}]}], "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["10", 
            RowBox[{"-", "5"}]]}], ")"}], "ba"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
