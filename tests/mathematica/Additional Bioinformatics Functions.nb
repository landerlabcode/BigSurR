Cell[CellGroupData[{

Cell["CommunityAnalysis", "Subsubsection",
 CellChangeTimes->{{3.876516160168693*^9, 
  3.876516172370799*^9}},ExpressionUUID->"372c10a8-72a0-40be-8376-\
d1de5c915817"],

Cell["\<\
This takes a gNO as input, and returns a list of communities linked by \
positive correlations, as well as a matrix plot showing the average \
intercommunity correlations.  The communities are listed in the same order as \
the file of communities returned at the end.

In the first version, which takes only a gNO as input, the code calculates \
the communities directly from the gNO.  In the second version, one inputs \
both the gNO and a prespecified set of communities.  The second input needs \
to be a list of lists.  \
\>", "Text",
 CellChangeTimes->{{3.8765162172184477`*^9, 
  3.876516361920059*^9}},ExpressionUUID->"baf3214c-18a9-48b9-adab-\
5a4837c85ef6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CommunityAnalysis", "[", "gNO_", "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "initialcoms", ",", " ", "subgNOset", ",", " ", "subcoms", ",", " ", 
        "finalcoms", ",", "lengths", ",", "accumlengths", ",", "spans", ",", 
        " ", "newgNO", ",", "comcorrelmat"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"initialcoms", " ", "=", " ", 
        RowBox[{"ReverseSortBy", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"FindCommunities", "[", "gNO", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}], ",",
           "Length"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"subgNOset", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"GeneSubsetGNO", "[", 
           RowBox[{
            RowBox[{"TruncateGNO", "[", 
             RowBox[{"gNO", ",", "0", ",", " ", 
              RowBox[{"\"\<Positive Only\>\"", "->", " ", "True"}]}], "]"}], ",",
             " ", "#"}], "]"}], "&"}], "/@", "initialcoms"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"subcoms", " ", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}], 
          "&"}], "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"FindCommunities", "[", "#", "]"}], "&"}], "/@", 
           "subgNOset"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"finalcoms", " ", "=", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"subcoms", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lengths", "=", 
        RowBox[{"Length", "/@", "finalcoms"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"accumlengths", "=", 
        RowBox[{"Accumulate", "[", "lengths", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"spans", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Span", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"{", "1", "}"}], ",", 
                RowBox[{"accumlengths", "+", "1"}]}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", "accumlengths"}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"newgNO", " ", "=", " ", 
        RowBox[{"GeneSubsetGNO", "[", 
         RowBox[{"gNO", ",", " ", 
          RowBox[{"Flatten", "[", "finalcoms", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"comcorrelmat", " ", "=", " ", 
        RowBox[{"LowerTriangularize", "[", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mean", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Normal", "[", 
               RowBox[{"Part", "[", 
                RowBox[{
                 RowBox[{"newgNO", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], ",", "#1", ",", "#2"}], 
                "]"}], "]"}], "]"}], "]"}], "&"}], ",", " ", "spans", ",", 
           " ", "spans"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixPlot", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Normal", "[", 
                  RowBox[{"RestoreSymmetry", "[", "comcorrelmat", "]"}], 
                  "]"}], "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                RowBox[{"lengths", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"Length", "[", "comcorrelmat", "]"}]}], "}"}]}], 
             "]"}], ",", "1"}], "]"}], ",", " ", 
          RowBox[{"AspectRatio", "->", " ", "1"}]}], "]"}], "]"}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "finalcoms", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CommunityAnalysis", "[", 
    RowBox[{"gNO_", ",", " ", "communities_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialcoms", ",", " ", "subgNOset", ",", " ", "subcoms", ",", " ", 
       "finalcoms", ",", "lengths", ",", "accumlengths", ",", "spans", ",", 
       " ", "newgNO", ",", "comcorrelmat"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lengths", "=", 
       RowBox[{"Length", "/@", "communities"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"accumlengths", "=", 
       RowBox[{"Accumulate", "[", "lengths", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"spans", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{"Span", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Drop", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", "1", "}"}], ",", 
               RowBox[{"accumlengths", "+", "1"}]}], "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}], ",", "accumlengths"}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"newgNO", " ", "=", " ", 
       RowBox[{"GeneSubsetGNO", "[", 
        RowBox[{"gNO", ",", " ", 
         RowBox[{"Flatten", "[", "finalcoms", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"comcorrelmat", " ", "=", " ", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{"Part", "[", 
               RowBox[{
                RowBox[{"newgNO", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], ",", "#1", ",", "#2"}], 
               "]"}], "]"}], "]"}], "]"}], "&"}], ",", " ", "spans", ",", " ",
           "spans"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"MatrixPlot", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Normal", "[", 
                 RowBox[{"RestoreSymmetry", "[", "comcorrelmat", "]"}], "]"}],
                 "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"lengths", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", 
               RowBox[{"Length", "[", "comcorrelmat", "]"}]}], "}"}]}], "]"}],
            ",", "1"}], "]"}], ",", " ", 
         RowBox[{"AspectRatio", "->", " ", "1"}]}], "]"}], "]"}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "finalcoms", "]"}]}]}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.87643705262833*^9, 3.8764371344942017`*^9}, {
   3.87643721096777*^9, 3.8764372765199823`*^9}, {3.876437341028129*^9, 
   3.87643737508934*^9}, {3.87643744609231*^9, 3.876437524656979*^9}, {
   3.876437567069688*^9, 3.876437584359488*^9}, {3.8764376288185883`*^9, 
   3.876437672055017*^9}, {3.876437703795219*^9, 3.8764377049694767`*^9}, {
   3.876437771634557*^9, 3.876437779255294*^9}, {3.8764378256778393`*^9, 
   3.8764378737422667`*^9}, {3.8764379079589157`*^9, 
   3.8764379560844088`*^9}, {3.8764381657307663`*^9, 3.876438169956427*^9}, {
   3.876438205817988*^9, 3.87643825932255*^9}, {3.8764384687488537`*^9, 
   3.876438469307952*^9}, {3.8764389088991413`*^9, 3.876438909383834*^9}, {
   3.8764390518390427`*^9, 3.876439052223113*^9}, {3.876476464939209*^9, 
   3.876476512729842*^9}, 3.87647665056882*^9, {3.876515544956298*^9, 
   3.876515561499456*^9}, {3.87651610260535*^9, 3.8765161039648867`*^9}, {
   3.876516184382571*^9, 3.876516203545133*^9}, {3.876516500487268*^9, 
   3.876516500927809*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[156]:=",ExpressionUUID->"4dc37b95-1bcf-4db3-b714-5af32598152d"]
}, Closed]],

Cell[CellGroupData[{

Cell["RetrieveGenePairs", "Subsubsection",
 CellChangeTimes->{{3.8779487346006317`*^9, 
  3.877948742236352*^9}},ExpressionUUID->"0a754ccd-1cae-43af-95ea-\
65ffcd5a2fe3"],

Cell["\<\
This code takes a gNO and a list of genes, and returns the names of the \
pair-wise connections between those genes that were identified in the gNO, as \
a list of pairs of gene names.  It only returns genes that are given to it as \
input, i.e. it doesn\[CloseCurlyQuote]t tell you other genes linked to the \
ones you put it.   It can pull both positive and negative connections, but \
the default setting is to pull only positive ones.  
Note that the code sorts each pair alphanumerically.  \
\>", "Text",
 CellChangeTimes->{{3.877948758915432*^9, 3.8779488170422087`*^9}, {
  3.884718112612488*^9, 3.884718112952507*^9}, {3.884718242675969*^9, 
  3.8847182566022863`*^9}, {3.884733954304563*^9, 3.884733967849009*^9}, {
  3.905162315847067*^9, 3.905162336657888*^9}, {3.906463643204399*^9, 
  3.906463647253478*^9}},ExpressionUUID->"ae9ed021-c66f-475d-abb9-\
fb28468f5203"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RetrieveGenePairs", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Positive Only\>\"", "->", " ", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RetrieveGenePairs", "[", 
   RowBox[{"gNO_", ",", " ", "genes_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"subgno", " ", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}], ",", 
        RowBox[{"GeneSubsetGNO", "[", 
         RowBox[{
          RowBox[{"TruncateGNO", "[", 
           RowBox[{"gNO", ",", " ", "0", ",", " ", 
            RowBox[{"\"\<Positive Only\>\"", "->", " ", "True"}]}], "]"}], ",",
           " ", "genes"}], "]"}], ",", 
        RowBox[{"GeneSubsetGNO", "[", 
         RowBox[{"gNO", ",", " ", "genes"}], "]"}]}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Sort", "/@", 
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"subgno", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<ExplicitPositions\>\"", 
         "]"}], ")"}], "/.", 
       RowBox[{"Dispatch", "[", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", 
            RowBox[{"subgno", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "->", " ", 
          RowBox[{"subgno", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], "]"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.877948363123439*^9, 3.87794845996126*^9}, {
   3.884718117331985*^9, 3.884718231314208*^9}, 3.8847182708794737`*^9, {
   3.884733940737355*^9, 3.88473394872119*^9}, {3.884735794564743*^9, 
   3.884735799434568*^9}, {3.884735874383819*^9, 3.884735905224135*^9}, {
   3.8847359665886383`*^9, 3.884736180346134*^9}, {3.88473623238587*^9, 
   3.884736238654624*^9}, {3.88473630038372*^9, 3.8847363324167*^9}, {
   3.884736384667585*^9, 3.884736456201901*^9}, {3.884736546915268*^9, 
   3.884736549526698*^9}, {3.884736873804493*^9, 3.884736891392128*^9}, {
   3.884736936615636*^9, 3.884736989079615*^9}, {3.904155974098366*^9, 
   3.9041559786383533`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[158]:=",ExpressionUUID->"8940c610-46f8-4171-995a-fc642c11bf52"]
}, Closed]],

Cell[CellGroupData[{

Cell["GenePairStats", "Subsubsection",
 CellChangeTimes->{{3.877948749700726*^9, 
  3.8779487556149807`*^9}},ExpressionUUID->"5c8efb47-a4b7-442d-bcb4-\
70cdba778d68"],

Cell["\<\
This code works with a matpac and a set of genepairs, and returns a list of \
rules associating every gene pair with its corrected PCC value and its \
statistical significance in that matpac.  Note that the code will not use any \
gene pairs for which the matpac doesn\[CloseCurlyQuote]t contain both genes.  \
It will print those genes out. \
\>", "Text",
 CellChangeTimes->{{3.877948825123863*^9, 3.8779488717253237`*^9}, {
  3.877950539709115*^9, 3.877950562725994*^9}, {3.877951640957335*^9, 
  3.877951648320367*^9}},ExpressionUUID->"266a2eb7-0efb-48fe-abd6-\
a7cf443db9bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GenePairStats", "[", 
   RowBox[{
   "matpac_", ",", " ", "pccmatrix_", ",", "logpvalmatrix_", ",", " ", 
    "genepairs_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"notfound", ",", "posns", ",", " ", "pairs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pairs", "=", "genepairs"}], ";", "\[IndentingNewLine]", 
     RowBox[{"notfound", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", "pairs", "]"}], "]"}], ",", " ", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "notfound", "]"}], ">", "0"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<genes not found: \>\"", ",", "notfound"}], "]"}], ";", 
        " ", 
        RowBox[{"pairs", " ", "=", 
         RowBox[{"Cases", "[", 
          RowBox[{"genepairs", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"notfound", ",", "x"}], "]"}], "==", "False"}], "&&", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"notfound", ",", "y"}], "]"}], "==", "False"}]}]}]}], 
          " ", "]"}]}]}]}], " ", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"posns", "=", 
      RowBox[{"pairs", "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"matpac", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "->", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pairs", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"pccmatrix", "[", 
             RowBox[{"[", 
              RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], "@@", 
           RowBox[{"posns", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"logpvalmatrix", "[", 
