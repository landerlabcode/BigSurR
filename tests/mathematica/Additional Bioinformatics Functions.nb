Cell[CellGroupData[{

Cell["MergeMatrix", "Subsubsection",
 CellChangeTimes->{{3.832284882637677*^9, 
  3.83228488639642*^9}},ExpressionUUID->"247736f2-97dc-43eb-a9ee-\
d0c6207b024d"],

Cell["\<\
This takes a list of matrices and catenates the rows together, in order, so \
that the output has the same length but a width equal to the sum of the \
widths of the matrices.  \
\>", "Text",
 CellChangeTimes->{{3.832284895772542*^9, 
  3.832284954962407*^9}},ExpressionUUID->"f183d5b6-0503-42aa-a2ff-\
3f050b10ead3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MergeMatrix", "[", "matlist_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"SameQ", "@@", 
     RowBox[{"Length", "/@", "matlist"}]}], ",", 
    RowBox[{"Transpose", "[", 
     RowBox[{"Catenate", "[", 
      RowBox[{"Transpose", "/@", "matlist"}], "]"}], "]"}], ",", 
    RowBox[{
    "Print", "[", "\"\<matrices have different lengths\>\"", " ", "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.832177672994175*^9, 3.832177677023144*^9}, {
   3.832177724752883*^9, 3.832177745453168*^9}, {3.832177818112512*^9, 
   3.832177886604357*^9}, {3.8321780547144747`*^9, 3.832178056583387*^9}, 
   3.842264123703553*^9, {3.8422642063759212`*^9, 3.842264270195178*^9}, 
   3.842264331922648*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[15]:=",ExpressionUUID->"95cb35fa-3fcf-4939-8327-838576eab763"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Unpack", "Subsubsection",
 CellChangeTimes->{{3.832258924392037*^9, 
  3.832258929715543*^9}},ExpressionUUID->"5d197079-f8c9-413f-8e3e-\
304bdf21df82"],

Cell["\<\
This takes a matrix and detects whether there are labels, i.e. non-numeric \
first rows or columns.  It then returns a list with three elements:  The \
matrix minus any labels, the row labels, and the column labels.  If no labels \
are present, it has {} in those positions.\
\>", "Text",
 CellChangeTimes->{{3.83225894321953*^9, 3.832259039327536*^9}, {
  3.832259672314315*^9, 
  3.832259672422429*^9}},ExpressionUUID->"0eff7eba-ff75-4d45-8d4d-\
604e0f42052a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Unpack", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Metadata\>\"", "\[Rule]", " ", "\"\<No data\>\""}], ",", 
     " ", 
     RowBox[{"\"\<Sparse\>\"", "->", " ", "False"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"Unpack", "[", 
    RowBox[{"mat_", ",", " ", 
     RowBox[{"opt", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"OptionValue", "[", "\"\<Sparse\>\"", "]"}], "==", "True"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SparseArray", "[", "mat", "]"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "\[Equal]", 
         "False"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"Drop", "[", 
           RowBox[{"mat", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"mat", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], "\[Equal]", 
         "False"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", "True", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"2", ";;"}], ",", 
             RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", " ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        " ", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"mat", ",", " ", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "\[Equal]", 
         "False"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Drop", "[", 
          RowBox[{"mat", ",", "1"}], "]"}], ",", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"mat", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], "\[Equal]", 
         "False"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", "True", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;"}], ",", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", " ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        " ", "}"}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.832259124285111*^9, 3.8322591298957863`*^9}, {
  3.8322591811454983`*^9, 3.832259311627494*^9}, {3.83225934302162*^9, 
  3.832259372526216*^9}, {3.832259405093985*^9, 3.8322594909020243`*^9}, {
  3.8322596603203497`*^9, 3.832259668615191*^9}, {3.835015188659862*^9, 
  3.835015305931057*^9}, {3.835015466684314*^9, 3.83501546837884*^9}, {
  3.835015514641746*^9, 3.8350155343066263`*^9}, {3.835015597933663*^9, 
  3.835015608404379*^9}, {3.835016035516794*^9, 3.835016042614052*^9}, {
