Cell[BoxData[
 RowBox[{
  RowBox[{"BHalt", "[", 
   RowBox[{"trials_", ",", " ", "\[Alpha]_"}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"list", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Abs", "[", "trials", "]"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"list", "\[LeftDoubleBracket]", " ", 
     RowBox[{"LengthWhile", "[", 
      RowBox[{
       RowBox[{"BHCFalt", "[", 
        RowBox[{"list", ",", " ", 
         RowBox[{"Length", "[", "list", "]"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"#", "\[LessEqual]", " ", 
         FractionBox["1", "\[Alpha]"]}], "&"}]}], "]"}], 
     "\[RightDoubleBracket]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.85059214857104*^9, 3.850592287468334*^9}, {
  3.850592319371957*^9, 3.8505923350756397`*^9}, {3.850592419042603*^9, 
  3.85059245917496*^9}, {3.850592770535722*^9, 3.850592774489275*^9}},
