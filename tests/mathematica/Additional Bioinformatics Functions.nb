Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "gNetworkObject", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Type\>\"", " ", "\[Rule]", "  ", "\"\<PCC\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gNetworkObject", "[", 
   RowBox[{
   "matpac_", ",", "correlmatpac_", ",", "cutoff_", ",", " ", "minlink_", ",",
     " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", 
        RowBox[{
        "matpac", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "]"}]}], ",", "\[Tau]", ",", "sa", ",", " ", "hits", ",", "  ", 
      "corr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
        "\[Equal]", "\"\<PCC\>\""}], ",", 
       RowBox[{"\[Tau]", "=", "cutoff"}], ",", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
        "\[Equal]", "\"\<FDR\>\""}], ",", "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cList", "=", 
           RowBox[{"ReverseSort", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Last", "/@", 
              RowBox[{"Drop", "[", 
               RowBox[{
                RowBox[{"ArrayRules", "[", 
                 RowBox[{"correlmatpac", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
          "Print", "[", "\"\<ready to apply B-H correction\>\"", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"i", "=", "1"}], ",", " ", 
              RowBox[{
               RowBox[{"i", "\[LessEqual]", " ", 
                RowBox[{"Length", "[", "cList", "]"}]}], "&&", 
               RowBox[{
                FractionBox[
                 RowBox[{"CorrelToPvalFisher", "[", 
                  RowBox[{
                   RowBox[{
                   "cList", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], ",", " ", "n"}], "]"}], "i"], "\[LessEqual]", 
                FractionBox["cutoff", 
                 RowBox[{
                  FractionBox["1", "2"], 
                  RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox[
                    RowBox[{"Length", "[", 
                    RowBox[{"correlmatpac", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "2"], "-", 
                    RowBox[{"Length", "[", 
                    RowBox[{"correlmatpac", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}]}]]}]}], ",",
               " ", 
              RowBox[{"i", "++"}]}], " ", "]"}], ";", "      ", 
            "\[IndentingNewLine]", 
            RowBox[{"\[Tau]", "=", 
             RowBox[{"cList", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ";", " ", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<PCC cutoff = \>\"", ",", "\[Tau]"}], "]"}]}], 
           ")"}]}]}], "]"}], ",", "True", ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Type option not recognized\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"BoolEval", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "correlmatpac", "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], "<", 
          RowBox[{"-", "\[Tau]"}]}], "||", 
         RowBox[{
          RowBox[{
          "correlmatpac", "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], ">", "\[Tau]"}]}], " ", "]"}], "]"}]}], 
     ";", 
     RowBox[{"hits", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"First", "/@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Tally", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"First", "/@", 
             RowBox[{"Drop", "[", 
              RowBox[{
               RowBox[{"ArrayRules", "[", "sa", "]"}], ",", 
               RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], ">", 
            RowBox[{"minlink", "-", "1"}]}], "&"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"ArrayRules", "[", "sa", "]"}], "]"}], "<", "2"}], ",", 
       RowBox[{"Print", "[", "\"\<no hits found\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sa", "\[LeftDoubleBracket]", 
          RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"correlmatpac", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"correlmatpac", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "hits", ",", " ", "hits"}], 
           "\[RightDoubleBracket]"}], "*", 
          RowBox[{"sa", "\[LeftDoubleBracket]", 
           RowBox[{"hits", ",", "hits"}], "\[RightDoubleBracket]"}]}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             
             RowBox[{"\"\<From Expression Matrix\>\"", "\[Rule]", 
              " ", "\"\<Metadata\>\""}], "/.", 
             RowBox[{"Last", "[", "matpac", "]"}]}], " ", ",", 
            RowBox[{
             
             RowBox[{"\"\<From Correlation Matrix\>\"", "\[Rule]", 
              " ", "\"\<Metadata\>\""}], "/.", 
             RowBox[{"Last", "[", "correlmatpac", "]"}]}], ",", 
            RowBox[{"\"\<Tested_By\>\"", "\[Rule]", "  ", 
             RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}]}], ",", 
            RowBox[{"\"\<FDR_cutoff\>\"", "\[Rule]", 
             RowBox[{"If", "[", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<Type\>\"", "]"}], 
                "\[Equal]", "\"\<FDR\>\""}], ",", " ", "cutoff", ",", 
               "None"}], "]"}]}], ",", "  ", 
            RowBox[{"\"\<CC_cutoff\>\"", "\[Rule]", " ", "\[Tau]"}], ",", " ", 
            RowBox[{"\"\<Minimum_Linkages\>\"", "\[Rule]", " ", "minlink"}]}],
            "}"}]}]}], "}"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.835020440315044*^9, 3.835020481440531*^9}, {
   3.8350205344875183`*^9, 3.835020606639247*^9}, {3.835020640465863*^9, 
   3.8350206824177856`*^9}, {3.835020729285322*^9, 3.8350207693502703`*^9}, {
   3.8350208212991457`*^9, 3.83502082314904*^9}, {3.835020890045207*^9, 
   3.835020968503737*^9}, 3.8350212044761267`*^9, {3.835021236097548*^9, 
   3.835021320551114*^9}, {3.835023785170209*^9, 3.835023856747655*^9}, {
   3.835024207651227*^9, 3.835024218756332*^9}, {3.835024740929413*^9, 
   3.835024784100806*^9}, {3.835024871622919*^9, 3.8350249265557127`*^9}, {
   3.835025067065774*^9, 3.8350250699226522`*^9}, 3.8399470199729433`*^9, 
   3.839984080567212*^9, {3.839985847224577*^9, 3.839985902066959*^9}, {
   3.8399860701561527`*^9, 3.839986073426066*^9}, {3.8399862054364347`*^9, 
   3.839986234061104*^9}, 3.839986748872307*^9, {3.840022103231987*^9, 
   3.840022122427747*^9}, {3.840457849032322*^9, 3.8404578508449173`*^9}, {
