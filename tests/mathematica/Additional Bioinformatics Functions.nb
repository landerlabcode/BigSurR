Cell[CellGroupData[{

Cell["InsertZeroRow", "Subsubsection",
 CellChangeTimes->{{3.883911304960279*^9, 
  3.883911308861064*^9}},ExpressionUUID->"8726c424-6556-47ad-9e48-\
7138a74ff8a2"],

Cell["\<\
This inserts a row of zeros BEFORE any given position in a matrix, so that \
the row of zeros occurs at the value entered for \
\[OpenCurlyDoubleQuote]position\[CloseCurlyDoubleQuote] and the positions of \
everything beyond it are shifted down by 1.  
 The default is to output the result as a sparse matrix.  This can be changed \
using the Option \[OpenCurlyDoubleQuote]Sparse\[CloseCurlyDoubleQuote]-> False\
\>", "Text",
 CellChangeTimes->{{3.883911322286806*^9, 3.883911341328732*^9}, {
   3.883911937364909*^9, 3.883911956578063*^9}, {3.8839129148079643`*^9, 
   3.883912938623178*^9}, 3.883912971414151*^9, {3.88391303192794*^9, 
   3.883913041522613*^9}},ExpressionUUID->"86a8b704-7bdf-4612-ada7-\
e0e6d68e383e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "InsertZeroRow", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Sparse\>\"", "->", " ", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InsertZeroRow", "[", 
   RowBox[{"matrix_", ",", " ", "position_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"OptionValue", "[", "\"\<Sparse\>\"", "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"matrix", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"position", "-", "1"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"Width", "[", "matrix", "]"}]}], "]"}], "}"}], ",", " ", 
        RowBox[{"matrix", "[", 
         RowBox[{"[", 
          RowBox[{"position", ";;"}], "]"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "matrix", "]"}], "+", "1"}], ",", " ", 
        RowBox[{"Width", "[", "matrix", "]"}]}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"matrix", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", 
         RowBox[{"position", "-", "1"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Width", "[", "matrix", "]"}]}], "]"}], "}"}], ",", " ", 
      RowBox[{"matrix", "[", 
       RowBox[{"[", 
        RowBox[{"position", ";;"}], "]"}], "]"}]}], "]"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.883911346563581*^9, 3.883911431022833*^9}, {
  3.883911610393641*^9, 3.883911708821247*^9}, {3.883911801421842*^9, 
  3.883911806161544*^9}, {3.883912941973563*^9, 3.8839129441006203`*^9}, {
  3.883913016648122*^9, 3.883913019526964*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[6]:=",ExpressionUUID->"f5b4385b-ccea-4fca-8f93-475e810e4d8c"]
}, Open  ]],

