Cell[CellGroupData[{

Cell["Enrichment PVal", "Subsubsection",
 CellChangeTimes->{{3.883653140060864*^9, 
  3.883653144006153*^9}},ExpressionUUID->"9ec14a80-bb2b-4c93-9a54-\
0c05c1a9f4b7"],

Cell[TextData[{
 "Consider a group of genes, g, of which you are interested in subgroup s, \
and you want to know whether the representation of geneset k is enriched in \
subgroup s.\n\nUnder the null hypothesis, that geneset is randomly assigned \
across the entire group, the expectation value for the number of genes from k \
that occur in s is simply ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Length", "[", "k", "]"}], "*", 
    FractionBox[
     RowBox[{"Length", "[", "s", "]"}], 
     RowBox[{"Length", "[", "g", "]"}]]}], TraditionalForm]],ExpressionUUID->
  "e4e35c06-bf19-4a1d-828c-74daf93f0946"],
 ".  \nThe distribution of that number will be Poisson, i.e. determined by \
PoissonDistribution[k s/g].  Thus the CDF is \n\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {"\[Piecewise]", GridBox[{
        {
         RowBox[{"GammaRegularized", "[", 
          RowBox[{
           RowBox[{"1", "+", 
            RowBox[{"Floor", "[", "x", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Length", "[", "k", "]"}], "*", 
            FractionBox[
             RowBox[{"Length", "[", "s", "]"}], 
             RowBox[{"Length", "[", "g", "]"}]]}]}], "]"}], 
         RowBox[{"x", "\[GreaterEqual]", "0"}]},
        {"0", 
         TagBox["True",
          "PiecewiseDefault",
          AutoDelete->True]}
       },
       AllowedDimensions->{2, Automatic},
       Editable->True,
       GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.84]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}},
       Selectable->True]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.35]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   "Piecewise",
   DeleteWithContents->True,
   Editable->False,
   SelectWithContents->True,
   Selectable->False,
   StripWrapperBoxes->True]],
  CellChangeTimes->{3.8722059236554623`*^9, 3.8722059851568537`*^9},
  ExpressionUUID->"53880632-b7f5-434b-9d5c-42773add1013"],
 ".       Thus  noting that x is always an integer, so its Floor is itself, \
the pvalue associated with observing x or more genes from k in subset s is \
just ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"1", "-", 
    RowBox[{"GammaRegularized", "[", 
     RowBox[{
      RowBox[{"1", "+", "x"}], ",", 
      FormBox[
       RowBox[{
        RowBox[{"Length", "[", "k", "]"}], "*", 
        FractionBox[
         RowBox[{"Length", "[", "s", "]"}], 
         RowBox[{"Length", "[", "g", "]"}]]}],
       TraditionalForm]}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"for", " ", "x"}], ">=", " ", "0"}]}]],
  CellChangeTimes->{{3.872170161457183*^9, 3.872170181268613*^9}, 
    3.872170287297949*^9},ExpressionUUID->
  "dbf23bea-2ac7-4489-8537-50e525cc033c"],
 ".  For ease of use we will convert the Pvalue so obtained into  -Log10 \
form.  However, there\[CloseCurlyQuote]s something a little weird here when x \
=0, i.e. one observes no overlap, the probability of that or greater occuring \
comes out to a small number, whereas it should come out to 1.  We have to \
correct that manually"
}], "Text",
 CellChangeTimes->{{3.872169924902046*^9, 3.872170081993348*^9}, {
   3.872170313515387*^9, 3.872170330578599*^9}, {3.8721704315909033`*^9, 
   3.872170498681973*^9}, 3.872170821191986*^9, {3.872205992215006*^9, 
   3.872206047688052*^9}, {3.872206201244199*^9, 3.872206213888657*^9}, {
   3.872206395536228*^9, 3.8722064013712187`*^9}, {3.872206653720777*^9, 
   3.872206708924765*^9}},ExpressionUUID->"b6f0a655-610b-43ce-895a-\
8f10994930bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EnrichmentPval", "[", 
   RowBox[{"subgroup_", ",", " ", "group_", ",", " ", "geneset_"}], "]"}], ":=",
   " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"Intersection", "[", 
       RowBox[{"geneset", ",", " ", "subgroup"}], "]"}], "]"}], "==", "0"}], ",",
     "0", ",", " ", 
    RowBox[{"-", 
     RowBox[{"Log10", "[", 
      RowBox[{"1.", "-", 
       RowBox[{"GammaRegularized", "[", 
        RowBox[{
         RowBox[{"1", "+", 
          RowBox[{"Length", "[", 
           RowBox[{"Intersection", "[", 
            RowBox[{"geneset", ",", " ", "subgroup"}], "]"}], "]"}]}], ",", 
         FractionBox[
          RowBox[{
           RowBox[{"Length", "[", "geneset", "]"}], " ", 
           RowBox[{"Length", "[", "subgroup", "]"}]}], 
          RowBox[{"Length", "[", "group", "]"}]]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.872169886981722*^9, 3.872169920752326*^9}, {
   3.872170207328504*^9, 3.872170282724628*^9}, 3.8721706024162273`*^9, {
   3.872170679141844*^9, 3.872170682304253*^9}, {3.8722059651463213`*^9, 
   3.872205975348691*^9}, 3.8722060566484947`*^9, {3.8722067566204557`*^9, 
   3.872206818759408*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[264]:=",ExpressionUUID->"11a168c0-7452-402d-9480-95b72530b501"]
}, Closed]],

