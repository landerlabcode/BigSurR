Cell[CellGroupData[{

Cell["TableToPAlt", "Subsubsection",
 CellChangeTimes->{{3.846156880609625*^9, 3.846156883027049*^9}, {
  3.8461977839770193`*^9, 
  3.846197784402481*^9}},ExpressionUUID->"04a53826-d16e-46ec-af26-\
592e21540962"],

Cell["\<\
This code operates on a long list of random data.  It sorts the data from low \
to high, splits the list in two.  This time, instead of splitting the list in \
two by at its median, it splits it where the values flip from negative to \
positive, so it is only useful for lists that are centered, more or less, \
around zero.  
As with TableToP, the function finds a Fitted function for the Log-pvalues \
for the first half of the list (\[OpenCurlyDoubleQuote]negative\
\[CloseCurlyDoubleQuote]) and the second half of the list (\
\[OpenCurlyDoubleQuote]positive\[CloseCurlyDoubleQuote]) separately, fitting \
only the most extreme 10% of the values (i.e. those that would give p<0.05).  \
The fit is a simple polynomial fit, with degree that is adjustable using the \
parameter \[OpenCurlyDoubleQuote]degree\[CloseCurlyDoubleQuote].  The \
function parameters are returned as ordered lists of coefficients of the \
polynomial, starting with the zeroth order coefficient (i.e. the intercept).  \
\>", "Text",
 CellChangeTimes->{{3.846156891790442*^9, 3.846157069358453*^9}, {
  3.8461981398495417`*^9, 
  3.846198209450677*^9}},ExpressionUUID->"ca7014c3-5ffe-4b41-9cca-\
81e67efccf1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TableToPAlt", "[", 
   RowBox[{"table_", ",", " ", "degree_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"neg", ",", " ", "pos"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"neg", ",", " ", "pos"}], "}"}], "=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"set", "=", 
          RowBox[{"SplitBy", "[", 
           RowBox[{
            RowBox[{"Sort", "[", "table", "]"}], ",", 
            RowBox[{
             RowBox[{"#", "\[GreaterEqual]", " ", "0"}], "&"}]}], "]"}]}], 
         "}"}], ",", "\[IndentingNewLine]", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"set", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"set", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{"Length", "[", "table", "]"}], "/", "20"}], "]"}]}], 
             "]"}]}], " ", "]"}], ",", " ", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"set", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"set", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{"Length", "[", "table", "]"}], "/", "20"}], "]"}]}], 
             "]"}]}], "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FindFit", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"List", ",", 
           RowBox[{"{", 
            RowBox[{"neg", ",", 
             RowBox[{"Log", "[", 
              RowBox[{"10", ",", 
               RowBox[{"N", "[", 
                FractionBox[
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "neg", "]"}], "]"}], 
                 RowBox[{"Length", "[", "table", "]"}]], "]"}]}], "]"}]}], 
            "}"}]}], "]"}], ",", " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], "degree"], 
          RowBox[{
           RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], 
           SuperscriptBox["x", "i"]}]}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "degree"}], "}"}]}], "]"}], 
         ",", "x"}], "]"}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{"FindFit", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"List", ",", 
           RowBox[{"{", 
            RowBox[{"pos", ",", 
             RowBox[{"Log", "[", 
              RowBox[{"10", ",", 
               RowBox[{"N", "[", 
                FractionBox[
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "pos", "]"}], "]"}], 
                 RowBox[{"Length", "[", "table", "]"}]], "]"}]}], "]"}]}], 
            "}"}]}], "]"}], ",", "  ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], "degree"], 
          RowBox[{
           RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], 
           SuperscriptBox["x", "i"]}]}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "degree"}], "}"}]}], "]"}], 
         ",", "x"}], "]"}]}], "}"}]}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.846154398257236*^9, 3.8461544417243233`*^9}, {
   3.846154472656145*^9, 3.846154597858849*^9}, {3.8461547151302433`*^9, 
   3.8461548615104628`*^9}, {3.846155427014036*^9, 3.846155440897298*^9}, {
   3.8461556698615503`*^9, 3.846155670350547*^9}, {3.846156408608033*^9, 
   3.846156440616699*^9}, {3.846156617347665*^9, 3.846156658067408*^9}, {
   3.8461977873301973`*^9, 3.846197787696126*^9}, {3.84619796454592*^9, 
   3.846197980700426*^9}, {3.8461980384085207`*^9, 3.8461980467993717`*^9}, 
   3.846198129302979*^9, {3.846198543300941*^9, 3.846198550369912*^9}, {
   3.846198653243143*^9, 3.846198684367695*^9}, {3.846287969751598*^9, 
   3.846287998122284*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[231]:=",ExpressionUUID->"d1584044-de81-416c-a31c-df079569afaf"]
}, Closed]],

Cell[CellGroupData[{

Cell["TableToP2", "Subsubsection",
 CellChangeTimes->{{3.846156880609625*^9, 3.846156883027049*^9}, {
   3.8461977839770193`*^9, 3.846197784402481*^9}, 3.846330167076872*^9, {
   3.849613149318453*^9, 
   3.849613149713842*^9}},ExpressionUUID->"b836476b-85b3-468e-af5f-\
d66d4a6b4756"],

Cell["This one fixes \[ScriptCapitalC]0 to be the true x-intercept of the \
function", "Text",
 CellChangeTimes->{{3.846330169332137*^9, 
  3.846330185219572*^9}},ExpressionUUID->"d49af397-7365-4edf-ad2d-\
ccd0d86e2026"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TableToP2", "[", 
    RowBox[{"table_", ",", " ", "degree_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "set", ",", "neg", ",", "pos", ",", " ", "negintercept", ",", " ", 
       "posintercept"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"set", "=", 
       RowBox[{"SplitBy", "[", 
        RowBox[{
         RowBox[{"Sort", "[", "table", "]"}], ",", "Sign"}], "]"}]}], ";", 
      " ", "\[IndentingNewLine]", 
      RowBox[{"negintercept", " ", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Log", "[", 
         RowBox[{"10", ",", 
          FractionBox[
           RowBox[{"Length", "[", 
            RowBox[{"First", "[", "set", "]"}], "]"}], 
           RowBox[{"Length", "[", "table", "]"}]]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"posintercept", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"Log", "[", 
         RowBox[{"10", ",", 
          FractionBox[
           RowBox[{"Length", "[", 
            RowBox[{"Last", "[", "set", "]"}], "]"}], 
           RowBox[{"Length", "[", "table", "]"}]]}], "]"}], "]"}]}], ";", " ",
       "\[IndentingNewLine]", 
      RowBox[{"neg", "=", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"First", "[", "set", "]"}], ",", 
         RowBox[{"UpTo", "[", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"Length", "[", "table", "]"}], "/", "20"}], "]"}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pos", "=", " ", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Reverse", "[", 
          RowBox[{"Last", "[", "set", "]"}], "]"}], ",", " ", 
         RowBox[{"UpTo", "[", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"Length", "[", "table", "]"}], "/", "20"}], "]"}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[ScriptCapitalC]", "[", "0", "]"}], "\[Rule]", 
            "negintercept"}], "}"}], ",", 
          RowBox[{"FindFit", "[", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{"List", ",", 
              RowBox[{"{", 
               RowBox[{"neg", ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"10", ",", 
                  RowBox[{"N", "[", 
                   FractionBox[
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "neg", "]"}], "]"}], 
                    RowBox[{"Length", "[", "table", "]"}]], "]"}]}], "]"}]}], 
               "}"}]}], "]"}], ",", 
            RowBox[{"negintercept", "+", " ", 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"i", "=", "1"}], "degree"], 
              RowBox[{
               RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], 
               SuperscriptBox["x", "i"]}]}]}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", " ", "degree"}], "}"}]}], "]"}], ",",
             "x"}], "]"}]}], "]"}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[ScriptCapitalC]", "[", "0", "]"}], "\[Rule]", 
            "posintercept"}], "}"}], ",", 
          RowBox[{"FindFit", "[", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{"List", ",", 
              RowBox[{"{", 
               RowBox[{"pos", ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"10", ",", 
                  RowBox[{"N", "[", 
                   FractionBox[
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pos", "]"}], "]"}], 
                    RowBox[{"Length", "[", "table", "]"}]], "]"}]}], "]"}]}], 
               "}"}]}], "]"}], ",", 
            RowBox[{"posintercept", "+", " ", 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"i", "=", "1"}], "degree"], 
              RowBox[{
               RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], 
               SuperscriptBox["x", "i"]}]}]}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "1", ",", " ", "degree"}], "}"}]}], 
             "]"}], ",", "x"}], "]"}]}], "]"}]}], "}"}]}]}], "]"}]}], " ", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.846329838055873*^9, 3.84632986337952*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[232]:=",ExpressionUUID->"46bfbb5a-6677-45a9-84fc-1e0b27f83c83"]
}, Closed]],

Cell[CellGroupData[{

Cell["Adjustment", "Subsubsection",
 CellChangeTimes->{
  3.8354830941630287`*^9},ExpressionUUID->"13ca9551-ed0a-4a65-9be8-\
17f8bd34c6de"],

Cell["\<\
This takes a set of correlations, reduces duplicated ones to single p-values \
according to FindP, then converts to adjusted correlation coefficients by the \
Fisher Formula.  \
\>", "Text",
 CellChangeTimes->{{3.8354833927118053`*^9, 
  3.8354834503229923`*^9}},ExpressionUUID->"d74abc47-959c-4513-b2ef-\
bb3248c068e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Adjustment", "[", 
   RowBox[{
   "correlmatpac_", ",", " ", "coms_", ",", " ", "vectorlength_", ",", " ", 
    "index1_", ",", " ", "index2_"}], "]"}], ":=", " ", "\[IndentingNewLine]", 
  RowBox[{"ToAdjustedCClist", "[", 
   RowBox[{
    RowBox[{"FindP", "[", 
     RowBox[{"Sort", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{"correlmatpac", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"correlmatpac", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"coms", "[", 
               RowBox[{"[", "index1", "]"}], "]"}]}], "]"}], "]"}], ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"correlmatpac", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"coms", "[", 
               RowBox[{"[", "index2", "]"}], "]"}]}], "]"}], "]"}]}], "]"}], 
         "]"}], "]"}], "]"}], "]"}], "]"}], ",", "vectorlength"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.835440795138792*^9, 3.83544089893926*^9}, {
   3.835440931119516*^9, 3.835440963912385*^9}, 3.8354706497345457`*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[233]:=",ExpressionUUID->"d5334021-8040-4d61-ab66-de8009d7c3fa"]
}, Closed]],

Cell[CellGroupData[{

Cell["CorrectionFits", "Subsubsection",
 CellChangeTimes->{
  3.835483100333548*^9},ExpressionUUID->"32cd8b43-5203-4132-8980-\
4cb4529f9c50"],

Cell["\<\
This takes the adjusted correlation coefficients for two sets of vectors \
defined by a particular bin for FracZeros (indicated by index1 and index2), \
and models the relationship between the observed PCC and the change required \
to adjust the PCC as a straight line.  It returns the equation of the \
straight line that models the relationship for negative PCCs and for positive \
PCCs separately.  \
\>", "Text",
 CellChangeTimes->{{3.8354834739236603`*^9, 3.835483625814242*^9}, {
   3.8355606800038977`*^9, 3.835560710256495*^9}, 3.835577130052726*^9, 
   3.850559899250024*^9},ExpressionUUID->"3746e867-3635-4981-8d96-\
4018a0cc83b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CorrectionFits", "[", 
   RowBox[{
   "correlmatpac_", ",", " ", "coms_", ",", " ", "vectorlength_", ",", " ", 
    "index1_", ",", " ", "index2_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"allpoints", ",", " ", "negpoints", ",", " ", "pospoints"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"allpoints", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Last", "[", "#", "]"}], "-", 
               RowBox[{"First", "[", "#", "]"}]}]}], "}"}], "&"}], "/@", 
           RowBox[{"Adjustment", "[", 
            RowBox[{
            "correlmatpac", ",", "coms", ",", "vectorlength", ",", "#1", ",", 
             "#2"}], "]"}]}], "&"}], "@@@", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", 
               RowBox[{"ToExpression", "[", 
                RowBox[{"\"\<comsgp\>\"", "<>", 
                 RowBox[{"ToString", "[", "index1", "]"}]}], "]"}]}], "}"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Select", "[", " ", 
                RowBox[{
                 RowBox[{"ToExpression", "[", 
                  RowBox[{"\"\<comsgp\>\"", "<>", 
                   RowBox[{"ToString", "[", "index2", "]"}]}], "]"}], ",", 
                 " ", 
                 RowBox[{
                  RowBox[{"#", "<", "i"}], "&"}]}], "]"}]}], "}"}]}], "]"}], ",",
            "1"}], "]"}]}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"negpoints", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"allpoints", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"pospoints", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"allpoints", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "#", "]"}], "\[GreaterEqual]", " ", "0"}], 
         "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Fit", "[", 
        RowBox[{"negpoints", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "x"}], "}"}], ",", " ", "x"}], "]"}], ",", 
       RowBox[{"Fit", "[", 
        RowBox[{"pospoints", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "x"}], "}"}], ",", " ", "x"}], "]"}]}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.835445785307165*^9, 3.835445878919962*^9}, {
  3.835459725797596*^9, 3.835459729769457*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[234]:=",ExpressionUUID->"528c5f8c-5d10-44d6-a7fe-0655af2361bc"]
}, Closed]],

Cell[CellGroupData[{

Cell["FixMissingValues", "Subsubsection",
 CellChangeTimes->{
  3.835483104764234*^9},ExpressionUUID->"89034e8a-31a3-486f-9aa9-\
50c0861af744"],

Cell["\<\
This takes an array which is properly structured for interpolation, but which \
has some points that are missing and have a value of 0 in place of the \
expected equation for a line.  This code replaces that value with a linear \
interpolation of up to 4 nearest neighbor points.  \
\>", "Text",
 CellChangeTimes->{{3.835483636304616*^9, 
  3.8354837349346247`*^9}},ExpressionUUID->"fe0ae477-6b8c-4300-ab13-\
b0eb4f15e04c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FixMissingValues", "[", "array_", "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"posnlist", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"array", ",", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"_", ",", " ", "_", ",", " ", "_", ",", " ", "a_"}], "}"}],
           "/;", 
          RowBox[{"a", "\[Equal]", "0"}]}]}], "]"}], "]"}]}], " ", "}"}], ",", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{"array", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"posnlist", "[", 
          RowBox[{"[", "h", "]"}], "]"}], "\[Rule]", " ", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{
           RowBox[{"array", "[", 
            RowBox[{"[", 
             RowBox[{"posnlist", "[", 
              RowBox[{"[", "h", "]"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"4", "\[Rule]", " ", 
            RowBox[{"Simplify", "[", 
             RowBox[{"Mean", "[", 
              RowBox[{"Last", "/@", 
               RowBox[{"Select", "[", 
                RowBox[{"array", ",", " ", 
                 RowBox[{
                  RowBox[{"MemberQ", "[", " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Plus", "[", 
                    RowBox[{
                    RowBox[{"array", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"posnlist", "[", 
                    RowBox[{"[", "h", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
                    "#"}], "]"}], "&"}], "/@", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", "1"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
                    RowBox[{"Part", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], "]"}], "&"}]}],
                 "]"}]}], "]"}], "]"}]}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", " ", "1", ",", " ", 
          RowBox[{"Length", "[", "posnlist", "]"}]}], "}"}]}], "]"}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.835464695860331*^9, 3.835464753032566*^9}, 
   3.8354648773719683`*^9, {3.835465196740034*^9, 3.8354651988155622`*^9}, {
