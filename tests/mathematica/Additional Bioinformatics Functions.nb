Cell[CellGroupData[{

Cell["ArrayPlotMatPac", "Subsubsection",
 CellChangeTimes->{
  3.833844499781942*^9},ExpressionUUID->"39e9a32b-dbc0-41c2-bf6f-\
66eaeef23907"],

Cell["\<\
This function takes a Matpac, or a gene subset of a matpac, and plots the \
values as an array with gene labels.  The first version, with one argument, \
plots an entire matpac.  The second version includes a second argument, which \
is the list of the subsetted genes that one wants to plot\
\>", "Text",
 CellChangeTimes->{{3.833844504398561*^9, 3.833844533432076*^9}, {
  3.833844583293042*^9, 
  3.83384462902304*^9}},ExpressionUUID->"efe8eacf-3a31-4451-8e9a-\
386d8b8e04bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ArrayPlotMatPac", "[", "matpac_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
      RowBox[{"rownames", "=", " ", 
       RowBox[{"GetGeneNames", "[", "matpac", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"ArrayPlot", "[", 
     RowBox[{"mat", ",", 
      RowBox[{"FrameTicks", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{"List", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"Length", "[", "rownames", "]"}], "]"}], ",", 
               "rownames"}], "}"}]}], "]"}], ",", "None"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"None", ",", "None"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"FrameTicksStyle", "\[Rule]", "  ", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", 
         RowBox[{"FontSize", "\[Rule]", " ", "9"}], ",", " ", 
         RowBox[{"FontFamily", "\[Rule]", " ", "\"\<Arial\>\""}]}], "]"}]}], ",", 
      RowBox[{"AspectRatio", "\[Rule]", 
       RowBox[{"4", "*", 
        RowBox[{"Divide", "@@", 
         RowBox[{"Dimensions", "[", "mat", "]"}]}]}]}], ",", " ", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"Placed", "[", 
        RowBox[{"Automatic", ",", "\"\<After\>\""}], "]"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.833844555565481*^9, 3.8338445670761538`*^9}, {
  3.833844678667845*^9, 3.8338446855064507`*^9}, {3.833844858707938*^9, 
  3.8338448591823587`*^9}, {3.8338449942196007`*^9, 3.8338450205795*^9}, {
  3.833845143630103*^9, 3.833845144240219*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
