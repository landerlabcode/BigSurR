      RowBox[{"Normal", "[", 
       RowBox[{"ds", "[", 
        RowBox[{"Values", ",", " ", "Values"}], "]"}], "]"}]}], " ", "]"}], ",", 
    RowBox[{"Normal", "[", 
     RowBox[{"ds", "[", "Keys", "]"}], "]"}], ",", 
    RowBox[{"Normal", "[", 
     RowBox[{"ds", "[", 
      RowBox[{"First", ",", "Keys"}], "]"}], "]"}]}], "}"}]}]}], "Input",
