Cell[CellGroupData[{

Cell[TextData[{
 "Preprocessing (",
 StyleBox["CutDown",
  FontColor->GrayLevel[0]],
 ")"
}], "Subsection",
 CellChangeTimes->{{3.832260813340618*^9, 3.832260817374008*^9}, {
  3.832330634525548*^9, 
  3.8323306371521177`*^9}},ExpressionUUID->"1b1ce629-ea28-4d3b-b671-\
9b126477caaf"],

Cell[CellGroupData[{

Cell["CutDown", "Subsubsection",
 CellChangeTimes->{{3.8322608202056723`*^9, 
  3.832260823043462*^9}},ExpressionUUID->"0e4e7a27-b75c-4ef8-8fa4-\
5d23c91746aa"],

Cell["\<\
This step eliminates rows where an insufficient number of cells (set by \
cellNumThresh) exceeds a value threshold (valThresh).  Default Value \
Threshold is zero, and Default Cell Number is 5.  So rows are cut out that \
have 5 or fewer non-zero entries.
It takes a matpac as its argument and returns a matpac.  
The code calls BoolEval, which is a loaded package that evaluates whether \
entries in arrays meet a criterion much more quickly than Mathematica \
normally does, by immediately reducing the problem to integer algebra.  \
\>", "Text",
 CellChangeTimes->{{3.832261109527128*^9, 3.832261203481318*^9}, {
  3.83227266066787*^9, 3.832272703742804*^9}, {3.83227412336261*^9, 
  3.832274136737713*^9}, {3.832330958719245*^9, 
  3.832330959112811*^9}},ExpressionUUID->"da1b7e16-9d37-4f73-85b9-\
a3b6d274f5f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CutDown", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<ValueThresh\>\"", "\[Rule]", " ", "0"}], ",", " ", 
     RowBox[{"\"\<CellNumber\>\"", "\[Rule]", " ", "5"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"CutDown", "[", 
    RowBox[{"matpac_", ",", " ", 
     RowBox[{"opt", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"posns", " ", "=", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"Total", "/@", 
           RowBox[{"BoolEval", "[", 
            RowBox[{
             RowBox[{"matpac", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">", 
             RowBox[{"OptionValue", "[", "\"\<ValueThresh\>\"", "]"}]}], 
            "]"}]}], ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", ">", 
            RowBox[{"OptionValue", "[", "\"\<CellNumber\>\"", "]"}]}]}]}], 
         "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"matpac", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "posns"}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"GetGeneNames", "[", "matpac", "]"}], "[", 
        RowBox[{"[", "posns", "]"}], "]"}], ",", 
       RowBox[{"GetCellNames", "[", "matpac", "]"}], ",", " ", 
       RowBox[{"\"\<Metadata\>\"", "\[Rule]", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"\"\<Metadata\>\"", "/.", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<CutDown_ValueThreshold\>\"", "\[Rule]", " ", 
             RowBox[{"OptionValue", "[", "\"\<ValueThresh\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<CutDown_CellNumber\>\"", "\[Rule]", " ", 
             RowBox[{"OptionValue", "[", "\"\<CellNumber\>\"", "]"}]}]}], 
           "}"}]}], "]"}]}]}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8322608649048767`*^9, 3.832260943883334*^9}, {
  3.832260994765217*^9, 3.832261090929954*^9}, {3.832261186270282*^9, 
  3.832261201106073*^9}, {3.832261358601048*^9, 3.83226141071105*^9}, {
  3.832272372672545*^9, 3.832272388921782*^9}, {3.832272429783675*^9, 
  3.832272461846162*^9}, {3.832274140706265*^9, 3.8322741425449867`*^9}, {
  3.832285086346772*^9, 3.832285115392082*^9}, {3.832286934488607*^9, 
  3.8322869404459677`*^9}, {3.835014975928051*^9, 3.8350149881042833`*^9}, {
  3.8350150345531607`*^9, 3.835015065905445*^9}, {3.8350151016122923`*^9, 
  3.835015141835043*^9}, {3.835015668886552*^9, 3.8350156765226803`*^9}, {
  3.8350157069823027`*^9, 3.835015714793151*^9}, {3.835015927357954*^9, 
  3.835015934430584*^9}, {3.835015986351323*^9, 3.8350159867730713`*^9}, {
  3.835016181824086*^9, 3.835016185496565*^9}},
