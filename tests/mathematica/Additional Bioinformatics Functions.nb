Cell["\<\
Finally, we have a code that puts genesetmatchfrequency together with \
genesetmatches.  \
\>", "Text",
 CellChangeTimes->{{3.8836560063701363`*^9, 3.883656026494174*^9}, {
   3.8838341722691298`*^9, 3.883834196354472*^9}, 
   3.883834659983912*^9},ExpressionUUID->"345cdb48-1da5-4a9a-b901-\
94d5776cce17"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneSetMatchTable", "[", 
   RowBox[{
   "genelist_", ",", " ", "datamatrix_", ",", " ", "genepositions_", ",", " ",
     "setpositions_", ",", "setsizes_", ",", " ", "cutoff_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"\"\<Gene Set\>\"", ",", " ", "\"\<#\>\"", ",", 
       " ", "\"\<genes\>\""}], "}"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", "=", 
        RowBox[{"Keys", "[", 
         RowBox[{"GeneSetMatchFrequency", "[", 
          RowBox[{
          "genelist", ",", "datamatrix", ",", "genepositions", ",", 
           "setpositions", ",", "setsizes", ",", "cutoff"}], " ", "]"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "/.", 
             RowBox[{"Reverse", "/@", 
              RowBox[{"Normal", "[", "setpositions", "]"}]}]}], "/.", 
            "setsizes"}], ")"}], ",", " ", 
          RowBox[{"GeneSetMatches", "[", 
           RowBox[{
           "genelist", ",", "#", ",", " ", "datamatrix", ",", " ", 
            "genepositions", ",", " ", "setpositions"}], " ", "]"}]}], "}"}], 
        "&"}], "/@", "k"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8836560306127653`*^9, 3.883656122020887*^9}, 
   3.883656418980424*^9, {3.883656489172941*^9, 3.883656530787375*^9}, {
