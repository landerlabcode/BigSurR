   3.8838347557154427`*^9}},ExpressionUUID->"295a4c18-1b63-4a00-9b56-\
dc17d19f1bcd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneSetMatchDB", "[", 
   RowBox[{
   "genelist_", ",", " ", "datamatrix_", ",", " ", "genepositions_", ",", " ",
     "setpositions_", ",", "setsizes_", ",", " ", "cutoff_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", "=", 
      RowBox[{"Keys", "[", 
       RowBox[{"GeneSetMatchFrequency", "[", 
        RowBox[{
        "genelist", ",", "datamatrix", ",", "genepositions", ",", 
         "setpositions", ",", "setsizes", ",", "cutoff"}], " ", "]"}], 
       "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Dataset", "[", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "->", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"\"\<Set size\>\"", "->", "#"}], "/.", 
               RowBox[{"Reverse", "/@", 
                RowBox[{"Normal", "[", "setpositions", "]"}]}]}], "/.", 
              "setsizes"}], ",", " ", 
             RowBox[{"\"\<Genes\>\"", "->", " ", 
              RowBox[{"GeneSetMatches", "[", 
               RowBox[{
               "genelist", ",", "#", ",", " ", "datamatrix", ",", " ", 
                "genepositions", ",", " ", "setpositions"}], " ", "]"}]}]}], 
            "|>"}]}], "&"}], "/@", "k"}], "|>"}], "]"}], ",", " ", 
      RowBox[{"MaxItems", "->", " ", 
       RowBox[{"{", 
        RowBox[{"20", ",", "3"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"HeaderDisplayFunction", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", "12"}], "]"}], "&"}], ")"}]}], ",", 
      RowBox[{"ItemDisplayFunction", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<Set size\>\"", "->", " ", "Automatic"}], ",", 
         RowBox[{"\"\<Genes\>\"", "->", 
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"TextGrid", "@", 
             RowBox[{"Partition", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"#", ",", "12"}], "]"}], "&"}], "/@", "#"}], ",", 
               RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], "&"}], ")"}]}]}], 
        "}"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8836560306127653`*^9, 3.883656122020887*^9}, 
   3.883656418980424*^9, {3.883656489172941*^9, 3.883656530787375*^9}, {
   3.883656661702662*^9, 3.883656665516876*^9}, {3.883656757291259*^9, 
   3.883656761791988*^9}, {3.8836567922991753`*^9, 3.8836568165311813`*^9}, {
   3.883656846788863*^9, 3.883656871215139*^9}, {3.8838347594895983`*^9, 
   3.883834835317614*^9}, {3.883834865950007*^9, 3.883834892758852*^9}, {
   3.883849177587945*^9, 3.883849203244626*^9}, {3.883852734359494*^9, 
   3.883852795530478*^9}, {3.8838528498652363`*^9, 3.883852850008398*^9}, {
   3.883854071365698*^9, 3.8838540769677*^9}, {3.883878126572736*^9, 
   3.883878128113943*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[259]:=",ExpressionUUID->"14dca0a0-c00c-4fca-b4cd-142045f63ba6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneSetMatchDB2", "[", 
   RowBox[{
   "genelist_", ",", " ", "datamatrix_", ",", " ", "genepositions_", ",", " ",
     "setpositions_", ",", "setsizes_", ",", " ", "cutoff_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", "=", 
      RowBox[{"Keys", "[", 
       RowBox[{"GeneSetMatchFrequency", "[", 
        RowBox[{
        "genelist", ",", "datamatrix", ",", "genepositions", ",", 
         "setpositions", ",", "setsizes", ",", "cutoff"}], " ", "]"}], 
       "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Dataset", "[", 
     RowBox[{
      RowBox[{"SortBy", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", 
             RowBox[{"StringSplit", "[", 
              RowBox[{"#", ",", "\"\<_\>\"", ",", "2"}], "]"}], "]"}], "->", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Collection\>\"", "->", 
               RowBox[{"First", "[", 
                RowBox[{"StringSplit", "[", 
                 RowBox[{"#", ",", "\"\<_\>\"", ",", "2"}], "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\"\<Set size\>\"", "->", "#"}], "/.", 
                RowBox[{"Reverse", "/@", 
                 RowBox[{"Normal", "[", "setpositions", "]"}]}]}], "/.", 
               "setsizes"}], ",", " ", 
              RowBox[{"\"\<Genes\>\"", "->", " ", 
               RowBox[{"GeneSetMatches", "[", 
                RowBox[{
                "genelist", ",", "#", ",", " ", "datamatrix", ",", " ", 
                 "genepositions", ",", " ", "setpositions"}], " ", "]"}]}]}], 
             "|>"}]}], "&"}], "/@", "k"}], "|>"}], ",", " ", 
        RowBox[{
         FractionBox[
          RowBox[{"Part", "[", 
           RowBox[{"#", ",", "2"}], "]"}], 
          RowBox[{"Length", "[", 
           RowBox[{"Part", "[", 
            RowBox[{"#", ",", "3"}], "]"}], "]"}]], "&"}]}], "]"}], 
      "\[IndentingNewLine]", ",", " ", 
      RowBox[{"MaxItems", "->", " ", 
       RowBox[{"{", 
        RowBox[{"20", ",", "4"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"HeaderDisplayFunction", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", "12"}], "]"}], "&"}], ")"}]}], ",", 
      RowBox[{"ItemDisplayFunction", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<Set size\>\"", "->", " ", "Automatic"}], ",", 
         RowBox[{"\"\<Genes\>\"", "->", 
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"TextGrid", "@", 
             RowBox[{"Partition", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"#", ",", "12"}], "]"}], "&"}], "/@", "#"}], ",", 
               RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], "&"}], ")"}]}]}], 
        "}"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8836560306127653`*^9, 3.883656122020887*^9}, 
   3.883656418980424*^9, {3.883656489172941*^9, 3.883656530787375*^9}, {
