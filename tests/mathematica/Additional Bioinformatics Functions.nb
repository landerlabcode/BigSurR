Cell[TextData[{
 "Because the function is Listable, it may be applied not just to a pair of \
vectors, but also a pair of matrices.  However, if either matrix is in sparse \
array form, the expression ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"data", "=", 
    FractionBox["vector", "expectationvector"]}],
   Background->None]],
  CellChangeTimes->{{3.8759582729327908`*^9, 3.875958387280637*^9}, {
   3.875958640927732*^9, 3.8759586450347567`*^9}, {3.875958712012974*^9, 
   3.875958721215818*^9}, {3.8759587559143744`*^9, 3.875958760863243*^9}},
  ExpressionUUID->"341f7487-8df5-4cd5-9600-659e47282ada"],
 " won\[CloseCurlyQuote]t thread properly.  So it is easier to create a \
separate function for use on matrices.  "
}], "Text",
 CellChangeTimes->{{3.8759585403936768`*^9, 3.875958557747911*^9}, {
  3.8759586508812513`*^9, 3.875958687747012*^9}, {3.875958766792369*^9, 
  3.8759588447804003`*^9}},ExpressionUUID->"36ae1b60-9065-4b74-be88-\
8da7e3e0ab4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GiniList", "[", 
   RowBox[{"matrix_", ",", " ", "expectationmatrix_"}], "]"}], ":=", 
  RowBox[{"Gini", "/@", 
   FractionBox[
    RowBox[{"Normal", "[", "matrix", "]"}], 
    RowBox[{"Normal", "[", "expectationmatrix", "]"}]]}]}]], "Input",
 CellChangeTimes->{{3.87596002893817*^9, 3.8759600649734173`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[196]:=",ExpressionUUID->"fa8ba010-4ba5-43c3-b628-b0a0d9a8e708"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GiniCorrection", "Subsubsection",
 CellChangeTimes->{{3.876183004157373*^9, 
  3.8761830073885717`*^9}},ExpressionUUID->"15f998ba-7ddb-46f0-8acd-\
d4109ad7b387"],

Cell["\<\
This corrects the Gini by subtracting the Gini that you\[CloseCurlyQuote]d \
get under the null hypothesis (all entries have the same underling mean) with \
a PLN distribution\
\>", "Text",
 CellChangeTimes->{{3.876183322735826*^9, 
  3.876183357955736*^9}},ExpressionUUID->"bfd9dd07-58ad-4d70-9d31-\
217e331358bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GiniCorrection", "[", "c_", "]"}], ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ifunc", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.1`", ",", 
