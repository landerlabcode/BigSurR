Cell[CellGroupData[{

Cell["SortByPCC", "Subsubsection",
 CellChangeTimes->{{3.834571471254497*^9, 3.83457147389452*^9}, 
   3.834670240878558*^9},
 CellLabel->"In[64]:=",ExpressionUUID->"0e9f2cdd-145a-489a-90f5-0a46db1d505f"],

Cell["\<\
This code takes a correlation matrix, extracts the array rules, and sorts \
them by the absolute value of the correlation coefficient, going from \
greatest to smallest, returning only the positions (and not the correlation \
coefficients themselves)\
\>", "Text",
 CellChangeTimes->{{3.834670305861435*^9, 
  3.834670373664278*^9}},ExpressionUUID->"15ae7fce-1920-4f5d-ac00-\
6f30bf7e4001"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SortByPCC", "[", "correlmatpac_", "]"}], ":=", 
   RowBox[{"First", "/@", 
    RowBox[{"ReverseSortBy", "[", 
     RowBox[{
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"ArrayRules", "[", 
         RowBox[{"correlmatpac", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"Last", "[", "#", "]"}], "]"}], "&"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.834433758557658*^9, 3.834433759237007*^9}, {
  3.83443566944484*^9, 3.834435682899873*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[227]:=",ExpressionUUID->"1299014f-6fae-4ec0-87a4-0888a96b9d47"]
}, Closed]],

Cell[CellGroupData[{

Cell["FindP", "Subsubsection",
 CellChangeTimes->{
  3.8354830897023087`*^9},ExpressionUUID->"76925d20-0ce6-4aea-96a3-\
97cb8b5097c0"],

Cell["\<\
This gathers up a list and assigns a single mean p-value to the set of \
vectors that all have the same correlation coefficient.   \
\>", "Text",
 CellChangeTimes->{{3.8354832664817743`*^9, 3.835483296392062*^9}, {
  3.8354833312883472`*^9, 
  3.835483355603567*^9}},ExpressionUUID->"37f3336d-7be3-429e-9c7b-\
656c2b3500ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindP", "[", "list_", "]"}], ":=", " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"list", "\[Equal]", " ", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"list2", " ", "=", " ", 
        RowBox[{"Gather", "[", 
         RowBox[{"list", ",", " ", 
          RowBox[{
           RowBox[{"#1", "\[Equal]", "#2"}], "&"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"MapThread", "[", 
       RowBox[{"List", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "/@", "list2"}], ",", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{
             RowBox[{"Accumulate", "[", 
              RowBox[{"Length", "/@", "list2"}], "]"}], "-", 
             RowBox[{"0.5", 
              RowBox[{"Length", "/@", "list2"}]}]}], 
            RowBox[{"Length", "[", "list", "]"}]]}]}], "}"}]}], "]"}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8354373562448187`*^9, 3.8354374230443*^9}, {
   3.835437459283166*^9, 3.835437480647049*^9}, {3.835440379009358*^9, 
   3.835440492354513*^9}, {3.835440560017832*^9, 3.835440616485695*^9}, {
   3.835624491506817*^9, 3.835624525616809*^9}, {3.835786241288602*^9, 
   3.835786248770585*^9}, 3.8357865754024353`*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[228]:=",ExpressionUUID->"aab3cdcb-6e3a-4334-8089-e65c995fddf1"],

Cell["\<\
This version of the code handles the cases when, for negative inputs you want \
to accumulate to the left and for positive inputs you want to accumulate to \
the right.  \
\>", "Text",
 CellChangeTimes->{{3.84188046461068*^9, 3.841880488918561*^9}, 
   3.841913777400607*^9},ExpressionUUID->"0f834dc9-fcb1-4ad7-9598-\
e9abd3945f6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindP2", "[", "list_", "]"}], ":=", " ", 
  RowBox[{"Mean", "/@", 
   RowBox[{"GatherBy", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "#", "]"}], "<", "0"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], ",", " ", 
           RowBox[{"1", "-", 
            RowBox[{"Last", "[", "#", "]"}]}]}], "}"}], ",", "#"}], "]"}], 
       "&"}], "/@", 
      RowBox[{"MapThread", "[", 
       RowBox[{"List", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sort", "[", "list", "]"}], ",", 
          RowBox[{"1", "-", 
           RowBox[{"N", "[", 
            FractionBox[
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "list", "]"}], "]"}], "-", "0.5"}], 
             RowBox[{"Length", "[", "list", "]"}]], "]"}]}]}], "}"}]}], 
       "]"}]}], ",", " ", "First"}], "]"}], " "}]}]], "Input",
 CellChangeTimes->{{3.841879740929617*^9, 3.8418797706140223`*^9}, 
   3.84188017115628*^9, {3.8418802320631638`*^9, 3.841880236579041*^9}, {
   3.8418802875729094`*^9, 3.8418803211887302`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[229]:=",ExpressionUUID->"2e595e86-3daa-4c81-8ffb-79d6d7b4af29"]
}, Closed]],

Cell[CellGroupData[{

Cell["TableToP", "Subsubsection",
 CellChangeTimes->{{3.846156880609625*^9, 
  3.846156883027049*^9}},ExpressionUUID->"650684dc-86d4-4627-9d06-\
7eebaf4a6f6b"],

Cell["\<\
This code operates on a long list of random data.  It sorts the data from low \
to high, splits the list in two, and Finds a Fitted function for the \
Log-pvalues for the first half of the list (\[OpenCurlyDoubleQuote]negative\
\[CloseCurlyDoubleQuote]) and the second half of the list (\
\[OpenCurlyDoubleQuote]positive\[CloseCurlyDoubleQuote]) separately, fitting \
only the most extreme 10% of the values (i.e. those that would give p<0.05).  \
The fit is a simple polynomial fit, with degree that is adjustable using the \
parameter \[OpenCurlyDoubleQuote]degree\[CloseCurlyDoubleQuote].  The \
function parameters are returned as ordered lists of coefficients of the \
polynomial, starting with the zeroth order coefficient (i.e. the intercept).  \
\>", "Text",
 CellChangeTimes->{{3.846156891790442*^9, 
  3.846157069358453*^9}},ExpressionUUID->"ec4949b3-71c4-40ea-a201-\
bb7dfa588806"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TableToP", "[", 
   RowBox[{"table_", ",", " ", "degree_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"neg", ",", " ", "pos"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"neg", ",", " ", "pos"}], "}"}], "=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"set", "=", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{"Sort", "[", "table", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Length", "[", "table", "]"}], "/", "2"}]}], "]"}]}], 
         "}"}], ",", "\[IndentingNewLine]", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"set", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"set", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "/", "10"}], "]"}]}], 
           " ", "]"}], ",", " ", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"set", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"set", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "/", "10"}], "]"}]}], 
           "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FindFit", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"List", ",", 
           RowBox[{"{", 
            RowBox[{"neg", ",", 
             RowBox[{"Log", "[", 
              RowBox[{"10", ",", 
               RowBox[{"N", "[", 
                FractionBox[
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "neg", "]"}], "]"}], 
                 RowBox[{"Length", "[", "table", "]"}]], "]"}]}], "]"}]}], 
            "}"}]}], "]"}], ",", " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], "degree"], 
          RowBox[{
           RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], 
           SuperscriptBox["x", "i"]}]}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "degree"}], "}"}]}], "]"}], 
         ",", "x"}], "]"}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{"FindFit", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"List", ",", 
           RowBox[{"{", 
            RowBox[{"pos", ",", 
             RowBox[{"Log", "[", 
              RowBox[{"10", ",", 
               RowBox[{"N", "[", 
                FractionBox[
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "pos", "]"}], "]"}], 
                 RowBox[{"Length", "[", "table", "]"}]], "]"}]}], "]"}]}], 
            "}"}]}], "]"}], ",", "  ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], "degree"], 
          RowBox[{
           RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], 
           SuperscriptBox["x", "i"]}]}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"\[ScriptCapitalC]", "[", "i", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "degree"}], "}"}]}], "]"}], 
         ",", "x"}], "]"}]}], "}"}]}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.846154398257236*^9, 3.8461544417243233`*^9}, {
  3.846154472656145*^9, 3.846154597858849*^9}, {3.8461547151302433`*^9, 
  3.8461548615104628`*^9}, {3.846155427014036*^9, 3.846155440897298*^9}, {
  3.8461556698615503`*^9, 3.846155670350547*^9}, {3.846156408608033*^9, 
