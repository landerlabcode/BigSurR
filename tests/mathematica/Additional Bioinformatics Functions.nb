Cell["\<\
To assess, for each community of genes, the strength of correlation of the \
equivalent PCCs associated with it, we define a function that finds the 90th \
percentile PCC\
\>", "Text",
 CellChangeTimes->{{3.883298834111453*^9, 3.883298860314021*^9}, {
  3.883474847086114*^9, 3.88347485052492*^9}, {3.883474898786954*^9, 
  3.88347492333603*^9}},ExpressionUUID->"a7f86530-7ebe-4e10-baa7-\
971adffcd91b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PCC90", "[", 
   RowBox[{"gNO_", ",", " ", "genes_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hits", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gNO", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "genes"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Quantile", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"gNO", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "hits", ",", " ", "hits"}], "]"}], "]"}], " ",
        "[", "\"\<ExplicitValues\>\"", "]"}], ",", "0.9"}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8832989181166058`*^9, 3.883298981179037*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[105]:=",ExpressionUUID->"15b208b7-fd77-44fe-8d09-4b0fa13a1982"],

