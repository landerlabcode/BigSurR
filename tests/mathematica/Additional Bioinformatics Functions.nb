Cell[BoxData[
 RowBox[{
  RowBox[{"SingleCommmunityGraph", "[", 
   RowBox[{"gNetObj_", ",", " ", "com_", ",", " ", "expressionds_", ",", "  ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "boolmat", ",", " ", "fullmat", ",", " ", "negposns", ",", "  ", 
      "posposns", ",", "poscolor", ",", " ", "negcolor", ",", "suppress", ",",
       "  ", "edges", ",", " ", "hls"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"boolmat", "=", 
      RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
       RowBox[{"1", ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"gNetObj", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "#"}], "]"}], "&"}], "/@",
           "com"}], "]"}], ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
