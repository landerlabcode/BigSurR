   3.872428596516012*^9}, {3.872428690982373*^9, 3.872428743346084*^9}, {
   3.872428796798835*^9, 3.872428809755534*^9}, {3.872428978254776*^9, 
   3.8724289794806004`*^9}, 3.8724294276360598`*^9, {3.8724294607003183`*^9, 
   3.87242955917586*^9}, {3.872429767490217*^9, 3.8724297981318808`*^9}, {
   3.872429832108185*^9, 3.8724298361847687`*^9}, 3.872429921233315*^9, 
