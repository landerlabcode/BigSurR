Cell[CellGroupData[{

Cell["FeaturePlot6", "Subsubsection",
 CellChangeTimes->{{3.879128290803763*^9, 3.879128294779901*^9}, 
   3.9648673738670692`*^9},ExpressionUUID->"4cd86d69-4d6c-4206-8aab-\
a9fd09c106ae"],

Cell["\<\
This uses a log pseudocount matrix derived from a residuals matrix.  It also \
automatically calculates the gray background.  Rather than require a whole \
matpac as the input, it just needs the genelist to which the logpMat \
corresponds.  It also allows for a name conversion in case the matpac stores \
the names in a different form from the way we want them to appear.  

Note that we don\[CloseCurlyQuote]t expect any zeros in this case, so we don\
\[CloseCurlyQuote]t need to prune.  

Also, by using Graphics primitives, rather than ListPlot, we speed things up \
almost 20 fold\
\>", "Text",
 CellChangeTimes->{{3.879128297803193*^9, 3.879128312048098*^9}, {
  3.96486738032165*^9, 3.964867428417058*^9}, {3.964867550532689*^9, 
  3.964867562388582*^9}, {3.964867613509801*^9, 3.9648676223851023`*^9}, {
  3.964869500420809*^9, 3.964869527206264*^9}, {3.964874117404326*^9, 
  3.964874156817994*^9}, {3.964875804421664*^9, 
  3.9648758232185163`*^9}},ExpressionUUID->"1652f552-5926-4a92-b0fa-\
51c241de5418"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FeaturePlot6", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<PointSize\>\"", "->", " ", "Medium"}], ",", " ", 
     RowBox[{"\"\<CellRange\>\"", "->", " ", "All"}], ",", " ", 
     RowBox[{"\"\<Conversion\>\"", "->", " ", 
      RowBox[{"{", "}"}]}], ",", " ", 
     RowBox[{"\"\<Unlog\>\"", "->", " ", "False"}], ",", " ", 
     RowBox[{"\"\<Resize\>\"", "->", " ", "None"}], ",", " ", 
     RowBox[{"\"\<Title Size\>\"", "->", " ", "Medium"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"FeaturePlot6", "[", 
    RowBox[{
    "matpac_", ",", "logpMat_", ",", " ", "gene_", ",", " ", "coordAssn_", ",",
      " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "assn", ",", "background", ",", "genelist", ",", "celllist", ",", "row",
        ",", " ", "labeleddata", ",", "image"}], " ", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"assn", "=", 
       RowBox[{"Flatten", "[", "coordAssn", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"genelist", "=", 
       RowBox[{
        RowBox[{"matpac", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "/.", 
        RowBox[{"OptionValue", "[", "\"\<Conversion\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"celllist", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"genelist", ",", " ", "gene"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"row", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<Unlog\>\"", "]"}], ",", 
            RowBox[{"Exp", "@", 
             RowBox[{"Flatten", "[", 
              RowBox[{"logpMat", "[", 
               RowBox[{"[", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"Position", "[", 
                  RowBox[{"genelist", ",", "gene"}], "]"}], "]"}], "]"}], 
               "]"}], "]"}]}], ",", 
            RowBox[{"Flatten", "[", 
             RowBox[{"logpMat", "[", 
              RowBox[{"[", 
               RowBox[{"Flatten", "[", 
                RowBox[{"Position", "[", 
                 RowBox[{"genelist", ",", "gene"}], "]"}], "]"}], "]"}], 
              "]"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"background", "=", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Values", "[", "assn", "]"}], ",", 
              RowBox[{"Directive", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"PointSize", "[", 
                  RowBox[{"OptionValue", "[", "\"\<PointSize\>\"", "]"}], 
                  "]"}], ",", "White"}], "}"}], "]"}], ",", 
              RowBox[{"Antialiasing", "->", " ", "False"}]}], "]"}], ",", " ", 
            RowBox[{"Axes", "\[Rule]", " ", "None"}], ",", 
            RowBox[{"PlotRange", "\[Rule]", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"MinMax", "[", 
                RowBox[{"First", "/@", 
                 RowBox[{"Values", "[", "assn", "]"}]}], "]"}], ",", 
               RowBox[{"MinMax", "[", 
                RowBox[{"Last", "/@", 
                 RowBox[{"Values", "[", "assn", "]"}]}], "]"}]}], "}"}]}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", " ", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"gene", "<>", "\"\< (max = \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"Max", "[", "row", "]"}], "]"}], "<>", "\"\<)\>\""}],
                ",", " ", 
               RowBox[{"OptionValue", "[", "\"\<Title Size\>\"", "]"}]}], 
              "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"labeleddata", "=", 
          RowBox[{"MapThread", "[", 
           RowBox[{"List", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"celllist", "/.", "assn"}], ",", " ", 
              FractionBox["row", 
               RowBox[{"Max", "[", "row", "]"}]]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"image", "=", 
          RowBox[{"Show", "[", 
           RowBox[{"background", ",", 
            RowBox[{"Graphics", "[", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"PointSize", "[", 
                 RowBox[{"OptionValue", "[", "\"\<PointSize\>\"", "]"}], 
                 "]"}], "}"}], ",", 
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"RGBColor", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"1", "-", 
                    RowBox[{"Last", "[", "#", "]"}]}], ",", 
                    RowBox[{"1", "-", 
                    RowBox[{"Last", "[", "#", "]"}]}]}], "]"}], ",", 
                    RowBox[{"Point", "[", 
                    RowBox[{"First", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@",
                   "labeleddata"}], ",", "1"}], "]"}]}], "]"}], " ", "]"}]}], 
           "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"NumberQ", "[", 
            RowBox[{"OptionValue", "[", "\"\<Resize\>\"", "]"}], "]"}], ",", 
           RowBox[{"ImageResize", "[", 
            RowBox[{"image", ",", " ", 
             RowBox[{"OptionValue", "[", "\"\<Resize\>\"", "]"}]}], "]"}], ",",
            " ", "image"}], "]"}]}], "\[IndentingNewLine]", ",", 
        RowBox[{"gene", "<>", " ", "\"\<not found\>\""}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8776524769808483`*^9, 3.877652479931916*^9}, {
