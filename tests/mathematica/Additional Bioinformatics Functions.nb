Cell[CellGroupData[{

Cell["PlotClusters2", "Subsubsection",
 CellChangeTimes->{{3.8774422175133257`*^9, 
  3.877442231464525*^9}},ExpressionUUID->"9cff1c0a-d812-4716-9499-\
b8c8ad25f19a"],

Cell["\<\
This version of PlotClusters is more flexible.  Resolution is a mandatory \
second argument, \[OpenCurlyDoubleQuote]UMAP\[CloseCurlyDoubleQuote] is the \
default method, and all of the options of ListPlot are inherited.  The \
PlotLegends give the community numbers and colors.  Colors may be customized \
just as in ListPlot

The code also informs someone how many communities of length>1 there are and \
gives the opportunity to interrupt before moving on.  \
\>", "Text",
 CellChangeTimes->{{3.877442225898448*^9, 3.877442300658121*^9}, {
  3.8774425177422647`*^9, 
  3.877442541920114*^9}},ExpressionUUID->"2efc2114-2b92-488a-8593-\
945467cdf7d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PlotClusters2", "]"}], " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Method\>\"", "->", " ", "\"\<UMAP\>\""}], ",", " ", 
       RowBox[{"PlotRange", "->", " ", "All"}]}], "}"}], ",", " ", 
     RowBox[{"Options", "[", "ListPlot", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PlotClusters2", "[", 
   RowBox[{"snngraph_", ",", "resolution_", ",", " ", 
    RowBox[{"opt", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"reduction", ",", "message", ",", " ", "communities"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"communities", " ", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IGCommunitiesLeiden", "[", 
          RowBox[{
           RowBox[{"snngraph", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
           RowBox[{"\"\<Resolution\>\"", "->", " ", "resolution"}]}], "]"}], 
         "[", "\"\<Communities\>\"", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"message", "=", 
      RowBox[{"PrintTemporary", "[", 
       RowBox[{"\"\<There are \>\"", ",", 
        RowBox[{"Length", "[", "communities", "]"}], 
        ",", "\"\< communities of size>1; Continue?\>\""}], "]"}]}], ";", 
     RowBox[{"Interrupt", "[", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"NotebookDelete", "[", "message", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"reduction", " ", "=", " ", 
      RowBox[{"DimensionReduce", "[", 
       RowBox[{
        RowBox[{"snngraph", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "2", ",", 
        RowBox[{"Method", "->", 
         RowBox[{"OptionValue", "[", "\"\<Method\>\"", "]"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"reduction", "[", 
          RowBox[{"[", 
           RowBox[{"communities", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "communities", "]"}]}], "}"}]}], "]"}], ",",
        " ", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "communities", "]"}], "]"}]}], ",", 
       RowBox[{"Evaluate", "@", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", "opt", "}"}], ",", 
            RowBox[{"Options", "[", "PlotClusters2", "]"}]}], "]"}], ",", 
          RowBox[{"Options", "[", "ListPlot", "]"}]}], "]"}]}]}], "]"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.8744395101312437`*^9, 3.874439519590057*^9}, {
   3.87444650391824*^9, 3.874446515169697*^9}, {3.874452675828541*^9, 
   3.874452750444406*^9}, {3.87445278637919*^9, 3.874452835098545*^9}, {
   3.874453563089616*^9, 3.874453622858686*^9}, {3.8746008999253187`*^9, 
   3.874600908211635*^9}, 3.877436951505323*^9, {3.877436982447012*^9, 
   3.877436997936061*^9}, {3.877437559444826*^9, 3.8774375703223743`*^9}, {
   3.877437620966811*^9, 3.877437717924156*^9}, {3.87743783904172*^9, 
   3.8774379124068947`*^9}, {3.877441987619598*^9, 3.8774419899434443`*^9}, {
   3.877442020923634*^9, 3.8774420214905148`*^9}, {3.8774420543125467`*^9, 
   3.877442126538602*^9}, {3.877442433631068*^9, 3.8774424340621443`*^9}, {
   3.877442498575573*^9, 3.877442513040125*^9}, {3.877442724195861*^9, 
   3.877442725288864*^9}, {3.8845209872381887`*^9, 3.884520992633374*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[183]:=",ExpressionUUID->"3e194deb-3e97-48f2-a35e-83c03427d52a"]
}, Closed]],

