Cell[BoxData[
 RowBox[{
  RowBox[{"PCC99", "[", 
   RowBox[{"gNO_", ",", " ", "genes_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hits", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gNO", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "genes"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Quantile", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"gNO", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "hits", ",", " ", "hits"}], "]"}], "]"}], " ",
        "[", "\"\<ExplicitValues\>\"", "]"}], ",", "0.99"}], "]"}]}], 
   "]"}]}]], "Input",
