    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"len", "=", 
         RowBox[{"Length", "[", "communities", "]"}]}], ",", "posns", ",", 
        RowBox[{"mat", "=", 
         RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", " ", "posmat", ",", 
        " ", "negmat", ",", " ", "maxlengths", ",", " ", "poslengths", ",", 
        " ", "neglengths", ",", " ", "backgroundstyle"}], "}"}], ",", 
      "\[IndentingNewLine]", 
