Cell[CellGroupData[{

Cell["PolygonExtract", "Subsubsection",
 CellChangeTimes->{{3.83496957626096*^9, 
  3.8349695793966827`*^9}},ExpressionUUID->"4b2b736b-c92c-4959-90f1-\
9b6b290e49f6"],

Cell[TextData[{
 "If you take drawing tools, and draw a CONVEX polygon on an image, either \
name the marked image, and execute PolygonExtract[",
 StyleBox["name",
  FontSlant->"Italic"],
 "] or",
 "\nplace PolygonExtract[#]&@ just before the image and hit enter; you should \
retrieve the coordinates of the vertices of the polygon.  "
}], "Text",
 CellChangeTimes->{{3.832958893119492*^9, 3.832958969700232*^9}, {
  3.8329590424545317`*^9, 3.832959076242435*^9}, {3.832960995713216*^9, 
  3.832960998309064*^9}},ExpressionUUID->"c76fc420-8e40-4d71-99f5-\
7fcac733a733"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonExtract", "[", "markup_", "]"}], ":=", " ", 
  RowBox[{"PolygonCoordinates", "@@", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"markup", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Head", "[", "#", "]"}], "\[Equal]", "Polygon"}], "&"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.832958821797943*^9, 3.832958879343815*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[200]:=",ExpressionUUID->"1ffa6833-2eb8-446f-b875-ed7de561800b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["PolygonMembers", "Subsubsection",
 CellChangeTimes->{{3.834969585209094*^9, 
  3.834969588868248*^9}},ExpressionUUID->"82caf540-49fa-4a7d-a056-\
82982a8fc9e4"],

Cell["\<\
The next code takes the output of the polygon, and, taking a list of x,y \
points as input, makes a region consisting of a convex hull mesh, and selects \
points that are members.  
Note, it will also take an association as input; so if the points have \
labels, it will return to selected points with their labels still associated. \
 \
\>", "Text",
 CellChangeTimes->{{3.832960978737208*^9, 3.8329610443764153`*^9}, {
  3.8329612691115637`*^9, 
  3.832961297398674*^9}},ExpressionUUID->"2f336a33-ac81-4f8f-87c8-\
b5a1a106bc09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonMembers", "[", 
   RowBox[{"pointslist_", ",", " ", "polygon_"}], "]"}], ":=", " ", 
  RowBox[{"Select", "[", 
   RowBox[{"pointslist", ",", "  ", 
    RowBox[{
     RowBox[{"#", "\[Element]", 
      RowBox[{"ConvexHullMesh", "[", "polygon", "]"}]}], "&"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8329608016448593`*^9, 3.8329608140175047`*^9}, {
  3.832960906483575*^9, 3.8329609511033154`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[201]:=",ExpressionUUID->"b0e35fa7-82e7-4e0a-9fff-e67b1567634d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FeaturePlot", "Subsubsection",
 CellChangeTimes->{{3.834969598517185*^9, 
  3.834969599941431*^9}},ExpressionUUID->"aa27ec8b-0490-4c19-b4ee-\
db311dca99bc"],

Cell["\<\
This code creates a feature plot, using a matpac for the values, a gene name, \
and a coordinate association, which is an association of cell names to x-y \
coordinates.  It also takes a colorfunction.  This version of the function \
automatically uses the values in the coordinateAssn to determine the bounds \
for the plot.  \
\>", "Text",
 CellChangeTimes->{{3.832984103829361*^9, 3.832984152145095*^9}, {
  3.832984187326889*^9, 
  3.832984228595591*^9}},ExpressionUUID->"39de6b55-50b2-4d42-8607-\
b1e81ff832f1"],

Cell["\<\
A common color function we use is RGBColor[0.9,0.9(1-#),0.9(1-#)]&\
\>", "Text",
 CellChangeTimes->{{3.8342389294154673`*^9, 
  3.834238936248642*^9}},ExpressionUUID->"f748630f-94bd-4b37-87de-\
178742fadf71"],

Cell["The options allow one to specify different bounds", "Text",
 CellChangeTimes->{{3.832984103829361*^9, 3.832984152145095*^9}, {
  3.832984187326889*^9, 3.832984278987784*^9}, {3.886251857099173*^9, 
  3.886251861423088*^9}},ExpressionUUID->"e02046b1-94b0-4986-8fa7-\
594a31bdd29b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FeaturePlot", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ImageSize", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotStyle", "->", " ", 
      RowBox[{"PointSize", "[", "Small", "]"}]}], ",", " ", 
     RowBox[{"PlotRange", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"\"\<Centroid\>\"", "->", " ", "False"}], ",", " ", 
     RowBox[{"\"\<Centroid Size\>\"", "->", " ", "Medium"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.886251412256742*^9, 3.886251449379662*^9}, {
  3.886251508839457*^9, 3.886251550146456*^9}, {3.886251737646579*^9, 
  3.886251744708055*^9}, {3.886252115019679*^9, 3.886252129087605*^9}, {
  3.886252167681418*^9, 3.886252181559023*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[202]:=",ExpressionUUID->"b2bca59c-7671-49ca-8561-cbca0e8ee54d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FeaturePlot", "[", 
   RowBox[{
   "matpac_", ",", " ", "gene_", ",", " ", "coordAssn_", ",", " ", 
    "colorfunction_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"matpac", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cells", "=", 
        RowBox[{"Keys", "[", "coordAssn", "]"}]}], "}"}], ",", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"maxexpression", " ", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"First", "[", 
            RowBox[{"GeneSubset", "[", 
             RowBox[{
              RowBox[{"CellSubset", "[", 
               RowBox[{"matpac", ",", "cells"}], "]"}], ",", 
              RowBox[{"{", "gene", "}"}]}], "]"}], "]"}], "]"}]}], " ", "}"}],
         ",", "\[IndentingNewLine]", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Values", "[", "coordAssn", "]"}], "\[LeftDoubleBracket]",
                "i", "\[RightDoubleBracket]"}], ",", 
              RowBox[{"colorfunction", "[", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"maxexpression", "\[Equal]", "0"}], ",", "0", ",", 
                 RowBox[{
                  FractionBox["1", "maxexpression"], 
                  RowBox[{"matpac", "\[LeftDoubleBracket]", 
                   RowBox[{"1", ",", 
                    RowBox[{"First", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{
                    "matpac", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], ",", "gene"}], "]"}], "]"}], 
                    "]"}], ",", 
                    RowBox[{"First", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{
                    "matpac", "\[LeftDoubleBracket]", "3", 
                    "\[RightDoubleBracket]"}], ",", 
                    RowBox[{
                    "cells", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}]}], "]"}], "]"}], "]"}]}], 
                   "\[RightDoubleBracket]"}]}]}], "]"}], "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", 
              RowBox[{"Length", "[", "cells", "]"}]}], "}"}]}], "]"}], ",", 
          " ", 
          RowBox[{"Axes", "\[Rule]", " ", "None"}], ",", 
          RowBox[{"PlotStyle", "\[Rule]", " ", 
           RowBox[{"OptionValue", "[", "PlotStyle", "]"}]}], ",", 
          RowBox[{"ImageSize", "->", " ", 
           RowBox[{"OptionValue", "[", "ImageSize", "]"}]}], ",", 
          RowBox[{"PlotRange", "\[Rule]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumberQ", "[", 
              RowBox[{"OptionValue", "[", "PlotRange", "]"}], "]"}], ",", 
             RowBox[{"OptionValue", "[", "PlotRange", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"First", "/@", 
                 RowBox[{"Values", "[", "coordAssn", "]"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"Last", "/@", 
                 RowBox[{"Values", "[", "coordAssn", "]"}]}], "]"}]}], 
              "}"}]}], "]"}]}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", " ", 
           RowBox[{"gene", "<>", "\"\< (max = \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"maxexpression", ",", "2"}], "]"}], "]"}], 
            "<>", "\"\<)\>\""}]}], ",", 
          RowBox[{"Epilog", "->", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<Centroid\>\"", "]"}], ",", " ", 
             
             RowBox[{"{", 
              RowBox[{
               RowBox[{"PointSize", "[", 
                RowBox[{"OptionValue", "[", "\"\<Centroid Size\>\"", "]"}], 
                "]"}], ",", " ", 
               RowBox[{"Point", "[", 
                RowBox[{"FeatureCentroid", "[", 
                 RowBox[{"matpac", ",", " ", "gene", ",", " ", "coordAssn"}], 
                 "]"}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", "}"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
       "]"}]}], "]"}], ",", 
    RowBox[{"Print", "[", "\"\<Gene not found\>\"", "]"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.832983347251053*^9, 3.832983369367244*^9}, {
   3.832983401125009*^9, 3.832983402345825*^9}, {3.832983446425181*^9, 
   3.832983579918475*^9}, {3.8329836247976217`*^9, 3.832983660225342*^9}, {
   3.83298372887094*^9, 3.83298373584956*^9}, {3.832983789869629*^9, 
   3.8329838342403812`*^9}, {3.8329838751495934`*^9, 3.83298403543605*^9}, {
   3.8329847165138683`*^9, 3.832984716625268*^9}, {3.832984756904449*^9, 
   3.832984942960269*^9}, {3.832985138016923*^9, 3.832985145078343*^9}, {
   3.8329852068496313`*^9, 3.832985221391761*^9}, {3.8329857915032167`*^9, 
   3.8329858082930527`*^9}, 3.832986878769863*^9, {3.83298693333396*^9, 
   3.832986940996663*^9}, {3.832986992305711*^9, 3.8329870417165623`*^9}, {
   3.832987094001132*^9, 3.832987109663649*^9}, {3.8329871494678087`*^9, 
   3.832987178284195*^9}, {3.832987229079791*^9, 3.832987243732739*^9}, {
   3.832987441956843*^9, 3.832987442477865*^9}, {3.8330197173576107`*^9, 
   3.8330197875204287`*^9}, {3.833020182739296*^9, 3.8330201941269073`*^9}, {
   3.8335449566677313`*^9, 3.833545004350689*^9}, {3.88625142431993*^9, 
   3.886251429002803*^9}, {3.886251555368444*^9, 3.886251589746813*^9}, {
   3.886251780574758*^9, 3.8862518393401127`*^9}, {3.8862519964631367`*^9, 
   3.886252000352396*^9}, {3.8862520324537497`*^9, 3.886252079101206*^9}, {
   3.886252135837689*^9, 3.886252144810206*^9}, {3.8862521856230583`*^9, 
   3.8862522195456533`*^9}, {3.886252274710593*^9, 3.8862522886198463`*^9}, {
   3.886252320676383*^9, 3.886252324922196*^9}, {3.886252408911458*^9, 
   3.8862524093351173`*^9}, {3.886252452986471*^9, 3.886252455180491*^9}, {
   3.886252485568111*^9, 3.886252508355275*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[203]:=",ExpressionUUID->"ff3fdb2d-04e2-40a1-9323-1ad51d76052c"]
}, Closed]],

Cell[CellGroupData[{

Cell["FeaturePlot2", "Subsubsection",
 CellChangeTimes->{{3.834969598517185*^9, 3.834969599941431*^9}, 
   3.871476217255474*^9},ExpressionUUID->"03b51ebd-1d9e-4a72-ac2c-\
b9238cd3daee"],

Cell["\<\
This version of Feature plot uses a pre-specified background plot, to save time
This code creates a feature plot, using a matpac for the values, a gene name, \
and a coordinate association, which is an association of cell names to x-y \
coordinates.  It also takes a colorfunction.  This version of the function \
automatically uses the values in the coordinateAssn to determine the bounds \
for the plot.  
A common color function we use is RGBColor[0.9,0.9(1-#),0.9(1-#)]&

In the second version of the code we include a residuals mat and plot that \
instead.  

In the optional input \
\[OpenCurlyDoubleQuote]cellrange\[CloseCurlyDoubleQuote] should be put in as \
a span, e.g. 1;;1000, or a similar thing that can be put inside [[]].  It \
restricts what\[CloseCurlyQuote]s plotted to just a subset of cells denoted \
by the range.  \
\>", "Text",
 CellChangeTimes->{{3.832984103829361*^9, 3.832984152145095*^9}, {
  3.832984187326889*^9, 3.832984228595591*^9}, {3.871476223489768*^9, 
  3.871476260060542*^9}, {3.873514811716094*^9, 3.873514823091988*^9}, {
  3.873530314225082*^9, 3.8735303861565523`*^9}, {3.873532066391943*^9, 
  3.8735321108506823`*^9}},ExpressionUUID->"c321729a-d9c7-4f16-9bf5-\
f25834c3f058"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FeaturePlot2", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<PointSize\>\"", "->", " ", "Medium"}], ",", " ", 
     RowBox[{"\"\<CellRange\>\"", "->", " ", "All"}], ",", " ", 
     RowBox[{"\"\<Log\>\"", "->", " ", "False"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FeaturePlot2", "[", 
     RowBox[{
     "matpac_", ",", " ", "gene_", ",", " ", "coordAssn_", ",", 
      "backgroundplot_", " ", ",", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{
        RowBox[{"matpac", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "list", ",", "initialcells", ",", "cells", ",", "cellposns", ",", 
          "geneposn", ",", "vals", ",", " ", "maxexpression", ",", " ", 
          "coordinates"}], " ", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"geneposn", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"matpac", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "gene"}], "]"}], "]"}]}], ";", 
         RowBox[{"initialcells", "=", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"matpac", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", " ", 
               RowBox[{"OptionValue", "[", "\"\<CellRange\>\"", "]"}]}], 
              "]"}], "]"}], ",", 
            RowBox[{"Keys", "[", "coordAssn", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cellposns", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"matpac", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"initialcells", ",", "x"}], "]"}]}]}], "]"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"list", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"initialcells", "->", " ", 
              RowBox[{"Flatten", "[", 
               RowBox[{"matpac", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "geneposn", ",", " ", "cellposns"}], "]"}],
                 "]"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"cells", "=", 
          RowBox[{"Keys", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"vals", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<Log\>\"", "]"}], ",", 
            RowBox[{"Log", "[", 
             RowBox[{"Values", "[", "list", "]"}], "]"}], ",", 
            RowBox[{"Values", "[", "list", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"coordinates", "=", 
          RowBox[{"cells", "/.", "coordAssn"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"MapThread", "[", 
              RowBox[{"Style", ",", " ", 
               RowBox[{"{", 
                RowBox[{"coordinates", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Directive", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"PointSize", "[", 
                    RowBox[{"OptionValue", "[", "\"\<PointSize\>\"", "]"}], 
                    "]"}], ",", 
                    RowBox[{"RGBColor", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"1", "-", "#"}], ",", 
                    RowBox[{"1", "-", "#"}]}], "]"}]}], "}"}], "]"}], "&"}], "/@", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    FractionBox["#", 
                    RowBox[{"Max", "[", "#", "]"}]], "&"}], "@", "vals"}], 
                   ")"}]}]}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"Axes", "\[Rule]", " ", "None"}], ",", 
             RowBox[{"PlotLabel", "\[Rule]", " ", 
              RowBox[{"gene", "<>", "\"\< (max = \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"Values", "[", "list", "]"}], "]"}], ",", "2"}], 
                 "]"}], "]"}], "<>", "\"\<)\>\""}]}], ",", 
