Cell[CellGroupData[{

Cell["SplitByVarCells", "Subsubsection",
 CellChangeTimes->{
  3.851262439710669*^9, {3.851262666096896*^9, 
   3.851262666791286*^9}},ExpressionUUID->"5cd70a29-a1ec-4d4b-b04b-\
8831afc04dd7"],

Cell["\<\
This code works the same as \[OpenCurlyDoubleQuote]SplitByVarNumbers\
\[CloseCurlyDoubleQuote], but instead of returning the lengths of the cell \
lists, it returns the actual cell IDs corresponding to those lists/\
\>", "Text",
 CellChangeTimes->{{3.851262460845031*^9, 3.851262570789135*^9}, {
  3.8512626123563433`*^9, 
  3.851262714187366*^9}},ExpressionUUID->"30db5181-9b11-4030-8282-\
d728a39edd80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SplitByVarCells", "[", 
   RowBox[{"matpac_", ",", " ", "community_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gs", ",", " ", "gs2", ",", " ", "cs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gs", " ", "=", " ", 
      RowBox[{"Standardize", "/@", 
       RowBox[{"First", "[", 
        RowBox[{"GeneSubset", "[", 
         RowBox[{"matpac", ",", "community"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gs2", " ", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"ReverseSortBy", "[", 
        RowBox[{
         RowBox[{"FindClusters", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "gs", "]"}], "\[Rule]", " ", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], ",", "Length"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cs", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"CellSubset", "[", 
        RowBox[{
         RowBox[{"ReplacePart", "[", 
          RowBox[{"matpac", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "\[Rule]", " ", "gs"}], ",", " ", 
             RowBox[{"2", "\[Rule]", " ", "community"}]}], "}"}]}], "]"}], ",",
          "gs2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"TakeDrop", "[", 
      RowBox[{"gs2", ",", 
       RowBox[{
        RowBox[{"Width", "[", "gs", "]"}], "-", "1", "-", 
        "\[IndentingNewLine]", 
        RowBox[{"First", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"#", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "\[Equal]", " ", 
                RowBox[{"Min", "[", "#", "]"}]}]}]}], "]"}], "&"}], "@", 
           RowBox[{"Differences", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"First", "[", 
               RowBox[{"VariancesExplained", "[", 
                RowBox[{"Drop", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", "cs", "]"}], ",", 
                  RowBox[{"-", "i"}]}], "]"}], "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "0", ",", 
                RowBox[{
                 RowBox[{"Width", "[", "gs", "]"}], "/", "2"}]}], " ", 
               "}"}]}], "]"}], " ", "]"}]}], "]"}], "]"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.851262347452758*^9, 3.851262357661849*^9}, {
  3.8512624044124393`*^9, 3.851262450024095*^9}, {3.851262598267715*^9, 
  3.851262600229471*^9}, {3.851262669880878*^9, 3.851262670518113*^9}, {
  3.851262957829259*^9, 3.85126297850309*^9}, {3.8512639494540854`*^9, 
  3.851263962134554*^9}, {3.8512716112032557`*^9, 3.851271619712329*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[246]:=",ExpressionUUID->"552bbb06-2474-47af-81ac-b35f3f4c90bb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SplitByVarPlot", "Subsubsection",
 CellChangeTimes->{
  3.851262439710669*^9, {3.851262666096896*^9, 3.851262666791286*^9}, {
   3.851263345554192*^9, 
   3.851263346258635*^9}},ExpressionUUID->"b69cd0ef-f88c-43bb-a230-\
d8af3970e5e0"],

Cell["\<\
This code works the same as \[OpenCurlyDoubleQuote]SplitByVarNumbers\
\[CloseCurlyDoubleQuote], but instead of returning the lengths of the cell \
lists, it plots the actual values of the variance explained as cells are \
deleted from the end of the list.  \
\>", "Text",
 CellChangeTimes->{{3.851262460845031*^9, 3.851262570789135*^9}, {
  3.8512626123563433`*^9, 3.851262714187366*^9}, {3.851263369300487*^9, 
  3.851263399759385*^9}},ExpressionUUID->"053a238d-90e9-4dbc-8b9c-\
f4d8eb8bfbb6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SplitByVarPlot", "[", 
   RowBox[{"matpac_", ",", " ", "community_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gs", ",", " ", "gs2", ",", " ", "cs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gs", " ", "=", " ", 
      RowBox[{"Standardize", "/@", 
       RowBox[{"First", "[", 
        RowBox[{"GeneSubset", "[", 
         RowBox[{"matpac", ",", "community"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gs2", " ", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"ReverseSortBy", "[", 
        RowBox[{
         RowBox[{"FindClusters", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "gs", "]"}], "\[Rule]", " ", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], ",", "Length"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cs", " ", "=", "  ", 
      RowBox[{"First", "[", 
       RowBox[{"CellSubset", "[", 
        RowBox[{
         RowBox[{"ReplacePart", "[", 
          RowBox[{"matpac", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "\[Rule]", " ", "gs"}], ",", " ", 
             RowBox[{"2", "\[Rule]", " ", "community"}]}], "}"}]}], "]"}], ",",
          "gs2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "i"}], ",", " ", 
           RowBox[{"First", "[", 
            RowBox[{"VariancesExplained", "[", 
             RowBox[{"Drop", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", "cs", "]"}], ",", 
               RowBox[{"-", "i"}]}], "]"}], "]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", 
           RowBox[{
            RowBox[{"Width", "[", "gs", "]"}], "/", "2"}]}], " ", "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"AxesLabel", "\[Rule]", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<length from end dropped\>\"", ",", 
          " ", "\"\<% of variance explained\>\""}], "}"}]}], " ", ",", " ", 
       RowBox[{"PlotRange", "\[Rule]", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.5"}], "}"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.851262347452758*^9, 3.851262357661849*^9}, {
   3.8512624044124393`*^9, 3.851262450024095*^9}, {3.851262598267715*^9, 
   3.851262600229471*^9}, {3.851262669880878*^9, 3.851262670518113*^9}, {
   3.851262957829259*^9, 3.85126297850309*^9}, 3.851263364253096*^9, {
   3.851263406976074*^9, 3.851263433782373*^9}, {3.851263469685111*^9, 
   3.851263471970604*^9}, {3.851263767008005*^9, 3.8512637759778423`*^9}, {
   3.8512639537531347`*^9, 3.851263966540806*^9}, {3.851264694604721*^9, 
   3.851264695370227*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[247]:=",ExpressionUUID->"45b90479-45cf-4ffa-8c04-3d79c2634d81"]
}, Open  ]],

Cell[CellGroupData[{

Cell["OverlapPlot", "Subsubsection",
 CellChangeTimes->{{3.851264626692541*^9, 3.851264628825075*^9}, 
   3.8512646892601633`*^9},ExpressionUUID->"f2acd3cf-87e3-4c9a-97bc-\
11e749110707"],

Cell["\<\
this takes a look at the cell subsets identified by SplitByVarCells for a \
bunch of communities, and plots the degree of overlap between those subsets.  \
Basically it tests the degree to which subsets defined by their ability to \
explain the variance in particular communities are the same or different from \
one another.   

An alternative approach might be to calculate a correlation coefficient \
between the cell orderings produced by each clustering.  \
\>", "Text",
 CellChangeTimes->{{3.8512655915692043`*^9, 3.851265669234*^9}, {
  3.851859520066059*^9, 
  3.85185954738105*^9}},ExpressionUUID->"d9eac99e-0529-4949-a16d-\
9c63f1d9bf05"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OverlapPlot", "[", 
   RowBox[{"matpac_", ",", "communities_", ",", " ", "indices_"}], "]"}], ":=",
   " ", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"groups", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Last", "[", 
         RowBox[{"SplitByVarCells", "[", 
          RowBox[{"matpac", ",", 
           RowBox[{"communities", "[", 
            RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "]"}], "&"}], "/@", 
       "indices"}]}], "}"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{"ArrayPlot", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"Length", "[", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"groups", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
            RowBox[{"groups", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"groups", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "+", 
            RowBox[{"Length", "[", 
             RowBox[{"groups", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ")"}], "/", "2"}]], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "groups", "]"}]}], " ", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", "groups", "]"}]}], " ", "}"}]}], "]"}], ",", 
      " ", 
      RowBox[{"FrameTicks", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"Style", "[", 
              RowBox[{"indices", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "indices", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"Style", "[", 
              RowBox[{"indices", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "indices", "]"}], "]"}]}], ",", "False", ",",
          "False"}], "}"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8512644925823393`*^9, 3.85126460592339*^9}, {
   3.851264675711936*^9, 3.851264677763585*^9}, {3.851264867876114*^9, 
   3.85126487015106*^9}, 3.8512649112424717`*^9, {3.851265114736949*^9, 
   3.851265164702982*^9}, 3.851265267062972*^9, {3.851265539282845*^9, 
   3.851265560597518*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[248]:=",ExpressionUUID->"6abeeada-10be-4d78-b95a-0dddac9a11cf"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.8519656011701927`*^9, 3.85196562036143*^9}, 
   3.851966424200491*^9},
 CellLabel->
  "In[249]:=",ExpressionUUID->"a9c63239-c174-44ca-9c65-51a8a3d20135"],

Cell["\<\
IN this version, gray to black shows positive correlation; negative \
correlation comes out kind of greenish\
\>", "Text",
 CellChangeTimes->{{3.851970272404194*^9, 
  3.8519702985485764`*^9}},ExpressionUUID->"41c0a9c0-5107-434f-a30b-\
e977afa3def6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OverlapPlot2", "[", 
   RowBox[{"orderedmatpac_", ",", "communities_", ",", " ", "indices_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "matpac", ",", "cellnum", ",", "celldata", ",", " ", "cellpcdata", ",", 
      " ", "cellorder"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"matpac", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"orderedmatpac", ",", " ", 
        RowBox[{"1", "\[Rule]", " ", 
         RowBox[{"Standardize", "/@", 
          RowBox[{
          "orderedmatpac", "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ArrayPlot", "[", 
      RowBox[{
       RowBox[{"Correlation", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"N", "[", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"celldata", "=", 
              RowBox[{"First", "[", 
               RowBox[{"GeneSubset", "[", 
                RowBox[{"matpac", ",", 
                 RowBox[{"communities", "[", 
                  RowBox[{"[", 
                   RowBox[{
                   "indices", "\[LeftDoubleBracket]", "k", 
                    "\[RightDoubleBracket]"}], "]"}], "]"}]}], "]"}], "]"}]}],
              ";", "\[IndentingNewLine]", 
             RowBox[{"cellpcdata", "=", 
              RowBox[{"PrincipalComponents", "[", 
               RowBox[{"celldata", ",", " ", 
                RowBox[{"Method", "->", "\"\<Correlation\>\""}]}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"cellnum", "=", 
              RowBox[{"Length", "[", 
               RowBox[{"matpac", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Ordering", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"N", "[", 
                 RowBox[{"SpecialCorrelation", "[", 
                  RowBox[{
                   RowBox[{"cellpcdata", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"Normal", "[", 
                    RowBox[{"celldata", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "j"}], "]"}], "]"}], "]"}]}], "]"}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "cellnum"}], "}"}]}], "]"}], "]"}]}], ",", 
            
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "indices"}], "}"}]}], "]"}], "]"}], "]"}],
         "]"}], ",", 
       RowBox[{"FrameTicks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"Style", "[", 
               RowBox[{"indices", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "indices", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"Style", "[", 
               RowBox[{"indices", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "indices", "]"}], "]"}]}], ",", "False", ",",
           "False"}], "}"}]}], ",", "  ", 
       RowBox[{"ColorFunction", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#", ">", "0"}], ",", 
            RowBox[{"GrayLevel", "[", 
             RowBox[{"1", "-", "#"}], "]"}], ",", 
            RowBox[{"CMYKColor", "[", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"-", "#"}], ",", "0.2"}], "]"}]}], "]"}], "&"}], 
         ")"}]}], ",", " ", 
       RowBox[{"ColorFunctionScaling", "\[Rule]", " ", "False"}]}], "]"}]}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.85197017828335*^9, 3.851970204520396*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[250]:=",ExpressionUUID->"03e4bef0-1891-4f48-ae17-37b7e2327f4f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Loadings", "Subsubsection",
 CellChangeTimes->{{3.8519439893329372`*^9, 3.851943991080927*^9}, {
  3.851944388504217*^9, 
  3.851944389544572*^9}},ExpressionUUID->"6c0f6198-6130-482d-b69a-\
15d6f355d294"],

Cell["\<\
Component loading  means the correlation of the ith principal component and \
the jth gene .\
\>", "Text",
 CellChangeTimes->{{3.851945248688106*^9, 
  3.851945253054162*^9}},ExpressionUUID->"b1049af5-c055-4274-97b3-\
852c5cf28ae7"],

Cell["\<\
Here we use PCA to find the top principal components that explain variance \
among cells, and return a matrix of \[OpenCurlyDoubleQuote]loadings\
\[CloseCurlyDoubleQuote] for each of the first five PCs.  A loading is a \
vector of gene names and associated values, where the value indicates the \
degree of correlation between that gene and that particular PC.  The most \
strongly positive and negative loadings represent the most \
\[OpenCurlyDoubleQuote]key\[CloseCurlyDoubleQuote] genes of that PC.  The \
output is a matrix in which the rows are gene names, and the columns of the \
loadings for the PCs, in order from 1 to 5.  \
\>", "Text",
 CellChangeTimes->{{3.851944003517912*^9, 3.851944125017398*^9}, {
  3.851944361750719*^9, 3.8519443678493223`*^9}, {3.851945427256456*^9, 
  3.851945456181857*^9}},ExpressionUUID->"2a89eeac-a2d2-4fe3-a9e6-\
5cf5e4c3b5d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Loadings", "[", 
   RowBox[{"matpac_", ",", " ", "genelist_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"data", ",", "pcdata", ",", " ", "loadingstable"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"data", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"First", "[", 
        RowBox[{"GeneSubset", "[", 
         RowBox[{"matpac", ",", "genelist"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pcdata", "=", 
      RowBox[{"PrincipalComponents", "[", 
       RowBox[{
        RowBox[{"N", "[", "data", "]"}], ",", " ", 
        RowBox[{"Method", "->", "\"\<Correlation\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"loadingstable", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"SpecialCorrelation", "[", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"pcdata", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "i"}], "]"}], "]"}], "]"}], ",", 
             RowBox[{"N", "[", 
              RowBox[{"Normal", "[", 
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "j"}], "]"}], "]"}], "]"}], "]"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "genelist", "]"}]}], "}"}]}], "]"}], ",", 
         "genelist"}], "]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.851944217755041*^9, 3.851944335255639*^9}, {
   3.85194462258202*^9, 3.851944633782851*^9}, {3.851944682961907*^9, 
   3.851944798555904*^9}, 3.851944841524712*^9, {3.851944939800645*^9, 
   3.8519449779504547`*^9}, {3.851945060067451*^9, 3.8519451150442963`*^9}, 
   3.851945197467802*^9, {3.851945362475761*^9, 3.851945412452447*^9}, {
   3.851945719328668*^9, 3.851945732008225*^9}, {3.851945791326037*^9, 
   3.851945821028605*^9}, {3.851960230989209*^9, 3.8519602438869133`*^9}, 
   3.851960316543989*^9, {3.8519606010762672`*^9, 3.851960611512363*^9}, 
   3.851960644529643*^9, {3.877453595138966*^9, 3.8774536138287907`*^9}, {
   3.877453707211569*^9, 3.877453713022184*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[251]:=",ExpressionUUID->"821ea235-3fbf-4904-b723-2353c8f9fd80"]
}, Open  ]],

Cell[CellGroupData[{

Cell["StrongestLoadings", "Subsubsection",
 CellChangeTimes->{{3.85194605714776*^9, 
  3.85194606126509*^9}},ExpressionUUID->"6c819408-58d6-4957-a123-\
65ceaec3608f"],

Cell["\<\
This takes a loadings table, and the index of a PC, sorts it by the Absolute \
value of the loading value, selects up to 200 genes with the most extreme \
values (or the maximum number of genes input, if it was fewer than 200), and \
returns them in ordered lists for both positive and negative loading.  The \
first list is the positively loaded genes, the second is the negatively \
loaded genes.  The order runs from strongest to weakest.  \
\>", "Text",
 CellChangeTimes->{{3.851946063555423*^9, 3.8519462027392473`*^9}, {
  3.851946698238546*^9, 3.851946721641882*^9}, {3.8519470341812067`*^9, 
  3.851947065195479*^9}},ExpressionUUID->"2818b86c-d16d-4c5e-a692-\
2b3a8b17603a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StrongestLoadings", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Target Number\>\"", "\[Rule]", " ", "200"}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.851947280614599*^9, 3.851947298766761*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[252]:=",ExpressionUUID->"67947bb8-6b6d-4a34-8697-2ee352e5dfef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrongestLoadings", "[", 
   RowBox[{"matpac_", ",", "genelist_", ",", " ", "pcnumber_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"top", ",", " ", 
      RowBox[{"len", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"Length", "[", "genelist", "]"}], ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<Target Number\>\"", "]"}]}], 
        "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"top", " ", "=", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"ReverseSortBy", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Loadings", "[", 
            RowBox[{"matpac", ",", " ", "genelist"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", 
               RowBox[{"1", "+", "pcnumber"}]}], "}"}]}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Last", "[", "#", "]"}], "]"}], "&"}]}], "]"}], ",", 
        "len"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<pos\>\"", "\[Rule]", " ", 
        RowBox[{"First", "/@", 
         RowBox[{"Select", "[", 
          RowBox[{"top", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}]}]}], 
       ",", " ", 
       RowBox[{"\"\<neg\>\"", "\[Rule]", " ", 
        RowBox[{"First", "/@", 
         RowBox[{"Select", "[", 
          RowBox[{"top", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], "<", "0"}], "&"}]}], 
          "]"}]}]}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.85194620529924*^9, 3.851946351223371*^9}, {
  3.851946499784234*^9, 3.851946505427141*^9}, {3.851946574357308*^9, 
  3.851946685682193*^9}, {3.851946794782483*^9, 3.851946812861877*^9}, {
  3.851946847083424*^9, 3.851946862300658*^9}, {3.851946947435402*^9, 
  3.85194694821554*^9}, {3.851946988846785*^9, 3.851947021258409*^9}, {
  3.851947274219696*^9, 3.851947278024194*^9}, {3.851947308385149*^9, 
  3.8519473202593946`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[253]:=",ExpressionUUID->"a675c0cd-8dc0-4d08-828b-74d9e0940850"],

Cell["\<\
The option is there so we can adjust the target number of genes to be greater \
or larger than 200\
\>", "Text",
 CellChangeTimes->{{3.8519473817421103`*^9, 
  3.851947403558538*^9}},ExpressionUUID->"36749208-fdaa-4d5d-aa43-\
6c72cfc6cde3"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Fitting Data to Distributions (",
 StyleBox["Rotate2Ddata, LineProjected, MixedDistributionFitTest)",
  FontColor->GrayLevel[0]]
}], "Subsection",
 CellChangeTimes->{{3.9684170792306147`*^9, 3.968417135946805*^9}, {
  3.968510870790145*^9, 
  3.9685108733029833`*^9}},ExpressionUUID->"a1a523bd-5b4e-4733-a81c-\
d0fce48503fa"],

Cell[CellGroupData[{

Cell["Rotate2Ddata", "Subsubsection",
 CellChangeTimes->{{3.968417143875555*^9, 
  3.968417145175456*^9}},ExpressionUUID->"0a2a74d9-28d0-4e76-8c37-\
0942efb676c6"],

Cell["\<\
This code takes a 2D data set, clusters by by Kmeans into 2 clusters and \
rotates so that the separation between the clusters is maximized along the \
x-axis.  One typically  takes First/@ this and passes that to \
MixedDistributionFit Test\
\>", "Text",
 CellChangeTimes->{{3.9684122678408413`*^9, 3.968412344224855*^9}, {
  3.968417179818721*^9, 
  3.968417205440466*^9}},ExpressionUUID->"60989dca-0efc-451b-82e2-\
1ffd87e7b13c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rotate2Ddata", "[", "data_", "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cl", ",", " ", "rawcentroids", ",", " ", "midpoint", ",", " ", 
      "translocated", ",", " ", "\[Theta]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cl", "=", 
      RowBox[{"FindClusters", "[", 
       RowBox[{"data", ",", "2", ",", " ", 
        RowBox[{"Method", "->", " ", "\"\<KMeans\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rawcentroids", "=", 
      RowBox[{"Mean", "/@", "cl"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"midpoint", "=", 
      RowBox[{"Mean", "[", "rawcentroids", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"translocated", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", "midpoint"}], "&"}], "/@", "data"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", " ", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{"-", " ", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rawcentroids", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", " ", "midpoint"}], ")"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rawcentroids", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", "midpoint"}], ")"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]]}], "]"}]}], ";", "  ", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], " ", "}"}], "&"}], "/@",
       "translocated"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.968412363461635*^9, 3.968412384775296*^9}, {
  3.968434999067615*^9, 3.9684350239898863`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[461]:=",ExpressionUUID->"600ce74b-de3e-4738-a9b4-dcd9ac6595b4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LineProjected ", "Subsubsection",
 CellChangeTimes->{{3.9685094349348927`*^9, 3.968509452791754*^9}, 
   3.968577687460396*^9},ExpressionUUID->"42daa2e4-5a27-4122-83ea-\
3619ebfe1d75"],

Cell["\<\
This code takes a dataset of any dimension, clusters it into two clusters, \
projects all the points down onto the line formed between the centroids of \
the two clusters, and then automatically rotates that line so that all of the \
locations along the line are in a single coordinate.  It returns a list of \
positions along the line, of length equal to the length of the data.   The \
data end up being centered on a mean of zero.\
\>", "Text",
 CellChangeTimes->{{3.9685094557807302`*^9, 3.9685095328790197`*^9}, {
  3.968509568046879*^9, 3.9685096149513397`*^9}, {3.968574543084003*^9, 
  3.968574594103362*^9}},ExpressionUUID->"eac39c8b-4f46-406d-a179-\
840a56b2174b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LineProjected", "[", "data_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"centroids", " ", "=", 
      RowBox[{"Mean", "/@", " ", 
       RowBox[{"FindClusters", "[", 
        RowBox[{"data", ",", "2", ",", " ", 
         RowBox[{"Method", "->", " ", "\"\<KMeans\>\""}]}], "]"}]}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"Flatten", "[", 
     RowBox[{"DimensionReduce", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RegionNearest", "[", 
          RowBox[{
           RowBox[{"InfiniteLine", "[", "centroids", "]"}], ",", "#"}], "]"}],
          "&"}], "/@", "data"}], ",", " ", "1"}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9685092133259783`*^9, 3.968509237232149*^9}, {
  3.9685092876994247`*^9, 3.968509353569195*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[531]:=",ExpressionUUID->"8edf1665-0921-468f-b605-8ad89c2061d8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MixedDistributionFitTest", "Subsubsection",
 CellChangeTimes->{
  3.968417165683723*^9},ExpressionUUID->"d4412c66-bfb2-4433-a42d-\
601217f0e886"],

Cell["\<\
This codes tests whether a univariate distribution is better fit by a single \
Normal Distribution or a Mixture of two.  The input must be datapoints of \
dimension 2 or higher, to which LineProjected gets applied in order to \
project onto one dimension.  

The output is a Dataset object giving the parameters of the fits and the RMS \
errors.  The RMS error is the root mean square error in the CDF for the two \
different models.  \
\>", "Text",
 CellChangeTimes->{{3.968411663933633*^9, 3.968411734780039*^9}, {
  3.968417211953342*^9, 3.9684172327452602`*^9}, {3.968577696608543*^9, 
  3.9685777348629932`*^9}},ExpressionUUID->"47bf0c48-0ab8-469a-97f0-\
16bc89cb1c7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "MixedDistributionFitTest", "]"}], "=", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Rescale\>\"", "->", " ", "False"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MixedDistributionFitTest", "[", 
   RowBox[{"testdata_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "linedata", ",", " ", "cdfData", ",", " ", "mixedparams", ",", " ", 
      "normalparams", ",", " ", "mixedCDFlist", ",", "gaussianCDFlist", ",", 
      " ", "\[ScriptCapitalD]1", ",", " ", "\[ScriptCapitalD]2"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Dimensions", "[", "testdata", "]"}], "]"}], "==", "1"}], ",",
        " ", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<Insufficient dimensions of data\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"linedata", "=", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"LineProjected", "[", "testdata", "]"}], "]"}], "+", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Rescale\>\"", "]"}], ",", 
         RowBox[{"Mean", "[", 
          RowBox[{"Mean", "[", "testdata", "]"}], "]"}], ",", "0"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cdfData", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"List", ",", " ", 
        RowBox[{"{", 
         RowBox[{"linedata", ",", " ", 
          FractionBox[
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "linedata", "]"}], "]"}], 
           RowBox[{"Length", "[", "linedata", "]"}]]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"mixedparams", "=", 
      RowBox[{"FindDistributionParameters", "[", 
       RowBox[{"linedata", ",", 
        RowBox[{"MixtureDistribution", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Alpha]", ",", 
            RowBox[{"1", "-", "\[Alpha]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"\[Mu]1", ",", "\[Sigma]1"}], "]"}], ",", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"\[Mu]2", ",", "\[Sigma]2"}], "]"}]}], "}"}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"normalparams", "=", 
      RowBox[{"FindDistributionParameters", "[", 
       RowBox[{"linedata", ",", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"\[Mu]1", ",", "\[Sigma]1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mixedCDFlist", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox["1", "2"], " ", "\[Alpha]", " ", 
             RowBox[{"Erfc", "[", 
              FractionBox[
               RowBox[{
                RowBox[{"-", "x"}], "+", "\[Mu]1"}], 
               RowBox[{
                SqrtBox["2"], " ", "\[Sigma]1"}]], "]"}]}], "+", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", "\[Alpha]"}], ")"}], " ", 
             RowBox[{"Erfc", "[", 
              FractionBox[
               RowBox[{
                RowBox[{"-", "x"}], "+", "\[Mu]2"}], 
               RowBox[{
                SqrtBox["2"], " ", "\[Sigma]2"}]], "]"}]}]}], "/.", 
           "mixedparams"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "linedata"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gaussianCDFlist", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"Erfc", "[", 
             FractionBox[
              RowBox[{
               RowBox[{"-", "x"}], "+", "\[Mu]1"}], 
              RowBox[{
               SqrtBox["2"], " ", "\[Sigma]1"}]], "]"}]}], "/.", 
           "normalparams"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "linedata"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[ScriptCapitalD]1", "=", 
      RowBox[{
       RowBox[{"MixtureDistribution", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", 
           RowBox[{"1", "-", "\[Alpha]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"\[Mu]1", ",", "\[Sigma]1"}], "]"}], ",", 
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"\[Mu]2", ",", "\[Sigma]2"}], "]"}]}], "}"}]}], "]"}], "/.",
        "mixedparams"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[ScriptCapitalD]2", "=", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"\[Mu]1", ",", "\[Sigma]1"}], "]"}], "/.", "normalparams"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Show", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Histogram", "[", 
            RowBox[{
            "linedata", ",", "Automatic", ",", " ", "\"\<PDF\>\"", ",", " ", 
             RowBox[{"PlotLabel", "->", " ", "\"\<PDF\>\""}]}], "]"}], ",", 
           " ", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"PDF", "[", 
                RowBox[{"\[ScriptCapitalD]1", ",", "x"}], "]"}], ",", " ", 
               RowBox[{"PDF", "[", 
                RowBox[{"\[ScriptCapitalD]2", ",", "x"}], "]"}]}], "}"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"x", ",", " ", 
               RowBox[{"Min", "[", "linedata", "]"}], ",", " ", 
               RowBox[{"Max", "[", "linedata", "]"}]}], "}"}], ",", " ", 
             RowBox[{"PlotStyle", "->", " ", 
              RowBox[{"{", 
               RowBox[{"Blue", ",", " ", "Red"}], "}"}]}]}], "]"}]}], "]"}], ",", 
         RowBox[{"ListPlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "cdfData", ",", "mixedCDFlist", ",", "  ", "gaussianCDFlist"}], 
            " ", "}"}], ",", 
           RowBox[{"Joined", "->", "True"}], ",", " ", 
           RowBox[{"Mesh", "->", " ", "50"}], ",", " ", 
           RowBox[{"PlotLabel", "->", " ", "\"\<CDF\>\""}], ",", 
           RowBox[{"PlotStyle", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Dashed", ",", "Black", ",", " ", 
                RowBox[{"PointSize", "[", "Medium", "]"}]}], "}"}], ",", " ", 
              "Blue", ",", " ", "Red"}], "}"}]}]}], "]"}]}], "}"}], "]"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Dataset", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<RMS error\>\"", "->", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<mixture\>\"", "->", " ", 
             SqrtBox[
              RowBox[{"Total", "[", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Last", "/@", "mixedCDFlist"}], " ", "-", " ", 
                  RowBox[{"Last", "/@", "cdfData"}]}], ")"}], "2"], "]"}]]}], 
            ",", 
            RowBox[{"\"\<Normal\>\"", "->", 
             SqrtBox[
              RowBox[{"Total", "[", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Last", "/@", "gaussianCDFlist"}], " ", "-", " ", 
                  RowBox[{"Last", "/@", "cdfData"}]}], ")"}], "2"], " ", 
               "]"}]]}]}], "|>"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<\[Mu]1\>\"", "->", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<mixture\>\"", "->", "\[Mu]1"}], "/.", 
             "mixedparams"}], " ", ",", 
            RowBox[{
             RowBox[{"\"\<Normal\>\"", "->", " ", "\[Mu]1"}], "/.", 
             "normalparams"}]}], "|>"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<\[Sigma]1\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<mixture\>\"", "->", "\[Sigma]1"}], "/.", 
             "mixedparams"}], " ", ",", 
            RowBox[{
             RowBox[{"\"\<Normal\>\"", "->", "\[Sigma]1"}], "/.", 
             "normalparams"}]}], " ", "|>"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<\[Mu]2\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<mixture\>\"", "->", " ", "\[Mu]2"}], "/.", 
             "mixedparams"}], ",", 
            RowBox[{"\"\<Normal\>\"", "->", " ", "\"\<\>\""}]}], "|>"}]}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"\"\<\[Sigma]2\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<mixture\>\"", "->", " ", "\[Sigma]2"}], "/.", 
             "mixedparams"}], ",", 
            RowBox[{"\"\<Normal\>\"", "->", "\"\<\>\""}]}], " ", "|>"}]}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"\"\<fraction\>\"", "->", "  ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<mixture\>\"", "->", " ", "\[Alpha]"}], "/.", 
             "mixedparams"}], ",", 
            RowBox[{"\"\<Normal\>\"", "->", " ", "\"\<\>\""}]}], "|>"}]}]}], 
        "|>"}], "}"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->CompressedData["
