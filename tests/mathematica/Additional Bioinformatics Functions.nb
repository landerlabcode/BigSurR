Cell[CellGroupData[{

Cell[TextData[{
 "Clustering genes using KNN graphs (",
 StyleBox["HCG,",
  FontColor->GrayLevel[0]],
 " ",
 StyleBox["SNN graph, PlotClusters",
  FontColor->GrayLevel[0]],
 ")"
}], "Subsection",
 CellChangeTimes->{{3.874439368822825*^9, 3.874439379682768*^9}, {
  3.877356043990735*^9, 3.877356071952237*^9}, {3.879107861007522*^9, 
