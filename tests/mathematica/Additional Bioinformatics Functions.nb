Cell[CellGroupData[{

Cell[TextData[{
 "Graphics and Manipulation of Graphics (",
 StyleBox["PolygonExtract, PolygonMembers, FeaturePlot, ArrayPlotMatPac",
  FontColor->GrayLevel[0]],
 ")"
}], "Subsection",
 CellChangeTimes->{{3.8329588045674353`*^9, 3.832958813757869*^9}, {
  3.832985875534727*^9, 3.8329858931456413`*^9}, {3.833844421822954*^9, 
