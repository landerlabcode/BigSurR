Cell[CellGroupData[{

Cell["FindSubCommunities", "Subsubsection",
 CellChangeTimes->{{3.834777227504312*^9, 
  3.834777236289227*^9}},ExpressionUUID->"da952e70-5961-44ca-b75a-\
48ed5aeac577"],

Cell["\<\
This function takes a gNetworkObject and a community from that object, and \
tries to break that up into smaller sub-communities.  It takes as input a \
gNetworkObject and the list of the genes in the community.  \
\>", "Text",
 CellChangeTimes->{{3.834777240309575*^9, 3.83477729429109*^9}, {
  3.8347774742123413`*^9, 
  3.834777492518127*^9}},ExpressionUUID->"2885e791-489f-4b6b-a993-\
3fbc4e6383c6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FindSubCommunities", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Min Correlation\>\"", "\[Rule]", "0"}], ",", " ", 
     RowBox[{"\"\<Min Connections\>\"", "\[Rule]", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FindSubCommunities", "[", 
   RowBox[{"gNetObj_", ",", "community_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "posns", ",", "posns2", ",", "tempGNO", ",", " ", "tempGNO2", ",", " ", 
      "tempGNO3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"posns", " ", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{
            "gNetObj", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
             ",", "#"}], "]"}], "&"}], "/@", "community"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tempGNO", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "posns", ",", " ", "posns"}], 
          "\[RightDoubleBracket]"}], ",", 
         RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", "posns"}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
          RowBox[{"3", ",", "posns", ",", " ", "posns"}], 
          "\[RightDoubleBracket]"}]}], " ", "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tempGNO2", " ", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
          "tempGNO", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "*",
           " ", 
          RowBox[{"BoolEval", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "tempGNO", "\[LeftDoubleBracket]", "3", 
              "\[RightDoubleBracket]"}], ">", 
             RowBox[{"OptionValue", "[", "\"\<Min Correlation\>\"", "]"}]}], "||", 
            RowBox[{
             RowBox[{
             "tempGNO", "\[LeftDoubleBracket]", "3", 
              "\[RightDoubleBracket]"}], "<", 
             RowBox[{"-", 
              RowBox[{
              "OptionValue", "[", "\"\<Min Correlation\>\"", "]"}]}]}]}], 
           "]"}]}], ",", 
         RowBox[{
         "tempGNO", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
         RowBox[{
         "tempGNO", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"posns2", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"Total", "/@", 
           RowBox[{"Normal", "[", 
            RowBox[{
            "tempGNO2", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}], "]"}]}], ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", "\[GreaterEqual]", " ", 
            RowBox[{
            "OptionValue", "[", "\"\<Min Connections\>\"", "]"}]}]}]}], "]"}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tempGNO3", " ", "=", "  ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tempGNO2", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "posns2", ",", " ", "posns2"}], 
          "\[RightDoubleBracket]"}], ",", 
         RowBox[{"tempGNO2", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", "posns2"}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"tempGNO2", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "posns2", ",", " ", "posns2"}], 
          "\[RightDoubleBracket]"}]}], " ", "}"}]}], ";"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FindCommunities", "[", "tempGNO3", "]"}]}]}], "]"}]}]}], "Input",\

 CellChangeTimes->{{3.834777309516601*^9, 3.834777346641921*^9}, {
   3.8347773873686438`*^9, 3.8347774679588137`*^9}, {3.834777532093316*^9, 
   3.834777569488566*^9}, {3.8347776921781178`*^9, 3.834777704493462*^9}, {
   3.8347777827098827`*^9, 3.834777943129381*^9}, {3.834778011416375*^9, 
   3.834778099270137*^9}, {3.834778136933778*^9, 3.834778179764085*^9}, {
   3.8347782344964657`*^9, 3.834778245148046*^9}, {3.834778291232386*^9, 
