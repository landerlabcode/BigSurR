Cell[CellGroupData[{

Cell["InsertZeroRowAndColumn", "Subsubsection",
 CellChangeTimes->{{3.883911312749799*^9, 3.883911319500332*^9}, {
  3.883912420601797*^9, 
  3.8839124234523373`*^9}},ExpressionUUID->"4d70c631-99de-4f4d-bc0a-\
8adae561bddf"],

Cell["\<\
This inserts both a column of zeros and a row of zeros at a single position; \
it is used on symmetric matrices to restore an all-zero element that had been \
left out. The default is to output the result as a sparse matrix.  This can \
be changed using the Option \[OpenCurlyDoubleQuote]Sparse\
\[CloseCurlyDoubleQuote]-> False\
\>", "Text",
 CellChangeTimes->{{3.883912427633009*^9, 3.8839124650282907`*^9}, {
  3.883912986738909*^9, 
  3.8839130003061457`*^9}},ExpressionUUID->"554d15e9-9222-4579-b8f5-\
b3acb31fa886"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "InsertZeroRowAndColumn", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Sparse\>\"", "->", " ", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InsertZeroRowAndColumn", "[", 
   RowBox[{"matrix_", ",", " ", "position_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"InsertZeroColumn", "[", 
   RowBox[{
    RowBox[{"InsertZeroRow", "[", 
     RowBox[{"matrix", ",", "position", ",", " ", 
      RowBox[{"\"\<Sparse\>\"", "->", " ", 
       RowBox[{"OptionValue", "[", "\"\<Sparse\>\"", "]"}]}]}], "]"}], ",", 
    " ", "position", ",", " ", 
    RowBox[{"\"\<Sparse\>\"", "->", " ", 
     RowBox[{"OptionValue", "[", "\"\<Sparse\>\"", "]"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.883912476369605*^9, 3.883912590401932*^9}, {
  3.883912657282243*^9, 3.883912700900887*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[10]:=",ExpressionUUID->"6daeccbc-7944-4a26-9f8b-65d3eb742a5c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["BelowDiagonalEntries", "Subsubsection",
 CellChangeTimes->{{3.833124040799938*^9, 
  3.833124052864903*^9}},ExpressionUUID->"9356320c-c26f-40bc-91bd-\
49d9ae323929"],

Cell["\<\
This just takes all the below-diagonal entries of a matrix and flattens them \
into a list; using Mathematica\[CloseCurlyQuote]s LowerTriangularize function \
is probably a lot faster.\
\>", "Text",
 CellChangeTimes->{{3.833124058367187*^9, 3.833124074601904*^9}, {
  3.8419279664480886`*^9, 
  3.841927992486899*^9}},ExpressionUUID->"a576bde3-dd90-46ed-935c-\
ed6ca8671fa2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BelowDiagonalEntries", "[", "mat_", "]"}], ":=", " ", 
  RowBox[{"Flatten", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"mat", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", 
        RowBox[{"Range", "[", 
         RowBox[{"i", "-", "1"}], "]"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "2", ",", " ", 
       RowBox[{"Length", "[", "mat", "]"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.833123974271632*^9, 3.83312400987359*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[12]:=",ExpressionUUID->"31ffd321-1268-481d-a48c-81ce1b787d02"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RestoreSymmetry", "Subsubsection",
 CellChangeTimes->{{3.833931563763345*^9, 
  3.833931569393667*^9}},ExpressionUUID->"e2b7f7b2-6577-4a07-b5e1-\
18d3862dee62"],

Cell["\<\
This takes a symmetric matrix that has been \
\[OpenCurlyDoubleQuote]lower-triangularized\[CloseCurlyDoubleQuote] and/or \
had its diagonal entries set to zero, and undoes these steps, restoring \
symmetry to the matrix and restoring 1\[CloseCurlyQuote]s to the diagonal.  \
The output is in the form of a SparseArray\
\>", "Text",
 CellChangeTimes->{{3.8339315733164053`*^9, 
  3.8339316420266314`*^9}},ExpressionUUID->"d1728f7a-506a-489b-bdd3-\
31a182da435f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RestoreSymmetry", "[", "mat_", "]"}], ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rules", "=", 
      RowBox[{"ArrayRules", "[", "mat", "]"}]}], "}"}], ",", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{"Union", "[", 
        RowBox[{"rules", ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Reverse", "/@", 
            RowBox[{"Keys", "[", "rules", "]"}]}], "\[Rule]", " ", 
           RowBox[{"Values", "[", "rules", "]"}]}], "]"}]}], "]"}], "]"}], ",",
       " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n_", ",", "n_"}], "}"}], "\[Rule]", " ", "1"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.833930686216305*^9, 3.833930784881845*^9}, {
  3.833931346441351*^9, 3.833931399358086*^9}, {3.8339314743565598`*^9, 
  3.8339314858511972`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[13]:=",ExpressionUUID->"05fa0d3d-1aca-4429-9fad-f26fa60fd0e6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RestoreSymmetryExceptDiagonal", "Subsubsection",
 CellChangeTimes->{{3.833931563763345*^9, 3.833931569393667*^9}, {
  3.850272772232736*^9, 
  3.850272775904338*^9}},ExpressionUUID->"bfa9a00b-a16c-447e-8620-\
34f0ae775a4e"],

Cell["\<\
This takes a symmetric matrix that has been \
\[OpenCurlyDoubleQuote]lower-triangularized\[CloseCurlyDoubleQuote] and had \
its diagonal entries set to zero, and undoes these steps, restoring symmetry \
to the matrix and not affecting the diagonal.  The output is in the form of a \
normal array or sparse array, depending on the input SparseArray\
\>", "Text",
 CellChangeTimes->{{3.8339315733164053`*^9, 3.8339316420266314`*^9}, {
  3.8516113389210663`*^9, 3.8516113393145657`*^9}, {3.8824261744743137`*^9, 
  3.8824262096251593`*^9}},ExpressionUUID->"0d65a4bf-4dee-4e2c-8097-\
52b5c50274b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RestoreSymmetryExceptDiagonal", "[", "mat_", "]"}], ":=", " ", 
  RowBox[{"mat", "+", 
   RowBox[{"Transpose", "[", "mat", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.833930686216305*^9, 3.833930784881845*^9}, {
