Cell[CellGroupData[{

Cell[TextData[{
 "Statistical Analysis (",
 StyleBox["CorrelToPval",
  FontColor->GrayLevel[0]],
 ", ",
 StyleBox["CorrelToPvalFisher, PvalToCorrelFisher, BenjaminiHochberg, \
BHNew,Tstat, SortByPCC, FindP, FindP2, Adjustment, CorrectionFits, \
FixMissingValues, CumulantToRawMoment, RawMomentToCumulant",
  FontColor->GrayLevel[0]],
 ")"
}], "Subsection",
 CellChangeTimes->{{3.8329612567867947`*^9, 3.8329612679783916`*^9}, {
   3.833017222879959*^9, 3.833017226653638*^9}, {3.833241260578484*^9, 
   3.8332412740124407`*^9}, {3.83328995502631*^9, 3.8332899618426247`*^9}, {
   3.8338161275357313`*^9, 3.833816164063136*^9}, {3.834969801417947*^9, 
   3.834969814393363*^9}, {3.8349699011195707`*^9, 3.834969902666615*^9}, {
   3.835482975078855*^9, 3.835482989970945*^9}, {3.835485954182839*^9, 
   3.835485961565135*^9}, {3.841655373643309*^9, 3.841655387132436*^9}, {
   3.841914160523356*^9, 3.841914163125699*^9}, {3.848591119259873*^9, 
   3.848591126601099*^9}, {3.849834083886197*^9, 3.849834085331544*^9}, 
   3.850351861672768*^9, {3.8505744096003857`*^9, 3.8505744105702353`*^9}, {
