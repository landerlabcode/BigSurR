Cell[CellGroupData[{

Cell[TextData[{
 "Principal Component Analysis (",
 StyleBox["VariancesExplained, PClist, SplitByVarNumbers, SplitByVarCells, \
SplitByVarPlot, OverlapPlot, Loadings, StrongestLoadings",
  FontColor->GrayLevel[0]],
 " )"
}], "Subsection",
 CellChangeTimes->{{3.851177465945402*^9, 3.8511774703454027`*^9}, {
  3.851543436361334*^9, 3.8515434909755363`*^9}, {3.851943980632203*^9, 
  3.851943983697332*^9}, {3.8519443946822567`*^9, 3.8519443955211687`*^9}, {
  3.8519471043743267`*^9, 
  3.851947108151206*^9}},ExpressionUUID->"8b3c7049-7b5c-4498-9e69-\
1e1423d72de0"],

Cell[CellGroupData[{

Cell["VariancesExplained", "Subsubsection",
 CellChangeTimes->{{3.85117748106103*^9, 
  3.851177495215221*^9}},ExpressionUUID->"31ddd6b3-0fa3-4dd9-9797-\
1ccfe66ed74d"],

Cell[TextData[{
 "This takes as input a data matrix with ",
 StyleBox["m",
  FontSlant->"Italic"],
 " rows and  ",
 StyleBox["n",
  FontSlant->"Italic"],
 " columns.  \nIt outputs a vector of length ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where the entries are the fraction of variance of the entries in the rows \
that is explained by each of the ",
 StyleBox["n",
  FontSlant->"Italic"],
 " principal components, in order.  \nIf we applied it to a genes x cells \
matrix, it would give the fraction of the cell-to-cell variation in gene \
expression that is explained by different combinations of cells.  If we apply \
it to a cells x gene matrix, it gives the fraction of gene-to-gene variation \
in which cells express that is explained by different combinations of genes.  \
Typically we will want the latter.  "
}], "Text",
 CellChangeTimes->{{3.8511775038974657`*^9, 3.851177551512313*^9}, {
  3.851177619604162*^9, 3.851177667213187*^9}, {3.851259189335165*^9, 
  3.851259225182149*^9}, {3.8512592765169573`*^9, 3.851259279328929*^9}, {
  3.8512594003912783`*^9, 
  3.851259563086622*^9}},ExpressionUUID->"47dd6c85-5d2c-4127-b625-\
c31f5c63546b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VariancesExplained", "[", "datamatrix_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"Diagonal", "[", 
      RowBox[{"Covariance", "[", 
       RowBox[{"N", "[", 
        RowBox[{"PrincipalComponents", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"Method", "->", "\"\<Correlation\>\""}]}], "]"}], "]"}], 
       "]"}], "]"}], 
     RowBox[{"Width", "[", "#", "]"}]], "&"}], "@", "datamatrix"}]}]], "Input",\

 CellChangeTimes->{{3.851177562529361*^9, 3.8511776093840313`*^9}, {
  3.851223710538454*^9, 3.851223748754188*^9}, {3.8512574517435513`*^9, 
  3.851257454890874*^9}, {3.851257486263096*^9, 3.851257493975704*^9}, {
  3.8512583670180693`*^9, 3.8512583710364103`*^9}, {3.851259155112315*^9, 
  3.851259170316103*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[243]:=",ExpressionUUID->"36bdd625-da2c-4cf8-a25d-9578dde9ae00"]
}, Open  ]],

Cell[CellGroupData[{

Cell["PClist", "Subsubsection",
 CellChangeTimes->{{3.851259006519072*^9, 
  3.8512590083983173`*^9}},ExpressionUUID->"deea94bc-1fa3-46af-be66-\
4328318fda2e"],

Cell["\<\
This takes a list of gene communities, and gives back, for each community, \
the amount of cell to cell variance explained by the first four PCs\
\>", "Text",
 CellChangeTimes->{{3.851259053526071*^9, 
  3.8512590969353657`*^9}},ExpressionUUID->"ad2a53a2-013c-4aec-acfe-\
ac16eac68128"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PClist", "[", 
   RowBox[{"matpac_", ",", " ", "communities_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"i", "\[Rule]", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"VariancesExplained", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"First", "[", 
          RowBox[{"GeneSubset", "[", 
           RowBox[{"matpac", ",", 
            RowBox[{
            "communities", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
       "4"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "communities", "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8512587187496777`*^9, 3.8512587664971313`*^9}, {
  3.851258973042696*^9, 3.8512589862458887`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[244]:=",ExpressionUUID->"68dce2cc-1ad5-4b6d-83c9-9c19e93fd348"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SplitByVarNumbers", "Subsubsection",
 CellChangeTimes->{
  3.851262439710669*^9},ExpressionUUID->"b522b878-ec19-4c8e-a1fe-\
739ef9b3d266"],

Cell["\<\
This code takes a gene community and a matpac, clusters the cells by the \
genes, then progressively deletes cells from the end of the list, up to 50% \
of the cells, tracking how much of the variance is still explained by the \
first Principal Component.  It finds the biggest change in that measure, and \
returns the position where that occurred.  The output is the number of cells \
to the left of that breakpoint and the number to the right.  \
\>", "Text",
 CellChangeTimes->{{3.851262460845031*^9, 3.851262570789135*^9}, {
  3.8512626123563433`*^9, 
  3.851262655108611*^9}},ExpressionUUID->"57ff8d4e-b61b-4891-ac28-\
359742ad686e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SplitByVarNumbers", "[", 
   RowBox[{"matpac_", ",", " ", "community_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gs", ",", " ", "gs2", ",", " ", "cs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gs", " ", "=", " ", 
      RowBox[{"Standardize", "/@", 
       RowBox[{"First", "[", 
        RowBox[{"GeneSubset", "[", 
         RowBox[{"matpac", ",", "community"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gs2", " ", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"ReverseSortBy", "[", 
        RowBox[{
         RowBox[{"FindClusters", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "gs", "]"}], "\[Rule]", " ", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], ",", "Length"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cs", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"CellSubset", "[", 
        RowBox[{
         RowBox[{"ReplacePart", "[", 
          RowBox[{"matpac", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "\[Rule]", " ", "gs"}], ",", " ", 
             RowBox[{"2", "\[Rule]", " ", "community"}]}], "}"}]}], "]"}], ",",
          "gs2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Width", "[", "gs", "]"}], "-", "#", "-", "1"}], ",", 
         RowBox[{"#", "-", "1"}]}], "}"}], "&"}], "@", 
      RowBox[{"First", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"#", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "\[Equal]", " ", 
              RowBox[{"Min", "[", "#", "]"}]}]}]}], "]"}], "&"}], "@", 
         RowBox[{"Differences", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"VariancesExplained", "[", 
              RowBox[{"Drop", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", "cs", "]"}], ",", 
                RowBox[{"-", "i"}]}], "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "0", ",", 
              RowBox[{
               RowBox[{"Width", "[", "gs", "]"}], "/", "2"}]}], " ", "}"}]}], 
           "]"}], " ", "]"}]}], "]"}], "]"}]}]}]}], "]"}]}]], "Input",
