Cell[BoxData[
 RowBox[{
  RowBox[{"CreateGNO", "[", 
   RowBox[{
   "matpac_", ",", "sigpccmatrix_", ",", "logpvalmat_", ",", " ", 
    "pvalcutoff_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hits", ",", " ", "adjustedmatrix"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"adjustedmatrix", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"sigpccmatrix", "*", 
         RowBox[{"BoolEval", "[", 
          RowBox[{"logpvalmat", ">", 
           RowBox[{"-", 
            RowBox[{"Log10", "[", "pvalcutoff", "]"}]}]}], "]"}]}], ",", 
        RowBox[{"Dimensions", "[", "sigpccmatrix", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hits", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Union", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Keys", "[", 
          RowBox[{"Drop", "[", 
           RowBox[{
            RowBox[{"ArrayRules", "[", "adjustedmatrix", "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"ArrayRules", "[", "adjustedmatrix", "]"}], "]"}], "<", 
        "2"}], ",", 
       RowBox[{"Print", "[", "\"\<no hits found\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "adjustedmatrix", "]"}], "\[LeftDoubleBracket]", 
            RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ">",
            "0"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"matpac", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{"adjustedmatrix", "\[LeftDoubleBracket]", 
          RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
         " ", "\[IndentingNewLine]", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             
             RowBox[{"\"\<From Expression Matrix\>\"", "\[Rule]", 
              " ", "\"\<Metadata\>\""}], "/.", 
             RowBox[{"Last", "[", "matpac", "]"}]}], ",", " ", 
            RowBox[{"\"\<Imposed p-value cutoff of \>\"", "<>", 
             RowBox[{"ToString", "[", "pvalcutoff", "]"}]}]}], "}"}]}]}], 
        "}"}]}], "]"}]}]}], "]"}]}]], "Input",
