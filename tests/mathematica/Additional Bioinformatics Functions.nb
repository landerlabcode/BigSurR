Cell["This adds a named column to the right side of any data set", "Text",
 CellChangeTimes->{{3.866285885040264*^9, 
  3.8662858967752047`*^9}},ExpressionUUID->"aa7a7771-eb18-4e24-b42d-\
2cd995d7d8fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AddDatasetColumn", "[", 
    RowBox[{"dataset_", ",", " ", "columnvector_", ",", " ", "columnname_"}], 
    "]"}], ":=", " ", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p1", " ", "=", 
       RowBox[{"DatasetToMatpac", "[", "dataset", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"p1", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "\[NotEqual]", " ", 
        RowBox[{"Length", "[", "columnvector", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Rows don't match\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"MatPacToDataset", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"p1", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
             RowBox[{"{", "columnvector", "}"}]}], "]"}], "]"}], ",", " ", 
          RowBox[{"p1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"p1", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", "columnname"}], "]"}]}], 
         "}"}], "]"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.866285029680202*^9, 3.866285041362586*^9}, {
  3.866285087937653*^9, 3.866285405169847*^9}, {3.866285462102171*^9, 
  3.8662856586052237`*^9}, {3.866285817313219*^9, 3.866285819894415*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[24]:=",ExpressionUUID->"39b19efe-37ba-48a0-abe0-87b50ed6f0bf"]
}, Open  ]],

