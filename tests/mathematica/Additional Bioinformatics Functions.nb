Cell[CellGroupData[{

Cell["NewPlotSingleAnchored", "Subsubsection",
 CellChangeTimes->{{3.885660352651806*^9, 
  3.885660359881131*^9}},ExpressionUUID->"7534c97f-4f83-4dd8-bed2-\
4aa9ce1171fd"],

Cell["\<\
This is code we will use if we want to plot a particular community or set of \
communities from a gNO, but we want the layout to be dictated by the genes in \
a different gNO and how they would be plotted.  

In order to do that, we must first merge the genes and the gNOs.  Then we map \
the VertexCoords between gNOs.  \
\>", "Text",
 CellChangeTimes->{{3.885660365608919*^9, 3.88566045662789*^9}, {
   3.885660534730998*^9, 3.885660536519517*^9}, {3.885666465923402*^9, 
   3.885666473898305*^9}, 3.885669141939619*^9, 
   3.88568663858143*^9},ExpressionUUID->"93cd6bea-71cc-4b44-9d0d-\
a329f0c91078"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "NewPlotSingleAnchored", "]"}], "=", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"\"\<Show Graph\>\"", "->", " ", "True"}], ",", 
      RowBox[{"\"\<Highlight\>\"", "->", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"\"\<Layout\>\"", "->", " ", "\"\<SpringEmbedding\>\""}], ",", 
      " ", 
      RowBox[{"\"\<Size Scaling\>\"", "->", " ", "25"}], ",", " ", 
      RowBox[{"\"\<Automatic Partitioning\>\"", "->", " ", "True"}], ",", " ", 
      RowBox[{"\"\<LabelStyle\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<HighlightLabelStyle\>\"", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Blue", ",", " ", "Larger"}], "]"}]}], ",", " ", 
      RowBox[{"\"\<HighlightShape\>\"", "->", " ", "\"\<Square\>\""}], ",", 
      RowBox[{"\"\<HighlightColor\>\"", "->", " ", "Yellow"}], ",", " ", 
      RowBox[{"\"\<Positive Only\>\"", "->", " ", "True"}], ",", 
      RowBox[{"\"\<GreenOpacity\>\"", "->", " ", "0.5"}], ",", " ", 
      RowBox[{"\"\<PinkOpacity\>\"", "->", "0.5"}], " ", ",", 
      RowBox[{"\"\<EdgeThickness\>\"", "->", " ", "0.003"}], ",", " ", 
      RowBox[{"ImageSize", "->", " ", "Automatic"}], ",", 
      RowBox[{"\"\<Zoom In\>\"", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<Pan x\>\"", "->", " ", "0"}], ",", " ", 
      RowBox[{"\"\<Pan y\>\"", "->", " ", "0"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ef1", "[", 
    RowBox[{"el_", ",", "___"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Arrowheads", "[", "0", "]"}], ",", 
     RowBox[{"Arrow", "[", 
      RowBox[{"el", ",", "0"}], "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"NewPlotSingleAnchored", "[", 
     RowBox[{
     "gNO_", ",", " ", "mergedGNO_", ",", "genes_", ",", "cutoff_", ",", " ", 
      
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gno", ",", " ", 
        RowBox[{"mergedgno", " ", "=", 
         RowBox[{"GeneSubsetGNO", "[", 
          RowBox[{"mergedGNO", ",", " ", 
           RowBox[{"Flatten", "[", "genes", "]"}], ",", " ", 
           RowBox[{"\"\<Purge\>\"", "->", " ", "True"}]}], "]"}]}], ",", 
        "mergedmat", ",", "mergedposmat", ",", " ", "mergedposposns", ",", 
        " ", "mergedposplot", ",", " ", "vertexcoordsbyname", ",", " ", 
        "allyellowvertices", ",", " ", "allvertexlabels", ",", " ", 
        "vertexsizes", ",", "workingmat", ",", "es", ",", " ", "workinggenes",
         ",", " ", "workinggenecoordinates", ",", " ", "workingvertices", ",",
         "allvertexcoords", ",", "  ", "yellowvertices", ",", "bluevertices", 
        ",", " ", "vertexcoords", ",", "vertexlabels", ",", "datarange", ",", 
        "centerpoint", ",", "\[Delta]x", ",", "\[Delta]y", ",", " ", 
        "newallposns", ",", "newnegposns", ",", "  ", "greenedges", ",", " ", 
        "rededges", ",", "cp"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mergedmat", "=", 
        RowBox[{"mergedgno", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", 
       RowBox[{"mergedposmat", "=", 
        RowBox[{"BoolEval", "[", 
         RowBox[{
          RowBox[{"mergedgno", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ">", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mergedposposns", " ", "=", " ", 
        RowBox[{"Sort", "[", 
         RowBox[{"Union", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"mergedposmat", "[", "\"\<ExplicitPositions\>\"", "]"}], 
           "]"}], "]"}], "]"}]}], " ", ";", "\[IndentingNewLine]", 
       RowBox[{"mergedposplot", "=", 
        RowBox[{"UndirectedGraph", "[", 
         RowBox[{"AdjacencyGraph", "[", 
          RowBox[{"mergedposmat", ",", 
           RowBox[{"GraphLayout", "->", 
            RowBox[{"OptionValue", "[", "\"\<Layout\>\"", "]"}]}]}], "]"}], 
         "]"}]}], " ", ";", "\[IndentingNewLine]", 
       RowBox[{"vertexcoordsbyname", " ", "=", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"mergedgno", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "mergedposposns"}], "]"}], "]"}], "->", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "mergedposplot", "]"}], "[", 
           RowBox[{"[", "mergedposposns", "]"}], "]"}]}], " ", "]"}]}], " ", ";",
        "\[IndentingNewLine]", 
       RowBox[{"gno", "=", 
        RowBox[{"TruncateGNO", "[", 
         RowBox[{
          RowBox[{"GeneSubsetGNO", "[", 
           RowBox[{"gNO", ",", " ", 
            RowBox[{"Flatten", "[", "genes", "]"}], ",", " ", 
            RowBox[{"\"\<Purge\>\"", "->", " ", "True"}]}], "]"}], ",", "0", ",", 
          RowBox[{"\"\<Positive Only\>\"", "->", " ", 
           RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"allyellowvertices", "=", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"gno", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
          
          RowBox[{"OptionValue", "[", "\"\<Highlight\>\"", "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"allvertexlabels", "=", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", 
            RowBox[{"gno", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "->", "  ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Placed", "[", 
              RowBox[{"#", ",", "Center"}], "]"}], "&"}], "/@", 
            RowBox[{"gno", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "]"}]}], " ", ";", 
       "\[IndentingNewLine]", 
       RowBox[{"workingmat", " ", "=", "  ", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"gno", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}], ">", "cutoff"}], "]"}], 
           "*", 
           RowBox[{"gno", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
          RowBox[{"Dimensions", "[", 
           RowBox[{"gno", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rededges", "=", 
        RowBox[{"EdgeList", "[", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"SparseArray", "[", 
            RowBox[{"BoolEval", "[", 
             RowBox[{"workingmat", "<", "0"}], "]"}], "]"}], 
           "[", "\"\<ExplicitPositions\>\"", "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"greenedges", "=", 
        RowBox[{"EdgeList", "[", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"SparseArray", "[", 
            RowBox[{"BoolEval", "[", 
             RowBox[{"workingmat", ">", "0"}], "]"}], "]"}], 
           "[", "\"\<ExplicitPositions\>\"", "]"}], "]"}], "]"}]}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"es", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "->", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{"{", 
                RowBox[{"Green", ",", " ", 
                 RowBox[{"Opacity", "[", 
                  RowBox[{"OptionValue", "[", "\"\<GreenOpacity\>\"", "]"}], 
                  "]"}], ",", " ", 
                 RowBox[{"Thickness", "[", 
                  RowBox[{"OptionValue", "[", "\"\<EdgeThickness\>\"", "]"}], 
                  "]"}]}], "}"}], "]"}]}], "&"}], "/@", "greenedges"}], ")"}],
           ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "->", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{"{", 
                RowBox[{"Pink", ",", " ", 
                 RowBox[{"Opacity", "[", 
                  RowBox[{"OptionValue", "[", "\"\<PinkOpacity\>\"", "]"}], 
                  "]"}], ",", " ", 
                 RowBox[{"Thickness", "[", 
                  RowBox[{"OptionValue", "[", "\"\<EdgeThickness\>\"", "]"}], 
                  "]"}]}], "}"}], "]"}]}], "&"}], "/@", "rededges"}], ")"}]}],
          "]"}]}], " ", ";", "\[IndentingNewLine]", 
       RowBox[{"workinggenes", " ", "=", " ", 
        RowBox[{"Intersection", "[", 
         RowBox[{
          RowBox[{"gno", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", "genes"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"workinggenecoordinates", " ", "=", " ", 
        RowBox[{"workinggenes", "/.", "vertexcoordsbyname"}]}], " ", ";", 
       "\[IndentingNewLine]", 
       RowBox[{"workingvertices", " ", "=", " ", 
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
