Cell["DisplayCommunities", "Subsubsection",
 CellChangeTimes->{
  3.83229050998072*^9, {3.832290640247819*^9, 
   3.8322906417490253`*^9}},ExpressionUUID->"bbb69e9f-02b0-484b-b3ad-\
00b6e44b7f7a"],

Cell["\<\
This function takes as input a gNetworkObject and a communities list computed \
by FindCommunities\
\>", "Text",
 CellChangeTimes->{{3.832330354680265*^9, 3.832330388427361*^9}, {
  3.832330429611598*^9, 
  3.832330431072919*^9}},ExpressionUUID->"e2758e7b-f0f3-425f-858f-\
596076745fdb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DisplayCommunities", "[", 
   RowBox[{"gNetObj_", ",", " ", "coms_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"gr", " ", "=", 
       RowBox[{"AdjacencyGraph", "[", 
        RowBox[{
         RowBox[{
         "gNetObj", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
         RowBox[{"DirectedEdges", "\[Rule]", "False"}]}], "]"}]}], ",", " ", 
      RowBox[{"genes", " ", "=", "  ", 
       RowBox[{
       "gNetObj", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"CommunityGraphPlot", "[", 
     RowBox[{"gr", ",", 
      RowBox[{"coms", "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{"genes", "\[Rule]", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "genes", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"VertexLabels", "\[Rule]", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "genes", "]"}], "]"}], "\[Rule]", " ", 
         "genes"}], "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.832290463212373*^9, 3.8322904823929033`*^9}, {
   3.832290654733716*^9, 3.832290703743949*^9}, {3.8322908438213997`*^9, 
   3.832290844490213*^9}, {3.832290884492169*^9, 3.832290999060981*^9}, {
   3.832293247530685*^9, 3.832293256331197*^9}, 3.832293387998948*^9, {
