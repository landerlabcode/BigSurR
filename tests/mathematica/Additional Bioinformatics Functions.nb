            "genes"}], ")"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"VertexShapeFunction", "\[Rule]", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[Rule]", " ", "\"\<Square\>\""}], "&"}], "/@", 
           "hls"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[Rule]", " ", "Automatic"}], "&"}], "/@", 
           "nonhls"}]}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{"EdgeWeight", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Values", "[", 
           RowBox[{"Drop", "[", 
            RowBox[{
             RowBox[{"ArrayRules", "[", "fullmat", "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}], "]"}]}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"EdgeStyle", "\[Rule]", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ReplaceAll", "[", 
            RowBox[{"List", "\[Rule]", " ", "TwoWayRule"}], "]"}], "/@", 
           "edges"}], "\[Rule]", " ", "\[IndentingNewLine]", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sign", "[", 
                    RowBox[{"fullmat", "\[LeftDoubleBracket]", 
                    RowBox[{"#1", ",", "#2"}], "\[RightDoubleBracket]"}], 
                    "]"}], "/.", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"1", "\[Rule]", " ", "poscolor"}], ",", " ", 
                    RowBox[{
                    RowBox[{"-", "1"}], "\[Rule]", " ", "negcolor"}]}], 
                    "}"}]}], ",", 
                  RowBox[{"Thickness", "[", 
                   RowBox[{"0.006", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"fullmat", "\[LeftDoubleBracket]", 
                    RowBox[{"#1", ",", "#2"}], "\[RightDoubleBracket]"}], 
                    "]"}]}], "]"}]}], "}"}], "]"}], "&"}], "@@", "#"}], "&"}],
             ",", "edges"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"CommunityBoundaryStyle", "\[Rule]", "None"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
