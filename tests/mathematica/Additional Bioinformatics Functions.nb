Cell[CellGroupData[{

Cell["GenesByMultipleCutoffs", "Subsubsection",
 CellChangeTimes->{
  3.8832983072861156`*^9, {3.883312526619504*^9, 
   3.8833125295278788`*^9}},ExpressionUUID->"949ca144-f49d-4a7a-a5bc-\
66e7ce85d7cd"],

Cell["\<\
Here rather than use manipulate, we just output each set of new genes added \
as we advance the cutoff, and put it all in the form of a text grid. 
Note that to retrieve the genes in a row, we just need to enter\
\>", "Text",
 CellChangeTimes->{{3.883319127375904*^9, 3.883319156914905*^9}, {
  3.88331920701803*^9, 
  3.8833192271453257`*^9}},ExpressionUUID->"aab328a4-dbb6-4bc2-a3dc-\
d0355dba5dab"],

Cell["#[[1, n, 2]]", "Text",
 CellChangeTimes->{{3.883319170516315*^9, 
  3.883319200096855*^9}},ExpressionUUID->"2caabcce-369a-4502-a9d7-\
5e103d946d27"],

Cell["\<\
where # is the name of the output and n is the number of the row we want to \
retrieve.  \
\>", "Text",
 CellChangeTimes->{{3.883319179613538*^9, 
  3.883319195512291*^9}},ExpressionUUID->"b5d0668f-5a5a-4aad-8cd4-\
90444be2b1dc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GenesByMultipleCutoffs", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Positive Only\>\"", "->", " ", "False"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenesByMultipleCutoffs", "[", 
   RowBox[{"gNO_", ",", " ", "genes_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"gno", "=", 
       RowBox[{"GeneSubsetGNO", "[", 
        RowBox[{"gNO", ",", " ", 
         RowBox[{"Flatten", "[", "genes", "]"}]}], "]"}]}], ",", " ", "mat", ",",
       " ", "geneset", ",", " ", "workingmat", ",", "workingposns", ",", " ", 
      "q", ",", " ", "lists"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mat", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{"gno", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ">", "0"}], "]"}], "*", 
         RowBox[{"gno", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ",", 
        RowBox[{"gno", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"list", "=", 
            RowBox[{"ReverseSort", "[", 
             RowBox[{"Max", "/@", 
              RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
               RowBox[{"Abs", "[", "mat", "]"}], "]"}]}], "]"}]}], "}"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"First", "[", 
           RowBox[{"ReverseSortBy", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Last", "/@", 
                RowBox[{"Partition", "[", 
                 RowBox[{"list", ",", "25"}], "]"}]}], ",", 
               RowBox[{"Quantile", "[", 
                RowBox[{"list", ",", 
                 RowBox[{"Reverse", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{"i", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "i", ",", " ", "0", ",", " ", "0.9", ",", " ", "0.1"}], 
                    "}"}]}], "]"}], "]"}]}], "]"}]}], "}"}], ",", "Length"}], 
            "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"geneset", "=", 
      RowBox[{"gno", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lists", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"geneset", "[", 
          RowBox[{"[", 
           RowBox[{"Union", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"SparseArray", "[", 
               RowBox[{
                RowBox[{"BoolEval", "[", 
                 RowBox[{
                  RowBox[{"q", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ">=", " ", "mat", ">", 
                  RowBox[{"q", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], "*", 
                "mat"}], "]"}], "[", "\"\<ExplicitPositions\>\"", "]"}], 
             "]"}], "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "q", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{"List", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Round", "[", 
            RowBox[{"#", ",", "0.001"}], "]"}], "&"}], "/@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"q", "[", 
             RowBox[{"[", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"i", "+", "1"}]}], "}"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{
               RowBox[{"Length", "[", "q", "]"}], "-", "1"}]}], "}"}]}], 
           "]"}]}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"lists", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Complement", "[", 
              RowBox[{
               RowBox[{"lists", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
               RowBox[{"Flatten", "[", 
                RowBox[{"lists", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ";;", 
                   RowBox[{"j", "-", "1"}]}], "]"}], "]"}], "]"}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "2", ",", 
               RowBox[{"Length", "[", "lists", "]"}]}], "}"}]}], "]"}]}], 
          "]"}]}], "}"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.8832979950462713`*^9, 3.8832980278594637`*^9}, {
   3.883298199993572*^9, 3.883298202813355*^9}, {3.883312540772524*^9, 
