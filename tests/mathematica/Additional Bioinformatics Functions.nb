                   RowBox[{"OptionValue", "[", "\"\<EdgeThickness\>\"", "]"}],
                    "]"}]}], "}"}], "]"}]}], "&"}], "/@", "rededges"}], 
            ")"}]}], "]"}]}]}]}], " ", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"workingvertices", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Union", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"workingmat", "[", "\"\<ExplicitPositions\>\"", "]"}], "]"}],
