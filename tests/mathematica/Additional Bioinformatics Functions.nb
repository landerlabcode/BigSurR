9f584313be45"],

Cell["\<\
Finds the centroid for all the points, with each position weighted by its \
expression value.  \
\>", "Text",
 CellChangeTimes->{{3.886251370353972*^9, 
  3.886251387183848*^9}},ExpressionUUID->"289b9394-1783-4097-8d33-\
82c4a8a861ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FeatureCentroid", "[", 
   RowBox[{"matpac_", ",", " ", "gene_", ",", " ", "coordAssn_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"matpac", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"expressionvector", " ", "=", " ", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Normal", "[", 
          RowBox[{
           RowBox[{"GeneSubset", "[", 
            RowBox[{
             RowBox[{"CellSubset", "[", 
              RowBox[{"matpac", ",", 
               RowBox[{"Keys", "[", "coordAssn", "]"}]}], "]"}], ",", 
             RowBox[{"{", "gene", "}"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Mean", "[", 
       RowBox[{"WeightedData", "[", 
        RowBox[{
         RowBox[{"Values", "[", "coordAssn", "]"}], ",", " ", 
         "expressionvector"}], "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"Print", "[", "\"\<Gene not found\>\"", "]"}]}], "]"}]}]], "Input",\

