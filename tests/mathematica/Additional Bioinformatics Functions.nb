  3.8430629554184027`*^9, 3.8430629593978148`*^9}, {3.871480001167584*^9, 
  3.87148000186139*^9}},ExpressionUUID->"cc0506ef-bdc5-406e-a001-\
338d254b4621"],

Cell["\<\
This takes a matpac and deletes those genes specified by a list, returning \
another matpac.  It will ignore any genes not in the list.  \
\>", "Text",
 CellChangeTimes->{{3.843063241872324*^9, 3.843063252735313*^9}, {
  3.843063297367906*^9, 
  3.843063313473907*^9}},ExpressionUUID->"7d14168e-5882-4aa0-9d30-\
bb1c000e2374"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CellComplementSubset", "[", 
   RowBox[{"matpac_", ",", " ", "celllist_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"positions", " ", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"matpac", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "celllist"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{"matpac", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "\[Rule]", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Part", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"matpac", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"Complement", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", 
                RowBox[{"matpac", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}], ",", 
              "positions"}], " ", "]"}]}], "]"}], "]"}]}], ",", " ", 
        RowBox[{"3", "\[Rule]", 
         RowBox[{"Part", "[", 
          RowBox[{
           RowBox[{"matpac", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", 
               RowBox[{"matpac", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}], ",", 
             "positions"}], " ", "]"}]}], "]"}]}]}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.843062970022374*^9, 3.843063215296715*^9}, {
  3.871480003893333*^9, 3.871480050163542*^9}, {3.871480081448841*^9, 
  3.871480098209634*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[32]:=",ExpressionUUID->"83f77ea3-d8ea-495d-9331-c4fc0834baa6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ReOrderMatPac", "Subsubsection",
 CellChangeTimes->{{3.848447012743478*^9, 
  3.84844701684732*^9}},ExpressionUUID->"0367570f-273a-45ac-9215-\
93631f9291a0"],

Cell["\<\
We use this function if we have a matpac and we want to re-order the rows \
according to some function, like for example, the mean or the number of zeros \
in the row.  

To order by the number of zeros in the row, going from highest zeros to \
lowest, we\[CloseCurlyQuote]d use:  Count[#,0]& for our function.  \
\>", "Text",
 CellChangeTimes->{{3.8484470215148973`*^9, 3.848447058990275*^9}, {
  3.848447125679658*^9, 3.848447191286846*^9}, {3.851343345788088*^9, 
  3.8513433695216093`*^9}},ExpressionUUID->"ddb5a539-1c26-4c95-9bd5-\
000933653799"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ReOrderMatPac", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<ReverseSort\>\"", "->", " ", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ReOrderMatPac", "[", 
   RowBox[{"matpac_", ",", " ", "function_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"assn", " ", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<ReverseSort\>\"", "]"}], ",", 
        RowBox[{"ReverseSortBy", "[", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"matpac", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "\[Rule]", " ", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "function"}], 
         "]"}], ",", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"matpac", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "\[Rule]", " ", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "function"}], 
         "]"}]}], " ", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Values", "[", "assn", "]"}], ",", " ", 
      RowBox[{"Keys", "[", "assn", "]"}], ",", " ", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
      RowBox[{"\"\<Metatdata\>\"", "\[Rule]", " ", 
       RowBox[{"StringJoin", "[", 
        RowBox[{
         RowBox[{"matpac", "[", 
          RowBox[{"[", 
           RowBox[{"4", ",", "2"}], "]"}], "]"}], 
         ",", "\"\<, Reordered\>\""}], "]"}]}]}], "}"}]}], "]"}]}]}], "Input",\

 CellChangeTimes->{{3.848447061735303*^9, 3.8484471023016663`*^9}, {
  3.8513429649285593`*^9, 3.8513429693445463`*^9}, {3.851343016630121*^9, 
  3.851343096948016*^9}, {3.851343198451477*^9, 3.851343321139873*^9}, {
  3.8513434790809793`*^9, 3.851343520651965*^9}, {3.8513435520221024`*^9, 
  3.851343553833068*^9}, {3.851957466079042*^9, 3.8519574905705423`*^9}, {
  3.85246523762883*^9, 3.852465272945693*^9}, {3.870860176032983*^9, 
  3.870860277463769*^9}, {3.870984541569591*^9, 3.870984547848024*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[33]:=",ExpressionUUID->"6a58e51d-2d60-416a-a67a-2021ce06b0ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ConcatenateMatpac", "Subsubsection",
 CellChangeTimes->{
  3.8708898469425383`*^9},ExpressionUUID->"f9058c05-381a-4077-bb56-\
878c10e6f210"],

Cell["\<\
This code concatenates two matpacs, placing zeros wherever genes are not \
found in one or the other dataset.  Genes that are not shared are moved to \
the end.  The presumptions is that, except for unshared genes, the gene \
orders are the same in the two matpacs.  If not that gets fixed.  In the \
metadata it indicates where the break in cell names from one dataset to \
another occurs.  

Another thing this code does is fix when the same barcode appears in two \
different datasets; If it detects the same barcode appearing twice it will \
add \[OpenCurlyDoubleQuote].1\[CloseCurlyDoubleQuote] to the second \
occurance.  If that produces a barcode that still appears twice it will add \
another .1 until finally there are no overlaps.  \
\>", "Text",
 CellChangeTimes->{{3.870887592477762*^9, 3.8708876070932417`*^9}, {
  3.870887771842074*^9, 3.87088779383078*^9}, {3.870889005169303*^9, 
  3.870889011748722*^9}, {3.870889864086871*^9, 3.870889941966529*^9}, {
  3.870889979841524*^9, 3.870889981932198*^9}, {3.870890061622971*^9, 
  3.870890082792467*^9}, {3.873517520399949*^9, 3.8735175616978683`*^9}, {
  3.87351804938046*^9, 3.87351806225764*^9}, {3.873518098836624*^9, 
  3.873518139577406*^9}, {3.873518415336894*^9, 
  3.8735184611053*^9}},ExpressionUUID->"8a655c20-610a-4cea-bbc0-07dd579655e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConcatenateMatpac", "[", 
   RowBox[{"matpac1_", ",", " ", "matpac2_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"cells1", "=", 
       RowBox[{"matpac1", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
      RowBox[{"cells2", "=", 
       RowBox[{"matpac2", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", "overlap", ",", "cells", ",",
       "genes", ",", "unsharedgenes12", ",", "unsharedgenes21", ",", 
      "sharedmatpac1", ",", "sharedmatpac2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Intersection", "[", 
          RowBox[{"cells1", ",", " ", "cells2"}], "]"}], "]"}], ">", "0"}], ",", 
       RowBox[{"cells2", "=", " ", 
        RowBox[{"cells2", "/.", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", "->", " ", 
              RowBox[{"StringJoin", "[", 
               RowBox[{"#", ",", "\"\<.1\>\""}], "]"}]}], ")"}], "&"}], "/@", 
           
           RowBox[{"Intersection", "[", 
            RowBox[{"cells1", ",", " ", "cells2"}], "]"}]}], ")"}]}]}]}], " ",
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cells", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"cells1", ",", "cells2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"unsharedgenes12", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"matpac1", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"matpac2", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"unsharedgenes21", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"matpac2", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"matpac1", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sharedmatpac1", " ", "=", " ", 
      RowBox[{"GeneComplementSubset", "[", 
       RowBox[{"matpac1", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"unsharedgenes12", ",", " ", "unsharedgenes21"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sharedmatpac2", " ", "=", " ", 
      RowBox[{"GeneComplementSubset", "[", 
       RowBox[{"matpac2", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"unsharedgenes12", ",", " ", "unsharedgenes21"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{
         RowBox[{"sharedmatpac1", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "===", " ", 
         RowBox[{"sharedmatpac2", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<gene orders not same; fixing\>\"", "]"}], ";",
         " ", 
        RowBox[{"sharedmatpac2", " ", "=", " ", 
         RowBox[{"GeneSubset", "[", 
          RowBox[{"sharedmatpac2", ",", " ", 
           RowBox[{"sharedmatpac1", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"genes", " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"sharedmatpac1", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "unsharedgenes12", ",", 
        "unsharedgenes21"}], " ", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Join", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"sharedmatpac1", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
            RowBox[{"Transpose", "[", 
             RowBox[{"sharedmatpac2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"PadRight", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Length", "[", "cells", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"GeneSubset", "[", 
             RowBox[{"matpac1", ",", "unsharedgenes12"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"PadLeft", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Length", "[", "cells", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"GeneSubset", "[", 
             RowBox[{"matpac2", ",", "unsharedgenes21"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], ")"}]}]}], "]"}], ",", " ", 
       "genes", ",", " ", "cells", ",", " ", 
       RowBox[{"\"\<Metadata\>\"", "->", " ", "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{
          
          RowBox[{"\"\<concatenated matpac cells break after cell number\>\"",
            "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"Length", "[", 
             RowBox[{"matpac1", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "matpac1", "]"}], ">", "3"}], ",", " ", 
            RowBox[{"Values", "[", 
             RowBox[{"matpac1", "[", 
              RowBox[{"[", "4", "]"}], "]"}], "]"}], ",", "Nothing"}], "]"}], 
          ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "matpac2", "]"}], ">", "3"}], ",", 
            RowBox[{"Values", "[", 
             RowBox[{"matpac2", "[", 
              RowBox[{"[", "4", "]"}], "]"}], "]"}], ",", "Nothing"}], 
           "]"}]}], "]"}]}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.870887538040907*^9, 3.870887573041992*^9}, {
   3.870887797009639*^9, 3.870887806924415*^9}, {3.870887879128817*^9, 
   3.8708879825506487`*^9}, {3.8708880558878813`*^9, 3.87088805801126*^9}, {
   3.870888177198208*^9, 3.870888360691278*^9}, 3.870888400153919*^9, {
   3.870888440138008*^9, 3.87088846723365*^9}, {3.870888509535767*^9, 
   3.870888816040298*^9}, {3.87088890055825*^9, 3.870888998466991*^9}, {
   3.8708890908783627`*^9, 3.870889292350564*^9}, {3.870889328175774*^9, 
   3.8708893407861977`*^9}, {3.870889624920253*^9, 3.8708896291669283`*^9}, {
   3.870889677488619*^9, 3.870889683101692*^9}, {3.870890002545968*^9, 
   3.8708900406042624`*^9}, {3.870890383958932*^9, 3.8708903899598103`*^9}, {
   3.870890477442401*^9, 3.870890477805211*^9}, {3.871024234348167*^9, 
   3.871024235326056*^9}, {3.873517624484653*^9, 3.873517690025302*^9}, {
   3.873517721722384*^9, 3.873517799087178*^9}, {3.8735179489559717`*^9, 
   3.873518007035885*^9}, 3.873518265118187*^9, {3.873518302739078*^9, 
   3.873518329140279*^9}, {3.8735183701741123`*^9, 3.873518405443437*^9}, {
   3.873518463349284*^9, 3.873518480381609*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[35]:=",ExpressionUUID->"d13f0220-ea78-43ca-940d-7f17793db570"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SplitMatpac", "Subsubsection",
 CellChangeTimes->{{3.8709874199953136`*^9, 
  3.870987426233334*^9}},ExpressionUUID->"c09d7eed-764d-486a-9214-\
715b78890968"],

Cell["\<\
This essentially does the reverse of Concatenate;  If you specify a list of \
ranges of cell positions, it will split a Matpac into several with those cell \
positions only.

The list of ranges should be in the form of {x1;;x2, y1;;y2, z1;;z2, etc}\
\>", "Text",
 CellChangeTimes->{{3.87098742888761*^9, 
  3.870987544352435*^9}},ExpressionUUID->"67c56f0e-5d5f-4b40-8378-\
cc342db33614"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SplitMatpac", "[", 
   RowBox[{"matpac_", ",", " ", "rangelist_"}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ReplacePart", "[", 
     RowBox[{"matpac", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "->", " ", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"matpac", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "All", ",", "#"}], "]"}], "]"}], "]"}]}], ",", 
        " ", 
        RowBox[{"3", "->", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"matpac", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "#"}], "]"}], "]"}], "]"}]}]}], "}"}]}], " ", 
     "]"}], "&"}], "/@", "rangelist"}]}]], "Input",
 CellChangeTimes->{{3.8709875024917803`*^9, 3.870987513966763*^9}, {
  3.870987547405768*^9, 3.87098765393603*^9}, {3.8709886155236197`*^9, 
  3.8709886326879063`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[36]:=",ExpressionUUID->"ea79e9c1-c669-4e05-bb93-b40e150335f0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FuseGenes", "Subsubsection",
 CellChangeTimes->{{3.851955735945648*^9, 
  3.851955737603434*^9}},ExpressionUUID->"5ae9310a-6b2e-461e-8b40-\
ed004db7c27e"],

Cell["\<\
In this case, we replace the rows corresponding to a set of genes with a \
single row that contains the sum of the expression values.  When we have a \
clique of genes that strongly correlate with each other, we may want to do \
this so that we don\[CloseCurlyQuote]t waste a lot of time calculating that \
correlation.  Instead we aggregate them all into a single \
\[OpenCurlyDoubleQuote]module representative\[CloseCurlyDoubleQuote] gene, \
similar to an eigen gene.  

The input needs to be the in the form of an association, where the keys are \
names that we wish to give the fused set, and the values are the names of the \
genes in each set.\
\>", "Text",
 CellChangeTimes->{{3.85195574540094*^9, 
  3.851955934216461*^9}},ExpressionUUID->"618cbb44-3016-41e3-927b-\
461f15dffbe0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FuseGenes", "[", 
   RowBox[{"matpac_", ",", " ", "assn_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "strippedmatpac", " ", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"strippedmatpac", " ", "=", 
      RowBox[{"GeneComplementSubset", "[", 
       RowBox[{"matpac", ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Values", "[", "assn", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"strippedmatpac", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Plus", "@@", 
            RowBox[{"First", "[", 
             RowBox[{"GeneSubset", "[", 
              RowBox[{"matpac", ",", " ", 
               RowBox[{
                RowBox[{"Values", "[", "assn", "]"}], "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "assn", "]"}]}], "}"}]}], "]"}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"strippedmatpac", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"Keys", "[", "assn", "]"}]}], "]"}], ",", " ", 
       RowBox[{"strippedmatpac", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", 
       RowBox[{"MapAt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"#", ",", 
            RowBox[{"\"\<Fused Genes\>\"", "\[Rule]", " ", 
             RowBox[{"Keys", "[", "assn", "]"}]}]}], "]"}], "&"}], ",", " ", 
         RowBox[{"matpac", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "2"}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.851955875184881*^9, 3.8519558820341463`*^9}, {
  3.851955937232729*^9, 3.851955943308549*^9}, {3.851955982299726*^9, 
  3.851956012897032*^9}, {3.8519560544320707`*^9, 3.8519561180774803`*^9}, {
  3.8519561847985477`*^9, 3.851956251827634*^9}, {3.851956315058976*^9, 
  3.851956347702435*^9}, {3.851956391869487*^9, 3.8519564926123857`*^9}, {
  3.851956853956604*^9, 3.8519568812992496`*^9}, {3.85195694275814*^9, 
  3.851956952299315*^9}, {3.851957000444436*^9, 3.851957046445407*^9}, {
  3.851957100151656*^9, 3.851957104872241*^9}, {3.851957160281617*^9, 
  3.851957218478622*^9}, {3.8519575147469187`*^9, 3.851957594301015*^9}, {
  3.8519579265267067`*^9, 3.851957928922882*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[37]:=",ExpressionUUID->"5dbad025-177f-4f0d-b12c-204444639a88"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SpecialCorrelation", "Subsubsection",
 CellChangeTimes->{{3.832375053397414*^9, 3.832375056744842*^9}, 
   3.832375095190724*^9, {3.83237582057705*^9, 
   3.832375823681758*^9}},ExpressionUUID->"2b230beb-96dd-482f-930f-\
55230bf1c89f"],

Cell[TextData[StyleBox["With the built in function \
\[OpenCurlyDoubleQuote]Correlation\[CloseCurlyDoubleQuote], Mathematica \
implements Pearson\[CloseCurlyQuote]s Correlation formula.  For any two \
vectors, the formula is essentially the covariance divided by the product of \
the Standard Deviations.  If ever a vector consists of all-identical entries, \
whether those entries are zeros or non-zeros, it has a standard deviation of \
zero, which will cause Mathematica to divide by zero, producing \
\[OpenCurlyDoubleQuote]Indeterminate\[CloseCurlyDoubleQuote].  To eliminate \
such results, we modify Correlation, so that when applied to a matrix, it \
first deletes any column vectors that have the same entry in every position.  \
",
 FontSlant->"Plain"]], "Text",
 CellChangeTimes->{{3.832375072255958*^9, 3.8323751554312468`*^9}, {
   3.832375829961248*^9, 3.832376031545197*^9}, {3.832376239346179*^9, 
   3.8323762403422728`*^9}, 3.833294700220314*^9, 3.8419143389059267`*^9},
 FontSlant->"Italic",ExpressionUUID->"f227ba2e-4bc4-40d9-8133-2ecaac8e302a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SpecialCorrelation", "[", "mat_", "]"}], ":=", 
  RowBox[{"Correlation", "[", 
   RowBox[{"N", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "mat", "]"}], ",", " ", 
       RowBox[{"x_", "/;", " ", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"Union", "[", "x", "]"}], "]"}], "\[Equal]", "1"}]}]}], 
      "]"}], "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.832376034797439*^9, 3.83237618780504*^9}, {
  3.8419713060378428`*^9, 3.841971308644017*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[38]:=",ExpressionUUID->"f950e0ec-85ea-46bf-9192-2f950d5df8f0"],

Cell["\<\
when we use SpecialCorrelation with two arguments instead of one, it applies \
to just a correlation between two vectors, rather than a whole matrix.  \
\>", "Text",
 CellChangeTimes->{{3.851944495381785*^9, 
  3.851944523689135*^9}},ExpressionUUID->"4ee1f67b-6f7e-4320-b02c-\
5176077f21d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SpecialCorrelation", "[", 
   RowBox[{"v1_", ",", " ", "v2_"}], "]"}], ":=", " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"Union", "[", "v1", "]"}], "]"}], "\[Equal]", "1"}], " ", "\[Or]",
      " ", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"Union", "[", "v2", "]"}], "]"}], "\[Equal]", "1"}]}], ",", 
    " ", "0", ",", " ", 
    RowBox[{"Correlation", "[", 
     RowBox[{"v1", ",", "v2"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.8519444845489683`*^9, {3.8519445723165607`*^9, 3.8519445878638363`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[39]:=",ExpressionUUID->"881318cf-e2ba-49a6-9d9c-0aee79c5ab6a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FixDups", "Subsubsection",
 CellChangeTimes->{{3.8340658902551126`*^9, 
  3.834065892715344*^9}},ExpressionUUID->"267fd7bc-fa51-4615-a5c4-\
b772423a3fc3"],

Cell["\<\
Mathematica\[CloseCurlyQuote]s built in Interpolation function can operate on \
relatively high dimensional data, but it chokes if any of the data points \
have the identical values for the \[OpenCurlyDoubleQuote]independent\
\[CloseCurlyDoubleQuote] variables (i.e. all but the last value in a data \
point), yet different values for the dependent variable.  It then gives an \
error message \[OpenCurlyDoubleQuote]
 Abcissa Points...\[CloseCurlyDoubleQuote], and fails to evaluate.  We can \
prevent that by applying a code that \"fixes\" any duplicates that are found \
by averaging them .  It takes any list whose elements are tuples (pairs, \
triples, etc .), checks for cases where the same \"independent\" \
coordinates-- all but the last member of every tuple-- occur more than once . \
 If it finds them it averages them and replaces them with a single instance \
of the average.  \
\>", "Text",
 CellChangeTimes->{{3.834065904766162*^9, 3.834066118616304*^9}, 
   3.849206608924087*^9},ExpressionUUID->"058b22ab-3db1-45b3-92a7-\
a8c4be72f130"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FixDups", "[", "list_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dups", ",", " ", "posns"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dups", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Tally", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{"#", ",", 
              RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", "list"}], "]"}], ",", 
         " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "dups", "]"}], "\[Equal]", "0"}], ",", " ", 
       "list", ",", 
       RowBox[{
        RowBox[{"posns", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Drop", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", "list"}], ",", 
              RowBox[{"dups", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", 
             RowBox[{"Length", "[", "dups", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"list", ",", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"First", "/@", "posns"}], " ", "\[Rule]", "  ", 
              RowBox[{"Mean", "/@", 
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"list", "[", 
                   RowBox[{"[", "#", "]"}], "]"}], "&"}], ",", "posns", ",", 
                 RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ",", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Drop", "[", 
                  RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", "posns"}], 
               "]"}], "\[Rule]", "Nothing"}], " ", "]"}]}], "]"}]}], 
         "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8340638772470922`*^9, 3.8340638976915617`*^9}, {
  3.834063936121063*^9, 3.834063989406919*^9}, {3.8340640528125887`*^9, 
  3.834064053595522*^9}, {3.834064713505953*^9, 3.834064822905622*^9}, {
  3.8340649539487267`*^9, 3.83406499601126*^9}, {3.834065035461236*^9, 
  3.834065113526156*^9}, {3.83406516148529*^9, 3.834065313601098*^9}, {
  3.834065391146575*^9, 3.834065464358872*^9}, {3.8340655106316633`*^9, 
  3.834065511286746*^9}, {3.834280383792705*^9, 3.834280384123949*^9}, {
  3.8345224176570587`*^9, 3.834522421142372*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[40]:=",ExpressionUUID->"bdeb7f0d-e8ed-4abb-97d5-7130655dfa95"],

Cell["\<\
Sometimes, Tally will see two numbers as different, but Interpolation will \
still judge them to be the same, if they are very very close, for example, \
this pair: {0.004521874588049349`,0.004521874588049373`} which is identical \
up through 16 digits of precision but then becomes different .  The following \
code rounds numbers to 7 digits before comparing them \
\>", "Text",
 CellChangeTimes->{{3.8359535679965763`*^9, 3.835953614751285*^9}, {
  3.835953673831975*^9, 3.835953738054076*^9}, {3.8359538955976057`*^9, 
  3.835953922865459*^9}},ExpressionUUID->"1e31953a-a2d1-4cfe-bd04-\
c4019d117807"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FixDups2", "[", "list_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dups", ",", " ", "posns"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dups", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Tally", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Round", "[", 
             RowBox[{"#", ",", 
              SuperscriptBox["10", 
               RowBox[{"-", "7"}]]}], "]"}], "&"}], "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Drop", "[", 
               RowBox[{"#", ",", 
                RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", "list"}], ")"}]}], 
          "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "dups", "]"}], "\[Equal]", "0"}], ",", " ", 
       "list", ",", 
       RowBox[{
        RowBox[{"posns", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Round", "[", 
                 RowBox[{"#", ",", 
                  SuperscriptBox["10", 
                   RowBox[{"-", "7"}]]}], "]"}], "&"}], "/@", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Drop", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", "list"}], 
                ")"}]}], ",", 
              RowBox[{"dups", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", 
             RowBox[{"Length", "[", "dups", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"list", ",", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"First", "/@", "posns"}], " ", "\[Rule]", "  ", 
              RowBox[{"Mean", "/@", 
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"list", "[", 
                   RowBox[{"[", "#", "]"}], "]"}], "&"}], ",", "posns", ",", 
                 RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ",", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Drop", "[", 
                  RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", "posns"}], 
               "]"}], "\[Rule]", "Nothing"}], " ", "]"}]}], "]"}]}], 
         "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8340638772470922`*^9, 3.8340638976915617`*^9}, {
   3.834063936121063*^9, 3.834063989406919*^9}, {3.8340640528125887`*^9, 
   3.834064053595522*^9}, {3.834064713505953*^9, 3.834064822905622*^9}, {
   3.8340649539487267`*^9, 3.83406499601126*^9}, {3.834065035461236*^9, 
   3.834065113526156*^9}, {3.83406516148529*^9, 3.834065313601098*^9}, {
   3.834065391146575*^9, 3.834065464358872*^9}, {3.8340655106316633`*^9, 
   3.834065511286746*^9}, {3.834280383792705*^9, 3.834280384123949*^9}, {
   3.8345224176570587`*^9, 3.834522421142372*^9}, {3.8359539478400793`*^9, 
   3.835953953610428*^9}, {3.8359539916917973`*^9, 3.8359540609420767`*^9}, 
   3.835954091845717*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[41]:=",ExpressionUUID->"ef2fbcb7-85c7-41c4-a0b5-82c602984ad7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RestoreToSquare", "Subsubsection",
 CellChangeTimes->{{3.834584345522208*^9, 
  3.8345843498772783`*^9}},ExpressionUUID->"0011240b-7672-43eb-aad0-\
050b616e064d"],

Cell["\<\
This function detects whether a matrix has more rows than columns, and if so, \
pads the matrix with columns of zeros so that the result is a square matrix, \
and returns the result as a Sparse Array object.  It is useful because, in \
doing operations on matrices in Sparse Array format, where the operations are \
done directly on the Array Rules list, when such Array Rules are turned back \
into matrices, they will generally be missing any columns at the end that are \
entirely made of zeros.  This code \[OpenCurlyDoubleQuote]fixes\
\[CloseCurlyDoubleQuote] that problem.  \
\>", "Text",
 CellChangeTimes->{{3.834663275144462*^9, 
  3.8346634747592487`*^9}},ExpressionUUID->"dc766a37-a181-4c4c-b19a-\
1ec16922f591"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RestoreToSquare", "[", "sparsearray_", "]"}], ":=", " ", 
  RowBox[{"SparseArray", "[", "\[IndentingNewLine]", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Drop", "[", 
      RowBox[{
       RowBox[{"ArrayRules", "[", "sparsearray", "]"}], ",", 
       RowBox[{"-", "1"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "#"}], "}"}], "\[Rule]", " ", "0"}], ")"}], "&"}],
       "/@", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Width", "[", "sparsearray", "]"}], "+", "1"}], ",", 
        RowBox[{"Length", "[", "sparsearray", "]"}]}], "]"}]}], " ", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"_", ",", "_"}], "}"}], "\[Rule]", " ", "0"}], "}"}]}], "]"}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.834584369835763*^9, 3.8345844512660027`*^9}, {
  3.8345847165349283`*^9, 3.834584744672142*^9}, {3.834584946692574*^9, 
  3.834584952429636*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[42]:=",ExpressionUUID->"bdd1c18f-777e-4ae4-93a7-485fabf83687"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FlattenLT", "Subsubsection",
 CellChangeTimes->{{3.846339463845867*^9, 
  3.846339469686472*^9}},ExpressionUUID->"488876a3-514f-4888-97f8-\
3315d752e70a"],

Cell["\<\
this function takes a matrix, lowertriangularizes it, and then returns the \
values as a flat list, in order, so that it may be reassembled into a matrix \
again later.  If the second parameter is -1, the diagonal is ignored; if it \
is 0 the diagonal is kept.  The code is a little strange because, \
LowerTriangularize doesn\[CloseCurlyQuote]t delete elements it just replaces \
them with zero.  \
\>", "Text",
 CellChangeTimes->{{3.846339473724697*^9, 3.8463395322597322`*^9}, {
  3.84633974375119*^9, 3.8463397633013477`*^9}, {3.846339793509547*^9, 
  3.8463397938830767`*^9}},ExpressionUUID->"d29663c6-df50-4b41-8770-\
94bf9b0f58b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlattenLT", "[", 
   RowBox[{"matrix_", ",", " ", "diag_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"SquareMatrixQ", "[", "matrix", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"N", "[", "matrix", "]"}], "/.", " ", 
          RowBox[{"0.", "\[Rule]", "z"}]}], ")"}], "*", 
        RowBox[{"LowerTriangularize", "[", 
         RowBox[{
          RowBox[{"Array", "[", 
           RowBox[{"f", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", "matrix", "]"}], ",", " ", 
              RowBox[{"Length", "[", "matrix", "]"}]}], "}"}]}], "]"}], ",", 
          " ", "diag"}], "]"}]}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"_", ",", "_"}], "]"}], "\[Rule]", "1"}], ",", 
        RowBox[{"0.", "\[Rule]", " ", "Nothing"}]}], "}"}]}], "/.", 
     RowBox[{"z", "\[Rule]", " ", "0"}]}], ",", "Null"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8463395356701527`*^9, 3.846339581470392*^9}, {
  3.846339821299356*^9, 3.8463398605804663`*^9}, {3.846339907242635*^9, 
  3.846339982847122*^9}, {3.8463400142401323`*^9, 3.846340034000292*^9}, {
  3.846340175227091*^9, 3.846340196435775*^9}, {3.846340252129897*^9, 
  3.8463403365291853`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[43]:=",ExpressionUUID->"b2ac2b6a-131d-4cf0-89f4-bf10804f0e64"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RestoreFlattenLT", "Subsubsection",
 CellChangeTimes->{{3.8463432315241737`*^9, 
  3.846343237326335*^9}},ExpressionUUID->"d659a900-e8e5-4d2d-9da5-\
05e554b604d4"],

Cell["\<\
This function restores a list generated by FlattenLT back to a matrix, via \
ArrayRules.  If the second parameters is -1, it assumes the list was \
generated from a matrix in which the diagonal was excluded; if it is 0, it \
assumes the list was generated from a matrix in which the diagonal was \
included.  \
\>", "Text",
 CellChangeTimes->{{3.846343241518189*^9, 
  3.846343341848372*^9}},ExpressionUUID->"0cf24190-1f98-47ad-8803-\
c398fd3e37b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RestoreLT", "[", 
   RowBox[{"list_", ",", " ", "diag_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"expectedrows", " ", "=", " ", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"diag", " ", "\[Equal]", "  ", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"8", " ", 
              RowBox[{"Length", "[", "list", "]"}]}]}]]}], ")"}]}], ",", " ", 
        
        RowBox[{"diag", " ", "\[Equal]", " ", "0"}], ",", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"8", " ", 
              RowBox[{"Length", "[", "list", "]"}]}]}]]}], ")"}]}], ",", " ", 
        "True", ",", " ", 
        RowBox[{"Abort", "[", "]"}]}], " ", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"IntegerQ", "[", " ", "expectedrows", "]"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"i", ",", "j"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", 
                 RowBox[{"1", "-", "diag"}], ",", "expectedrows"}], "}"}], ",",
                " ", 
               RowBox[{"{", 
                RowBox[{"j", ",", " ", "1", ",", " ", 
                 RowBox[{"i", "+", "diag"}]}], "}"}]}], "]"}], ",", "1"}], 
            "]"}], "\[Rule]", "list"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "expectedrows"}], "}"}], "\[Rule]", " ", "0"}],
            ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"_", ",", "_"}], "}"}], "\[Rule]", " ", "0"}]}], "}"}]}],
         "]"}], "]"}], ",", "Null"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.846343358870591*^9, 3.84634338087169*^9}, {
  3.846343432479218*^9, 3.846343471544479*^9}, {3.846343827162178*^9, 
  3.84634384497031*^9}, {3.846344101594921*^9, 3.846344109476266*^9}, {
  3.846345041728469*^9, 3.8463450461726313`*^9}, {3.846345098505707*^9, 
  3.846345192956963*^9}, {3.846345227818012*^9, 3.8463452495110197`*^9}, {
  3.8463454345927067`*^9, 3.8463454390011187`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[44]:=",ExpressionUUID->"ecae7084-68d0-445d-9f07-467d3f6ff98b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FracZero", "Subsubsection",
 CellChangeTimes->{{3.835483027039238*^9, 
  3.83548302888378*^9}},ExpressionUUID->"efd5da26-8013-458b-a692-\
76f8b7f9dfde"],

Cell["\<\
This function counts the fraction of entries in a vector that are zero\
\>", "Text",
 CellChangeTimes->{{3.835483030545827*^9, 
  3.8354830418760033`*^9}},ExpressionUUID->"d81a2edc-1abc-411f-80fc-\
faab986dd818"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FracZero", "[", "vector_", "]"}], ":=", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{"vector", ",", "0"}], "]"}], "/", 
    RowBox[{"Length", "[", "vector", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.835395498946262*^9, 3.835395523286003*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[45]:=",ExpressionUUID->"8fd6c00e-d96d-48d2-acfe-e54626cd59f7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TakeByFracZero", "Subsubsection",
 CellChangeTimes->{{3.8524631837856627`*^9, 
  3.852463188405785*^9}},ExpressionUUID->"07ee32f1-e61e-46dc-b4ff-\
72eb3f85e2d1"],

Cell["\<\
This function takes a matpac and selects only those genes whose vectors have \
fewer than a specified fraction, \[OpenCurlyDoubleQuote]f\
\[CloseCurlyDoubleQuote],  of zeros.  \
\>", "Text",
 CellChangeTimes->{{3.852463194430283*^9, 3.852463225679059*^9}, {
  3.8524633037453814`*^9, 
  3.852463305220687*^9}},ExpressionUUID->"dccda656-0396-4b2b-98d6-\
c985c37a9dbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TakeByFracZero", "[", 
   RowBox[{"matpac_", ",", "f_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fp", "=", 
      RowBox[{"First", "[", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
          RowBox[{"matpac", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", "<", 
           RowBox[{"f", " ", 
            RowBox[{"Length", "[", 
             RowBox[{"matpac", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}]}]}]}]}], "]"}], "]"}]}], 
     "}"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{"group1orderedMatpac", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "\[Rule]", 
         RowBox[{"matpac", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"fp", ";;"}]}], "]"}], "]"}]}], ",", " ", 
        RowBox[{"2", "\[Rule]", 
         RowBox[{"matpac", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", 
            RowBox[{"fp", ";;"}]}], "]"}], "]"}]}]}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.85246323936742*^9, 3.8524632779837513`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[46]:=",ExpressionUUID->"c2f2ad1d-5858-4110-915a-fef30df03b8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ToTitleCase", "Subsubsection",
 CellChangeTimes->{{3.842095607156775*^9, 
  3.842095612674046*^9}},ExpressionUUID->"a5ce670f-794b-4b2e-a5e8-\
869d26161dd3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToTitleCase", "[", "string_", "]"}], ":=", " ", 
  RowBox[{"StringReplace", "[", 
   RowBox[{
    RowBox[{"ToLowerCase", "[", "string", "]"}], ",", " ", 
    RowBox[{"x_", "\[Rule]", " ", 
     RowBox[{"ToUpperCase", "[", "x", "]"}]}], ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8416822910027847`*^9, 3.841682313049721*^9}, {
  3.841682553531313*^9, 3.8416825576522493`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[47]:=",ExpressionUUID->"bd117a1f-c160-45c5-9c28-e4115fa97945"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LogSpacedPoints", "Subsubsection",
 CellChangeTimes->{{3.84616309832318*^9, 
  3.846163102794437*^9}},ExpressionUUID->"2c8bce88-a903-4655-a635-\
83a722be9e9d"],

Cell["\<\
This takes data in the form of x,y pairs, and retrieves from it a fixed \
number of representative points, logarithmically spaced over the data domain, \
beginning with the first point and ending with the last.  The number of \
points to retrieve is given by the second argument, \
\[OpenCurlyDoubleQuote]points\[CloseCurlyDoubleQuote].\
\>", "Text",
 CellChangeTimes->{{3.846163110371542*^9, 
  3.8461632034902287`*^9}},ExpressionUUID->"5a9eb801-14cf-4f8a-bdb4-\
6bf4ede608b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LogSpacedPoints", "[", 
   RowBox[{"data_", ",", " ", "points_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"range", ",", " ", "vals"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"range", " ", "=", " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"First", "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], ",", " ", 
            RowBox[{"First", "[", "#", "]"}]}], "}"}]}], "&"}], "@", 
        RowBox[{"SortBy", "[", 
         RowBox[{"thetaMeanTable", ",", "First"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vals", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"range", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "+", "i"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", " ", 
          RowBox[{"Subtract", "@@", "range"}], ",", 
          FractionBox[
           RowBox[{"Subtract", "@@", "range"}], 
           RowBox[{"points", "-", "1"}]]}], "}"}]}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Nearest", "[", 
          RowBox[{"data", ",", " ", 
           RowBox[{"{", 
            RowBox[{"#", ",", "0"}], "}"}], ",", "1", ",", 
           RowBox[{"DistanceFunction", "\[Rule]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"#1", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", " ", 
                RowBox[{"#2", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], ")"}]}]}], 
          "]"}], "&"}], "/@", "vals"}], ",", "1"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.846162974074148*^9, 3.846163031808641*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[48]:=",ExpressionUUID->"ed42f92b-0a2c-4b39-a923-a376ebe43a10"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ToPearsonResidual", "Subsubsection",
 CellChangeTimes->{{3.847647072372983*^9, 3.847647077441201*^9}, 
   3.851259936874557*^9},ExpressionUUID->"f84e75d4-9ceb-4801-99a3-\
81ca7c8f4bca"],

Cell["\<\
Note, this function is unnecessary; Mathematica has a built-in function, \
\[OpenCurlyDoubleQuote]Standardize\[CloseCurlyDoubleQuote], that does exactly \
the same thing!\
\>", "Text",
 CellChangeTimes->{{3.8512597492623377`*^9, 
  3.851259778542966*^9}},ExpressionUUID->"de3d9756-1ff4-4adc-a1ef-\
13b8a726d01d"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"ToPearsonResidual", "[", "vector_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"#", "-", 
       RowBox[{"Mean", "[", "vector", "]"}]}], 
      RowBox[{"StandardDeviation", "[", "vector", "]"}]], "&"}], "/@", 
    "vector"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.847646197124806*^9, 3.847646277720467*^9}, {
   3.847646365216466*^9, 3.847646377440431*^9}, 3.8476469918791103`*^9, 
   3.851259871023975*^9, {3.8512599464499397`*^9, 3.8512599488044558`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[49]:=",ExpressionUUID->"ca34258b-502f-4651-828c-b140a250b513"]
}, Open  ]],

Cell[CellGroupData[{

Cell["AddThird", "Subsubsection",
 CellChangeTimes->{{3.8545824956319532`*^9, 
  3.854582501865052*^9}},ExpressionUUID->"82f92380-adf3-4af4-ba89-\
f3979087b4a3"],

Cell["\<\
This creates triples by adding each of the elements of list to the end of \
{x,y}.  \
\>", "Text",
 CellChangeTimes->{{3.854582522016808*^9, 
  3.854582545526805*^9}},ExpressionUUID->"ab2a76dd-dc81-4ebe-a300-\
1b366468ca4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddThird", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], ",", "list_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "#"}], "}"}], "&"}], "/@", 
   "list"}]}]], "Input",
 CellChangeTimes->{{3.851565082491938*^9, 3.851565084300935*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[50]:=",ExpressionUUID->"220a6628-bf1b-474a-8392-6f9970dde39a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SymmetricMatrixToList", "Subsubsection",
 CellChangeTimes->{{3.871864248472568*^9, 
  3.871864250004983*^9}},ExpressionUUID->"3a526056-efbf-4f15-b191-\
1ddc0c64afbb"],

Cell["\<\
There are times when it is inconvenient to store a symmetric matrix as a \
matrix, and easier to store it as a flat list, especially when combining \
matrices, and when the have been lower-triangularized.  The following code \
replaces a symmetric matrix with the values of the Array Rules that would \
result from the Lower-triangularized version of the matrix.  Note that there \
should be Binomial[m,2] values, where m- is the common dimension or the \
original matrix\
\>", "Text",
 CellChangeTimes->{{3.871864263588213*^9, 
  3.871864386319517*^9}},ExpressionUUID->"73dd17bc-0024-464b-81b8-\
213241b45ce4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SymmetricMatrixToList", "[", "matrix_", "]"}], ":=", 
  RowBox[{"Values", "[", 
   RowBox[{"Drop", "[", 
    RowBox[{
     RowBox[{"ArrayRules", "[", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{"matrix", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"-", "1"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.87186469042749*^9, 3.8718647381371183`*^9}, {
   3.8718647798665752`*^9, 3.8718647928023567`*^9}, 3.871903715504642*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[51]:=",ExpressionUUID->"afdfbebd-59bf-41e7-9b14-a6657f805575"],

Cell["\<\
Interestingly, this runs rather slowly for big matrices, probably because of \
the LowerTriangularize step\
\>", "Text",
 CellChangeTimes->{{3.871902112396345*^9, 
  3.871902134310823*^9}},ExpressionUUID->"d825a166-c9c6-442d-aac2-\
43812248b0ba"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ListToSymmetricMatrix", "Subsubsection",
 CellChangeTimes->{{3.8718642519497757`*^9, 
  3.871864261075214*^9}},ExpressionUUID->"7ca7a5b3-c95a-49e6-a086-\
b4c306619c61"],

Cell[TextData[{
 "This takes a matrix that has been converted to a list by ",
 StyleBox["SymmetricMatrixToList",
  FontWeight->"Bold"],
 ", and restores it to a Sparse Array of a strictly lower-triangularized \
matrix.  To do this, it must first detect that the length of the matrix is \
equal to Binomial[m,2] for some integer, and it uses that integer as the \
dimensions of the symmetric matrix.  The test for that is that ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     SqrtBox[
      RowBox[{"1", "+", 
       RowBox[{"8", " ", 
        RowBox[{"Length", "[", "list", "]"}]}]}]]}], ")"}]}]],
  CellChangeTimes->{{3.8718645072618427`*^9, 3.871864538589795*^9}, 
    3.8718645814521713`*^9},ExpressionUUID->
  "f1787494-1bd4-4ec4-a615-6385ae1f0546"],
 " must come out to an integer.  "
}], "Text",
 CellChangeTimes->{{3.871864395970929*^9, 3.871864478135056*^9}, {
  3.871864595792633*^9, 3.871864624393455*^9}, {3.8836038957971487`*^9, 
  3.8836039124955177`*^9}},ExpressionUUID->"cc101b1a-b3d1-42f5-9395-\
26f4a54f9d79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ListToSymmetricMatrix", "[", "list_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", "=", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"8", " ", 
            RowBox[{"Length", "[", "list", "]"}]}]}]]}], ")"}]}]}], "}"}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"IntegerQ", "[", "m", "]"}], ",", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2", ",", "m"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"y", ",", " ", "1", ",", " ", 
                RowBox[{"x", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], 
          "->", " ", "list"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<Dimensions incorrect for restoration to symmetric \
matrix\>\"", "]"}], ";", " ", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.871864809863283*^9, 3.871864957302676*^9}, {
   3.87186499729932*^9, 3.87186502277293*^9}, 3.87186505820753*^9, {
   3.871865301406657*^9, 3.871865364283741*^9}, {3.871904343534956*^9, 
   3.871904348161562*^9}, 3.871905182960773*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[52]:=",ExpressionUUID->"35f65701-5d51-426e-8de8-922c4758fad3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MatpacDN ", "Subsubsection",
 CellChangeTimes->{{3.8786755734628143`*^9, 
  3.878675582297401*^9}},ExpressionUUID->"0613f1fe-c833-41b4-8a32-\
28dfb8730b02"],

Cell[TextData[{
 "The denominator in ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"Total", "/@", 
    RowBox[{"Transpose", "[", 
     RowBox[{"matpac", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}]}], 
   RowBox[{"Mean", "[", 
    RowBox[{"Total", "/@", 
     RowBox[{"Transpose", "[", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]]],
  CellChangeTimes->{{3.8786755955687227`*^9, 3.878675620347714*^9}, {
   3.8786756505430193`*^9, 3.8786756561306467`*^9}, {3.87867584044376*^9, 
   3.8786758510909567`*^9}},
  Background->RGBColor[1, 1, 0],ExpressionUUID->
  "3cae0dc4-3999-491c-9ffa-945adadb3e29"],
 " is the average number of UMI per cell.  The numerator is a list of the UMI \
in each of the cells.  Thus the ratio ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"Total", "/@", 
    RowBox[{"Transpose", "[", 
     RowBox[{"matpac", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}]}], 
   RowBox[{"Mean", "[", 
    RowBox[{"Total", "/@", 
     RowBox[{"Transpose", "[", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]]],
  CellChangeTimes->{{3.8786755955687227`*^9, 3.878675620347714*^9}, {
   3.8786756505430193`*^9, 3.8786756561306467`*^9}, {3.87867584044376*^9, 
   3.8786758510909567`*^9}},
  Background->RGBColor[1, 1, 0],ExpressionUUID->
  "296aba84-b644-4219-9d72-afd904d9196a"],
 "is the relative number of UMI per cell, relative to the average.  We invert \
this so that we can multiple gene expression values by it rather than divide. \
 We table it many times, so we can use it to multiply a matrix of gene \
expression values, each vector being multiplied by the same vector.  \n\n So \
in the end we are scaling each gene expression value to the relative total \
UMI in that cell.  "
}], "Text",
 CellChangeTimes->{{3.888838237818367*^9, 
  3.888838455249196*^9}},ExpressionUUID->"9f759b02-d12a-441f-938b-\
0e8736a91fe0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatpacDN", "[", "matpac_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"scalingmatrix", " ", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"N", "[", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"Total", "/@", 
              RowBox[{"Transpose", "[", 
               RowBox[{"matpac", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], 
             RowBox[{"Mean", "[", 
              RowBox[{"Total", "/@", 
               RowBox[{"Transpose", "[", 
                RowBox[{"matpac", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]], ")"}], 
           RowBox[{"-", "1"}]], "]"}], "]"}], ",", 
        RowBox[{"Length", "[", 
         RowBox[{"matpac", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], " ", "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{"matpac", ",", " ", 
      RowBox[{"1", "->", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"scalingmatrix", "*", 
          RowBox[{"matpac", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"Dimensions", "[", 
          RowBox[{"matpac", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8786755955687227`*^9, 3.878675620347714*^9}, {
  3.8786756505430193`*^9, 3.8786756561306467`*^9}, {3.87867584044376*^9, 
  3.8786758510909567`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[53]:=",ExpressionUUID->"f5c710d4-16f1-48e9-b7f3-b0a1d0305808"]
}, Open  ]],

Cell[CellGroupData[{

Cell["PseudocountsFromResiduals", "Subsubsection",
 CellChangeTimes->{{3.9637698242597237`*^9, 3.963769856901765*^9}, 
   3.963770011335161*^9},ExpressionUUID->"2a166917-5244-4a3d-b79e-\
27577e6c2091"],

Cell[TextData[{
 "To convert a residuals matrix back to something that resembles normalized \
counts, we use the following formula:\n\npseudomatrix[[i,j]]  = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"residual", "[", 
     RowBox[{"[", 
      RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
    SqrtBox[
     SubscriptBox["\[Mu]", "j"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c081e41d-1574-4f57-ac4b-7a438e0da95d"],
 "  + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "j"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ad65d752-3f1e-47f3-8346-aa9f31f8702f"],
 "  where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "j"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "db655b25-8159-4640-87a8-fa5703effc1f"],
 " is the mean of the counts for gene j.  If an entry of the pseudomatrix \
comes out to be less then or equal to -1, we convert it to -1+",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d0c611bc-d837-4713-ba9f-808c9d02e6bd"],
 ", so that when we try to do a Log[1+x] transformation there will be no \
negative numbers.  For efficiency we do this using BoolEval to create a \
matrix that has zeros everywhere except where the value is less than or equal \
to -1.  Subtracting from 1 inverts the matrix to put zeros only in places \
where the value is less than or equal to -1, and we multiply by that to zero \
out those positions.  Then we add ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], ")"}]],
  CellChangeTimes->{{3.963770018363289*^9, 3.963770102801229*^9}, {
    3.963770364333222*^9, 3.963770377923771*^9}, {3.963770416332884*^9, 
    3.963770574050742*^9}, {3.9637706705338306`*^9, 3.963770674784546*^9}, {
    3.963770710680273*^9, 3.96377071449463*^9}, 3.9637708787197523`*^9, {
    3.96377195473034*^9, 3.963771972936536*^9}, {3.963772526599925*^9, 
    3.963772561219486*^9}, {3.963772631478745*^9, 3.9637727021685667`*^9}, {
    3.963772826088924*^9, 3.963772831461048*^9}, {3.963772896006678*^9, 
    3.963772917669671*^9}, {3.963772988564262*^9, 3.963772988958898*^9}, {
    3.963773372783915*^9, 3.963773420022994*^9}, {3.963773533943047*^9, 
    3.963773539752603*^9}},
  Background->None,ExpressionUUID->"5fb19664-90de-4953-add9-a221887e3299"],
 "times the Boolean matrix.  "
}], "Text",
 CellChangeTimes->{{3.963769832465013*^9, 3.963770001885139*^9}, {
  3.9637705815120153`*^9, 3.9637705874339933`*^9}, {3.963770633320505*^9, 
  3.963770641456208*^9}, {3.9637706956422367`*^9, 3.9637706989355803`*^9}, {
