Cell[CellGroupData[{

Cell["ConnectedGenes", "Subsubsection",
 CellChangeTimes->{{3.8840979373277273`*^9, 
  3.884097939682786*^9}},ExpressionUUID->"389263b2-1a33-4960-9c18-\
3526b94a2dbb"],

Cell["\<\
Given a gNO and a list of genes (or several lists of genes--which it will \
automatically flatten), it returns the connected components.  \
\>", "Text",
 CellChangeTimes->{{3.8840979509466763`*^9, 3.884097976210782*^9}, {
  3.8840981215614557`*^9, 
  3.8840981220850143`*^9}},ExpressionUUID->"a161461c-4c24-4e97-b794-\
8d008466743b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConnectedGenes", "[", 
   RowBox[{"gNO_", ",", " ", "genes_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hits", " ", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gNO", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", "#"}], "]"}], "&"}], "/@", 
        RowBox[{"Flatten", "[", "genes", "]"}]}], "]"}]}], " ", "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"graph", "=", 
        RowBox[{"UndirectedGraph", "[", 
         RowBox[{"AdjacencyGraph", "[", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "hits", ",", "hits"}], "]"}], "]"}], "]"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ConnectedComponents", "[", "graph", "]"}], "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "hits", "]"}], "]"}], "->", 
         RowBox[{"gNO", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "hits"}], "]"}], "]"}]}], " ", "]"}]}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.884097316670302*^9, 3.884097445626955*^9}, {
  3.8840974943928423`*^9, 3.884097578651505*^9}, {3.884097653882538*^9, 
  3.8840976929924383`*^9}, {3.8840977592882757`*^9, 3.884097764098895*^9}, {
  3.884097910702105*^9, 3.884097916290975*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[96]:=",ExpressionUUID->"4102b8a5-0b1a-441c-bdbb-a27e168029b2"]
}, Closed]],

Cell[CellGroupData[{

Cell["SingleCommmunityGraph", "Subsubsection",
 CellChangeTimes->{
  3.833306413510427*^9},ExpressionUUID->"9d1490fc-7318-4753-ad49-\
69a0f2bbca30"],

Cell["\<\
The second and third versions of this code scale the sizes of the vertices \
according to the sqrt of the mean expression level of the gene.  To use it, \
one needs to input not just a NetObject, and a community (list of genes) but \
also a dataset in which rows are genes and columns represent some group over \
which the mean was taken.  The name (as text) of that group is entered as the \
final argument in the function.  If there is only one column in the \
expression data set, then one just omits the expressiondsgroup slot from the \
function, and it implements the second rather than the third version of the \
code.
Options associated with this function include re-coloring the Positive and \
Negative edges (setting the option to White removes the edges), and \
specifying a list of genes to highlight.  Note that the sublist need not be \
limited to genes in the community; the code will automatically identify which \
members of the list are in the community and highlight those.  \
\>", "Text",
 CellChangeTimes->{{3.833904281396592*^9, 3.8339043929976263`*^9}, {
  3.83483803487368*^9, 3.834838163747816*^9}, {3.840464762089773*^9, 
  3.840464846412176*^9}},ExpressionUUID->"ebbb82a5-7290-4d97-a232-\
ba7191eb73e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SingleCommmunityGraph", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Layout\>\"", "\[Rule]", " ", "Automatic"}], ",", " ", 
     RowBox[{"\"\<Positive\>\"", "\[Rule]", " ", "Green"}], ",", " ", 
     RowBox[{"\"\<Negative\>\"", "\[Rule]", " ", "Red"}], ",", " ", 
     RowBox[{"\"\<Highlight\>\"", "\[Rule]", " ", 
      RowBox[{"{", "}"}]}], ",", " ", 
     RowBox[{"\"\<Suppress\>\"", "\[Rule]", " ", "\"\<None\>\""}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.834790973765787*^9, 3.834790996336072*^9}, {
  3.8348340485682507`*^9, 3.834834058192576*^9}, {3.841598091817236*^9, 
  3.841598108156254*^9}, {3.841603021137211*^9, 3.8416030371303387`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[97]:=",ExpressionUUID->"b4e36615-442f-44f1-bfec-e1a4290eec4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SingleCommmunityGraph", "[", 
   RowBox[{"gNetObj_", ",", " ", "com_", " ", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "hls", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hls", " ", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Highlight\>\"", "]"}], "\[Equal]", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"com", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{"Intersection", "[", 
           RowBox[{"com", ",", 
            RowBox[{"OptionValue", "[", "\"\<Highlight\>\"", "]"}]}], "]"}]}],
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AdjacencyGraph", "[", 
      RowBox[{
       RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
        RowBox[{"1", ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"gNetObj", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "#"}], "]"}], "&"}], 
           "/@", "com"}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"gNetObj", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "#"}], "]"}], "&"}], 
           "/@", "com"}], "]"}]}], "\[RightDoubleBracket]"}], ",", 
       RowBox[{"GraphLayout", "\[Rule]", 
        RowBox[{"OptionValue", "[", "\"\<Layout\>\"", "]"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"DirectedEdges", "\[Rule]", "False"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"VertexLabels", "\[Rule]", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "com", "]"}], "]"}], "\[Rule]", " ", 
          "com"}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{"VertexLabelStyle", "\[Rule]", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[Rule]", 
             RowBox[{"Directive", "[", 
              RowBox[{"Blue", ",", " ", "Larger"}], "]"}]}], "&"}], "/@", 
           "hls"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[Rule]", "Automatic"}], "&"}], "/@", " ", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "com", "]"}], "]"}], ",", "hls"}], 
            "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"VertexStyle", "\[Rule]", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[Rule]", " ", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"EdgeForm", "[", "None", "]"}], ",", "Yellow"}], 
              "]"}]}], "&"}], "/@", "hls"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[Rule]", " ", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"EdgeForm", "[", "None", "]"}], ",", "Blue", ",", 
               RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}]}], "&"}], "/@", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "com", "]"}], "]"}], ",", "hls"}], 
            "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"EdgeStyle", "\[Rule]", " ", "Thin"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"VertexSize", "\[Rule]", "Tiny"}], ",", 
       RowBox[{"VertexShapeFunction", "\[Rule]", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[Rule]", " ", "\"\<Square\>\""}], "&"}], "/@", 
           "hls"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[Rule]", " ", "Automatic"}], "&"}], "/@", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "com", "]"}], "]"}], ",", "hls"}], 
            "]"}]}]}], "]"}]}]}], " ", "]"}]}]}], " ", "]"}]}]], "Input",
 CellChangeTimes->{{3.8333059995031567`*^9, 3.8333060234823017`*^9}, {
