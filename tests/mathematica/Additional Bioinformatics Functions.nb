Cell[CellGroupData[{

Cell["FindGroups and FindGroupsAbove", "Subsubsection",
 CellChangeTimes->{{3.848666748834708*^9, 3.848666758275297*^9}, {
  3.848670065525051*^9, 
  3.848670072287191*^9}},ExpressionUUID->"fcf0abb0-8076-4ecc-8072-\
2bf58e9e1a1b"],

Cell[TextData[{
 "This code takes as input a set of pairs of coordinates representing genes, \
as might be output in a gNetworkObject.  It then identifies all connected \
coordinates, that is all groups that are connected to each other and \
disconnected from everything else.  It then retrieves only those of a \
specified length.  and a specified number of edges.  This code will only find \
those with ",
 StyleBox["exactly",
  FontSlant->"Italic"],
 " the specified length and edges.  However, our sets of pairlists will \
usually stop at some set of length, e.g. 6, meaning that groups with more \
than that number of links won\[CloseCurlyQuote]t be kept.  Even if we don\
\[CloseCurlyQuote]t explicitly generate pairlists for lengths above that, we \
know that the PCC cutoffs for those won\[CloseCurlyQuote]t be any more \
stringent, as PCC cutoffs always get smaller as one increases the group \
length.  Thus, we have an alternate form for when we want to talk all lengths \
above a cutoff as well"
}], "Text",
 CellChangeTimes->{{3.848666760482053*^9, 3.84866676102275*^9}, {
  3.848666792957327*^9, 3.848666830807213*^9}, {3.848666877649662*^9, 
  3.8486670063121433`*^9}, {3.848667042146964*^9, 3.848667044838855*^9}, {
  3.848667475504346*^9, 3.8486674904767942`*^9}, {3.848668808200436*^9, 
  3.848668808463771*^9}, {3.8486693774495687`*^9, 3.8486694096101503`*^9}, {
  3.848669492896673*^9, 3.848669520522616*^9}, {3.848669587201043*^9, 
  3.848669591481605*^9}, {3.848669637426038*^9, 3.848669703865408*^9}, {
  3.848669765973576*^9, 3.848669775624366*^9}, {3.848669896109166*^9, 
  3.8486699130776997`*^9}},ExpressionUUID->"d8740dbc-fbb2-42d5-a1f4-\
8967073daf5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindGroups", "[", 
   RowBox[{"pairlist_", ",", " ", 
    RowBox[{"{", 
     RowBox[{"length_", ",", " ", "edges_"}], "}"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"cc", ",", " ", "ccl", ",", " ", "ccle", ",", " ", "cclx"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cc", "=", 
      RowBox[{"ConnectedComponents", "[", 
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", "/.", 
            RowBox[{"List", "\[Rule]", " ", "UndirectedEdge"}]}], ")"}], 
          "&"}], "/@", "pairlist"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ccl", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"cc", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "\[Equal]", "length"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccle", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ReverseSort", "/@", 
         RowBox[{"Subsets", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], "&"}], "/@", "ccl"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cclx", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Intersection", "[", 
             RowBox[{"pairlist", ",", "#"}], "]"}], "&"}], "/@", "ccle"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "\[Equal]", " ", "edges"}], 
           "&"}]}], "]"}], ",", "1"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8486674935646343`*^9, 3.848667660779368*^9}, {
  3.8486677494828176`*^9, 3.848667784391632*^9}, {3.848667867019299*^9, 
  3.848667884377884*^9}, {3.848667986735252*^9, 3.848668047868258*^9}, {
  3.84866811368265*^9, 3.848668148265294*^9}, {3.848668198010538*^9, 
  3.848668237781454*^9}, {3.848668457985787*^9, 3.848668471940027*^9}, {
  3.848668523802243*^9, 3.8486685285902557`*^9}, {3.848668597375214*^9, 
  3.84866874796301*^9}, {3.8486687909705772`*^9, 3.8486688400509644`*^9}, {
  3.848668916259609*^9, 3.848668920567093*^9}, {3.848669153802313*^9, 
  3.848669178388681*^9}, {3.848669209173832*^9, 3.8486692132824183`*^9}, {
  3.8486692495455923`*^9, 3.8486692524921713`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[87]:=",ExpressionUUID->"50b9ce4b-4a6b-48a7-9e0f-baaf7434f969"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindGroupsAbove", "[", 
   RowBox[{"pairlist_", ",", " ", 
    RowBox[{"{", 
     RowBox[{"length_", ",", " ", "edges_"}], "}"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"cc", ",", " ", "ccl", ",", " ", "ccle", ",", " ", "cclx"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cc", "=", 
      RowBox[{"ConnectedComponents", "[", 
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", "/.", 
            RowBox[{"List", "\[Rule]", " ", "UndirectedEdge"}]}], ")"}], 
          "&"}], "/@", "pairlist"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ccl", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"cc", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "\[GreaterEqual]", " ", 
          "length"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccle", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ReverseSort", "/@", 
         RowBox[{"Subsets", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], "&"}], "/@", "ccl"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cclx", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Intersection", "[", 
             RowBox[{"pairlist", ",", "#"}], "]"}], "&"}], "/@", "ccle"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "\[Equal]", " ", "edges"}], 
           "&"}]}], "]"}], ",", "1"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.848670043810828*^9, 3.8486700543315487`*^9}},
