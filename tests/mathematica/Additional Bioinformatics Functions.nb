NwPRe/+rWoHoYqt3DiA6X6fDDUQ/2HXTHURbHVrXCqJFfr1sA9EXVqV3g+j2
3+k9IDroQuhEEH2jZtJiEO2h9f0kiN5m/vI0iD6VE/8VRK9mLfwGoo9sWC2/
Ekj3PJdSB9EzfNTNQfSZzBsVIPrL3feNINqLR7odRL9i1+kF0XPObpgCogEP
ysZ8
  "],ExpressionUUID->"a1e5f4ea-cd6f-4ae7-87ac-e5fe6b6f4b76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HCG", "[", 
   RowBox[{
   "gno_", ",", " ", "coms_", ",", "minlength_", ",", " ", "target_"}], "]"}],
   ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "sortedlist", ",", " ", "selections"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"selections", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sortedlist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"First", "/@", 
          RowBox[{"ReverseSortBy", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"#", "->", 
              RowBox[{"DegreeCentrality", "[", 
               RowBox[{"AdjacencyGraph", "[", 
                RowBox[{"gno", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"gno", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], 
                    "/@", "#"}], "]"}], ",", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"gno", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], 
                    "/@", "#"}], "]"}]}], "]"}], "]"}], "]"}], "]"}]}], "]"}],
             ",", "Last"}], "]"}]}], ")"}], "&"}], "/@", 
       RowBox[{"Select", "[", 
        RowBox[{"coms", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], ">=", "minlength"}], "&"}]}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Flatten", "[", "sortedlist", "]"}], "]"}], "<=", " ", 
        "target"}], ",", 
       RowBox[{"selections", "=", 
        RowBox[{"Flatten", "[", "sortedlist", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"Ceiling", "[", 
           FractionBox["target", 
            RowBox[{"Length", "[", "sortedlist", "]"}]], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Length", "[", "selections", "]"}], "<", "target"}], ",", 
         RowBox[{"t", "++"}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{"selections", "=", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Take", "[", 
              RowBox[{"#", ",", 
               RowBox[{"UpTo", "[", "t", "]"}]}], "]"}], "&"}], "/@", 
            "sortedlist"}], "]"}]}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "selections", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.878501989656289*^9, 3.878502140394291*^9}, {
   3.878502171026663*^9, 3.878502297405438*^9}, {3.87850244095944*^9, 
   3.878502605522993*^9}, {3.87850264672596*^9, 3.878502647199285*^9}, {
   3.8785026814861307`*^9, 3.878502716722958*^9}, {3.878502775703992*^9, 
   3.878502780610148*^9}, {3.8785030500827503`*^9, 3.878503172355714*^9}, {
   3.878503281443206*^9, 3.8785032829208593`*^9}, {3.878503318993685*^9, 
   3.878503487327908*^9}, {3.878503546667737*^9, 3.878503548188249*^9}, {
   3.8785036054472923`*^9, 3.878503645682654*^9}, {3.878503678985735*^9, 
   3.878503683501198*^9}, {3.87850377060926*^9, 3.878503779891152*^9}, {
   3.878503868613881*^9, 3.878503888419333*^9}, 3.878504085296674*^9, {
   3.8785044755003233`*^9, 3.878504543453649*^9}, {3.878504607924654*^9, 
   3.8785046411022997`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[177]:=",ExpressionUUID->"a17f741a-cee9-42c4-8455-a4be21445282"]
}, Closed]],

Cell[CellGroupData[{

Cell["HBG (High betweenness genes)", "Subsubsection",
 CellChangeTimes->{{3.878504690208515*^9, 3.878504691971436*^9}, {
  3.8785055556082687`*^9, 3.8785055606577177`*^9}, {3.879429671505556*^9, 
  3.879429677031653*^9}},ExpressionUUID->"3be5f1d8-248a-42d6-b860-\
7b7224b9b696"],

Cell[TextData[{
 "These are genes which, by correlations, have high betweenness centrality.  \
This can\[CloseCurlyQuote]t be done at the community level.  \n\n",
 StyleBox["Target",
  FontSlant->"Italic"],
 " sets a goal for the maximum number of high betweenness genes we want to \
find.  "
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQrRjFp/j1yRvHtZUC2iBaRTXVGkS32FnbgWiBJU4+
