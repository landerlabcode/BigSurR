         RowBox[{
          RowBox[{
           RowBox[{"Placed", "[", 
            RowBox[{"#", ",", "Center"}], "]"}], "&"}], "/@", 
          RowBox[{"gno", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
