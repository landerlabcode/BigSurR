      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "-", 
            RowBox[{"Length", "[", "data", "]"}], "-", "1"}], ")"}], "#"}], 
         "&"}], ",", 
