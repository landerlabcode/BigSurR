Cell[CellGroupData[{

Cell["GenesByCutoff", "Subsubsection",
 CellChangeTimes->{
  3.8832983072861156`*^9},ExpressionUUID->"e5d6a279-eda4-4d21-baa9-\
a8c84bd9b739"],

Cell["\<\
This uses the same Manipulate structure as NewPlot, but just returns a list \
of genes that meet the criteria.  The two criteria are (1) Positive Only = \
Don\[CloseCurlyQuote]t include genes that have ONLY negative links; (2) \
cutoff = only include genes involved in links with PCC greater than the \
cutoff.  As with NewPlot, the cutoff choices have been preselected based on \
10 quantiles covering the range of PCCs in the input data\
\>", "Text",
 CellChangeTimes->{{3.883298322037636*^9, 
  3.8832984370801992`*^9}},ExpressionUUID->"7b691ed5-c993-4c42-be0c-\
173b1b2b3027"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GenesByCutoff", "[", 
   RowBox[{"gNO_", ",", " ", "genes_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{
        RowBox[{"GeneSubsetGNO", "[", 
         RowBox[{"gNO", ",", " ", 
          RowBox[{"Flatten", "[", "genes", "]"}]}], "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"geneset", "=", 
       RowBox[{
        RowBox[{"GeneSubsetGNO", "[", 
         RowBox[{"gNO", ",", " ", 
          RowBox[{"Flatten", "[", "genes", "]"}]}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q", "=", 
        RowBox[{"Quantile", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"mat", "[", "\"\<ExplicitValues\>\"", "]"}], "]"}], ",", 
          RowBox[{"Reverse", "[", 
           RowBox[{"Table", "[", 
            RowBox[{"i", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", "0.9", ",", " ", "0.1"}], 
              "}"}]}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Manipulate", "[", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"geneset", "[", 
          RowBox[{"[", 
           RowBox[{"Union", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"SparseArray", "[", 
               RowBox[{
                RowBox[{"BoolEval", "[", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{"positiveOnly", ",", "mat", ",", 
                    RowBox[{"Abs", "[", "mat", "]"}]}], "]"}], ">", 
                  "cutoff"}], "]"}], "*", "mat"}], "]"}], 
              "[", "\"\<ExplicitPositions\>\"", "]"}], "]"}], "]"}], "]"}], 
          "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"cutoff", ",", " ", "q"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"positiveOnly", ",", " ", 
          RowBox[{"{", 
           RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}]}], "]"}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8832979950462713`*^9, 3.8832980278594637`*^9}, {
  3.883298199993572*^9, 3.883298202813355*^9}},
