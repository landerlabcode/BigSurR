Cell[CellGroupData[{

Cell["GeneSetMatchFrequency", "Subsubsection",
 CellChangeTimes->{
  3.8836529839752073`*^9, {3.8836540583466597`*^9, 
   3.8836540599106207`*^9}},ExpressionUUID->"1e5dd1af-ae8a-4aa0-a09b-\
f445c2c995d5"],

Cell["\<\
The purpose of this code is to take a list of genes and compare them to a \
database of curated \[OpenCurlyDoubleQuote]genesets\[CloseCurlyDoubleQuote], \
returning those with the greatest overlap.  

To run this code we need four things:
1.  A database consisting a sparse matrix.  Rows are genes, columns are \
genesets.  \
\[OpenCurlyDoubleQuote]1\[CloseCurlyDoubleQuote]\[CloseCurlyQuote]s occur \
wherever a gene is found in a geneset.
2.  A dispatch table \[OpenCurlyDoubleQuote]genepositions\
\[CloseCurlyDoubleQuote] that maps gene names to their correct row in the \
matrix
3.  A dispatch table \[OpenCurlyDoubleQuote]setpositions\
\[CloseCurlyDoubleQuote] that maps column numbers in the matrix to their \
correct geneset names
4.  A dispatch table \[OpenCurlyDoubleQuote]setsize\[CloseCurlyDoubleQuote] \
that maps column numbers in the matrix to the the lengths of those genesets
The result is a list of geneset names and the fraction of those names that \
are found in our input gene list.  
In addition we use a \[OpenCurlyDoubleQuote]cutoff\[CloseCurlyDoubleQuote] so \
that we only display the names of genesets that have a least a certain \
fraction of their genes in the gene list.  
\tN.B we will modify the cutoff to reject not only genes where the fraction \
of the list isn\[CloseCurlyQuote]t above cutoff, but also where only a single \
gene is hit.  That way we eliminate gene sets which are small, and may thus \
pass the cutoff, but where there\[CloseCurlyQuote]s only one hit.  

Note that the code starts by tossing out any genes that are in our list but \
not in any of the datasets (using NumberQ)

For the 11,118  genesets found in MSigDB collections H, C2, C3, C4, C6, we \
have already generated the datamatrix, genepositions, setpositions and \
setsizes, and stored these in 
/Users/arthurlander/Documents/RESEARCH/Bioinformatics Resources/Lists of \
Genes by Category/Broad GSEA sets/MSigDB Human Gene Sets raw data/

under the names:
\[OpenCurlyDoubleQuote]msigDBmat.mx\[CloseCurlyDoubleQuote]
\[OpenCurlyDoubleQuote]genepositionsDispatch.mx\[CloseCurlyDoubleQuote]
\[OpenCurlyDoubleQuote]setpositionsDispatch.mx\[CloseCurlyDoubleQuote]
\[OpenCurlyDoubleQuote]setsizesDispatch.mx\[CloseCurlyDoubleQuote]

respectively, so one needs only import these files to run the code.
For more information on how these files were generated, see the notebook
/Users/arthurlander/Documents/RESEARCH/Bioinformatics Resources/Lists of \
Genes by Category/Broad GSEA sets/MSigDB Human Gene Sets raw data/Merging \
MSigDB Datasets.nb
\
\>", "Text",
 CellChangeTimes->{{3.8836524785588627`*^9, 3.883652830757057*^9}, {
  3.8836528674416647`*^9, 3.883653077734734*^9}, {3.883834467947612*^9, 
  3.883834527671548*^9}},ExpressionUUID->"e6f2cf7b-ede7-489e-8c6a-\
b6b527757394"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneSetMatchFrequency", "[", 
   RowBox[{
   "genelist_", ",", " ", "datamatrix_", ",", " ", "genepositions_", ",", " ",
     "setpositions_", ",", "setsizes_", ",", " ", "cutoff_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"results1", ",", " ", "results2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"results1", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Tally", "[", 
         RowBox[{"Last", "/@", 
          RowBox[{
           RowBox[{"datamatrix", "[", 
            RowBox[{"[", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"genelist", "/.", "genepositions"}], ",", " ", 
               "NumberQ"}], "]"}], "]"}], "]"}], 
           "[", "\"\<ExplicitPositions\>\"", "]"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Last", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"results2", " ", "=", " ", 
      RowBox[{"ReverseSortBy", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"First", "/@", "results1"}], "/.", "setpositions"}], 
           ")"}], "->", 
          RowBox[{"N", "[", 
           FractionBox[
            RowBox[{"Last", "/@", "results1"}], 
            RowBox[{
             RowBox[{"First", "/@", "results1"}], "/.", "setsizes"}]], 
           "]"}]}], "]"}], ",", "Last"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Select", "[", 
      RowBox[{"results2", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "[", "#", "]"}], ">=", "cutoff"}], "&"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.883651968198526*^9, 3.8836522389545794`*^9}, {
   3.883652561279684*^9, 3.883652590289091*^9}, 3.8836540634698153`*^9, {
   3.883834540633986*^9, 3.883834558496148*^9}, {3.8838346094288893`*^9, 
   3.8838346371956778`*^9}, {3.8838486704345293`*^9, 3.883848695643305*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[256]:=",ExpressionUUID->"c1464688-32ab-44b2-81f9-f43c4d56354e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneSetMatches", "Subsubsection",
 CellChangeTimes->{
  3.8836529839752073`*^9, {3.8836540583466597`*^9, 3.8836540599106207`*^9}, {
   3.883655961182816*^9, 
   3.883655961369609*^9}},ExpressionUUID->"395acdcf-6993-45f7-a698-\
bd192eb94cac"],

Cell["\<\
Next we want to write a code that, given a particular geneset, gives us the \
names of the matching genes.  It uses the same inputs as GeneSetMatchFrequency\
\>", "Text",
 CellChangeTimes->{{3.8836540812353573`*^9, 3.883654104648054*^9}, {
  3.883655977834259*^9, 
  3.8836559885401793`*^9}},ExpressionUUID->"2d1647aa-ec79-476b-a7e9-\
266c1d271da2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeneSetMatches", "[", 
   RowBox[{
   "genelist_", ",", "genesetname_", ",", " ", "datamatrix_", ",", " ", 
    "genepositions_", ",", " ", "setpositions_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"column", "=", 
      RowBox[{"genesetname", "/.", 
       RowBox[{"(", 
        RowBox[{"Reverse", "/@", 
         RowBox[{"Normal", "[", "setpositions", "]"}]}], ")"}]}]}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Intersection", "[", 
      RowBox[{"genelist", ",", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"datamatrix", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "column"}], "]"}], "]"}], 
          "[", "\"\<ExplicitPositions\>\"", "]"}], "]"}], "/.", 
        RowBox[{"(", 
         RowBox[{"Reverse", "/@", 
          RowBox[{"Normal", "[", "genepositions", "]"}]}], ")"}]}]}], "]"}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8836541130024157`*^9, 3.883654176035285*^9}, {
   3.8836543913235292`*^9, 3.883654464770406*^9}, {3.883654508582387*^9, 
   3.883654622922543*^9}, {3.8836547119570827`*^9, 3.883654720021462*^9}, {
   3.883654919560755*^9, 3.883654924322793*^9}, {3.883655132659684*^9, 
   3.8836551683382597`*^9}, 3.8836554602393208`*^9, {3.8836554916493597`*^9, 
   3.883655550140938*^9}, {3.88365560463301*^9, 3.883655619938476*^9}, {
   3.88365567174631*^9, 3.883655675663237*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[257]:=",ExpressionUUID->"300500d8-6494-4b6b-9c68-506790ffd913"]
}, Open  ]],

