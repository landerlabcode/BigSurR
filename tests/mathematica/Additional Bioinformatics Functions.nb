}, Closed]],

Cell[CellGroupData[{

Cell["Useful Hacks", "Subsection",
 CellChangeTimes->{{3.83501330969412*^9, 
  3.835013314698058*^9}},ExpressionUUID->"1887192e-088e-4552-82ba-\
9af182cb0f38"],

Cell[CellGroupData[{

Cell["Inheriting Options from One Function to Another", "Subsubsection",
 CellChangeTimes->{{3.8350137573905363`*^9, 3.835013765076152*^9}, {
  3.8350138236094437`*^9, 
  3.83501383012786*^9}},ExpressionUUID->"24c793a3-9c3c-4dfd-bef8-\
8e94ebe78ddf"],

Cell["\<\
To set up options for a new function so that it acquires the options of a \
function it calls:
Begin by writing your options definition this way, joining the options of \
your function (in this case Top->10) with the options of an existing \
function, in this case, the function Plot\
\>", "Text",
 CellChangeTimes->{{3.835013325998362*^9, 3.8350133987465897`*^9}, {
  3.835013520106451*^9, 
  3.835013530825289*^9}},ExpressionUUID->"ab891eda-b554-403b-aaf4-\
c0b098834230"],

Cell["\tOptions[Func] = Join[{Top -> 10}, Options[Plot]]; ", "Text",
 CellChangeTimes->{{3.8350135094491262`*^9, 3.835013510125135*^9}, {
  3.835013792766552*^9, 
  3.835013809381091*^9}},ExpressionUUID->"f1f48f96-58b1-480d-a60f-\
52e1a24d7275"],

Cell["\<\
Next, if you want to alter the default settings for any of the inherited \
options, you can, this way; this statement is optional.\
\>", "Text",
 CellChangeTimes->{{3.835013453892095*^9, 3.835013471662588*^9}, {
  3.8350135408323927`*^9, 
  3.835013546673108*^9}},ExpressionUUID->"b81e9238-4be4-4084-b719-\
aa12bfff16b8"],

Cell["\tSetOptions[Func, {PlotRange -> All, PlotStyle -> Red}];", "Text",
 CellChangeTimes->{{3.8350135125677*^9, 3.835013513220965*^9}, {
  3.835013795896706*^9, 
  3.835013810602257*^9}},ExpressionUUID->"14eb2c4c-daed-4f58-b5c8-\
56c9a6c3d3df"],

Cell["\<\
Finally, in the definition of your function, you want to use this syntax\
\>", "Text",
 CellChangeTimes->{{3.8350135596843843`*^9, 
  3.835013568854113*^9}},ExpressionUUID->"a88209bb-87af-44f8-ace9-\
8b1727c818dd"],

Cell["\<\
\tFunc[f_, opt : OptionsPattern[]] :=
\t\t Plot[f[x], {x, 0, OptionValue[Top]},
\t\t  Evaluate@FilterRules[Join[{opt}, Options[Func]], Options[Plot]]]
\
\>", "Text",
 CellChangeTimes->{{3.835012762104507*^9, 3.835012768792738*^9}, {
  3.835013578018365*^9, 3.835013600477531*^9}, {3.8350137985304737`*^9, 
  3.835013813766573*^9}},ExpressionUUID->"108264d8-fb55-49e5-b010-\
51a93d3a91bf"],

Cell["\<\
the final statement in the above, that begins with \
\[OpenCurlyDoubleQuote]Evaluate\[CloseCurlyDoubleQuote] sits in the location \
within Plot where Plot would normally take options.  The Evaluate statement \
places there just those options that are ones you have called, and that are \
found among the options available to Plot.  \
\>", "Text",
 CellChangeTimes->{{3.835013607492118*^9, 3.8350136194506474`*^9}, {
  3.835013674530987*^9, 
  3.835013749784855*^9}},ExpressionUUID->"e2decdb9-8eff-4370-90a7-\
0f3bac06a78a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Inheriting Metadata from One function to Another", "Subsubsection",
 CellChangeTimes->{{3.835013832688715*^9, 
  3.8350138461614647`*^9}},ExpressionUUID->"3f759d40-4d70-43a0-bdb2-\
c2522dd4036c"],

Cell["\<\
If we set up an output \
\[OpenCurlyDoubleQuote]myOutput\[CloseCurlyDoubleQuote] so that it appends a \
list of text items to its output in this format :\
\>", "Text",
 CellChangeTimes->{{3.835013862544409*^9, 3.835013901504087*^9}, {
  3.835013972125391*^9, 3.835013974689211*^9}, {3.835014014679894*^9, 
  3.835014030887745*^9}},ExpressionUUID->"f27c2380-0f63-4029-8b03-\
95dca709c2d2"],

Cell["\"Metadata\" -> list", "Text",
 CellChangeTimes->{{3.8350139039657307`*^9, 
  3.835013919556527*^9}},ExpressionUUID->"270386d6-ac80-417a-aff0-\
fcebd5ffef61"],

Cell["\<\
then a new function that takes that output as input can access that \
information as \
\[OpenCurlyDoubleQuote]Metadata\[CloseCurlyDoubleQuote]/.Last[myOutput], and \
just append it to the new output.  \
\>", "Text",
 CellChangeTimes->{{3.835013953039502*^9, 
  3.835014054743866*^9}},ExpressionUUID->"e232f21a-80f8-467f-a885-\
55818d4923ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Aborting on Messages", "Subsubsection",
 CellChangeTimes->{{3.885947762545858*^9, 
  3.8859477677874193`*^9}},ExpressionUUID->"371983c3-6944-4724-9630-\
141d91fd2ff7"],

Cell["\<\
You can call ResourceFunction[\"AbortOnMessage\"] anywhere within a \
computation . If it generates an abort, it has the same effect as an \
interactive interrupt in which you select the abort option . You can use \
ResourceFunction[\"AbortOnMessage\"] as an \"emergency stop\" in a \
computation as soon as the first message is printed . Once \
ResourceFunction[\"AbortOnMessage\"] has been called, Wolfram Language \
functions currently being evaluated return as quickly as possible . In an \
interactive session, the final result from an aborted computation is $Aborted \
. You can use CheckAbort to \"catch\" returns from an abort .\
\>", "Text",
 CellChangeTimes->{{3.885947923642517*^9, 
  3.885947926315858*^9}},ExpressionUUID->"57044918-1d83-41b6-9ca4-\
46cf488a7126"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"AbortOnMessage", " ", "//", " ", "ClearAll"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AbortOnMessage", " ", "//", " ", "Attributes"}], " ", "=", " ", 
   RowBox[{"{", " ", "HoldAllComplete", " ", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AbortOnMessage", "::", "invarg"}], " ", "=", 
    " ", "\"\<Invalid arguments\>\""}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AbortOnMessage", "[", " ", "eval_", "              ", "]"}], " ", 
   ":=", " ", 
   RowBox[{"AbortOnMessage", "[", " ", 
    RowBox[{"eval", ",", " ", "None"}], "        ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AbortOnMessage", "[", " ", 
    RowBox[{"eval_", ",", " ", "quiet_"}], "      ", "]"}], " ", ":=", " ", 
   RowBox[{"AbortOnMessage", "[", " ", 
    RowBox[{"eval", ",", " ", "quiet", ",", " ", "None"}], " ", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AbortOnMessage", "[", " ", 
     RowBox[{"eval_", ",", " ", "quiet_", ",", " ", "All"}], " ", "]"}], " ", 
    ":=", " ", 
    RowBox[{"AbortOnMessage", "[", " ", 
     RowBox[{"eval", ",", " ", "quiet", ",", " ", "_"}], "    ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AbortOnMessage", "[", " ", 
     RowBox[{"eval_", ",", " ", "quiet_", ",", " ", 
      RowBox[{"{", " ", "listen___", " ", "}"}]}], " ", "]"}], " ", ":=", 
    "\n", "  ", 
    RowBox[{"AbortOnMessage", "[", " ", 
     RowBox[{"eval", ",", " ", "quiet", ",", " ", 
      RowBox[{"Alternatives", " ", "@", " ", "listen"}]}], " ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AbortOnMessage", "[", " ", 
     RowBox[{"eval_", ",", " ", "quiet_", ",", " ", "listen_"}], " ", "]"}], 
    " ", ":=", "\n", "  ", 
    RowBox[{"If", "[", " ", 
     RowBox[{
      RowBox[{"FreeQ", "[", " ", 
       RowBox[{
        RowBox[{"Internal`Handlers", "[", " ", "\"\<Message\>\"", " ", "]"}], 
        ",", " ", "_msgAbort"}], " ", "]"}], ",", "\n", "      ", 
      RowBox[{"Internal`HandlerBlock", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"\"\<Message\>\"", ",", " ", 
          RowBox[{
           RowBox[{"msgAbort", "[", " ", 
            RowBox[{"listen", ",", " ", "##"}], " ", "]"}], " ", "&"}]}], " ",
          "}"}], ",", "\n", "                             ", 
        RowBox[{"Quiet", "[", " ", 
         RowBox[{"eval", ",", " ", "quiet"}], " ", "]"}]}], "\n", "      ", 
       "]"}], ",", "\n", "      ", "eval"}], "\n", "  ", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AbortOnMessage", "[", " ", "___", " ", "]"}], " ", ":=", " ", 
   RowBox[{"Null", " ", "/;", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Message", "[", 
       RowBox[{"AbortOnMessage", "::", "invarg"}], "]"}], ";", " ", "False"}],
      ")"}]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.773423186004115*^9, 3.7734231986147137`*^9}},
 CellLabel->"In[282]:=",
 CellID->128875146,ExpressionUUID->"67494b05-1eee-4175-a576-a2b1080395da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"msgAbort", " ", "//", " ", "ClearAll"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"msgAbort", " ", "//", " ", "Attributes"}], " ", "=", " ", 
    RowBox[{"{", " ", "HoldAllComplete", " ", "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"msgAbort", "[", " ", 
      RowBox[{"listen_", ",", " ", 
       RowBox[{"Hold", "[", " ", 
        RowBox[{
         RowBox[{"m", " ", ":", " ", 
          RowBox[{"Message", "[", " ", 
           RowBox[{"msg_", ",", " ", "___"}], " ", "]"}]}], ",", " ", 
         "False"}], " ", "]"}]}], " ", "]"}], " ", "/;", "\n", "  ", 
     RowBox[{"MatchQ", "[", " ", 
      RowBox[{
       RowBox[{"Unevaluated", " ", "@", " ", "msg"}], ",", " ", "listen"}], 
      " ", "]"}]}], " ", ":=", " ", "\n", "    ", 
    RowBox[{"Abort", "[", " ", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"msgAbort", "[", " ", 
    RowBox[{"_", ",", " ", 
     RowBox[{"Hold", "[", " ", 
      RowBox[{"msg_", ",", " ", "True"}], " ", "]"}]}], " ", "]"}], " ", ":=",
    " ", 
   RowBox[{"Abort", "[", " ", "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.7734231768994036`*^9, 3.7734232052815046`*^9}},
 CellLabel->"In[291]:=",
 CellID->71707868,ExpressionUUID->"bff1c934-49c2-4d6a-b487-ee264c32bc63"]
}, Open  ]]
}, Closed]]
}, Open  ]]
},
