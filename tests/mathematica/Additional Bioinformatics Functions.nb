Cell[CellGroupData[{

Cell["PullCorrelations", "Subsubsection",
 CellChangeTimes->{{3.835102173676107*^9, 
  3.835102175966251*^9}},ExpressionUUID->"3ad6218f-a292-4d86-92f6-\
0be8ed39f586"],

Cell["\<\
This function takes a gNetworkObject, and pulls out those correlations that \
correspond to a gene list, ignoring any genes not present in the \
gNetworkObject.  To facilitate comparisons between experiments, the output \
give the correlation rules in terms of the gene names, and not their \
positions.  Thus, to turn this back into a sparse matrix, the gene names \
should be assigned numbers equal to their position in the original gene list. \
 \
\>", "Text",
 CellChangeTimes->{{3.835102193205269*^9, 
  3.835102317768529*^9}},ExpressionUUID->"eed533d6-a74b-43e1-81d5-\
2dc2538fd171"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PullCorrelations", "[", 
   RowBox[{"gNObject_", ",", " ", "com_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hits", " ", ",", " ", "hitrules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hits", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gNObject", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "com"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"hitrules", " ", "=", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{"hits", "\[Rule]", " ", 
        RowBox[{"gNObject", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "hits"}], "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"MapAt", "[", 
         RowBox[{"Sort", ",", "#", ",", "1"}], "]"}], "&"}], "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"ArrayRules", "[", 
          RowBox[{"gNObject", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"ContainsAll", "[", 
           RowBox[{"hits", ",", " ", 
            RowBox[{"First", "[", "#", "]"}]}], "]"}], "&"}]}], "]"}]}], "/.",
       "hitrules"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.835102178831044*^9, 3.835102184768635*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[69]:=",ExpressionUUID->"57a0542f-0ad1-4646-8552-c67446cae697"]
}, Closed]],

Cell[CellGroupData[{

Cell["AggregationgNO", "Subsubsection",
 CellChangeTimes->{{3.852467946302712*^9, 
  3.852467949015027*^9}},ExpressionUUID->"301008b7-b2c2-4748-bc1f-\
5d3abf43d942"],

Cell["\<\
This code starts with a matpac, takes only those rows that pass a threshold \
of less than a certain fraction zeros, then calculates the PCCs and \
identifies only those genes-gene pairs that have a positive PCC exceeding a \
given threshold.  Then it creates a geneNetworkObejct with only those \
correlations in it.  \
\>", "Text",
 CellChangeTimes->{{3.852467953822362*^9, 
  3.852468096260119*^9}},ExpressionUUID->"7399dcc9-10a3-498a-a3e1-\
411b869d7d31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AggregationgNO", "[", 
   RowBox[{
   "matpac_", ",", " ", "zerosthreshold_", ",", " ", "correlthreshold_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cutdownmatpac", ",", "correlmat", ",", " ", "sa", ",", " ", "hits"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cutdownmatpac", "=", 
      RowBox[{"TakeByFracZero", "[", 
       RowBox[{"matpac", ",", " ", "zerosthreshold"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"correlmat", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{
         RowBox[{"Correlation", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"N", "[", 
            RowBox[{"First", "[", "cutdownmatpac", "]"}], "]"}], "]"}], "]"}],
          ",", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa", "=", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"BoolEval", "[", 
        RowBox[{"correlmat", ">", "correlthreshold"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hits", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Keys", "[", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{"ArrayRules", "[", "sa", "]"}], ",", 
           RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"testsa", "[", 
        RowBox[{"[", 
         RowBox[{"hits", ",", " ", "hits"}], "]"}], "]"}], ",", 
       RowBox[{"cutdownmatpac", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "hits"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"correlmat", "*", "sa"}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"hits", ",", " ", "hits"}], "]"}], "]"}], ",", " ", 
       RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
        " ", "\"\<Aggregation gNO\>\""}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.852467409992174*^9, 3.852467428994555*^9}, {
   3.852467489618773*^9, 3.852467579808373*^9}, {3.852467628830578*^9, 
   3.8524679028138447`*^9}, {3.852468098377915*^9, 3.852468107606371*^9}, {
   3.852468369254127*^9, 3.852468378337583*^9}, 3.852468563929286*^9, 
   3.8524688349742413`*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[70]:=",ExpressionUUID->"abb3f7a0-501d-45b1-adb8-5e50130c6157"]
}, Closed]],

Cell[CellGroupData[{

Cell["CommunityCellClusterPlot", "Subsubsection",
 CellChangeTimes->{{3.8490269091473293`*^9, 
  3.849026914584895*^9}},ExpressionUUID->"54bc2920-ece0-41f0-a5e4-\
c200d9701e94"],

Cell["\<\
Given any expression matpac, and a list of communities of genes defined on \
that matpac, this code will convert the matpac to Pearson residual form, then \
cluster each community by gene (using gene-gene similarity) and concatenate \
them back together, then cluster the cells by cell-cell similarity, and then \
output the result as a heat map, with the gene names labeled and colored \
according to the community to which each gene belongs\
\>", "Text",
 CellChangeTimes->{{3.849026955131422*^9, 3.849027107053521*^9}, {
  3.849027162415143*^9, 
  3.849027178209284*^9}},ExpressionUUID->"7df502df-bd81-4367-9703-\
45a263a0de02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CommunityCellClusterPlot", "[", 
   RowBox[{"matpac_", ",", " ", "communities_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "coms", ",", "skewlist", ",", "gs", ",", " ", "gs2", ",", " ", "cs", ",",
       " ", "colordata", ",", " ", "comlengths", ",", "colors", ",", 
      "colorsequence", ",", " ", "geneticks"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"skewlist", "=", 
      RowBox[{"SortBySkew", "[", 
       RowBox[{"matpac", ",", "communities"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"coms", "=", 
      RowBox[{"communities", "[", 
       RowBox[{"[", 
        RowBox[{"Keys", "[", "skewlist", "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gs", "=", 
      RowBox[{"GeneSubset", "[", 
       RowBox[{"matpac", ",", 
        RowBox[{"Flatten", "[", "coms", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gs2", " ", "=", " ", 
      RowBox[{"GeneSubset", "[", " ", 
       RowBox[{
        RowBox[{"ReplacePart", "[", 
         RowBox[{"gs", ",", " ", 
          RowBox[{"1", "\[Rule]", " ", 
           RowBox[{"Standardize", "/@", 
            RowBox[{
            "gs", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}]}]}]}], "]"}], ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"FindClusters", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"GeneSubset", "[", 
                RowBox[{"gs", ",", 
                 RowBox[{
                 "coms", "\[LeftDoubleBracket]", "k", 
                  "\[RightDoubleBracket]"}]}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "\[Rule]", " ", 
              RowBox[{
              "coms", "\[LeftDoubleBracket]", "k", 
               "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{"Method", "\[Rule]", " ", "\"\<Agglomerate\>\""}]}], 
            "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "1", ",", " ", 
             RowBox[{"Length", "[", "coms", "]"}]}], "}"}]}], "]"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cs", "=", 
      RowBox[{"CellSubset", "[", 
       RowBox[{"gs2", ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{"ReverseSortBy", "[", 
          RowBox[{
           RowBox[{"FindClusters", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"gs2", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[Rule]", " ", 
             RowBox[{"gs2", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "]"}], ",", "Length"}], "]"}],
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"colordata", "=", 
      RowBox[{"ColorData", "[", 
       RowBox[{"63", ",", "\"\<ColorList\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"comlengths", "=", 
      RowBox[{"Length", "/@", "coms"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"colors", "=", 
      RowBox[{"colordata", "\[LeftDoubleBracket]", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "1", "}"}], ",", 
         RowBox[{"1", "+", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "colordata", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", 
              RowBox[{"Length", "[", "comlengths", "]"}]}], "}"}]}], 
           "]"}]}]}], "]"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"colorsequence", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"colors", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"comlengths", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "comlengths", "]"}]}], "}"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"geneticks", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"cs", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "#"}], "]"}], "]"}], ",", 
            RowBox[{"colorsequence", "[", 
             RowBox[{"[", "#", "]"}], "]"}]}], "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", 
         RowBox[{"cs", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Skew factors are \>\"", ",", 
