Cell[CellGroupData[{

Cell["ExtractTerminalCommunities", "Subsubsection",
 CellChangeTimes->{
  3.872429037402071*^9},ExpressionUUID->"64ccc831-9768-4b6f-bcde-\
4cbe9bd333d1"],

Cell["\<\
This starts with a gNO and an initial set of communities.  It then \
repetitively attempts to subdivide each community until it can no longer be \
subdivided into parts at least one of which is longer than a specified \
threshold.  In a sense it helps us find \[OpenCurlyDoubleQuote]terminal\
\[CloseCurlyDoubleQuote] communities, ones that are held together by lots of \
internal linkages, and cannot be meaningfully partitioned further (especially \
if the threshold used is small, e.g. 4 genes).  The existence of large \
terminal communities suggest there is substructure in our group of cells, \
i.e. they are not homogeneous.    \
\>", "Text",
 CellChangeTimes->{{3.872428848834907*^9, 3.872429031528697*^9}, {
  3.872429110256983*^9, 
  3.872429161030086*^9}},ExpressionUUID->"3e45dc8e-bae3-4b35-bf01-\
7df5d05d4d7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExtractTerminalCommunities", "[", 
   RowBox[{"gNetObj_", ",", " ", "coms_", ",", " ", "threshold_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "list", ",", " ", "subcoms", ",", "keepers", ",", " ", "newsubcoms"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"list", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"subcoms", "=", "coms"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "subcoms", "]"}], ">", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"keepers", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"subcoms", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Length", "/@", 
               RowBox[{"FindSubCommunities", "[", 
                RowBox[{"gNetObj", ",", "#"}], "]"}]}], "]"}], ">", 
             "threshold"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"list", ",", 
          RowBox[{"Complement", "[", 
           RowBox[{"subcoms", ",", "keepers"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"subcoms", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"FindSubCommunities", "[", 
              RowBox[{"gNetObj", ",", "#"}], "]"}], "&"}], "/@", "keepers"}], 
           ",", "1"}], "]"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ReverseSortBy", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"list", ",", "1"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"MeanDegreeCentrality", "[", 
         RowBox[{"gNetObj", ",", " ", "#"}], "]"}], "&"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.872427409923696*^9, 3.8724274763766117`*^9}, 
   3.872427579815317*^9, {3.872427631616848*^9, 3.8724277403569736`*^9}, 
   3.87242778853526*^9, {3.872427842825616*^9, 3.8724278734416533`*^9}, {
