Cell[CellGroupData[{

Cell["Alternative Benjamini Hochberg", "Subsubsection",
 CellChangeTimes->{{3.850592467433935*^9, 
  3.850592480174654*^9}},ExpressionUUID->"fa3e6427-9eaf-4ffd-ab58-\
241c20844a00"],

Cell[TextData[{
 "Normally, BH uses a list of pvalues as a starting point.  However, very \
often our pvalues come from a list of permutation trials, and it\
\[CloseCurlyQuote]s the number of permutation trials we actually store.  This \
form of BH takes as input a list of results from permutation trials, and \
outputs the value of the permutation trial at which the BH threshold is \
crossed.  To convert that to a pvalue we\[CloseCurlyQuote]d just do ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["2", 
      RowBox[{"1", "+", "#"}]], "&"}], " "}], TraditionalForm]],
  ExpressionUUID->"ee7d18b5-f9ed-4b5d-916b-5e3be557f184"],
 "to the result.  "
}], "Text",
 CellChangeTimes->{{3.850592495266984*^9, 3.8505925090988913`*^9}, {
  3.85059264920475*^9, 3.8505926699798737`*^9}, {3.850592758747661*^9, 
  3.8505927660421143`*^9}, {3.850592817742011*^9, 
  3.850592911653798*^9}},ExpressionUUID->"c8931fa2-5cb1-4e2b-8091-\
71eeed09e5c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BHCFalt", "=", "\[IndentingNewLine]", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sortedtrials", ",", " ", "_Real", ",", " ", "1"}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"altlength", ",", " ", "_Integer"}], "}"}]}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"1", "+", "sortedtrials"}], 
       RowBox[{"2", " ", "altlength"}]], ")"}], " ", "*", 
     RowBox[{"Reverse", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "sortedtrials", "]"}], "]"}], "]"}]}], ",", 
    RowBox[{"RuntimeAttributes", "\[Rule]", 
     RowBox[{"{", "Listable", "}"}]}], ",", 
    RowBox[{"Parallelization", "\[Rule]", "True"}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.8505920041309233`*^9, 3.8505920404819613`*^9}, {
  3.8505920805097733`*^9, 3.85059212162488*^9}, {3.850592450725563*^9, 
