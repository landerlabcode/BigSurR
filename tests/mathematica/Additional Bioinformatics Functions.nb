   3.832330762841256*^9, 3.832330794365402*^9}, {3.833118514609202*^9, 
   3.833118522382163*^9}, {3.833240099377791*^9, 3.83324010176171*^9}, {
   3.833297105700905*^9, 3.833297113408946*^9}, {3.833933829348309*^9, 
   3.83393383273344*^9}, 3.834586545797422*^9, 3.8346706858001003`*^9, 
