Cell[CellGroupData[{

Cell["NeighborZoom", "Subsubsection",
 CellChangeTimes->{3.835029446045722*^9},
 CellLabel->
  "In[103]:=",ExpressionUUID->"4a75521b-118e-4cbb-8700-7b6af45d2411"],

Cell["\<\
This function takes a graph of a community, and extracts all the genes \
located within some distance (number of edges) of any one gene or group of \
genes.  The input genes may be entered as a single gene or as a list of \
genes.  It works by extracting the Vertex index for the genes of interest and \
then calling Mathematica\[CloseCurlyQuote]s NeighborhoodGraph Code\
\>", "Text",
 CellChangeTimes->{{3.8348650944621353`*^9, 3.834865161028647*^9}, {
  3.834865257367485*^9, 3.834865265726406*^9}, {3.834865597082137*^9, 
  3.834865609286848*^9}, {3.842104475693084*^9, 
  3.842104498971304*^9}},ExpressionUUID->"ecea7d59-472b-4e0e-84fe-\
526c77aed0c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NeighborZoom", "[", 
   RowBox[{"graph_", ",", " ", "genes_", ",", " ", "distance_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rules", "=", 
      RowBox[{"AnnotationValue", "[", 
       RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"NeighborhoodGraph", "[", 
     RowBox[{"graph", ",", 
      RowBox[{"genes", "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Extract", "[", 
             RowBox[{"#", ",", 
              RowBox[{"Position", "[", 
               RowBox[{"#", ",", "_String"}], "]"}]}], "]"}], "&"}], "/@", 
           RowBox[{"Last", "/@", "rules"}]}], "]"}], "\[Rule]", " ", 
         RowBox[{"First", "/@", "rules"}]}], "]"}]}], ",", " ", "distance"}], 
     "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.834865040824769*^9, 3.8348650765956*^9}, {
   3.83486511219907*^9, 3.834865114007205*^9}, {3.8348651688190813`*^9, 
   3.8348653052962713`*^9}, {3.834865497578454*^9, 3.834865507211646*^9}, {
   3.835026461403863*^9, 3.835026488153019*^9}, {3.8350265202985487`*^9, 
   3.835026526110264*^9}, 3.835026597360186*^9, {3.835026693159137*^9, 
   3.835026740868685*^9}, {3.8350277792750597`*^9, 3.835027789030477*^9}, {
   3.8350278531490107`*^9, 3.835027856966226*^9}, 3.8350278943315353`*^9, {
   3.835028043252371*^9, 3.835028050029971*^9}, 3.835028107273921*^9, {
   3.835028265817422*^9, 3.835028286128866*^9}, {3.8350300630281353`*^9, 
   3.8350300640584784`*^9}, {3.8516153075708838`*^9, 3.851615326788332*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[141]:=",ExpressionUUID->"84a26c9b-3115-4c23-ad96-88771307ca7f"]
}, Closed]],

Cell[CellGroupData[{

Cell["DirectNeighborsList", "Subsubsection",
 CellChangeTimes->{
  3.835029446045722*^9, {3.8516106261665*^9, 3.8516106267871017`*^9}, {
   3.851627950592018*^9, 
   3.851627988191451*^9}},ExpressionUUID->"71a248eb-bdcc-4bc0-938b-\
36fcc7d38bbc"],

Cell["\<\
This function takes a gNO and a set of one or more target genes.  It displays \
only the edges connected to those target genes, and not the edges between \
those connected nodes (NeighborZoom would be used for that)\
\>", "Text",
 CellChangeTimes->{{3.8348650944621353`*^9, 3.834865161028647*^9}, {
  3.834865257367485*^9, 3.834865265726406*^9}, {3.834865597082137*^9, 
  3.834865609286848*^9}, {3.842104475693084*^9, 3.842104498971304*^9}, {
  3.851610636829126*^9, 
  3.8516107654523497`*^9}},ExpressionUUID->"056c1203-08ff-4ecf-b3d1-\
4c89337a8e4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "DirectNeighborsList", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Positive Only\>\"", "->", " ", "False"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DirectNeighborsList", "[", 
   RowBox[{"gNO_", ",", " ", "genes_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"gno", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}], ",", 
         RowBox[{"TruncateGNO", "[", 
          RowBox[{"gNO", ",", " ", "0", ",", 
           RowBox[{"\"\<Positive Only\>\"", "->", " ", 
            RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}]}]}], 
          "]"}], ",", "gNO"}], "]"}]}], ",", " ", "slots", ",", " ", "mat"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"slots", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
