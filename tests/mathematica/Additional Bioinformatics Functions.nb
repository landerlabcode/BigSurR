Cell[CellGroupData[{

Cell["InteractiveGraph", "Subsubsection",
 CellChangeTimes->{{3.851648520835595*^9, 
  3.851648524063367*^9}},ExpressionUUID->"497f1972-ab4a-4fbf-93ef-\
1c2bee13f072"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InteractiveGraph", "[", 
   RowBox[{
   "gNetObj_", ",", "expressionDS_", ",", "targets_", ",", "highlights_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gNO", "=", "gNetObj"}], ",", " ", 
        RowBox[{"expressiondataset", "=", "expressionDS"}], ",", " ", 
        RowBox[{"targetgenes", "=", "targets"}], ",", " ", 
        RowBox[{"highlightgenes", " ", "=", " ", "highlights"}]}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "rules", ",", "dispatch", ",", "posrules", ",", "targetposns", ",", 
          "highlightgeneposns", ",", "zeroedges", ",", "oneedges", ",", 
          "twoedges", ",", "pos1edges", ",", "neg1edges", ",", "pos2edges", ",",
           "neg2edges", ",", "alledges", ",", "firstneighborposns", ",", 
          "secondneighborposns", ",", " ", "allpositions", ",", " ", 
          "vlabels", ",", " ", "vsize", ",", "vstyle", ",", "vshape", ",", 
          "vlabelstyle", ",", " ", "colorfunc", ",", " ", "thicknessfunc"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rules", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{
              RowBox[{"ArrayRules", "[", 
               RowBox[{"gNO", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Last", "[", "#", "]"}], ">", "poscorrthresh"}], "||", 
              
              RowBox[{
               RowBox[{"Last", "[", "#", "]"}], "<", "negcorrthresh"}]}], 
             "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"dispatch", "=", 
          RowBox[{"Dispatch", "[", "rules", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"posrules", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"rules", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"targetposns", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{"gNO", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@",
             "targetgenes"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"highlightgeneposns", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{"gNO", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@",
             "highlightgenes"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"zeroedges", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Keys", "[", "rules", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"ContainsAll", "[", 
              RowBox[{"targetposns", ",", "#"}], "]"}], "&"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"oneedges", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Keys", "[", 
             RowBox[{"If", "[", 
              RowBox[{"posonly", ",", " ", "posrules", ",", "rules"}], "]"}], 
             "]"}], ",", " ", 
            RowBox[{
             RowBox[{"ContainsAny", "[", 
              RowBox[{"targetposns", ",", "#"}], "]"}], "&"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"pos1edges", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"oneedges", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "/.", "dispatch"}], ")"}], ">", "0"}], "&"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"neg1edges", " ", "=", " ", 
          RowBox[{"Complement", "[", 
           RowBox[{"oneedges", ",", " ", "pos1edges"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"firstneighborposns", "=", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Union", "[", 
             RowBox[{"Flatten", "[", "oneedges", "]"}], "]"}], ",", 
            "targetposns"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"twoedges", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Keys", "[", 
             RowBox[{"If", "[", 
              RowBox[{"posonly", ",", " ", "posrules", ",", "rules"}], "]"}], 
             "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"ContainsAny", "[", 
               RowBox[{"firstneighborposns", ",", "#"}], "]"}], "&&", 
              RowBox[{"ContainsNone", "[", 
               RowBox[{"targetposns", ",", "#"}], "]"}]}], "&"}]}], " ", 
           "]"}]}], ";", "\t", "\[IndentingNewLine]", 
         RowBox[{"pos2edges", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"twoedges", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "/.", "dispatch"}], ")"}], ">", "0"}], "&"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"neg2edges", "=", 
          RowBox[{"Complement", "[", 
           RowBox[{"twoedges", ",", " ", "pos2edges"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"secondneighborposns", " ", "=", " ", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Union", "[", 
             RowBox[{"Flatten", "[", "twoedges", "]"}], "]"}], ",", 
            RowBox[{"Join", "[", 
             RowBox[{"firstneighborposns", ",", "targetposns"}], "]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"alledges", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{"linknum", "\[Equal]", " ", "0"}], ",", "zeroedges", ",", 
            " ", 
            RowBox[{"linknum", "\[Equal]", " ", "1"}], ",", "oneedges", ",", 
            " ", "True", ",", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"oneedges", ",", "twoedges"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"allpositions", "=", 
          RowBox[{"Union", "[", 
           RowBox[{"Flatten", "[", "alledges", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"vlabels", "=", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"allpositions", "\[Rule]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Placed", "[", 
                RowBox[{"#", ",", "Center"}], "]"}], "&"}], "/@", 
              RowBox[{"gNO", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "allpositions"}], "]"}], "]"}]}], ")"}]}], 
           "]"}]}], " ", ";", "\[IndentingNewLine]", 
         RowBox[{"vsize", " ", "=", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"allpositions", "\[Rule]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               SqrtBox[
                RowBox[{"expressiondataset", "[", "#", "]"}]], "&"}], "/@", 
              RowBox[{"gNO", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "allpositions"}], "]"}], "]"}]}], ")"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"vstyle", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "\[Rule]", 
               RowBox[{"Directive", "[", 
                RowBox[{
                 RowBox[{"EdgeForm", "[", "None", "]"}], ",", "LightOrange", ",",
                  " ", 
                 RowBox[{"Opacity", "[", "0.4", "]"}]}], "]"}]}], "&"}], "/@", 
             RowBox[{"Intersection", "[", 
              RowBox[{"targetposns", ",", "allpositions"}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "\[Rule]", " ", 
               RowBox[{"Directive", "[", 
                RowBox[{
                 RowBox[{"EdgeForm", "[", "None", "]"}], ",", "Yellow", ",", 
                 " ", 
                 RowBox[{"Opacity", "[", "0.6", "]"}]}], "]"}]}], "&"}], "/@", 
             RowBox[{"Intersection", "[", 
              RowBox[{"highlightgeneposns", ",", " ", "allpositions"}], 
              "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "\[Rule]", " ", 
               RowBox[{"Directive", "[", 
                RowBox[{
                 RowBox[{"EdgeForm", "[", "None", "]"}], ",", "Blue", ",", 
                 RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}]}], "&"}], "/@", 
             RowBox[{"Complement", "[", 
              RowBox[{
              "allpositions", ",", "highlightgeneposns", ",", " ", 
               "targetposns"}], "]"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"vshape", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "\[Rule]", " ", "\"\<Square\>\""}], "&"}], "/@", 
             RowBox[{"Intersection", "[", 
              RowBox[{"highlightgeneposns", ",", " ", "allpositions"}], 
              "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "\[Rule]", " ", "Automatic"}], "&"}], "/@", 
             RowBox[{"Complement", "[", " ", 
              RowBox[{"allpositions", ",", "highlightgeneposns"}], "]"}]}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"vlabelstyle", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "\[Rule]", 
                RowBox[{"Directive", "[", 
                 RowBox[{"Black", ",", " ", "Larger"}], "]"}]}], ")"}], "&"}],
              "/@", 
             RowBox[{"Intersection", "[", 
              RowBox[{"targetposns", ",", "allpositions"}], "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "\[Rule]", 
                RowBox[{"Directive", "[", 
                 RowBox[{"Blue", ",", " ", "Larger"}], "]"}]}], ")"}], "&"}], 
             "/@", 
             RowBox[{"Intersection", "[", 
              RowBox[{"highlightgeneposns", ",", " ", "allpositions"}], 
              "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "\[Rule]", 
                RowBox[{"GrayLevel", "[", "0.2", "]"}]}], ")"}], "&"}], "/@", 
             
             RowBox[{"Complement", "[", " ", 
              RowBox[{
              "allpositions", ",", "highlightgeneposns", ",", " ", 
               "targetposns"}], "]"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"colorfunc", "=", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "/.", "rules"}], ")"}], ">", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"edgestoshow", "\[Equal]", "\"\<all edges\>\""}], "\[Or]", 
                RowBox[{
                "edgestoshow", "\[Equal]", "\"\<positive edges\>\""}]}], ",", 
               "Green", ",", " ", 
               RowBox[{"Directive", "[", 
                RowBox[{"Green", ",", 
                 RowBox[{"Opacity", "[", "0.2", "]"}]}], "]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"edgestoshow", "\[Equal]", "\"\<all edges\>\""}], "\[Or]", 
                RowBox[{
                "edgestoshow", "\[Equal]", "\"\<negative edges\>\""}]}], ",", 
               "Red", ",", 
               RowBox[{"Directive", "[", 
                RowBox[{"Red", ",", 
                 RowBox[{"Opacity", "[", "0.05", "]"}]}], "]"}]}], "]"}]}], 
            "]"}], "&"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"thicknessfunc", " ", "=", 
          RowBox[{
           RowBox[{"Thickness", "[", 
            RowBox[{"0.006", 
             RowBox[{"Abs", "[", 
              RowBox[{"(", 
               RowBox[{"#", "/.", "rules"}], ")"}], "]"}]}], "]"}], "&"}]}], 
         " ", ";", "\[IndentingNewLine]", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"Directive", "[", 
                  RowBox[{
                   RowBox[{"colorfunc", "[", "#", "]"}], ",", 
                   RowBox[{"thicknessfunc", "[", "#", "]"}]}], "]"}]}], "]"}],
                "/.", 
               RowBox[{"(", 
                RowBox[{"List", "\[Rule]", " ", "UndirectedEdge"}], ")"}]}], 
              ")"}], "&"}], "/@", "alledges"}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"VertexSize", "\[Rule]", "vsize"}], ",", 
           RowBox[{"VertexLabelStyle", "\[Rule]", " ", "vlabelstyle"}], ",", 
           RowBox[{"VertexStyle", "\[Rule]", "vstyle"}], ",", 
           RowBox[{"VertexShapeFunction", "\[Rule]", "vshape"}], ",", " ", 
           RowBox[{"VertexLabels", "\[Rule]", " ", "vlabels"}], " ", ",", 
           RowBox[{"ImageSize", "\[Rule]", 
            RowBox[{"80", "*", 
             SqrtBox[
              RowBox[{"Length", "[", "allpositions", "]"}]]}]}]}], "]"}]}]}], 
       "]"}]}], "]"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"linknum", ",", "1", ",", "\"\<Links\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "2"}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edgestoshow", ",", "\"\<all edges\>\"", ",", "\"\<Show\>\""}],
        "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<all edges\>\"", ",", " ", "\"\<positive edges\>\"", ",", 
        " ", "\"\<negative edges\>\"", ",", " ", "\"\<no edges\>\""}], 
       "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "posonly", ",", "False", 
        ",", "\"\<Build using only positive correlations\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "poscorrthresh", ",", " ", "0", 
        ",", "\"\<Positive Correlation Threshold\>\""}], "}"}], ",", "0", ",",
       "0.5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "negcorrthresh", ",", " ", "0", ",", 
        " ", "\"\<Negative Correlation Threshold\>\""}], "}"}], ",", 
      RowBox[{"-", "0.5"}], ",", "0"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.851648549597356*^9, 3.851648617368279*^9}, {
