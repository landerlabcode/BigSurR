Cell[CellGroupData[{

Cell[TextData[{
 "InterCommunityCorrelations ",
 StyleBox["(InterCommunityCorrelations, InterCommunityCorrelations2, \
CollapseCommunitiesRecursive)",
  FontColor->GrayLevel[0]]
}], "Subsection",
 CellChangeTimes->{
  3.880307348366478*^9, {3.885932764154459*^9, 3.885932796990439*^9}, {
   3.885933159712183*^9, 3.885933165697551*^9}, {3.906463367257388*^9, 
   3.906463373650939*^9}},ExpressionUUID->"03d152b1-77d1-4d70-b9f5-\
7cf5a384e7fc"],

Cell[CellGroupData[{

Cell["InterCommunityCorrelations", "Subsubsection",
 CellChangeTimes->{{3.884598347473834*^9, 3.88459835384501*^9}, 
   3.885932808935316*^9},ExpressionUUID->"fa19cd96-682f-4af6-9016-\
4afb24ffac20"],

Cell["\<\
This produces a matrix plot of the correlations between communities.  It does \
so by averaging the correlations between the genes of one community and the \
genes of every other community individually.  The code was fixed on 2-5-23 to \
add RestoreSymmetryExceptDiagonal to the correlation matrix.  \
\>", "Text",
 CellChangeTimes->{{3.8803073561547327`*^9, 3.880307424795841*^9}, {
  3.884598338779125*^9, 3.8845983414415627`*^9}, {3.884598681612714*^9, 
  3.884598720877892*^9}},ExpressionUUID->"50591f38-aa7f-4e90-9289-\
6c1cc183a62a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "InterCommunityCorrelations", "]"}], "=", 
   RowBox[{"Options", "[", "MatrixPlot", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InterCommunityCorrelations", "[", 
   RowBox[{"gNO_", ",", " ", "communities_", ",", 
    RowBox[{"opt", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"posns", ",", " ", "correlmatrix", ",", " ", "limits"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"posns", "=", 
      RowBox[{"Flatten", "/@", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"gNO", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "#"}], "]"}], "]"}], 
          "&"}], ",", "communities", ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"correlmatrix", "=", 
      RowBox[{"Outer", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mean", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
             RowBox[{"gNO", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "#1", ",", " ", "#2"}], "]"}], "]"}], 
             "]"}], "]"}], "]"}], "]"}], "&"}], ",", " ", "posns", ",", " ", 
        "posns", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"limits", "=", 
      RowBox[{"MinMax", "[", 
       RowBox[{"Flatten", "[", "correlmatrix", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"1", "/", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "/@", "limits"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"MatrixPlot", "[", 
        RowBox[{"correlmatrix", ",", 
         RowBox[{"FrameTicks", "->", " ", "All"}], ",", 
         RowBox[{"ColorFunction", "\[Rule]", 
          RowBox[{"Function", "[", 
           RowBox[{"x", ",", 
            RowBox[{"RGBColor", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"x", "<", "0"}], ",", "1", ",", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"a", " ", "x"}]}], ")"}], "2"]}], "]"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"x", "<", "0"}], ",", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"a", " ", "x"}]}], ")"}], "2"], ",", "1"}], "]"}], 
              ",", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"a", " ", 
                  RowBox[{"Abs", "[", "x", "]"}]}]}], ")"}], "2"]}], "]"}]}], 
           "]"}]}], ",", " ", 
         RowBox[{"ColorFunctionScaling", "->", " ", "False"}], ",", " ", 
         RowBox[{"PlotLabel", "->", " ", 
          
          RowBox[{"\"\<Intercommunity Correlations, max Abs. val = \>\"", "<>",
            " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"1", "/", "a"}], " ", "]"}]}]}], ",", " ", 
         RowBox[{"Evaluate", "@", 
          RowBox[{"FilterRules", "[", 
           RowBox[{
