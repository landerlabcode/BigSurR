              RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], "@@", 
           RowBox[{"posns", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "pairs", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
