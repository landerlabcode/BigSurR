  3.8712242591018753`*^9},ExpressionUUID->"9ea83100-0860-42ff-a3be-\
17529f02d7b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RawMomentToCumulant", "[", 
    RowBox[{"{", 
     RowBox[{"\[ScriptCapitalE]1_", ",", "\[ScriptCapitalE]2_"}], "}"}], 
    "]"}], ":=", " ", 
   RowBox[{"{", 
    RowBox[{"\[ScriptCapitalE]1", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[ScriptCapitalE]1", "2"]}], "+", 
      "\[ScriptCapitalE]2"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"RawMomentToCumulant", "[", 
    RowBox[{"{", 
     RowBox[{
     "\[ScriptCapitalE]1_", ",", "\[ScriptCapitalE]2_", ",", " ", 
      "\[ScriptCapitalE]3_"}], "}"}], "]"}], ":=", " ", 
   RowBox[{"{", 
    RowBox[{"\[ScriptCapitalE]1", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[ScriptCapitalE]1", "2"]}], "+", 
      "\[ScriptCapitalE]2"}], ",", 
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["\[ScriptCapitalE]1", "3"]}], "-", 
      RowBox[{"3", " ", "\[ScriptCapitalE]1", " ", "\[ScriptCapitalE]2"}], "+",
       "\[ScriptCapitalE]3"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"RawMomentToCumulant", "[", 
    RowBox[{"{", 
     RowBox[{
     "\[ScriptCapitalE]1_", ",", "\[ScriptCapitalE]2_", ",", " ", 
      "\[ScriptCapitalE]3_", ",", " ", "\[ScriptCapitalE]4_"}], "}"}], "]"}], 
   ":=", " ", 
   RowBox[{"{", 
    RowBox[{"\[ScriptCapitalE]1", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[ScriptCapitalE]1", "2"]}], "+", 
      "\[ScriptCapitalE]2"}], ",", 
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["\[ScriptCapitalE]1", "3"]}], "-", 
      RowBox[{"3", " ", "\[ScriptCapitalE]1", " ", "\[ScriptCapitalE]2"}], "+",
       "\[ScriptCapitalE]3"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "6"}], " ", 
