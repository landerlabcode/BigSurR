Cell["\<\
To assess, for each community of genes, the strength of correlation of the \
equivalent PCCs associated with it, we define a function that finds the 99th \
percentile PCC\
\>", "Text",
 CellChangeTimes->{{3.883298834111453*^9, 3.883298860314021*^9}, {
   3.883474847086114*^9, 3.88347485052492*^9}, {3.883474898786954*^9, 
