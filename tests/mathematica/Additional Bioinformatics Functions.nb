Cell["\<\
We note that the Gini result does not remain bounded by 0 and 1 if the data \
can be both positive an negative.  To work with residuals we need our own \
version.  If we start with the version that works on sorted data, sorted from \
lowest to highest, we note that the coefficients in front of the x[i] (the \
prime just indicates they were sorted) are symmetrical\
\>", "Text",
 CellChangeTimes->{{3.875529357873855*^9, 3.8755294161848907`*^9}, {
  3.8755324808963957`*^9, 
  3.875532555265086*^9}},ExpressionUUID->"efb51ecb-7b70-4cfb-a443-\
c660f2036a53"],

Cell[TextData[{
 "If we have true Pearson residuals, where \[Mu] is a common mean, then when \
we take the absolute value of the differences between Pearson residuals we \
get ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"Abs", "[", 
    RowBox[{
     SubscriptBox["x", "i"], "-", 
     SubscriptBox["x", "j"]}], "]"}], 
   SqrtBox["\[Mu]"]]],
  CellChangeTimes->{{3.875922101721209*^9, 3.875922122183763*^9}},
  ExpressionUUID->"beb5519f-87d1-4260-abca-65449aa44c87"],
 ". This suggest that, if we divide each Pearson residual by ",
 Cell[BoxData[
  FormBox[
   SqrtBox["\[Mu]"], TraditionalForm]],ExpressionUUID->
  "fd035a46-a272-4624-8648-dcf3ccb1ea7a"],
 " and take absolute differences we\[CloseCurlyQuote]ll get ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"Abs", "[", 
    RowBox[{
     SubscriptBox["x", "i"], "-", 
     SubscriptBox["x", "j"]}], "]"}], "\[Mu]"]],
  CellChangeTimes->{{3.875922101721209*^9, 3.875922122183763*^9}, {
   3.875922193115789*^9, 3.8759221933503027`*^9}},ExpressionUUID->
  "2788eb9e-21d0-4885-b0d2-4e557b9f8294"],
 "which merely needs to be divided by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox["n", "2"]}], TraditionalForm]],ExpressionUUID->
  "d234cdd0-1659-4175-bcf9-ee51ff2e2021"],
 " to give the Gini.  But doing that is  the same as just default-normalizing \
our terms (that is to say, dividing values by their expectations) and \
calculating a Gini from them.  In fact it is (see Single Cell Statistics from \
UnNormalized Reads.nb).  \n\nWe may write it this way:"
}], "Text",
 CellChangeTimes->{{3.875922038355164*^9, 3.8759220958690166`*^9}, {
  3.875957252946612*^9, 3.875957269335594*^9}, {3.8759573354356613`*^9, 
  3.875957340171955*^9}, {3.875957377205216*^9, 3.875957392481175*^9}, {
  3.875957440755472*^9, 3.875957441388083*^9}, {3.875957480026395*^9, 
  3.8759574983686323`*^9}, {3.87595816531814*^9, 
  3.8759581716426992`*^9}},ExpressionUUID->"09d7ab7d-2a0d-43d8-b3b2-\
41f83db5d585"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Gini", "[", 
   RowBox[{"vector_", ",", " ", "expectationvector_"}], "]"}], ":=", " ", 
  FractionBox[
   RowBox[{"Total", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Subtract", "[", 
          RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], ",", 
       FractionBox["vector", "expectationvector"], ",", 
       FractionBox["vector", "expectationvector"]}], "]"}], "]"}], "]"}], 
   RowBox[{"2", 
    SuperscriptBox[
     RowBox[{"Length", "[", "vector", "]"}], "2"]}]]}]], "Text",
 CellChangeTimes->{
  3.875958178876647*^9},ExpressionUUID->"fa163bf1-c6b0-4f59-b5a3-\
db133eb64845"],

Cell["\<\
this works but it\[CloseCurlyQuote]s slow because of having to do outer so \
many times; it is better to use the MapIndexed code.  And it is better to \
compile the code\
\>", "Text",
 CellChangeTimes->{{3.875958016089554*^9, 3.875958041862026*^9}, {
  3.875958431754187*^9, 
  3.8759584371793957`*^9}},ExpressionUUID->"4fbb8cdd-435c-4ca6-bd60-\
f3f56780c75c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GiniCF", " ", "=", " ", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vector", ",", "_Real", ",", " ", "1"}], " ", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"expectationvector", ",", "_Real", ",", " ", "1"}], "}"}]}], 
     "}"}], ",", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", "=", 
        FractionBox["vector", "expectationvector"]}], "}"}], ",", 
      FractionBox[
       RowBox[{"Plus", "@@", 
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", 
               RowBox[{"#2", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "-", 
              RowBox[{"Length", "[", "data", "]"}], "-", "1"}], ")"}], "#"}], 
           "&"}], ",", 
          RowBox[{"Sort", "[", "data", "]"}]}], "]"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "data", "]"}], "^", "2"}], 
         RowBox[{"Mean", "[", "data", "]"}]}], ")"}]]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"RuntimeAttributes", "\[Rule]", 
     RowBox[{"{", "Listable", "}"}]}], ",", 
    RowBox[{"Parallelization", "\[Rule]", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8759582729327908`*^9, 3.875958387280637*^9}, {
  3.875958640927732*^9, 3.8759586450347567`*^9}, {3.875958712012974*^9, 
  3.875958721215818*^9}, {3.8759587559143744`*^9, 3.875958760863243*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[195]:=",ExpressionUUID->"c46a37ed-73c6-4621-9f9b-cccf80680b12"],

