Cell[CellGroupData[{

Cell["FindCommunities", "Subsubsection",
 CellChangeTimes->{
  3.83229050998072*^9},ExpressionUUID->"8cd78463-c18d-4ad1-9cc8-45dfe3263f69"],

Cell["\<\
The function IGCommunitiesWalktrap does all the work if implementing Pons and \
Latapy*, but needs to take an AdjacencyGraph as in input, which in this case \
is obtained from the output of a gNetworkObject.    In this function there\
\[CloseCurlyQuote]s an option, \[OpenCurlyDoubleQuote]Steps\
\[CloseCurlyDoubleQuote], which allows one to set the number of steps used by \
IGCommunitiesWalkTrap.  The default is 4.  The output is a list of lists of \
gene communities.  
\t*Pons P, Latapy M (2005) Computing communities in large networks using \
random walks . Computer and Information Sciences - Iscis 2005, Proceedings \
3733 : 284 - 293 \
\>", "Text",
 CellChangeTimes->{{3.832290250818873*^9, 3.83229027457246*^9}, {
  3.8323298281082163`*^9, 3.832329867973982*^9}, {3.8323299061153812`*^9, 
  3.832329991123147*^9}, {3.8323320120447187`*^9, 
  3.8323320243536253`*^9}},ExpressionUUID->"b28ab552-59f5-421a-836c-\
03151c0e9543"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FindCommunities", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Steps\>\"", "\[Rule]", " ", "4"}], ",", " ", 
     RowBox[{"\"\<Timeout\>\"", "\[Rule]", " ", "300"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"FindCommunities", "[", 
    RowBox[{"gNetObj_", ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"TimeConstrained", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
        RowBox[{"2", ",", "#"}], "\[RightDoubleBracket]"}], "&"}], "/@", 
      RowBox[{
       RowBox[{"IGCommunitiesWalktrap", "[", 
        RowBox[{
         RowBox[{"AdjacencyGraph", "[", 
          RowBox[{
          "gNetObj", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
          "]"}], ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<Steps\>\"", "]"}]}], "]"}], 
       "[", "\"\<Communities\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"OptionValue", "[", "\"\<Timeout\>\"", "]"}], ",", 
     RowBox[{"Print", "[", "\"\<Timed out\>\"", "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.832290463212373*^9, 3.8322904823929033`*^9}, {
  3.832329723815236*^9, 3.832329812288643*^9}, {3.840618882446258*^9, 
  3.8406189639849586`*^9}, {3.8415113736246967`*^9, 3.841511379448146*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[89]:=",ExpressionUUID->"606f0817-aa3e-4c9f-a44d-51c6dd5ee145"],

Cell["\<\
Comment:  sometimes this hangs up and takes a really long time, possibly \
because the adjacency graph of gNetObj[[1]] is too big to calculate.  We have \
added a time limitation step here.  It is set by default at 5 minutes, but \
can be set to another time as an option.  \
\>", "Text",
 CellChangeTimes->{{3.840618725278829*^9, 3.840618759054123*^9}, {
  3.840618804039473*^9, 3.840618811939107*^9}, {3.840618969977145*^9, 
  3.840618979319137*^9}, {3.8406190845822144`*^9, 
  3.8406191006856413`*^9}},ExpressionUUID->"5598f8ff-b2e4-40dd-81b2-\
51868bfacfcc"]
}, Closed]],

Cell[CellGroupData[{

Cell["FindCommunitiesRecursive", "Subsubsection",
 CellChangeTimes->{
  3.83229050998072*^9, {3.849103940908513*^9, 
   3.8491039425065203`*^9}},ExpressionUUID->"2574f944-6861-4b6a-ba73-\
9c83e47bcd86"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindCommunitiesRecursive", "[", "gNetObj_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "finallist", ",", "pendinglist", ",", "list", ",", " ", "bigones", ",", 
      " ", "smallones"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bigones", ",", "finallist"}], "}"}], "=", 
      RowBox[{"GatherBy", "[", 
       RowBox[{
        RowBox[{"FindCommunities", "[", "gNetObj", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], ">", "5"}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "bigones", "]"}], ">", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pendinglist", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"posns", "=", " ", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{
                    "gNetObj", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], ",", "#"}], "]"}], "&"}], "/@", 
                   RowBox[{"bigones", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
               "\[IndentingNewLine]", "\t", 
               RowBox[{"FindCommunities", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
                   RowBox[{"1", ",", "posns", ",", " ", "posns"}], 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
                   RowBox[{"2", ",", "posns"}], "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"gNetObj", "\[LeftDoubleBracket]", 
                   RowBox[{"3", ",", "posns", ",", " ", "posns"}], 
                   "\[RightDoubleBracket]"}]}], " ", "}"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "bigones", "]"}]}], "}"}]}], "]"}], ",",
            "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"bigones", ",", " ", "smallones"}], "}"}], "=", 
         RowBox[{"GatherBy", "[", 
          RowBox[{"pendinglist", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "#", "]"}], ">", "5"}], "&"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"finallist", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"finallist", ",", "smallones"}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "finallist"}]}], "]"}]}]], "Input",
 CellChangeTimes->CompressedData["
