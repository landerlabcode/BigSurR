 CellChangeTimes->{
  3.884455519634234*^9},ExpressionUUID->"344faf2d-273a-425a-b96d-\
728461cae508"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SDFunc", "[", "sigPCCmat_", "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sigPosPCCmat", " ", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"BoolEval", "[", 
          RowBox[{"sigPCCmat", ">", "0"}], "]"}], "*", "sigPCCmat"}], "]"}]}],
       ",", "\[Alpha]", ",", "k", ",", " ", "n", ",", "data", ",", " ", 
      "sdpoints"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "sigPosPCCmat", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", " ", 
      RowBox[{"sigPosPCCmat", "[", "\"\<ExplicitLength\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"StandardDeviation", "[", "#", "]"}], "]"}], "&"}], "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"choices", "=", 
               RowBox[{"RandomSample", "[", 
                RowBox[{
                 RowBox[{"Range", "[", " ", 
                  RowBox[{"Length", "[", "sigPosPCCmat", "]"}], "]"}], ",", 
                 "j"}], "]"}]}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{"sigPosPCCmat", "[", 
               RowBox[{"[", 
                RowBox[{"choices", ",", " ", "choices"}], "]"}], "]"}], 
              "[", "\"\<ExplicitLength\>\"", "]"}]}], "]"}], ",", "1000"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"Union", "[", 
            RowBox[{"Round", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               SuperscriptBox["2", "k"], ",", " ", 
               RowBox[{"{", 
                RowBox[{"k", ",", " ", "2", ",", " ", 
                 RowBox[{"Log", "[", 
                  RowBox[{"2", ",", "2000"}], "]"}], ",", "0.05"}], "}"}]}], 
              "]"}], "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sdpoints", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"List", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{"Union", "[", 
            RowBox[{"Round", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               SuperscriptBox["2", "k"], ",", " ", 
               RowBox[{"{", 
                RowBox[{"k", ",", " ", "2", ",", " ", 
                 RowBox[{"Log", "[", 
                  RowBox[{"2", ",", "2000"}], "]"}], ",", "0.05"}], "}"}]}], 
              "]"}], "]"}], "]"}], "]"}], ",", "data"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"b", " ", 
       SuperscriptBox["x", "k"]}], "/.", 
      RowBox[{"FindFit", "[", 
       RowBox[{"sdpoints", ",", 
        RowBox[{"b", " ", 
         SuperscriptBox["x", "k"]}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "k"}], "}"}], ",", " ", "x"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
