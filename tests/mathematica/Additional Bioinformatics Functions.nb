Cell[CellGroupData[{

Cell["FirstDegreeConnections", "Subsubsection",
 CellChangeTimes->{{3.872100943835579*^9, 
  3.872100949656002*^9}},ExpressionUUID->"e4ae4f2b-bbfa-4bb6-b829-\
d193101997e6"],

Cell["\<\
You give this a gNO and some target genes and it returns all the first degree \
connections to those target genes.  The previous version of the code \
(commented out) failed to restore symmetry to the matrix and so missed \
connections; the new one fixes this\
\>", "Text",
 CellChangeTimes->{{3.9051623513758698`*^9, 3.905162380492379*^9}, {
   3.90516362613314*^9, 3.905163674910549*^9}, 
   3.906463546265452*^9},ExpressionUUID->"3b2310cd-accd-4ab7-95e3-\
c39528b74f76"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FirstDegreeConnections", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Positive Connections\>\"", "->", " ", "True"}], ",", 
     RowBox[{"\"\<Negative Connections\>\"", "->", " ", "False"}]}], " ", 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FirstDegreeConnections", "[", 
   RowBox[{"gNO_", ",", " ", "gene_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"posn", ",", "mat", ",", "row", ",", " ", "positions"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"posn", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"gNO", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"mat", "=", 
      RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
       RowBox[{"gNO", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"row", "=", 
      RowBox[{"Normal", "[", 
       RowBox[{"Sign", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", "posn", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"positions", "=", "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Positive Connections\>\"", "]"}], "&&", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<Negative Connections\>\"", "]"}], "==",
           "False"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"row", ",", " ", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "==", "1"}]}]}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<Positive Connections\>\"", "]"}], "==",
           "False"}], "&&", 
         RowBox[{"OptionValue", "[", "\"\<Negative Connections\>\"", "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"row", ",", " ", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "==", 
             RowBox[{"-", "1"}]}]}]}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", "True", ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"row", ",", " ", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "!=", "0"}]}]}], "]"}], "]"}]}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"gNO", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "positions"}], "]"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.872100655583499*^9, 3.872100690986659*^9}, {
   3.872100847623101*^9, 3.8721009089797697`*^9}, {3.872119998819796*^9, 
   3.872120025514636*^9}, {3.872120080906542*^9, 3.8721200979488363`*^9}, {
