Cell[CellGroupData[{

Cell["FeaturePlot5", "Subsubsection",
 CellChangeTimes->{{3.879128290803763*^9, 3.879128294779901*^9}, 
   3.925689325802904*^9},ExpressionUUID->"1a81d146-27a8-4b51-a9e5-\
a59aa6874694"],

Cell["This allows allows for Logarithmic plotting", "Text",
 CellChangeTimes->{{3.879128297803193*^9, 3.879128312048098*^9}, {
  3.925783012966033*^9, 3.925783023133445*^9}, {3.925965985258239*^9, 
  3.925965986060231*^9}},ExpressionUUID->"3745d7a7-1bb9-4619-a8c1-\
e37a1968a430"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FeaturePlot5", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<PointSize\>\"", "->", " ", "Medium"}], ",", " ", 
     RowBox[{"\"\<CellRange\>\"", "->", " ", "All"}], ",", " ", 
     RowBox[{"\"\<Background\>\"", "->", " ", 
      RowBox[{"{", "}"}]}], ",", " ", 
     RowBox[{"\"\<Log\>\"", "->", " ", "False"}], ",", " ", 
     RowBox[{"\"\<Epsilon\>\"", "->", " ", "0"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"FeaturePlot5", "[", 
    RowBox[{
    "matpacDN_", ",", " ", "gene_", ",", " ", "coordAssn_", ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"matpacDN", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", "gene"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "geneposn", ",", " ", "expressionvalues", ",", "nonzeroposns", ",", 
         " ", "coordinates", " ", ",", "cases"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"geneposn", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"matpacDN", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "gene"}], "]"}], "]"}]}], 
        " ", "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
         "finds", " ", "the", " ", "row", " ", "where", " ", "the", " ", 
          "gene", " ", "is"}], "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"expressionvalues", "=", 
         RowBox[{"Normal", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"matpacDN", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "geneposn", ",", "All"}], "]"}], "]"}], "]"}], 
          "]"}]}], " ", "\[IndentingNewLine]", "\t", 
        RowBox[{"(*", 
         RowBox[{
         "returns", " ", "the", " ", "vector", " ", "of", " ", "the", " ", 
          RowBox[{"gene", "'"}], "s", " ", "expression"}], "*)"}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"nonzeroposns", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{"expressionvalues", ",", " ", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", ">", "0"}]}]}], "]"}], "]"}]}], " ", 
        RowBox[{"(*", 
         RowBox[{
         "returns", " ", "the", " ", "positions", " ", "where", " ", "gene", " ",
           "expression", " ", 
          RowBox[{"isn", "'"}], "t", " ", "zero"}], "*)"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coordinates", "=", 
         RowBox[{
          RowBox[{"matpacDN", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "nonzeroposns"}], "]"}], "]"}], "/.", 
          RowBox[{"Flatten", "[", "coordAssn", "]"}]}]}], "  ", 
        RowBox[{"(*", 
         RowBox[{
         "returns", " ", "the", " ", "cell", " ", "IDs", " ", "at", " ", 
          "the", " ", "nonzero", " ", "positions"}], "*)"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cases", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Log\>\"", "]"}], ",", 
           RowBox[{
            RowBox[{
             FractionBox["#", 
              RowBox[{"Max", "[", "#", "]"}]], "&"}], "@", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<Epsilon\>\"", "]"}], "+", 
              RowBox[{"expressionvalues", "[", 
               RowBox[{"[", "nonzeroposns", "]"}], "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             FractionBox["#", 
              RowBox[{"Max", "[", "#", "]"}]], "&"}], "@", 
            RowBox[{"expressionvalues", "[", 
             RowBox[{"[", "nonzeroposns", "]"}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<Background\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Values", "[", 
               RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}], ",", 
              RowBox[{"Directive", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"PointSize", "[", 
                  RowBox[{"OptionValue", "[", "\"\<PointSize\>\"", "]"}], 
                  "]"}], ",", "White"}], "}"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"Axes", "\[Rule]", " ", "None"}], ",", 
            RowBox[{"PlotRange", "\[Rule]", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"First", "/@", 
                 RowBox[{"Values", "[", 
                  RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}]}], "]"}], 
               ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"Last", "/@", 
                 RowBox[{"Values", "[", 
                  RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}]}], 
                "]"}]}], "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{"Style", ",", " ", 
              RowBox[{"{", 
               RowBox[{"coordinates", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Directive", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"PointSize", "[", 
                    RowBox[{"OptionValue", "[", "\"\<PointSize\>\"", "]"}], 
                    "]"}], ",", 
                    RowBox[{"RGBColor", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"1", "-", "#"}], ",", 
                    RowBox[{"1", "-", "#"}]}], "]"}]}], "}"}], "]"}], "&"}], "/@",
                  "cases"}]}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"Axes", "\[Rule]", " ", "None"}], ",", 
            RowBox[{"PlotRange", "\[Rule]", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"First", "/@", 
                 RowBox[{"Values", "[", 
                  RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}]}], "]"}], 
               ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", "#", "]"}], ",", 
                   RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
                RowBox[{"Last", "/@", 
                 RowBox[{"Values", "[", 
                  RowBox[{"Flatten", "[", "coordAssn", "]"}], "]"}]}], 
                "]"}]}], "}"}]}]}], "]"}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", " ", 
           RowBox[{"gene", "<>", "\"\< (max = \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"matpacDN", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "geneposn", ",", "All"}], "]"}], "]"}], 
                 "]"}], "]"}], ",", "2"}], "]"}], "]"}], 
            "<>", "\"\<)\>\""}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"Print", "[", "\"\<Gene not found\>\"", "]"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8776524769808483`*^9, 3.877652479931916*^9}, {
