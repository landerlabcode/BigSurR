Cell[CellGroupData[{

Cell["PCC99", "Subsubsection",
 CellChangeTimes->{{3.8832990390708323`*^9, 3.8832990403399973`*^9}, 
   3.883299584821601*^9},ExpressionUUID->"7edba612-c43b-47c4-8b53-\
7f9e4544a6de"],

Cell["\<\
This code takes a gNO and a genelist, and returns the equivalent PCC value at \
the 99th percentile for the correlations among those genes.  \
\>", "Text",
 CellChangeTimes->{{3.883299048663837*^9, 3.8832991097786427`*^9}, {
  3.883299413270035*^9, 3.883299413935523*^9}, {3.883299588222274*^9, 
  3.88329958874577*^9}},ExpressionUUID->"1b66cfef-535d-429c-9f8f-\
46b4256ffab1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PCC99", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Positive Only\>\"", "->", " ", "False"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PCC99", "[", 
   RowBox[{"gNO_", ",", " ", "genes_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hits", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"gNO", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
        "genes"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Quantile", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"gNO", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", " ", "hits", ",", " ", "hits"}], "]"}], "]"}], 
           " ", "[", "\"\<ExplicitValues\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}], ",", "0.99"}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Quantile", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"gNO", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", " ", "hits", ",", " ", "hits"}], "]"}], "]"}], 
          " ", "[", "\"\<ExplicitValues\>\"", "]"}], "]"}], ",", "0.99"}], 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.8832989181166058`*^9, 3.883298981179037*^9}, {
  3.883299416579748*^9, 3.883299516390399*^9}, {3.883299618944317*^9, 
  3.883299642424036*^9}, {3.883299706109351*^9, 3.883299725392701*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[136]:=",ExpressionUUID->"7754d279-bc7c-4c45-b5d7-ddd9d1624032"]
}, Closed]],

Cell[CellGroupData[{

Cell["MembershipScore", "Subsubsection",
 CellChangeTimes->{{3.884783939361327*^9, 
  3.8847839418645697`*^9}},ExpressionUUID->"e75890c2-f6ea-49b5-94a5-\
49933f05c0c4"],

Cell["\<\
Given an already analyzed matpac, with its attendant residuals matrix and \
gNO, for any community of genes, we may derive a \
\[OpenCurlyDoubleQuote]membership score\[CloseCurlyDoubleQuote] for each \
cell, which is a weighted average of the standardized Pearson residuals for \
each gene.  The weighting is according to the Vertex Degree of each gene in \
the adjacency graph produced from the Positive Only gNO for that gene.  There \
is an option to restrict the Adjacency graph only to those correlations that \
exceed a threshold.  The default for that option is zero, i.e. no threshold.  

Note that the code does not require that the residualsmatrix and the gNO come \
from the same sample.  \[OpenCurlyDoubleQuote]Values\[CloseCurlyDoubleQuote] \
pulls the standardized residuals from matpac and residuals matrix for just \
those genes in \[OpenCurlyDoubleQuote]community\[CloseCurlyDoubleQuote].  \
\[OpenCurlyDoubleQuote]weights\[CloseCurlyDoubleQuote] comes from a GNO cut \
down to just contain that community.  As long as all of the genes in the \
community are in both the matpac and the gno, the code will work.  The \
weighting will come from the gNO, even if the matpac includes many cells not \
used to create the gNO.  \
\>", "Text",
 CellChangeTimes->{{3.884783945207078*^9, 3.884784089910739*^9}, {
  3.893549324841083*^9, 
  3.8935495200785923`*^9}},ExpressionUUID->"81992b84-a7fe-4e90-b41c-\
33b668cd9727"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MembershipScore", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<cutoff\>\"", "->", " ", "0"}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"MembershipScore", "[", 
    RowBox[{
    "matpac_", ",", "residualsmatrix_", ",", "gNO_", ",", " ", "community_", ",",
      " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"values", " ", "=", 
        RowBox[{"Standardize", "/@", 
         RowBox[{"residualsmatrix", "[", 
          RowBox[{"[", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{
                RowBox[{"matpac", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@",
              "community"}], "]"}], "]"}], "]"}]}]}], ",", " ", 
       RowBox[{"gno", "=", " ", 
        RowBox[{"GeneSubsetGNO", "[", 
         RowBox[{"gNO", ",", " ", 
          RowBox[{"Flatten", "[", "community", "]"}], ",", " ", 
          RowBox[{"\"\<Purge\>\"", "->", " ", "True"}]}], "]"}]}], ",", 
       "posmatrix", ",", " ", "weights"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"posmatrix", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"BoolEval", "[", 
         RowBox[{
          RowBox[{"gno", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ">", 
          RowBox[{"OptionValue", "[", "\"\<cutoff\>\"", "]"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"weights", " ", "=", 
       RowBox[{"VertexDegree", "[", 
        RowBox[{"UndirectedGraph", "[", 
         RowBox[{"AdjacencyGraph", "[", "posmatrix", "]"}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"matpac", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "->", 
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"WeightedData", "[", 
             RowBox[{"#", ",", " ", "weights"}], "]"}], "]"}], "&"}], "/@", 
          RowBox[{"Transpose", "[", "values", "]"}]}], "]"}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.884782102270103*^9, 3.8847822154499283`*^9}, {
   3.88478229533356*^9, 3.884782315597929*^9}, {3.884782408498084*^9, 
   3.8847824095366287`*^9}, {3.8847824512048483`*^9, 
   3.8847824676920967`*^9}, {3.884782512122156*^9, 3.884782533986031*^9}, {
   3.884783195799143*^9, 3.8847832067776327`*^9}, {3.884783249243331*^9, 
   3.884783259611643*^9}, {3.88478331962354*^9, 3.884783426468851*^9}, {
   3.884783469950664*^9, 3.884783484881878*^9}, {3.88478377125739*^9, 
   3.884783845897298*^9}, {3.884783883694837*^9, 3.884783906837391*^9}, {
   3.884784092344211*^9, 3.884784162931785*^9}, 3.8847857364342937`*^9, {
   3.885169480939996*^9, 3.885169481238332*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[138]:=",ExpressionUUID->"bc75753e-3287-4d60-8029-ac20942a8801"]
}, Closed]],

Cell[CellGroupData[{

Cell["SingleCommmunityGraphTrio", "Subsubsection",
 CellChangeTimes->{
  3.833306413510427*^9, {3.8416043949788313`*^9, 
   3.841604396236042*^9}},ExpressionUUID->"f3fb8560-15fa-40b5-b1e2-\
084a3421a45a"],

Cell["\<\
This does the useful thing of plotting three SingleCommunityGraphs side by \
side; in one all links show, in the other only positive links and nodes that \
have positive links show, and in the third only negative links and nodes that \
have negative links show.  \
\>", "Text",
 CellChangeTimes->{{3.8416043999778023`*^9, 3.8416044520994377`*^9}, 
   3.842105380588727*^9},ExpressionUUID->"62f920ac-4cee-46db-b55a-\
ac63f3dc7f24"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SingleCommmunityGraphTrio", "[", 
   RowBox[{
   "gNetObj_", ",", " ", "com_", ",", " ", "expressionds_", ",", " ", 
    RowBox[{"opt", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"GraphicsRow", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"SingleCommmunityGraph", "[", 
        RowBox[{"gNetObj", ",", "com", ",", "expressionds", ",", "#"}], "]"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"SingleCommmunityGraph", "[", 
        RowBox[{"gNetObj", ",", "com", ",", "expressionds", ",", " ", 
         RowBox[{"\"\<Suppress\>\"", "\[Rule]", " ", "\"\<Negative\>\""}], ",",
          "#"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"SingleCommmunityGraph", "[", 
        RowBox[{"gNetObj", ",", "com", ",", "expressionds", ",", " ", 
         RowBox[{"\"\<Suppress\>\"", "\[Rule]", " ", "\"\<Positive\>\""}], ",",
          "#"}], "]"}]}], "}"}], "&"}], "@", " ", 
    RowBox[{"Evaluate", "@", 
     RowBox[{"FilterRules", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "opt", "}"}], ",", " ", 
         RowBox[{"Options", "[", "GraphicsRow", "]"}]}], "]"}], ",", " ", 
       RowBox[{"Options", "[", "SingleCommmunityGraph", "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.841603717991851*^9, 3.841603805225618*^9}, 
   3.841604037838502*^9, {3.841604095748774*^9, 3.841604135796796*^9}, {
   3.8416042009128113`*^9, 3.841604246122325*^9}, {3.841604321596032*^9, 
   3.841604342503747*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[139]:=",ExpressionUUID->"723d79b1-4fc7-4a49-8ee5-c31e196d19f5"],

