   3.871226428285638*^9}},ExpressionUUID->"0df1f6f1-51ce-40dc-9305-\
bbc31c866b19"],

Cell[CellGroupData[{

Cell["CorrelToPval", "Subsubsection",
 CellChangeTimes->{{3.833289970461182*^9, 3.8332899753257923`*^9}, 
   3.83467821015495*^9},
 CellLabel->"In[55]:=",ExpressionUUID->"c39fc2d3-3fc4-4cc6-9527-bfcea2fe2585"],

Cell["\<\
This code takes a correlation coefficient, and using the length of the two \
vectors that had been correlated to produce it, calculates a p-value for the \
correlation, based on the known formula for turning a Pearson Correlation \
Coefficient into a t-statistic.  We put \[OpenCurlyDoubleQuote]Quiet\
\[CloseCurlyDoubleQuote] in there because this function has a habit of \
returning numerical error messages when the numbers it calculates are \
extremely small\
\>", "Text",
 CellChangeTimes->{{3.8332900911837797`*^9, 3.833290163173901*^9}, {
  3.83329767321196*^9, 
  3.833297712865398*^9}},ExpressionUUID->"addad1a0-f329-4f79-b972-\
add312d52eed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CorrelToPval", "[", 
   RowBox[{"cc_", ",", " ", "vectorlength_"}], "]"}], ":=", " ", 
  RowBox[{"Quiet", "[", 
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"CDF", "[", 
        RowBox[{"StudentTDistribution", "[", 
         RowBox[{"vectorlength", "-", "2"}], "]"}], "]"}], "[", 
       FractionBox[
        RowBox[{" ", 
         RowBox[{
          RowBox[{"Abs", "[", "cc", "]"}], 
          SqrtBox[
           RowBox[{"vectorlength", "-", "2"}]]}]}], 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["cc", "2"]}]]], "]"}]}], ")"}]}], "  ", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.833290004503502*^9, 3.833290088148369*^9}, {
  3.833297715050713*^9, 3.8332977179146338`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[215]:=",ExpressionUUID->"4c87ec90-4270-4a43-956c-1fee6436b95a"]
}, Closed]],

Cell[CellGroupData[{

Cell["CorrelToPvalFisher", "Subsubsection",
 CellChangeTimes->{{3.833289970461182*^9, 3.8332899753257923`*^9}, {
   3.833816154768516*^9, 3.833816155480505*^9}, 3.834678219763008*^9},
 CellLabel->"In[57]:=",ExpressionUUID->"3dc312df-111e-44b0-9c2c-cfe81d5f146a"],

Cell[TextData[{
 "Whereas the previous code calculates a pvalue from a correlation using the \
Student\[CloseCurlyQuote]s t-distribution, Mathematica\[CloseCurlyQuote]s \
built in \[OpenCurlyDoubleQuote]Correlation Test\[CloseCurlyDoubleQuote] \
first uses the FisherZTransform defined as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"fisherZTransform", "[", 
    RowBox[{"r_", ",", "\[Rho]0_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ArcTanh", "[", "r", "]"}], "-", 
      RowBox[{"ArcTanh", "[", "\[Rho]0", "]"}], "-", 
      FractionBox["\[Rho]0", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}]]}], ")"}], " ", 
    SqrtBox[
     RowBox[{"n", "-", "3"}]]}]}]],ExpressionUUID->
  "a3e3a81a-fc1a-45e3-a098-5c277614c217"],
 ".  Note that r is the correlation coefficient, \[Rho]0 is the Hypothesis (\
\[Rho]0=0 means testing that two things aren\[CloseCurlyQuote]t correlated), \
and n is the vector length.  For testing the null Hypothesis, this reduces to \
z = ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{
     RowBox[{"-", "3"}], "+", "n"}]], " ", 
   RowBox[{"ArcTanh", "[", "r", "]"}]}]],
  CellChangeTimes->{{3.8338163535280533`*^9, 3.833816365306566*^9}},
  ExpressionUUID->"7a6fb715-dfbc-4cf9-ad33-055d5bf3c3b6"],
 ", where r is the correlation coefficient.  Then to convert to a pvalue we \
ask for Probability[Abs[x]>Abs[z],x\[Distributed]NormalDistribution[]].  When \
you evaluate that expression you get ",
 Cell[BoxData[
  RowBox[{"Erfc", "[", 
   FractionBox[
    RowBox[{"Abs", "[", "z", "]"}], 
    SqrtBox["2"]], "]"}]],
  CellChangeTimes->{3.83381651766292*^9},ExpressionUUID->
  "d1740de3-f4b5-4a94-ab82-3012fbedc741"],
 ".  Thus, putting them together we get p =  ",
 Cell[BoxData[
  RowBox[{"Erfc", "[", 
   FractionBox[
    RowBox[{"Abs", "[", 
     RowBox[{
      SqrtBox[
       RowBox[{
        RowBox[{"-", "3"}], "+", "n"}]], " ", 
      RowBox[{"ArcTanh", "[", "r", "]"}]}], "]"}], 
    SqrtBox["2"]], "]"}]],
  CellChangeTimes->{3.83381651766292*^9},ExpressionUUID->
  "885fb276-a8e5-4b93-b228-7b832f1e632a"],
 "=  ",
 Cell[BoxData[
  RowBox[{"Erfc", "[", 
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"-", "3"}], "+", "n"}]], " ", 
     RowBox[{"Abs", "[", 
      RowBox[{"ArcTanh", "[", "r", "]"}], "]"}]}], 
    SqrtBox["2"]], "]"}]],
  CellChangeTimes->{3.83381651766292*^9},ExpressionUUID->
  "0284d754-e365-4cff-96ac-bb3c4889572d"],
 "= ",
 Cell[BoxData[
  RowBox[{"Erfc", "[", 
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"-", "3"}], "+", "n"}]], " ", 
     RowBox[{"ArcTanh", "[", 
      RowBox[{"Abs", "[", "r", "]"}], "]"}]}], 
    SqrtBox["2"]], "]"}]],
  CellChangeTimes->{3.83381651766292*^9},ExpressionUUID->
  "ae7956c5-63cc-4338-8a09-4b88d6dcdd12"]
}], "Text",
 CellChangeTimes->{{3.8338161801230793`*^9, 3.8338162427967873`*^9}, {
  3.833816389721716*^9, 3.833816463433614*^9}, {3.8338164963198557`*^9, 
  3.83381652285835*^9}, {3.833816593214329*^9, 3.833816644955888*^9}, {
  3.833816777312701*^9, 
  3.833816786193014*^9}},ExpressionUUID->"cdaaa834-bab4-4d66-9b73-\
8998dd2fbb8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CorrelToPvalFisher", "[", 
   RowBox[{"cc_", ",", " ", "vectorlength_"}], "]"}], ":=", " ", 
  RowBox[{"Erfc", "[", 
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"-", "3"}], "+", "vectorlength"}]], " ", 
     RowBox[{"ArcTanh", "[", 
      RowBox[{"Abs", "[", "cc", "]"}], "]"}]}], 
    SqrtBox["2"]], "]"}], " "}]], "Input",
 CellChangeTimes->{
  3.833816388483653*^9, {3.8338167968046722`*^9, 3.833816818386383*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[216]:=",ExpressionUUID->"b4c8f86d-1f2b-4afc-a45c-6c6db7ab3c74"]
}, Closed]],

Cell[CellGroupData[{

Cell["PvalToCorrelFisher", "Subsubsection",
 CellChangeTimes->{3.841655323039611*^9},
 CellLabel->"In[72]:=",ExpressionUUID->"904a39f0-4694-4937-86d7-c6ba087f74a5"],

Cell["\<\
This is just the inverse, but uses a pair and gives a pair because we need to \
know the sign of the pcc\
\>", "Text",
 CellChangeTimes->{{3.8354709708273277`*^9, 3.835470976315559*^9}, {
  3.835783575087133*^9, 3.835783579730465*^9}, {3.8357863884944*^9, 
  3.835786402683034*^9}},ExpressionUUID->"5bdf8659-6edb-4765-bdde-\
042fba0e48fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PvalToCorrelFisher", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pcc_", ",", " ", "pval_"}], "}"}], ",", " ", "vectorlength_"}], 
   "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"pcc", ",", " ", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Sign", "[", "pcc", "]"}], 
      RowBox[{"Tanh", "[", 
       FractionBox[
        RowBox[{
         SqrtBox["2"], " ", 
         RowBox[{"InverseErfc", "[", "pval", "]"}]}], 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "3"}], "+", "vectorlength"}]]], "]"}]}], "]"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.835438529224443*^9, 3.835438547065243*^9}, {
  3.835438637074069*^9, 3.835438693277893*^9}, {3.835438732607884*^9, 
  3.835438743634363*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[217]:=",ExpressionUUID->"cc0e8e9d-5aed-4005-bf82-009f3833d6b2"]
}, Closed]],

Cell[CellGroupData[{

Cell["ToAdjustedCClist", "Subsubsection",
 CellChangeTimes->{{3.83548307424669*^9, 3.835483078355836*^9}, 
   3.8416553195321074`*^9},
 CellLabel->"In[74]:=",ExpressionUUID->"76abbfc8-e090-4d5f-bccf-19a404a54dc6"],

Cell["\<\
This takes a list of p-values (actually probabilities from a cumulative \
distribution) and, using the Fisher function, turns them into correlation \
coefficients\
\>", "Text",
 CellChangeTimes->{{3.8354831486697483`*^9, 3.835483167070009*^9}, {
  3.835483220002742*^9, 
  3.835483234960606*^9}},ExpressionUUID->"770e967f-0dad-4b5e-9105-\
bfdbdd201933"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToAdjustedCClist", "[", 
   RowBox[{"list_", ",", " ", "vectorlength_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"list", "\[Equal]", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"neglist", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], ",", " ", 
              RowBox[{"1", "-", 
               RowBox[{"Last", "[", "#", "]"}]}]}], "}"}], "&"}], ",", 
           RowBox[{"Select", "[", 
            RowBox[{"list", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"First", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}]}],
           "]"}]}], ",", " ", 
        RowBox[{"poslist", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"list", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], "\[GreaterEqual]", "0"}], 
            "&"}]}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Join", "[", " ", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"PvalToCorrelFisher", "[", 
            RowBox[{"#", ",", " ", "vectorlength"}], "]"}], "&"}], ",", " ", 
          "neglist"}], "]"}], ",", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"PvalToCorrelFisher", "[", 
            RowBox[{"#", ",", " ", "vectorlength"}], "]"}], "&"}], ",", " ", 
          "poslist"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.835437948581744*^9, 3.835437967555969*^9}, {
  3.835438018668522*^9, 3.835438114372633*^9}, {3.8354381499526987`*^9, 
  3.835438197940687*^9}, {3.835438265940407*^9, 3.8354382971768312`*^9}, {
  3.8354383658792887`*^9, 3.835438404174036*^9}, {3.8354387536967163`*^9, 
  3.835438822748632*^9}, {3.835438867486025*^9, 3.8354388828735027`*^9}, {
  3.835438928179452*^9, 3.835439035980008*^9}, {3.835624592469824*^9, 
  3.835624603223398*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[218]:=",ExpressionUUID->"a3b9ff9f-bae6-40a6-a385-d77133600771"]
}, Closed]],

Cell[CellGroupData[{

Cell["BH (BenjaminiHochberg)", "Subsubsection",
 CellChangeTimes->{{3.833289970461182*^9, 3.833289992083272*^9}, 
   3.8346782297946787`*^9, {3.850587632162613*^9, 
   3.850587636269288*^9}},ExpressionUUID->"cd97fe32-c9a3-4f98-853d-\
43fa41a53bfd"],

Cell["\<\
This code implements the Benjamini Hochberg procedure for correcting multiple \
sampling by finding a cutoff p-value below which a certain FDR is achieved.  \
In this procedure, one orders a set of p-values and sequentially queries, \
from lowest to highest, whether a p-value is less than its rank times the \
stipulated FDR divided by the total number of p-values.  It returns the first \
p-value for which this condition fails.  That may be used as a cutoff \
p-value, below which statistical significance is achieved.  

N.B. if we are using this on a list where a whole bunch of p-values have been \
deleted because they are below some threshold, we need to account for that.  \
So the second version of the function adds the argument, altlength, where we \
specify a different length. 

The second version of these functions uses a compiled intermediate function \
to speed up the running time four to five fold  \
\>", "Text",
 CellChangeTimes->{{3.833241092387398*^9, 3.833241243649514*^9}, {
   3.846518615662373*^9, 3.8465186419091883`*^9}, {3.84858328385686*^9, 
   3.848583399795512*^9}, {3.85056347645487*^9, 3.850563484505278*^9}, 
   3.8505635492885942`*^9, {3.850564173452066*^9, 3.850564209830208*^9}, {
   3.850564288955282*^9, 
   3.8505643005323553`*^9}},ExpressionUUID->"920945f4-16b8-4dfa-94ff-\
eff93dcb777c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BH", "[", 
   RowBox[{"pvals_", ",", " ", "\[Alpha]_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"list", "=", " ", 
      RowBox[{"Sort", "[", "pvals", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"list", "[", 
     RowBox[{"[", 
      RowBox[{"First", "[", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"list", "*", 
           RowBox[{"Length", "[", "pvals", "]"}]}], 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "list", "]"}], "]"}]], ",", " ", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", ">", "\[Alpha]"}]}]}], "]"}], "]"}], "]"}], "]"}]}], 
   "]"}], "  "}]], "Input",
 CellChangeTimes->{{3.849658389580474*^9, 3.8496583931810637`*^9}, {
   3.849658475946677*^9, 3.849658497644909*^9}, {3.849658568951893*^9, 
