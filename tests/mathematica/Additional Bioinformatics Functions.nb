           RowBox[{
            RowBox[{"collection", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], "->", 
            "\[IndentingNewLine]", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"hits", "=", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{
                    RowBox[{"gNO", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], 
                   "/@", 
                   RowBox[{"collection", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", 
                    RowBox[{"2", ";;"}]}], "]"}], "]"}]}], "]"}]}], ",", 
                RowBox[{"setlength", " ", "=", " ", 
                 RowBox[{"Length", "[", 
                  RowBox[{"collection", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", 
                    RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}]}]}], "}"}], ",",
               " ", 
              FractionBox[
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"gNO", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", " ", "hits", ",", " ", "hits"}], "]"}], 
                    "]"}], "[", "\"\<ExplicitLength\>\"", "]"}], "]"}], ")"}],
                 "-", 
                RowBox[{"(", 
                 RowBox[{"meanfunc", "/.", 
                  RowBox[{"x", "->", " ", "setlength"}]}], ")"}]}], 
               RowBox[{"sdfunc", "/.", 
                RowBox[{"x", "->", "setlength"}]}]]}], " ", "]"}]}], " ", ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", "50"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], ">", "3"}], "&"}]}], "]"}], ",", 
       "Last"}], "]"}]}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.884374762454831*^9, 3.88437480119302*^9}, 
   3.884375031178829*^9, {3.884375159767218*^9, 3.884375277686881*^9}, {
