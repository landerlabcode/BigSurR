Cell[CellGroupData[{

Cell["DatasetToMatpac", "Subsubsection",
 CellChangeTimes->{{3.833205208974943*^9, 
  3.833205219634369*^9}},ExpressionUUID->"0fa86e82-d9a7-4ca7-999f-\
1c36c4f7b107"],

Cell["\<\
This turns a dataset into a matpac;   Setting the option \
\[OpenCurlyDoubleQuote]Sparse\[CloseCurlyDoubleQuote] to True causes the \
matrix in the resulting matpac to be formatted as a SparseArray.
Not the argument fed to this must be a dataset with both row and column \
labels.\
\>", "Text",
 CellChangeTimes->{{3.833203805091696*^9, 3.8332038106336813`*^9}, {
