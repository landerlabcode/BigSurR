Cell[CellGroupData[{

Cell["Repack", "Subsubsection",
 CellChangeTimes->{{3.832259041740408*^9, 
  3.832259044399432*^9}},ExpressionUUID->"8f9fc228-296f-4d94-9d92-\
86154255fa5e"],

Cell["\<\
This takes a list of the form (matrix, rowlabels, columnlabels),  and \
attaches column and row labels to the matrix.  It discards metadata\
\>", "Text",
 CellChangeTimes->{{3.832259047962429*^9, 3.832259119416109*^9}, {
  3.835017146165338*^9, 
  3.8350171682275667`*^9}},ExpressionUUID->"f9ee847d-0972-4818-a9ab-\
8fa79b332c39"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Repack", "[", "matpac_", "]"}], ":=", " ", 
  RowBox[{"JoinColumnLeft", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "_", "}"}], ",", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"JoinRowTop", "[", 
     RowBox[{
      RowBox[{"matpac", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8322595932929697`*^9, 3.832259612205933*^9}, {
  3.832259700199389*^9, 3.832259712405938*^9}, {3.832260018597081*^9, 
  3.8322600208556643`*^9}, {3.832260090793344*^9, 3.832260096979726*^9}, {
  3.832260185526383*^9, 3.832260193146249*^9}, {3.8839108467413397`*^9, 
  3.883910849075131*^9}, {3.883910898014534*^9, 3.883910903284081*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[17]:=",ExpressionUUID->"83d7fb13-38a7-4b5c-a1f9-d85149617a74"]
}, Open  ]],

Cell[CellGroupData[{

Cell["UndoLogs", "Subsubsection",
 CellChangeTimes->{{3.842270250082362*^9, 
  3.842270252454688*^9}},ExpressionUUID->"3071ba79-fb28-48a5-af8e-\
5acd3e11dfe2"],

Cell[TextData[{
 "This takes a dataset in which the expression values have been transformed \
via ",
 StyleBox["ln(1+x)",
  FontSlant->"Italic"],
 ", and undoes that transformation.  For data output by SCTransform, it \
restores the data to integer values representing counts.  "
}], "Text",
 CellChangeTimes->{{3.842270256558099*^9, 
  3.8422703344439993`*^9}},ExpressionUUID->"b4d39fd1-d89f-4a97-97ea-\
1cee98d6c90f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UndoLogs", "[", "matpac_", "]"}], ":=", " ", 
  RowBox[{"ReplacePart", "[", 
   RowBox[{"matpac", ",", " ", 
    RowBox[{"1", "\[Rule]", "  ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"Exp", "[", "#", "]"}]}], ")"}], "&"}], ",", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"{", "2", "}"}]}], " ", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8422699955934553`*^9, 3.842270001628186*^9}, {
   3.842270041012602*^9, 3.842270212103367*^9}, {3.842270489457603*^9, 
   3.84227049940831*^9}, 3.842270623771503*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[18]:=",ExpressionUUID->"898d4ffa-cc82-4089-b6ef-1c688fb7b329"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MatPacToDataset", "Subsubsection",
 CellChangeTimes->{{3.833203790169098*^9, 3.833203800877689*^9}, {
   3.83320405166003*^9, 3.83320405238758*^9}, 
   3.857518126858529*^9},ExpressionUUID->"a65fcae7-a3d2-46b5-a105-\
c18e71b4bf35"],

Cell["This turns a matpac into an dataset; It discards metadata.", "Text",
 CellChangeTimes->{{3.833203805091696*^9, 3.8332038106336813`*^9}, {
  3.83320406415905*^9, 3.8332040650269613`*^9}, {3.833205849110798*^9, 
  3.8332058674576073`*^9}, {3.835017187107979*^9, 
  3.8350171887791*^9}},ExpressionUUID->"52ce8e32-3417-4053-985a-7adff31310d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MatPacToDataset", "]"}], "=", 
   RowBox[{"Options", "[", "Dataset", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatPacToDataset", "[", 
   RowBox[{"matpac_", ",", " ", 
    RowBox[{"opt", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Which", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}], "\[NotEqual]", " ", "0"}], "&&", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "]"}], "\[NotEqual]", " ", "0"}]}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"Dataset", "[", 
     RowBox[{
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"matpac", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"matpac", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
         RowBox[{"matpac", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ",", 
      RowBox[{"Evaluate", "@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "opt", "}"}], ",", " ", 
           RowBox[{"Options", "[", "MatPacToDataset", "]"}]}], "]"}], ",", 
         " ", 
         RowBox[{"Options", "[", "Dataset", "]"}]}], "]"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "]"}], "\[NotEqual]", " ", "0"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Dataset", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"matpac", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"Evaluate", "@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "opt", "}"}], ",", " ", 
           RowBox[{"Options", "[", "MatPacToDataset", "]"}]}], "]"}], ",", 
         " ", 
         RowBox[{"Options", "[", "Dataset", "]"}]}], "]"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "]"}], "\[NotEqual]", " ", "0"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Dataset", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"matpac", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"Evaluate", "@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "opt", "}"}], ",", " ", 
           RowBox[{"Options", "[", "MatPacToDataset", "]"}]}], "]"}], ",", 
         " ", 
         RowBox[{"Options", "[", "Dataset", "]"}]}], "]"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", "True", ",", 
    RowBox[{"Print", "[", "\"\<No labels; cannot convert\>\"", "]"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.8332038460984697`*^9, 3.833203871557212*^9}, {
  3.833204047581195*^9, 3.833204048571252*^9}, {3.8332041100525618`*^9, 
  3.833204290467074*^9}, {3.833204355809101*^9, 3.833204383631229*^9}, {
  3.833204939540112*^9, 3.833205042500399*^9}, {3.833205091278946*^9, 
  3.8332050948017893`*^9}, {3.835014363983178*^9, 3.835014459956973*^9}, {
  3.835014496070366*^9, 3.835014534772644*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[19]:=",ExpressionUUID->"7a9cc6bf-dd06-492d-9dc6-06948f383e61"]
