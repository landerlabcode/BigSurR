              RowBox[{"tick1", "[", 
               RowBox[{"[", "#", "]"}], "]"}], ",", 
              RowBox[{"Pi", "/", "2"}]}], "]"}], ",", " ", "Black"}], "]"}]}],
          "}"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "tick1", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
