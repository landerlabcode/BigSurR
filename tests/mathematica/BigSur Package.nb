           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}], "3"], "\[ScriptCapitalJ]3"}]], 
         ")"}], 
        RowBox[{"DotProductCF", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"ematrix", "*", " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{
               SuperscriptBox["c", "2"], " ", "ematrix", " ", 
               RowBox[{"(", 
                RowBox[{"3", "+", 
                 RowBox[{
                  SuperscriptBox["c", "2"], " ", 
                  RowBox[{"(", 
                   RowBox[{"3", "+", 
                    SuperscriptBox["c", "2"]}], ")"}], "ematrix"}]}], 
                ")"}]}]}], ")"}]}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"ematrix", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{
                 SuperscriptBox["c", "2"], " ", "ematrix"}]}], ")"}]}], ")"}], 
            RowBox[{"3", "/", "2"}]]], " ", ",", " ", "n"}], "]"}]}], " ", 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}], "4"]], ")"}], 
