   3.891014960992536*^9}, {3.891014991990636*^9, 3.891015007494443*^9}, {
   3.8910150446689053`*^9, 3.8910150523496027`*^9}, {3.891015457901854*^9, 
   3.89101547025742*^9}, {3.891015575345894*^9, 3.891015594746956*^9}, 
   3.891015694186968*^9, {3.891015784917047*^9, 3.891015802982727*^9}, {
   3.891015837603064*^9, 3.891015869637557*^9}, {3.891016363051857*^9, 
   3.891016527913589*^9}, {3.891261242695375*^9, 3.891261268909308*^9}, {
   3.8912617056815357`*^9, 3.891261724789147*^9}, 3.891264406595324*^9, {
   3.891265952362261*^9, 3.891266007110487*^9}, 3.891267433207403*^9, {
