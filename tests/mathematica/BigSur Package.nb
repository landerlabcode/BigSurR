Cell[BoxData[
 RowBox[{
  RowBox[{"FoundrootsAlt", "[", "params_", "]"}], ":=", " ", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"TakeSmallestBy", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "/.", 
          RowBox[{"{", 
           RowBox[{"ToRules", "[", 
            RowBox[{"NRoots", "[", 
             RowBox[{"#", ",", "x"}], "]"}], "]"}], "}"}]}], "/.", 
         RowBox[{"_Complex", "->", " ", "z"}]}], ")"}], ",", " ", "Abs", ",", 
       "1"}], "]"}], "&"}], "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", ".", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "x", ",", " ", 
           SuperscriptBox["x", "2"], ",", " ", 
           SuperscriptBox["x", "3"], ",", " ", 
           SuperscriptBox["x", "4"], ",", "0"}], "}"}]}], "==", "0"}], "&"}], 
      "/@", "params"}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.967158660910774*^9, 3.9671586906748667`*^9}, {
  3.967158741420452*^9, 3.967158747155012*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[71]:=",ExpressionUUID->"3c2ffea6-dd1e-4790-adfd-a50ff57ebdfb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindZ", "[", "augmentedParams_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rootrules", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{"0", "==", 
           RowBox[{"augmentedParams", ".", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", 
              RowBox[{"2", " ", "x"}], ",", 
              RowBox[{"3", " ", 
               SuperscriptBox["x", "2"]}], ",", 
              RowBox[{"4", " ", 
               SuperscriptBox["x", "3"]}], ",", "0"}], "}"}]}]}], ",", "x"}], 
         "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Im", "[", 
           RowBox[{"x", "/.", "#"}], "]"}], "==", "0"}], "&"}]}], "]"}]}], 
     "}"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vals", "=", 
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"augmentedParams", ".", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "x", ",", " ", 
             SuperscriptBox["x", "2"], ",", " ", 
             SuperscriptBox["x", "3"], ",", " ", 
             SuperscriptBox["x", "4"], ",", "0"}], "}"}]}], "/.", 
          "rootrules"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"x", "/.", 
       RowBox[{"rootrules", "[", 
        RowBox[{"[", 
         RowBox[{"First", "[", 
          RowBox[{"Ordering", "[", 
           RowBox[{"Abs", "[", "vals", "]"}], "]"}], "]"}], "]"}], "]"}]}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.890919544131463*^9, 3.89091967359699*^9}, {
  3.890919707033305*^9, 3.890919731557179*^9}, {3.8909200385959597`*^9, 
  3.8909200446995583`*^9}, {3.890920144776422*^9, 3.8909201669751253`*^9}, {
  3.8909202438314238`*^9, 3.8909202467409687`*^9}},
