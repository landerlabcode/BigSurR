Cell[CellGroupData[{

Cell["BigSurAlt7", "Subsubsection",
 CellChangeTimes->{{3.964953212886732*^9, 3.964953216554319*^9}, 
   3.967415786864484*^9},ExpressionUUID->"6c22fed9-a9fe-4962-8703-\
76764c4f7034"],

Cell["\<\
On 3/23/36 the code was modified to save the metadata from the matpac to a \
file.  \
\>", "Text",
 CellChangeTimes->{{3.983307660250554*^9, 
  3.983307693532126*^9}},ExpressionUUID->"baa4732e-e307-463d-93a3-\
239870de7574"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "BigSurAlt7", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Correlations\>\"", "->", " ", "False"}], ",", " ", 
      RowBox[{"\"\<alpha\>\"", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"\"\<Pvalue\>\"", "->", " ", "\"\<BH\>\""}], ",", 
      RowBox[{"\"\<First Pass Cutoff\>\"", "->", " ", "2"}], ",", 
      RowBox[{"\"\<Fano Inverse Sqrt Moments\>\"", "->", " ", "True"}], ",", 
      " ", 
      RowBox[{"\"\<Find Communities\>\"", "->", " ", "True"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BigSurAlt7", "[", 
     RowBox[{
     "matpac_", ",", " ", "\[Eta]_", ",", " ", "\[Theta]_", ",", 
      "filemarker_", ",", "depthscaling_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "foldername", ",", "n", ",", "m", ",", "z", ",", "clist", ",", " ", 
        "negccthreshold", ",", " ", "mat", ",", " ", "depthlist", ",", " ", 
        "genetotals", ",", " ", "ematrix", ",", " ", "pmatrix", ",", " ", 
        "mflist", ",", "fanocorrectionmatrices", ",", " ", "pccmatrix", ",", 
        "\[Kappa]lists", ",", "ccmats", ",", "polylist", ",", " ", 
        "polymatrix", ",", "equationslist", ",", "logplist", ",", 
        "pccSignmatrix", ",", "augmentedParameters", ",", "xlist", ",", 
        "equivalentPCCs", ",", "logpmatrix", ",", " ", "rows", ",", 
        "randomematrix", ",", "randommat", ",", "randompmatrix", ",", " ", 
        "randommflist", ",", "randomfanocorrectionmatrices", ",", 
        "invsqrtmoments", ",", "randompolymatrix", ",", "randompccmatrix", 
        ",", "randomccmats", ",", "randompccSignmatrix", ",", 
        "randomaugmentedParameters", ",", "randomxlist", ",", 
        "randomlogpmatrix", ",", "cutoff", ",", " ", "bhcutoff", ",", " ", 
        "bonferroni", ",", "sigcutofflevel", ",", "sigcutofflist", ",", 
        "truesigdata", ",", "randomsigdata", ",", "significantPCCmatrix", ",",
         "gno", ",", " ", "subsetgno", ",", "communities"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mat", "=", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"genetotals", " ", "=", " ", 
        RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], 
         ",", " ", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], 
          ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Tally", "[", 
             RowBox[{"matpac", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
             RowBox[{"y", ">", "1"}]}]}], "]"}], ">", "0"}], ",", " ", 
         RowBox[{
          RowBox[{
          "Print", "[", "\"\<Matpac contains duplicated genes\>\"", "]"}], 
          ";", " ", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"n", "=", 
        RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"clist", "=", 
        RowBox[{
         RowBox[{
          SqrtBox[
           RowBox[{
            FractionBox["\[Eta]", "#"], "+", " ", "\[Theta]"}]], "&"}], "/@", 
         
         RowBox[{"N", "[", 
          FractionBox["genetotals", "n"], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"SetDirectory", "[", 
        RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Started on\>\"", ",", 
         RowBox[{"CurrentDate", "[", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"foldername", "=", 
        RowBox[{"filemarker", "<>", 
         RowBox[{"DateString", "[", "]"}], "<>", "\"\< \[Eta]=\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Round", "[", 
           RowBox[{"\[Eta]", ",", "0.001"}], "]"}], "]"}], "<>", 
         "\"\< \[Theta]=\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Round", "[", 
           RowBox[{"\[Theta]", ",", "0.001"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"CreateDirectory", "[", "foldername", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"SetDirectory", "[", "foldername", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<Folder name is\>\"", "]"}], ";", 
       RowBox[{"Print", "[", "foldername", "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_matpac metadata.mx\>\""}], ",", 
         " ", 
         RowBox[{"matpac", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"depthlist", " ", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
          RowBox[{"N", "[", "depthscaling", "]"}], ",", 
          FractionBox[
           RowBox[{"Total", "/@", 
            RowBox[{"N", "[", 
             RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
           RowBox[{"Total", "[", 
            RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ematrix", " ", "=", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pmatrix", " ", "=", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"mat", "-", "ematrix"}], ")"}], 
         SqrtBox[
          RowBox[{"ematrix", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              SuperscriptBox["clist", "2"], "ematrix"}]}], ")"}]}]]]}], "  ", 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_cell-specific residuals.mx\>\""}], 
         ",", " ", "pmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"mflist", " ", "=", " ", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"n", "-", "1"}]], 
         RowBox[{"Total", "/@", 
          RowBox[{"(", 
           SuperscriptBox["pmatrix", "2"], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{
         "filemarker", "<>", "\"\<_modified_corrected_Fano factors.mx\>\""}], 
         ",", " ", "mflist"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Modified, corrected Fano factors acquired and saved\>\"", ",", 
         " ", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Kappa]lists", "=", 
        RowBox[{"FanoCumulants5CFAlt", "[", 
         RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polylist", "=", 
        RowBox[{"CornishFisherPolynomialCoefficientsforFano5CF", "[", 
         RowBox[{
          RowBox[{"\[Kappa]lists", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"\[Kappa]lists", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"\[Kappa]lists", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"\[Kappa]lists", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "mflist"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"equationslist", " ", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            SuperscriptBox["x", "k"], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
          "polylist"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"logplist", "=", 
        RowBox[{"FixedPosPValFunc", "/@", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"0", ",", "#"}], "]"}], "&"}], ",", 
           RowBox[{"Min", "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "/.", 
                  RowBox[{"FindInstance", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", "==", "0"}], "&&", 
                    RowBox[{"x", ">", "0"}]}], ",", "x", ",", "Reals", ",", 
                    "2"}], "]"}]}], ")"}], "/.", 
                RowBox[{"x", "->", 
                 RowBox[{"{", "0", "}"}]}]}], "&"}], "/@", "equationslist"}], 
             ")"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_fanopvalues.mx\>\""}], ",", " ", 
         "logplist"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Fano p-values acquired and saved\>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"OptionValue", "[", " ", "\"\<Correlations\>\"", "]"}], "==",
           " ", "False"}], ",", " ", 
         RowBox[{"Goto", "[", "end", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pccmatrix", "=", 
        RowBox[{"DotProductCF", "[", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           FractionBox["pmatrix", 
            SqrtBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", "1"}], ")"}], "mflist"}]]], "]"}], ",", 
          "n"}], "]"}]}], " ", ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_pccmatrix.mx\>\""}], ",", " ", 
         "pccmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Modified corrected correlations acquired and saved \>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pccSignmatrix", " ", "=", " ", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"LowerTriangularize", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BoolEval", "[", 
             RowBox[{"pccmatrix", ">", "0"}], "]"}], "-", 
            RowBox[{"BoolEval", "[", 
             RowBox[{"pccmatrix", "<=", "0"}], "]"}]}], ",", 
           RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "OptionValue", "[", "\"\<Fano Inverse Sqrt Moments\>\"", "]"}], "==",
           "True"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"invsqrtmoments", "=", 
           RowBox[{"InverseSqrtMomentListsAltNew", "[", 
            RowBox[{
            "genetotals", ",", "depthlist", ",", " ", "\[Eta]", ",", " ", 
             "\[Theta]", ",", " ", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"filemarker", "<>", "\"\<_invsqrtmoments.mx\>\""}], ",", 
            " ", "invsqrtmoments"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<inverse squareroot Fano moments acquired and saved \>\"", ",", 
            RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"fanocorrectionmatrices", "=", 
           RowBox[{"SqrtCorrectionmats", "[", 
            RowBox[{"invsqrtmoments", ",", "genetotals"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fanocorrectionmatrices", "=", 
           RowBox[{"Table", "[", " ", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"1", ",", 
               RowBox[{"{", 
                RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", "4"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{
          "Print", "[", "\"\<inverse squareroot Fano moments ignored \>\"", 
           "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ccmats", "=", 
        RowBox[{"CorrelationCumulantsNewCFAlt", "[", 
         RowBox[{"ematrix", ",", 
          RowBox[{"fanocorrectionmatrices", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"fanocorrectionmatrices", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"fanocorrectionmatrices", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"fanocorrectionmatrices", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "clist", ",", "n"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Adjusted cumulants of the correlations acquired\>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polymatrix", "=", 
        RowBox[{"CornishFisherPolynomialCoefficients5CF", "[", 
         RowBox[{
          RowBox[{"ccmats", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"ccmats", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"ccmats", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"ccmats", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", ",", "pccmatrix"}], "]"}]}], 
       " ", ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Cornish Fisher Polynomial Coefficients acquired\>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"augmentedParameters", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"SymmetricMatrixToListNew", "/@", 
          RowBox[{"Append", "[", 
           RowBox[{"polymatrix", ",", " ", "pccSignmatrix"}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "augmentedParameters", "]"}], "]"}], "<>", 
