             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"n", "-", "1"}], ")"}], "5"], "\[ScriptCapitalJ]5"}]], 
           ")"}], " ", 
          RowBox[{"DotProductCF", "[", 
           RowBox[{
            RowBox[{
             FractionBox["1", 
              RowBox[{
               SuperscriptBox["ematrix", 
                RowBox[{"3", "/", "2"}]], " ", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   SuperscriptBox["c", "2"], " ", "ematrix"}]}], ")"}], 
                RowBox[{"5", "/", "2"}]]}]], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"ematrix", " ", 
                RowBox[{"(", 
                 RowBox[{"10", "+", 
                  RowBox[{
                   SuperscriptBox["c", "2"], " ", 
                   RowBox[{"(", 
                    RowBox[{"15", "+", 
                    RowBox[{"ematrix", " ", 
                    RowBox[{"(", 
                    RowBox[{"40", "+", 
                    RowBox[{
                    SuperscriptBox["c", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"75", "+", 
                    RowBox[{"60", " ", "ematrix"}], "+", 
                    RowBox[{
                    SuperscriptBox["c", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"25", "+", 
                    RowBox[{"10", " ", 
                    RowBox[{"(", 
                    RowBox[{"17", "+", 
                    RowBox[{"15", " ", 
                    SuperscriptBox["c", "2"]}], "+", 
                    RowBox[{"6", " ", 
                    SuperscriptBox["c", "4"]}], "+", 
                    SuperscriptBox["c", "6"]}], ")"}], " ", "ematrix"}], "+", 
                    
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "+", 
                    SuperscriptBox["c", "2"]}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"15", "+", 
                    RowBox[{"60", " ", 
                    SuperscriptBox["c", "2"]}], "+", 
                    RowBox[{"81", " ", 
                    SuperscriptBox["c", "4"]}], "+", 
                    RowBox[{"62", " ", 
                    SuperscriptBox["c", "6"]}], "+", 
                    RowBox[{"29", " ", 
                    SuperscriptBox["c", "8"]}], "+", 
                    RowBox[{"8", " ", 
                    SuperscriptBox["c", "10"]}], "+", 
                    SuperscriptBox["c", "12"]}], ")"}], " ", 
                    SuperscriptBox["ematrix", "2"]}]}], ")"}]}]}], ")"}]}]}], 
                    ")"}]}]}], ")"}]}]}], ")"}]}]}], ")"}]}], ",", "n"}], 
