 Background->RGBColor[1, 1, 0],
 CellLabel->"In[96]:=",ExpressionUUID->"437a2bdd-b0ee-4643-a76d-25b4bbe4c86c"]
}, Closed]],

Cell[CellGroupData[{

Cell["BigSurAlt4", "Subsubsection",
 CellChangeTimes->{{3.890065212137455*^9, 3.890065229611292*^9}, 
   3.890915989050908*^9},ExpressionUUID->"1c40ded3-f144-4f04-8d2c-\
cab89e0501b5"],

Cell["\<\
Here we use the proper matrix corrections for the square roots of the Fano \
factors.  And we fixed the root finding so it doesn\[CloseCurlyQuote]t need a \
\[OpenCurlyDoubleQuote]CFThreshold\[CloseCurlyDoubleQuote] anymore.  
We  add in an option, \[OpenCurlyDoubleQuote]Fano Inverse Sqrt Moments\
\[CloseCurlyDoubleQuote], however, to block the generation of these when we \
set it to False, in case we want to see whether the results come out the same;\
\>", "Text",
 CellChangeTimes->{{3.890065232458729*^9, 3.890065250334845*^9}, {
  3.890065835904763*^9, 3.890065859641531*^9}, {3.8900662296333227`*^9, 
  3.89006624973251*^9}, {3.8909159916626177`*^9, 3.890916018008998*^9}, {
  3.891014771700521*^9, 3.891014804680388*^9}, {3.891854422156548*^9, 
  3.891854439545184*^9}},ExpressionUUID->"805ece29-f2a9-4091-b13e-\
652e2b4de295"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "BigSurAlt4", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Correlations\>\"", "->", " ", "False"}], ",", " ", 
      RowBox[{"\"\<alpha\>\"", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"\"\<Pvalue\>\"", "->", " ", "\"\<BH\>\""}], ",", 
      RowBox[{"\"\<First Pass Cutoff\>\"", "->", " ", "2"}], ",", 
      RowBox[{"\"\<Fano Inverse Sqrt Moments\>\"", "->", " ", "True"}], ",", 
      " ", 
      RowBox[{"\"\<Interrupt\>\"", "->", " ", "True"}], " ", ",", 
      RowBox[{"\"\<Find Communities\>\"", "->", " ", "True"}]}], "}"}]}], ";",
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"BigSurAlt4", "[", 
     RowBox[{
     "matpac_", ",", " ", "c_", ",", " ", "filemarker_", ",", "depthscaling_",
       ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "foldername", ",", "n", ",", "m", ",", "z", ",", "negccthreshold", ",",
         " ", "mat", ",", " ", "depthlist", ",", " ", "genetotals", ",", " ", 
        "ematrix", ",", " ", "pmatrix", ",", " ", "mflist", ",", 
        "invsqrtmoments", ",", "fanocorrectionmatrices", ",", " ", 
        "pccmatrix", ",", "\[Kappa]lists", ",", "ccmats", ",", "polylist", 
        ",", " ", "polymatrix", ",", "equationslist", ",", "logplist", ",", 
        "pccSignmatrix", ",", "augmentedParameters", ",", "xlist", ",", 
        "logpmatrix", ",", "equivalentPCCs", ",", " ", "rows", ",", 
        "randomematrix", ",", "randommat", ",", "randompmatrix", ",", " ", 
        "randommflist", ",", "randomfanocorrectionmatrices", ",", 
        "randompolymatrix", ",", "randompccmatrix", ",", "randomccmats", ",", 
        "randompccSignmatrix", ",", "randomaugmentedParameters", ",", 
        "randomxlist", ",", "randomlogpmatrix", ",", "cutoff", ",", " ", 
        "bhcutoff", ",", " ", "bonferroni", ",", "sigcutofflevel", ",", 
        "sigcutofflist", ",", "truesigdata", ",", "randomsigdata", ",", 
        "significantPCCmatrix", ",", "gno", ",", " ", "subsetgno", ",", 
        "communities"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mat", "=", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"genetotals", " ", "=", " ", 
        RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], 
         ",", " ", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], 
          ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Tally", "[", 
             RowBox[{"matpac", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
             RowBox[{"y", ">", "1"}]}]}], "]"}], ">", "0"}], ",", " ", 
         RowBox[{
          RowBox[{
          "Print", "[", "\"\<Matpac contains duplicated genes\>\"", "]"}], 
          ";", " ", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"c", "<=", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<c must be greater than zero\>\"", "]"}], 
          ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"n", "=", 
        RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"SetDirectory", "[", 
        RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Started on\>\"", ",", 
         RowBox[{"CurrentDate", "[", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"foldername", "=", 
        RowBox[{"filemarker", "<>", 
         RowBox[{"DateString", "[", "]"}], "<>", "\"\< c=\>\"", "<>", 
         RowBox[{"ToString", "[", "c", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"CreateDirectory", "[", "foldername", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"SetDirectory", "[", "foldername", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<Folder name is\>\"", "]"}], ";", 
       RowBox[{"Print", "[", "foldername", "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"depthlist", " ", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
          RowBox[{"N", "[", "depthscaling", "]"}], ",", 
          FractionBox[
           RowBox[{"Total", "/@", 
            RowBox[{"N", "[", 
             RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
           RowBox[{"Total", "[", 
            RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ematrix", " ", "=", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pmatrix", " ", "=", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"mat", "-", "ematrix"}], ")"}], 
         SqrtBox[
          RowBox[{"ematrix", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              SuperscriptBox["c", "2"], "ematrix"}]}], ")"}]}]]]}], "  ", ";",
        "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_cell-specific residuals.mx\>\""}], 
         ",", " ", "pmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"mflist", " ", "=", " ", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"n", "-", "1"}]], 
         RowBox[{"Total", "/@", 
          RowBox[{"(", 
           SuperscriptBox["pmatrix", "2"], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{
         "filemarker", "<>", "\"\<_modified_corrected_Fano factors.mx\>\""}], 
         ",", " ", "mflist"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Modified, corrected Fano factors acquired and saved\>\"", ",", 
         " ", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<mcFano slope between 0.01 and 10 is \>\"", ",", 
         RowBox[{"a", "/.", 
          RowBox[{"FindFit", "[", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"MapThread", "[", 
               RowBox[{"List", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Log10", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{"Mean", "[", "#", "]"}], "]"}], "]"}], "&"}], "/@",
                    "mat"}], ",", " ", "mflist"}], "}"}]}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], "<", 
                RowBox[{"First", "[", "#", "]"}], "<", "1"}], "&"}]}], "]"}], 
            ",", 
            RowBox[{
             RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Interrupt\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", "\"\<Continue or try a different value of c?\>\"", 
           "]"}], ";", 
          RowBox[{"Interrupt", "[", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Kappa]lists", "=", 
        RowBox[{"FanoCumulants5CF", "[", 
         RowBox[{"ematrix", ",", "c", ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polylist", "=", 
        RowBox[{"CornishFisherPolynomialCoefficientsforFano5CF", "[", 
         RowBox[{
          RowBox[{"\[Kappa]lists", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"\[Kappa]lists", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"\[Kappa]lists", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"\[Kappa]lists", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "mflist"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"equationslist", " ", "=", 
        RowBox[{"Dot", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            SuperscriptBox["x", "k"], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
          "polylist"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"logplist", "=", 
        RowBox[{"FixedPosPValFunc", "/@", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"0", ",", "#"}], "]"}], "&"}], ",", 
           RowBox[{"Min", "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "/.", 
                  RowBox[{"FindInstance", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", "==", "0"}], "&&", 
                    RowBox[{"x", ">", "0"}]}], ",", "x", ",", "Reals", ",", 
                    "2"}], "]"}]}], ")"}], "/.", 
                RowBox[{"x", "->", 
                 RowBox[{"{", "0", "}"}]}]}], "&"}], "/@", "equationslist"}], 
             ")"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_fanopvalues.mx\>\""}], ",", " ", 
         "logplist"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Fano p-values acquired and saved\>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"OptionValue", "[", " ", "\"\<Correlations\>\"", "]"}], "==",
           " ", "False"}], ",", " ", 
         RowBox[{"Goto", "[", "end", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pccmatrix", "=", 
        RowBox[{"DotProductCF", "[", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           FractionBox["pmatrix", 
            SqrtBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", "1"}], ")"}], "mflist"}]]], "]"}], ",", 
          "n"}], "]"}]}], " ", ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_pccmatrix.mx\>\""}], ",", " ", 
         "pccmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<corrected modified correlations acquired and saved \>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pccSignmatrix", " ", "=", " ", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"LowerTriangularize", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BoolEval", "[", 
             RowBox[{"pccmatrix", ">", "0"}], "]"}], "-", 
            RowBox[{"BoolEval", "[", 
             RowBox[{"pccmatrix", "<=", "0"}], "]"}]}], ",", 
           RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "OptionValue", "[", "\"\<Fano Inverse Sqrt Moments\>\"", "]"}], "==",
           "True"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"invsqrtmoments", "=", 
           RowBox[{"InverseSqrtMomentLists", "[", 
            RowBox[{
            "genetotals", ",", "depthlist", ",", " ", "c", ",", " ", "n"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"filemarker", "<>", "\"\<_invsqrtmoments.mx\>\""}], ",", 
            " ", "invsqrtmoments"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<inverse squareroot Fano moments acquired and saved \>\"", ",", 
            RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"fanocorrectionmatrices", "=", 
           RowBox[{"SqrtCorrectionmats", "[", 
            RowBox[{"invsqrtmoments", ",", "genetotals"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"fanocorrectionmatrices", "=", 
           RowBox[{"Table", "[", " ", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"1", ",", 
               RowBox[{"{", 
                RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", "4"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{
          "Print", "[", "\"\<inverse squareroot Fano moments ignored \>\"", 
           "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ccmats", "=", 
        RowBox[{"CorrelationCumulantsNewCF", "[", 
         RowBox[{"ematrix", ",", 
          RowBox[{"fanocorrectionmatrices", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"fanocorrectionmatrices", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"fanocorrectionmatrices", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"fanocorrectionmatrices", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "c", ",", "n"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Adjusted cumulants of the correlations acquired\>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"polymatrix", "=", 
        RowBox[{"CornishFisherPolynomialCoefficients5CF", "[", 
         RowBox[{
          RowBox[{"ccmats", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"ccmats", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"ccmats", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", 
          RowBox[{"ccmats", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", ",", "pccmatrix"}], "]"}]}], 
       " ", ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Cornish Fisher Polynomial Coefficients acquired\>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"augmentedParameters", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"SymmetricMatrixToList", "/@", 
          RowBox[{"Append", "[", 
           RowBox[{"polymatrix", ",", " ", "pccSignmatrix"}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "augmentedParameters", "]"}], "]"}], "<>", 
          "\"\< equations gathered\>\""}], ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xlist", "=", 
        RowBox[{"NewFindX", "[", 
         RowBox[{"augmentedParameters", ",", " ", 
          RowBox[{"OptionValue", "[", "\"\<First Pass Cutoff\>\"", "]"}]}], 
         "]"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_xlist.mx\>\""}], ",", "xlist"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<x-values acquired\>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"logpmatrix", "=", 
        RowBox[{"ListToSymmetricMatrix", "[", 
         RowBox[{"FixedPValFunc", "/@", "xlist"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_logpvalues.mx\>\""}], ",", 
         "logpmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<p-values acquired and saved\>\"", ",", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"equivalentPCCs", " ", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{"InferredPCCs", "[", 
          RowBox[{"logpmatrix", ",", "pccSignmatrix", ",", 
           RowBox[{"OptionValue", "[", "\"\<First Pass Cutoff\>\"", "]"}], 
           ",", " ", "n"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"filemarker", "<>", "\"\<_equivalentPCCs.mx\>\""}], ",", " ",
          "equivalentPCCs"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<equivalent PCCs acquired and saved\>\"", ",", " ", 
         RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "]"}], ",", 
         RowBox[{"sigcutofflist", " ", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], ",", 
            RowBox[{"2", "*", 
             RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}], ",", 
            RowBox[{"3", "*", 
             RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}]}], "}"}]}],
          ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "==", 
          "\"\<BH\>\""}], ",", "\[IndentingNewLine]", 
         RowBox[{"sigcutofflist", " ", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", " ", 
              RowBox[{"2", "#"}], ",", " ", 
              RowBox[{"3", "#"}]}], "}"}], "&"}], "@", 
           RowBox[{"BHNew", "[", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"logpmatrix", "[", "\"\<ExplicitValues\>\"", "]"}], 
                ")"}]}]}], ",", " ", 
             RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], ",", 
             RowBox[{"Binomial", "[", 
              RowBox[{"m", ",", "2"}], "]"}]}], " ", "]"}]}]}], ",", 
         "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
         RowBox[{"sigcutofflist", " ", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}], ",", 
            RowBox[{"2", "*", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
               RowBox[{"Binomial", "[", 
                RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}], ",", 
            RowBox[{"3", "*", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
               RowBox[{"Binomial", "[", 
                RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}]}], "}"}]}]}], "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"\"\<For FDR = \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "]"}], "<>", 
          "\"\<, the significance level is p < \>\""}], ",", 
         RowBox[{"ScientificForm", "[", 
          RowBox[{"sigcutofflist", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"significantPCCmatrix", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{"logpmatrix", ">", 
             RowBox[{"-", 
              RowBox[{"Log10", "[", 
               RowBox[{"sigcutofflist", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "]"}], "*", 
           "equivalentPCCs"}], ",", " ", 
