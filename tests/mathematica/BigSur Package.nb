Cell[BoxData[
 RowBox[{"SecondTestCF", "=", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"c", ",", " ", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", "_Real"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"cutoff", ",", " ", "_Real"}], "}"}]}], "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", 
        RowBox[{
         SqrtBox["2"], " ", 
         RowBox[{"InverseErfc", "[", 
          RowBox[{"2.", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "cutoff"}]]}], "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{"b", "-", 
           RowBox[{"2", " ", "c", " ", "x"}], "+", 
           RowBox[{"3", " ", "d", " ", 
            SuperscriptBox["x", "2"]}], "-", 
           RowBox[{"4", " ", "e", " ", 
            SuperscriptBox["x", "3"]}]}], "]"}], "==", 
         RowBox[{"-", "1"}]}], ",", "1", ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"if", " ", "the", " ", "slope", " ", "at"}], " ", "-", 
          RowBox[{"X", " ", 
           RowBox[{"isn", "'"}], "t", " ", "positive", " ", "we", " ", 
           "keep"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{"b", "+", 
           RowBox[{"2", " ", "c", " ", "x"}], "+", 
           RowBox[{"3", " ", "d", " ", 
            SuperscriptBox["x", "2"]}], "+", 
           RowBox[{"4", " ", "e", " ", 
            SuperscriptBox["x", "3"]}]}], "]"}], "==", 
         RowBox[{"-", "1"}]}], ",", "0", ",", 
        RowBox[{"(*", 
         RowBox[{
         "if", " ", "the", " ", "slope", " ", "at", " ", "X", " ", "is", " ", 
          "negative", " ", "we", " ", "reject"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"3", " ", 
          SuperscriptBox["d", "2"]}], "<", 
         RowBox[{"8", " ", "c", " ", "e"}]}], ",", "1", ",", 
        RowBox[{"(*", 
         RowBox[{
         "if", " ", "there", " ", "is", " ", "no", " ", "inflection", " ", 
          "point", " ", "we", " ", "keep"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "x"}], "<", 
          FractionBox[
           RowBox[{
            RowBox[{"3", " ", "d"}], "-", 
            SqrtBox[
             RowBox[{
              RowBox[{"9", " ", 
               SuperscriptBox["d", "2"]}], "-", 
              RowBox[{"24", " ", "c", " ", "e"}]}]]}], 
           RowBox[{"12", " ", "e"}]], "<", "x"}], " ", "&&", 
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"45", " ", 
             SuperscriptBox["d", "3"]}], "-", 
            RowBox[{"36", " ", "c", " ", "d", " ", "e"}], "-", 
            RowBox[{"15", " ", 
             SuperscriptBox["d", "2"], " ", 
             SqrtBox[
              RowBox[{
               RowBox[{"9", " ", 
                SuperscriptBox["d", "2"]}], "-", 
               RowBox[{"24", " ", "c", " ", "e"}]}]]}], "+", 
            RowBox[{"8", " ", "e", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"9", " ", "b", " ", "e"}], "-", 
               RowBox[{"c", " ", 
                SqrtBox[
                 RowBox[{
                  RowBox[{"9", " ", 
                   SuperscriptBox["d", "2"]}], "-", 
                  RowBox[{"24", " ", "c", " ", "e"}]}]]}]}], ")"}]}]}], " ", 
           "]"}], "==", 
          RowBox[{"-", "1"}]}]}], ",", "0", ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "if", " ", "the", " ", "location", " ", "of", " ", "the", " ", 
           "first", " ", "inflection", " ", "point", " ", "is", " ", 
           RowBox[{"in", " ", "[", 
            RowBox[{
             RowBox[{"-", "X"}], ",", "X"}], "]"}], " ", "AND", " ", "the", 
           " ", "slope", " ", "at", " ", "that", " ", "point", " ", "is", " ",
            "negative"}], ",", " ", 
          RowBox[{"we", " ", "reject"}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "x"}], "<", 
          FractionBox[
           RowBox[{
            RowBox[{"3", " ", "d"}], "+", 
            SqrtBox[
             RowBox[{
              RowBox[{"9", " ", 
               SuperscriptBox["d", "2"]}], "-", 
              RowBox[{"24", " ", "c", " ", "e"}]}]]}], 
           RowBox[{"12", " ", "e"}]], "<", "x"}], " ", "&&", "  ", 
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"45", " ", 
             SuperscriptBox["d", "3"]}], "-", 
            RowBox[{"36", " ", "c", " ", "d", " ", "e"}], "+", 
            RowBox[{"15", " ", 
             SuperscriptBox["d", "2"], " ", 
             SqrtBox[
              RowBox[{
               RowBox[{"9", " ", 
                SuperscriptBox["d", "2"]}], "-", 
               RowBox[{"24", " ", "c", " ", "e"}]}]]}], "+", 
            RowBox[{"8", " ", "e", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"9", " ", "b", " ", "e"}], "+", 
               RowBox[{"c", " ", 
                SqrtBox[
                 RowBox[{
                  RowBox[{"9", " ", 
                   SuperscriptBox["d", "2"]}], "-", 
                  RowBox[{"24", " ", "c", " ", "e"}]}]]}]}], ")"}]}]}], "]"}],
           "==", 
          RowBox[{"-", "1"}]}]}], ",", "0", ",", 
        RowBox[{"(*", 
         RowBox[{"otherwise", ",", " ", 
          RowBox[{
          "if", " ", "the", " ", "location", " ", "of", " ", "the", " ", 
           "second", " ", "inflection", " ", "point", " ", "is", " ", 
           RowBox[{"in", " ", "[", 
            RowBox[{
             RowBox[{"-", "X"}], ",", "X"}], "]"}], " ", "AND", "  ", "slope",
            " ", "at", " ", "that", " ", "point", " ", "is", " ", 
           "negative"}], ",", " ", 
          RowBox[{"we", " ", "reject"}]}], "*)"}], "\[IndentingNewLine]", 
        "True", ",", "1"}], " ", 
       RowBox[{"(*", 
        RowBox[{"otherwise", " ", "we", " ", "keep"}], "*)"}], "]"}]}], "]"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{"RuntimeAttributes", "->", 
     RowBox[{"{", "Listable", "}"}]}], ",", " ", 
    RowBox[{"Parallelization", "->", "True"}]}], "]"}]}]], "Input",
