   3.8909160228803787`*^9, 3.8909160365137568`*^9}, {3.890921627985697*^9, 
   3.8909216927332706`*^9}, {3.890921943323616*^9, 3.890921962622365*^9}, {
   3.8909223338521223`*^9, 3.890922334640703*^9}, {3.891014411216383*^9, 
   3.8910145204751377`*^9}, {3.891014730471527*^9, 3.89101473160423*^9}, {
   3.891014830635631*^9, 3.891014857048785*^9}, {3.89101489007156*^9, 
   3.891014960992536*^9}, {3.891014991990636*^9, 3.891015007494443*^9}, {
   3.8910150446689053`*^9, 3.8910150523496027`*^9}, {3.891015457901854*^9, 
   3.89101547025742*^9}, {3.891015575345894*^9, 3.891015594746956*^9}, 
   3.891015694186968*^9, {3.891015784917047*^9, 3.891015802982727*^9}, {
   3.891015837603064*^9, 3.891015869637557*^9}, {3.891016363051857*^9, 
   3.891016527913589*^9}, {3.891261242695375*^9, 3.891261268909308*^9}, {
   3.8912617056815357`*^9, 3.891261724789147*^9}, 3.891264406595324*^9, {
   3.891265952362261*^9, 3.891266007110487*^9}, 3.891267433207403*^9, {
   3.891267476450068*^9, 3.891267523318478*^9}, {3.891267561139162*^9, 
   3.891267585381033*^9}, {3.891267644944792*^9, 3.891267648471478*^9}, 
   3.891268059187173*^9, {3.8913558539567003`*^9, 3.891355896651029*^9}, {
   3.891456046491762*^9, 3.8914560465911922`*^9}, {3.891456972956435*^9, 
   3.8914569913207073`*^9}, 3.891457604531654*^9, {3.891469573031376*^9, 
   3.891469581332284*^9}, 3.891557543289339*^9, {3.8956815634311533`*^9, 
   3.895681563980618*^9}, {3.895686201440524*^9, 3.895686201836247*^9}, {
   3.8957471326106997`*^9, 3.895747132960764*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[99]:=",ExpressionUUID->"8c9c5e16-2a16-4f27-83fb-1d43d86fde6f"]
