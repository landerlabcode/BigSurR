        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Gene Network Object saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Find Communities\>\"", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"subsetgno", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"GeneSubsetGNO", "[", 
             RowBox[{
              RowBox[{"TruncateGNO", "[", 
               RowBox[{"gno", ",", "0", ",", " ", 
                RowBox[{"\"\<Positive Only\>\"", "->", " ", "True"}]}], "]"}],
               ",", " ", "#"}], "]"}], "&"}], "/@", 
           RowBox[{"ReverseSortBy", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"FindCommunities", "[", "gno", "]"}], ",", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], 
              "]"}], ",", "Length"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"communities", "=", 
          RowBox[{"Quiet", "@", 
           RowBox[{"ReverseSortBy", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Select", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], 
