Cell[CellGroupData[{

Cell["BigSurAlt8", "Subsubsection",
 CellChangeTimes->{{3.964953212886732*^9, 3.964953216554319*^9}, 
   3.967415786864484*^9, 
   3.979985461290639*^9},ExpressionUUID->"652d1b2e-7ef4-4cb7-bddb-\
abcdd5f9293d"],

Cell["\<\
In BigSurAlt8 we switch to the NB distribution for the underlying gene \
expression model.  Note that, on Aug 23, 2026, we added the modification to \
FanoCumulantNB5 that breaks up the expectation matrix into blocks of 1000 \
columns; in cases where the number of cells is large, this is essential to \
avoid blowing the memory.  \
\>", "Text",
 CellChangeTimes->{{3.979985464920082*^9, 3.979985522736918*^9}, 
   3.983487811788045*^9, {3.9965115848682547`*^9, 
   3.996511648368573*^9}},ExpressionUUID->"b89a8d95-557e-4b5e-88bc-\
b8a12dd3fc2a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "BigSurAlt8", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Correlations\>\"", "->", " ", "False"}], ",", " ", 
      RowBox[{"\"\<alpha\>\"", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"\"\<Pvalue\>\"", "->", " ", "\"\<BH\>\""}], ",", 
      RowBox[{"\"\<First Pass Cutoff\>\"", "->", " ", "2"}], ",", 
      RowBox[{"\"\<Fano Inverse Sqrt Moments\>\"", "->", " ", "True"}], ",", 
      " ", 
      RowBox[{"\"\<Find Communities\>\"", "->", " ", "True"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BigSurAlt8", "[", 
    RowBox[{
    "matpac_", ",", " ", "\[Eta]_", ",", " ", "\[Theta]_", ",", "filemarker_",
      ",", "depthscaling_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "foldername", ",", "n", ",", "m", ",", "z", ",", "clist", ",", " ", 
       "negccthreshold", ",", " ", "mat", ",", " ", "depthlist", ",", " ", 
       "genetotals", ",", " ", "ematrix", ",", " ", "pmatrix", ",", " ", 
       "mflist", ",", "fanocorrectionmatrices", ",", " ", "pccmatrix", ",", 
       "\[Kappa]lists", ",", "ccmats", ",", "polylist", ",", " ", 
       "polymatrix", ",", "equationslist", ",", "logplist", ",", 
       "pccSignmatrix", ",", "augmentedParameters", ",", "xlist", ",", 
       "equivalentPCCs", ",", "logpmatrix", ",", " ", "rows", ",", 
       "randomematrix", ",", "randommat", ",", "randompmatrix", ",", " ", 
       "randommflist", ",", "randomfanocorrectionmatrices", ",", 
       "invsqrtmoments", ",", "randompolymatrix", ",", "randompccmatrix", ",",
        "randomccmats", ",", "randompccSignmatrix", ",", 
       "randomaugmentedParameters", ",", "randomxlist", ",", 
       "randomlogpmatrix", ",", "cutoff", ",", " ", "bhcutoff", ",", " ", 
       "bonferroni", ",", "sigcutofflevel", ",", "sigcutofflist", ",", 
       "truesigdata", ",", "randomsigdata", ",", "significantPCCmatrix", ",", 
       "gno", ",", " ", "subsetgno", ",", "communities"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"genetotals", " ", "=", " ", 
       RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], ",",
         " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Tally", "[", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{"y", ">", "1"}]}]}], "]"}], ">", "0"}], ",", " ", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Matpac contains duplicated genes\>\"", "]"}], ";",
          " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"clist", "=", 
       RowBox[{
        RowBox[{
         SqrtBox[
          RowBox[{
           FractionBox["\[Eta]", "#"], "+", " ", "\[Theta]"}]], "&"}], "/@", 
        RowBox[{"N", "[", 
         FractionBox["genetotals", "n"], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Started on\>\"", ",", 
        RowBox[{"CurrentDate", "[", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"foldername", "=", 
       RowBox[{"filemarker", "<>", 
        RowBox[{"DateString", "[", "]"}], "<>", "\"\< \[Eta]=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Round", "[", 
          RowBox[{"\[Eta]", ",", "0.001"}], "]"}], "]"}], "<>", 
        "\"\< \[Theta]=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Round", "[", 
          RowBox[{"\[Theta]", ",", "0.001"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"CreateDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Folder name is\>\"", "]"}], ";", 
      RowBox[{"Print", "[", "foldername", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_matpac metadata.mx\>\""}], ",", " ", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"depthlist", " ", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
         RowBox[{"N", "[", "depthscaling", "]"}], ",", 
         FractionBox[
          RowBox[{"Total", "/@", 
           RowBox[{"N", "[", 
            RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
          RowBox[{"Total", "[", 
           RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ematrix", " ", "=", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pmatrix", " ", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"mat", "-", "ematrix"}], ")"}], 
        SqrtBox[
         RowBox[{"ematrix", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             SuperscriptBox["clist", "2"], "ematrix"}]}], ")"}]}]]]}], "  ", 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_cell-specific residuals.mx\>\""}], 
        ",", " ", "pmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"mflist", " ", "=", " ", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"n", "-", "1"}]], 
        RowBox[{"Total", "/@", 
         RowBox[{"(", 
          SuperscriptBox["pmatrix", "2"], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "filemarker", "<>", "\"\<_modified_corrected_Fano factors.mx\>\""}], 
        ",", " ", "mflist"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Modified, corrected Fano factors acquired and saved\>\"", ",", 
        " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Kappa]lists", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "<=", "1000"}], ",", 
         RowBox[{"FanoCumulantsNB5CF", "[", 
          RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}], ",", " ", 
         RowBox[{"FanoCumulantsNB5alt", "[", 
          RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polylist", "=", 
       RowBox[{"CornishFisherPolynomialCoefficientsforFano5CFAlt", "[", 
        RowBox[{
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "mflist", ",", "n"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"equationslist", " ", "=", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           SuperscriptBox["x", "k"], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
         "polylist"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"logplist", "=", 
       RowBox[{"FixedPosPValFunc", "/@", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", "#"}], "]"}], "&"}], ",", 
          RowBox[{"Min", "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "/.", 
                 RowBox[{"FindInstance", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "==", "0"}], "&&", 
                    RowBox[{"x", ">", "0"}]}], ",", "x", ",", "Reals", ",", 
                   "2"}], "]"}]}], ")"}], "/.", 
               RowBox[{"x", "->", 
                RowBox[{"{", "0", "}"}]}]}], "&"}], "/@", "equationslist"}], 
            ")"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_fanopvalues.mx\>\""}], ",", " ", 
        "logplist"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Fano p-values acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", " ", "\"\<Correlations\>\"", "]"}], "==",
          " ", "False"}], ",", " ", 
        RowBox[{"Goto", "[", "end", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pccmatrix", "=", 
       RowBox[{"DotProductCF", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          FractionBox["pmatrix", 
           SqrtBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "mflist"}]]], "]"}], ",", "n"}],
         "]"}]}], " ", ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_pccmatrix.mx\>\""}], ",", " ", 
        "pccmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Modified corrected correlations acquired and saved \>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pccSignmatrix", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"LowerTriangularize", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{"pccmatrix", ">", "0"}], "]"}], "-", 
           RowBox[{"BoolEval", "[", 
            RowBox[{"pccmatrix", "<=", "0"}], "]"}]}], ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "OptionValue", "[", "\"\<Fano Inverse Sqrt Moments\>\"", "]"}], "==",
          "True"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"invsqrtmoments", "=", 
          RowBox[{"InverseSqrtFanoMomentsListNB", "[", 
           RowBox[{
           "genetotals", ",", "depthlist", ",", " ", "\[Eta]", ",", " ", 
            "\[Theta]", ",", " ", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"filemarker", "<>", "\"\<_invsqrtmoments.mx\>\""}], ",", 
           " ", "invsqrtmoments"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<inverse squareroot Fano moments acquired and saved \>\"", ",", 
           
           RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"fanocorrectionmatrices", "=", 
          RowBox[{"SqrtCorrectionmats", "[", 
           RowBox[{"invsqrtmoments", ",", "genetotals"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"fanocorrectionmatrices", "=", 
          RowBox[{"Table", "[", " ", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", "4"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<inverse squareroot Fano moments ignored \>\"", 
          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ccmats", "=", 
       RowBox[{"CorrelationCumulantsNB", "[", 
        RowBox[{"ematrix", ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "clist", ",", "n"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Adjusted cumulants of the correlations acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polymatrix", "=", 
       RowBox[{"CornishFisherPolynomialCoefficients5CF", "[", 
        RowBox[{
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "4", "]"}], "]"}], " ", ",", "pccmatrix"}], "]"}]}], 
      " ", ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Cornish Fisher Polynomial Coefficients acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"augmentedParameters", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"SymmetricMatrixToListNew", "/@", 
         RowBox[{"Append", "[", 
          RowBox[{"polymatrix", ",", " ", "pccSignmatrix"}], "]"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"Length", "[", "augmentedParameters", "]"}], "]"}], "<>", 
         "\"\< equations gathered\>\""}], ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xlist", "=", 
       RowBox[{"ImprovedFindXAlt", "[", 
        RowBox[{"augmentedParameters", ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<First Pass Cutoff\>\"", "]"}], ",", 
         " ", "genetotals", ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}]}], "]"}]}], ";", 
      " ", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_xlist.mx\>\""}], ",", "xlist"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<x-values acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"logpmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"IntegerPart", "[", 
            RowBox[{"MatrixIndexCF", "/@", 
             RowBox[{"Flatten", "[", 
              RowBox[{"xlist", "[", "\"\<ExplicitPositions\>\"", "]"}], 
              "]"}]}], "]"}], "->", " ", 
           RowBox[{"FixedPValFunc", "/@", 
            RowBox[{"xlist", "[", "\"\<ExplicitValues\>\"", "]"}]}]}], "]"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_logpvalues.mx\>\""}], ",", 
        "logpmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<p-values acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"equivalentPCCs", " ", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"InferredPCCs2", "[", 
         RowBox[{"logpmatrix", ",", "pccSignmatrix", ",", 
          RowBox[{"OptionValue", "[", "\"\<First Pass Cutoff\>\"", "]"}], ",",
           " ", "n"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_equivalentPCCs.mx\>\""}], ",", " ", 
        "equivalentPCCs"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<equivalent PCCs acquired and saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "]"}], ",", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], ",", 
           RowBox[{"2", "*", 
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}], ",", 
           RowBox[{"3", "*", 
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}]}], "}"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "==", 
         "\"\<BH\>\""}], ",", "\[IndentingNewLine]", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{"2", "#"}], ",", " ", 
             RowBox[{"3", "#"}]}], "}"}], "&"}], "@", 
          RowBox[{"BHNew", "[", 
           RowBox[{
            RowBox[{"10", "^", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"logpmatrix", "[", "\"\<ExplicitValues\>\"", "]"}], 
               ")"}]}]}], ",", " ", 
            RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], ",", 
            RowBox[{"Binomial", "[", 
             RowBox[{"m", ",", "2"}], "]"}]}], " ", "]"}]}]}], ",", 
        "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
             RowBox[{"Binomial", "[", 
              RowBox[{"m", ",", "2"}], "]"}]}], "]"}], ",", 
           RowBox[{"2", "*", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"3", "*", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}]}], "}"}]}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"\"\<For FDR = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "]"}], "<>", 
         "\"\<, the significance level is p < \>\""}], ",", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"sigcutofflist", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"significantPCCmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BoolEval", "[", 
           RowBox[{"logpmatrix", ">", 
            RowBox[{"-", 
             RowBox[{"Log10", "[", 
              RowBox[{"sigcutofflist", "[", 
