Cell[TextData[{
 "Recall that \[Theta] and \[Eta] are found by fitting the mean of the \
Pearson residuals ",
 Cell[BoxData[
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "[", "i", "]"}], "-", 
      RowBox[{"\[Mu]", "[", "i", "]"}]}], ")"}], "2"], 
   RowBox[{
    RowBox[{"\[Mu]", "[", "i", "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"j", " ", 
       RowBox[{"\[Mu]", "[", "i", "]"}]}]}], ")"}]}]]],
  CellChangeTimes->{{3.965029474711892*^9, 3.965029724114294*^9}, {
    3.965029767588723*^9, 3.965029811128416*^9}, {3.965029861062038*^9, 
    3.965029908779766*^9}, {3.9650299759592876`*^9, 3.965030001056531*^9}, {
    3.9650300323910427`*^9, 3.965030050047575*^9}, {3.965030080886397*^9, 
    3.9650300952946444`*^9}, {3.965030150280223*^9, 3.9650301782466087`*^9}, {
    3.9650311664045477`*^9, 3.965031273549402*^9}, {3.96503232619238*^9, 
    3.965032345438122*^9}, {3.965953557306192*^9, 3.965953557651108*^9}, {
    3.9659535968277893`*^9, 3.965953642718355*^9}, {3.965953676218206*^9, 
    3.9659536903026447`*^9}, {3.965953720428129*^9, 3.965953731261801*^9}, {
    3.9659538244123287`*^9, 3.9659538690614758`*^9}, {3.965953961693536*^9, 
    3.965953963331542*^9}, {3.965954066482671*^9, 3.965954079622851*^9}, 
    3.9659541529062862`*^9, {3.965954270152226*^9, 3.965954384636273*^9}, {
    3.965954625408709*^9, 3.965954640970409*^9}, {3.965954777471698*^9, 
    3.965954779783979*^9}, 3.9659548458935633`*^9, {3.968063813912779*^9, 
    3.9680638281066513`*^9}, {3.968063871621602*^9, 3.968063894360276*^9}, {
    3.968068828011527*^9, 3.968068831878439*^9}, {3.968068893168212*^9, 
    3.968068910260666*^9}, {3.977323098910536*^9, 3.9773230992093983`*^9}, {
    3.977323133765586*^9, 3.977323186548746*^9}},
  Background->RGBColor[1, 1, 0],ExpressionUUID->
  "cc4110c1-aa04-4138-a283-d89cec931e61"],
 " to 1.  Then we assume that the a[i] are taken from an NB distribution \
parametrized as ",
 Cell[BoxData[
  RowBox[{"NegativeBinomialDistribution", "[", 
   RowBox[{
    FractionBox["\[Mu]", 
     RowBox[{"j", " ", "\[Mu]"}]], 
    RowBox[{",", 
     FractionBox["1", 
      RowBox[{"1", "+", 
       RowBox[{"j", " ", "\[Mu]"}]}]]}]}], "]"}]],
  CellChangeTimes->{{3.98020337261614*^9, 3.980203374464704*^9}},
  ExpressionUUID->"fc43e604-f37b-433b-a3d5-66673b4460a4"],
 ".  "
}], "Text",
 CellChangeTimes->{{3.980412310765339*^9, 3.9804124205569353`*^9}, {
  3.980412483682535*^9, 3.980412519627479*^9}, {3.980412557221035*^9, 
  3.980412611049161*^9}},ExpressionUUID->"02831c4f-e814-4e56-983d-\
b292d2835d37"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InverseSqrtFanoMomentsListNB", "[", 
    RowBox[{
    "genetotals_", ",", " ", "depthlist_", ",", " ", "\[Eta]_", ",", " ", 
     "\[Theta]_", ",", " ", "n_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "j", ",", " ", "iter", ",", "cellmeans", ",", " ", "simMat", ",", " ", 
       "invFanoMat", ",", 
       RowBox[{"a", " ", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"2", ",", 
          RowBox[{"Min", "[", "genetotals", "]"}]}], "]"}]}], ",", 
       RowBox[{"e", "=", 
        RowBox[{"n", "/", "50"}]}], ",", " ", 
       RowBox[{"h", "=", " ", 
        RowBox[{"Max", "[", "genetotals", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"glist", "=", 
         RowBox[{"{", 
          RowBox[{"a", ",", 
           RowBox[{"a", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"e", "/", "a"}], ")"}], 
             RowBox[{"1", "/", "4"}]]}], ",", 
           RowBox[{"a", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"e", "/", "a"}], ")"}], 
             RowBox[{"1", "/", "2"}]]}], ",", 
           RowBox[{"a", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"e", "/", "a"}], ")"}], 
             RowBox[{"3", "/", "4"}]]}], ",", "e", ",", " ", 
           RowBox[{"e", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"h", "/", "e"}], ")"}], 
             RowBox[{"1", "/", "3"}]]}], ",", 
           RowBox[{"e", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"h", "/", "e"}], ")"}], 
             RowBox[{"2", "/", "3"}]]}], ",", "h"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"j", "=", 
            RowBox[{"(", 
             RowBox[{
              FractionBox[
               RowBox[{"\[Eta]", " ", "n"}], 
               RowBox[{"glist", "[", 
                RowBox[{"[", "i", "]"}], "]"}]], "+", " ", "\[Theta]"}], 
             ")"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"iter", "=", 
            RowBox[{"Round", "[", 
             FractionBox["40000000.", 
              RowBox[{"n", 
               RowBox[{"(", " ", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"Log10", "[", 
                   RowBox[{"glist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], 
                  RowBox[{"1", "/", "5"}]], "+", 
                 RowBox[{"0.5", " ", 
                  SuperscriptBox[
                   RowBox[{"Log10", "[", 
                    RowBox[{"glist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "3"]}]}], ")"}]}]],
              "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"cellmeans", "=", 
            RowBox[{
             RowBox[{"glist", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "*", "depthlist"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"simMat", " ", "=", " ", 
            RowBox[{"Transpose", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"RandomVariate", "[", 
                RowBox[{
                 RowBox[{"NegativeBinomialDistribution", "[", 
                  RowBox[{
                   FractionBox["#", 
                    RowBox[{"j", " ", "#"}]], ",", 
                   FractionBox["1", 
                    RowBox[{"1", "+", 
                    RowBox[{"j", " ", "#"}]}]]}], "]"}], ",", "iter"}], "]"}],
                "&"}], "/@", "cellmeans"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"invFanoMat", " ", "=", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 FractionBox["1", 
                  RowBox[{"n", "-", "1"}]], 
                 RowBox[{"Total", "[", " ", 
                  FractionBox[
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"#", "-", "cellmeans"}], ")"}], "2"], 
                   RowBox[{"cellmeans", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"j", " ", "cellmeans"}]}], ")"}]}]], "]"}]}], 
                "&"}], "/@", "simMat"}], ")"}], 
             RowBox[{
              RowBox[{"-", "1"}], "/", "2"}]]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", " ", 
                RowBox[{
                 RowBox[{"glist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"Moment", "[", 
                  RowBox[{"#", ",", "2"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"glist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"Moment", "[", 
                  RowBox[{"#", ",", "3"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"glist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"Moment", "[", 
                  RowBox[{"#", ",", "4"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"glist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"Moment", "[", 
                  RowBox[{"#", ",", "5"}], "]"}]}], "}"}]}], "}"}], "&"}], 
            "@", "invFanoMat"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "8"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
    " ", "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9804111716751537`*^9, 3.980411201924695*^9}, {
   3.9804136700593243`*^9, 3.9804137375026007`*^9}, {3.98041380325034*^9, 
   3.980413813824141*^9}, {3.9804138708814983`*^9, 3.980413892874238*^9}, {
   3.980413976664372*^9, 3.9804139860509872`*^9}, {3.980414549947343*^9, 
   3.98041456215501*^9}, 3.9804145950593987`*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[53]:=",ExpressionUUID->"29f95ed2-f194-42f3-ab01-e69ad5809a55"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SqrtCorrectionmats", "Subsubsection",
 CellChangeTimes->{3.890059399748259*^9, 
  3.890059627656123*^9},ExpressionUUID->"d6cce037-9e15-4be3-8b0d-\
48e181840bca"],

Cell[TextData[{
 "This takes the output of ",
 StyleBox["InverseSqrtMomentLists, ",
  FontWeight->"Bold"],
 " and generates four sets of correction matrices for use on the gene pair \
data.  These square matrices represent moments 2-5 of distributions under the \
null hypothesis of ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SqrtBox[
     RowBox[{
      SubscriptBox["\[Phi]", "a"], 
      SubscriptBox["\[Phi]", "b"]}]]], TraditionalForm]],ExpressionUUID->
  "3918e7a0-c9a6-4e83-9875-f78b749a5d67"],
 " where a and b are the genes.  \nQuiet is used because occasionally the \
genetotals are below 2 (i.e. just 1 UMI) yet our interpolation function does \
not go down to datapoints below 2.  "
}], "Text",
 CellChangeTimes->{{3.890059408050334*^9, 3.890059550650548*^9}, {
  3.890069571004189*^9, 3.890069623021722*^9}, {3.890681202374689*^9, 
  3.8906812132645607`*^9}},ExpressionUUID->"ded1dc75-4a4a-44b8-92d7-\
c87baeb9526f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SqrtCorrectionmats", "[", 
    RowBox[{"invsqrtmoments_", ",", "genetotals_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"list2", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"10", "^", 
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"Log10", "[", 
                RowBox[{"invsqrtmoments", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "#", 
             "]"}]}], "&"}], "/@", 
          RowBox[{"Log10", "[", "genetotals", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"list3", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"10", "^", 
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"Log10", "[", 
                RowBox[{"invsqrtmoments", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "#", 
             "]"}]}], "&"}], "/@", 
          RowBox[{"Log10", "[", "genetotals", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"list4", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"10", "^", 
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"Log10", "[", 
                RowBox[{"invsqrtmoments", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "#", 
             "]"}]}], "&"}], "/@", 
          RowBox[{"Log10", "[", "genetotals", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"list5", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"10", "^", 
            RowBox[{
             RowBox[{"Interpolation", "[", 
              RowBox[{
               RowBox[{"Log10", "[", 
                RowBox[{"invsqrtmoments", "[", 
                 RowBox[{"[", "4", "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "#", 
             "]"}]}], "&"}], "/@", 
          RowBox[{"Log10", "[", "genetotals", "]"}]}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"list2", ",", " ", "list2"}], "]"}], ",", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"list3", ",", " ", "list3"}], "]"}], ",", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"list4", ",", " ", "list4"}], "]"}], ",", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"list5", ",", " ", "list5"}], "]"}]}], "}"}]}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.890058444396029*^9, 3.89005847525699*^9}, {
  3.890059009937769*^9, 3.890059106954096*^9}, {3.890059215529373*^9, 
  3.8900592534363747`*^9}, {3.890059287566901*^9, 3.890059401957513*^9}, {
  3.890069268856977*^9, 3.890069388768507*^9}, {3.890069564375597*^9, 
  3.890069568454146*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[54]:=",ExpressionUUID->"d0307a15-6602-4f99-846e-f0f3c5c23ae1"]
}, Closed]],

Cell[CellGroupData[{

Cell["FanoCorrectionMatrices (to be dropped in Alt3 and Alt4)", \
"Subsubsection",
 CellChangeTimes->{{3.8712271858241653`*^9, 3.871227189896912*^9}, {
  3.871227873714177*^9, 3.871227874855226*^9}, {3.890059600720934*^9, 
  3.8900596128304863`*^9}, {3.890916182311697*^9, 
  3.89091618450776*^9}},ExpressionUUID->"cdca2882-bc16-4e89-a325-\
e46f5e8c2ff1"],

Cell[TextData[{
 "This gives the Fano moment corrections for ",
 Cell[BoxData[
  FormBox[
   SqrtBox["\[Phi]"], TraditionalForm]],ExpressionUUID->
  "51932463-9b12-4df7-814b-065bbb479b7a"],
 " for each gene, then uses KroneckerProduct to create three matrices for the \
combined correction for the product ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     SubscriptBox["\[Phi]", "a"], 
     SubscriptBox["\[Phi]", "b"]}]], TraditionalForm]],ExpressionUUID->
  "dec1a99c-db8d-47e6-b450-b4cb2a363a5a"],
 ".  The three matrices represent the  3rd, 4th, and 5th moments of ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     SubscriptBox["\[Phi]", "a"], 
     SubscriptBox["\[Phi]", "b"]}]], TraditionalForm]],ExpressionUUID->
  "89cd4227-92bb-4a0f-843c-a226fe536bbb"],
 ".  These are used to correct our correlation moments, which get divided by \
these.  The reason there is no 2nd moment matrix is that the moments for that \
are already built into the correlation coefficient moments; we can just \
substitute 1 for that.  The reason there is no 1st moment matrix is that the \
first correlation moment is zero, so there is no point in dividing it by \
anything  \n\nPrior to 10/30/2020, we used the second version of the code, \
shown below as commented out.  However, the newer version is slightly more \
accurate.  "
}], "Text",
 CellChangeTimes->{{3.871227303893812*^9, 3.871227540850704*^9}, {
  3.876159412687203*^9, 
  3.876159513824296*^9}},ExpressionUUID->"0289f10d-d8b5-46b9-ac14-\
a9452804fcb6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"FanoCorrectionMatrices", "[", 
     RowBox[{"emat_", ",", " ", "c_"}], "]"}], ":=", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Width", "[", "emat", "]"}]}], ",", 
        RowBox[{"\[Chi]", "=", 
         RowBox[{"1", "+", 
          SuperscriptBox["c", "2"]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[ScriptCapitalJ]3", "=", 
            SqrtBox[
             RowBox[{
              FractionBox["n", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"]], " ", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["n", "2"], "-", "n", "+", 
                RowBox[{"Total", "/@", 
                 RowBox[{"(", 
                  FractionBox[
                   RowBox[{"1", "+", 
                    RowBox[{"emat", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "4"}], "+", 
                    RowBox[{"7", " ", "\[Chi]"}], "+", 
                    RowBox[{"6", " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"2", " ", "\[Chi]"}], "+", 
                    SuperscriptBox["\[Chi]", "3"]}], ")"}], " ", "emat"}], 
                    "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "3"}], "+", 
                    RowBox[{"6", " ", "\[Chi]"}], "-", 
                    RowBox[{"4", " ", 
                    SuperscriptBox["\[Chi]", "3"]}], "+", 
                    SuperscriptBox["\[Chi]", "6"]}], ")"}], 
                    SuperscriptBox["emat", "2"]}]}], ")"}]}]}], 
                   RowBox[{"emat", " ", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "\[Chi]"}], ")"}], "emat"}]}], 
                    ")"}], "2"]}]], ")"}]}]}], ")"}]}]]}], "}"}], ",", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"\[ScriptCapitalJ]3", ",", "\[ScriptCapitalJ]3"}], "]"}]}],
          "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[ScriptCapitalJ]4", "=", 
            RowBox[{
             FractionBox["n", 
              RowBox[{"(", 
               RowBox[{"n", "-", "1"}], ")"}]], "+", 
             RowBox[{
              FractionBox["1", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"]], 
              RowBox[{"Total", "/@", 
               RowBox[{"(", 
                FractionBox[
                 RowBox[{"1", "+", 
                  RowBox[{"emat", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "4"}], "+", 
                    RowBox[{"7", " ", "\[Chi]"}], "+", 
                    RowBox[{"6", " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"2", " ", "\[Chi]"}], "+", 
                    SuperscriptBox["\[Chi]", "3"]}], ")"}], " ", "emat"}], 
                    "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "3"}], "+", 
                    RowBox[{"6", " ", "\[Chi]"}], "-", 
                    RowBox[{"4", " ", 
                    SuperscriptBox["\[Chi]", "3"]}], "+", 
                    SuperscriptBox["\[Chi]", "6"]}], ")"}], " ", 
                    SuperscriptBox["emat", "2"]}]}], ")"}]}]}], 
                 RowBox[{"emat", " ", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "\[Chi]"}], ")"}], " ", 
                    "emat"}]}], ")"}], "2"]}]], ")"}]}]}]}]}], "}"}], ",", 
          " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"\[ScriptCapitalJ]4", ",", "\[ScriptCapitalJ]4"}], "]"}]}],
          "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[ScriptCapitalJ]5", "=", 
            RowBox[{"\[Sqrt]", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", "n"}], ")"}], "5"]], 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["n", "2"], "+", 
                 RowBox[{"Total", "/@", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", 
                    FractionBox[
                    RowBox[{"1", "+", 
                    RowBox[{"emat", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "4"}], "+", 
                    RowBox[{"7", " ", "\[Chi]"}], "+", 
                    RowBox[{"6", " ", "emat", " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"2", " ", "\[Chi]"}], "+", 
                    SuperscriptBox["\[Chi]", "3"]}], ")"}]}], "+", 
                    RowBox[{
                    SuperscriptBox["emat", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "3"}], "+", 
                    RowBox[{"6", " ", "\[Chi]"}], "-", 
                    RowBox[{"4", " ", 
                    SuperscriptBox["\[Chi]", "3"]}], "+", 
                    SuperscriptBox["\[Chi]", "6"]}], ")"}]}]}], ")"}]}]}], 
                    RowBox[{"emat", " ", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"emat", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "\[Chi]"}], ")"}]}]}], ")"}], 
                    "2"]}]]}], ")"}]}]}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["n", "3"], "+", 
                 RowBox[{"Total", "/@", 
                  RowBox[{"(", 
                   RowBox[{
                    FractionBox["1", 
                    RowBox[{
                    SuperscriptBox["emat", "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"emat", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "\[Chi]"}], ")"}]}]}], ")"}], 
                    "3"]}]], 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"emat", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "9"}], "+", 
                    RowBox[{"31", " ", "\[Chi]"}]}], ")"}]}], "+", 
                    RowBox[{"2", " ", 
                    SuperscriptBox["emat", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"16", "-", 
                    RowBox[{"57", " ", "\[Chi]"}], "+", 
                    RowBox[{"45", " ", 
