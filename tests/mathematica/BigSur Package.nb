Cell[TextData[{
 "Rather than try to generate the intact polynomials, this code just returns \
their coefficients as a list of matrices.  The matrices go in order from the \
coefficients of lowest to highest order, i.e. a+ bx ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"+", 
     SuperscriptBox["cx", "2"]}], "+", 
    SuperscriptBox["dx", "3"]}], TraditionalForm]],ExpressionUUID->
  "671c4a63-c886-4020-b330-5c044e18bce8"],
 ", etc.  "
}], "Text",
 CellChangeTimes->{{3.870280468020463*^9, 
  3.8702805890415*^9}},ExpressionUUID->"84d3b036-20f6-440e-bd31-7d1080380220"],

