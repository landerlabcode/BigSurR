              SqrtBox["ematrix"], " ", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{
                  SuperscriptBox["c", "2"], " ", "ematrix"}]}], ")"}], 
