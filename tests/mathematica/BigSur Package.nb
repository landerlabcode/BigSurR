Cell[TextData[{
 "This code finds the values of 4 cumulants and goes with the Alt3 form of \
BigSur.  The matrices \[ScriptCapitalF]2,  \[ScriptCapitalF]3, \
\[ScriptCapitalF]4, and \[ScriptCapitalF]5  are the output of \
InverseSqrtMomentLists.\n\nWhat it returns is a list of square matrices, \
starting with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Kappa]", "2"], TraditionalForm]],ExpressionUUID->
  "5fbf073f-1270-411d-abc9-2aab292c123e"],
 ", in the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Kappa]", "2"], ",", " ", 
     SubscriptBox["\[Kappa]", "3"], ",", " ", 
     SubscriptBox["\[Kappa]", "4"], ",", " ", 
     SubscriptBox["\[Kappa]", "5"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "e8a74e62-537d-4ed6-b964-d1b8fdb15327"]
}], "Text",
 CellChangeTimes->{{3.870250788509596*^9, 3.870250929938821*^9}, {
