            RowBox[{"Min", "[", 
             RowBox[{"First", "/@", "data"}], "]"}], ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"First", "/@", "data"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"PlotRange", "->", " ", "All"}], ",", "  ", 
