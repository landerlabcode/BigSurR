         9 $CellContext`d^2 - 24 $CellContext`c $CellContext`e])/(
        12 $CellContext`e) < $CellContext`x, 
       Sign[45 $CellContext`d^3 - 
         36 $CellContext`c $CellContext`d $CellContext`e - 
         15 $CellContext`d^2 
         Sqrt[9 $CellContext`d^2 - 24 $CellContext`c $CellContext`e] + 
         8 $CellContext`e (9 $CellContext`b $CellContext`e - $CellContext`c 
           Sqrt[9 $CellContext`d^2 - 
             24 $CellContext`c $CellContext`e])] == -1], 0, 
      And[-$CellContext`x < (3 $CellContext`d + 
         Sqrt[9 $CellContext`d^2 - 24 $CellContext`c $CellContext`e])/(
        12 $CellContext`e) < $CellContext`x, 
       Sign[45 $CellContext`d^3 - 
         36 $CellContext`c $CellContext`d $CellContext`e + 
         15 $CellContext`d^2 
          Sqrt[9 $CellContext`d^2 - 24 $CellContext`c $CellContext`e] + 
         8 $CellContext`e (
           9 $CellContext`b $CellContext`e + $CellContext`c 
            Sqrt[9 $CellContext`d^2 - 
              24 $CellContext`c $CellContext`e])] == -1], 0, True, 1]], 
    Listable], Evaluate],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
 CellChangeTimes->{3.891250004117001*^9, 3.8912510843135443`*^9, 
  3.8914766551010437`*^9, 3.967473747419594*^9, 3.999779910786641*^9, 
