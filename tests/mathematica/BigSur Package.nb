b46ec57319b4"],

Cell["\<\
This takes a matrix and detects whether there are labels, i.e. non-numeric \
first rows or columns.  It then returns a list with three elements:  The \
matrix minus any labels, the row labels, and the column labels.  If no labels \
are present, it has {} in those positions.\
\>", "Text",
 CellChangeTimes->{{3.83225894321953*^9, 3.832259039327536*^9}, {
  3.832259672314315*^9, 
  3.832259672422429*^9}},ExpressionUUID->"075726c1-75dd-4c9c-aa02-\
928892995dd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Unpack", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Metadata\>\"", "\[Rule]", " ", "\"\<No data\>\""}], ",", 
     " ", 
     RowBox[{"\"\<Sparse\>\"", "->", " ", "False"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"Unpack", "[", 
    RowBox[{"mat_", ",", " ", 
     RowBox[{"opt", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"OptionValue", "[", "\"\<Sparse\>\"", "]"}], "==", "True"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SparseArray", "[", "mat", "]"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "\[Equal]", 
         "False"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"Drop", "[", 
           RowBox[{"mat", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"mat", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], "\[Equal]", 
         "False"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", "True", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"2", ";;"}], ",", 
             RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", " ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        " ", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"mat", ",", " ", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "\[Equal]", 
         "False"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Drop", "[", 
          RowBox[{"mat", ",", "1"}], "]"}], ",", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"mat", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], "\[Equal]", 
         "False"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        "}"}], ",", "\[IndentingNewLine]", "True", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;"}], ",", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", 
            RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
         RowBox[{"\"\<Metadata\>\"", "\[Rule]", "  ", " ", 
          RowBox[{"{", 
           RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}], "}"}]}]}], 
        " ", "}"}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.832259124285111*^9, 3.8322591298957863`*^9}, {
  3.8322591811454983`*^9, 3.832259311627494*^9}, {3.83225934302162*^9, 
  3.832259372526216*^9}, {3.832259405093985*^9, 3.8322594909020243`*^9}, {
  3.8322596603203497`*^9, 3.832259668615191*^9}, {3.835015188659862*^9, 
  3.835015305931057*^9}, {3.835015466684314*^9, 3.83501546837884*^9}, {
  3.835015514641746*^9, 3.8350155343066263`*^9}, {3.835015597933663*^9, 
  3.835015608404379*^9}, {3.835016035516794*^9, 3.835016042614052*^9}, {
  3.879643070607395*^9, 3.879643080024617*^9}, {3.879643239330491*^9, 
  3.879643367541741*^9}},
 Background->RGBColor[1, 1, 0],
