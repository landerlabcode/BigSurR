Cell[CellGroupData[{

Cell["TruncateGNO", "Subsubsection",
 CellChangeTimes->{{3.871899676072687*^9, 
  3.871899679856929*^9}},ExpressionUUID->"f77bfb52-7689-4ab5-ba6c-\
7efae15b7951"],

Cell["\<\
This truncates a gNO, eliminating correlations that fall below a certain \
threshold of PCC.  Options allow one to also select only the positive or \
negative correlations .  
If the second argument is left out, only the options are applied\
\>", "Text",
 CellChangeTimes->{{3.871900573113618*^9, 3.871900592273279*^9}, {
   3.8719007914311666`*^9, 3.871900804091263*^9}, {3.8727807185852337`*^9, 
   3.872780722177582*^9}, 3.876391667288209*^9, {3.876391703631558*^9, 
   3.876391742418481*^9}, {3.876392879604054*^9, 
   3.876392879766724*^9}},ExpressionUUID->"a0e46906-80e2-4aea-8bfa-\
1ae3048984fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "TruncateGNO", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Positive Only\>\"", "->", " ", "False"}], ",", " ", 
      RowBox[{"\"\<Negative Only\>\"", "->", " ", "False"}]}], "}"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TruncateGNO", "[", 
    RowBox[{"gNO_", ",", " ", 
     RowBox[{"ccthreshold_", ":", "0"}], ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hits", ",", " ", "sigmat", ",", " ", "adjustedmatrix"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sigmat", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Positive Only\>\"", "]"}], ",", 
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{"gNO", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ">", "ccthreshold"}], "]"}], ",", 
         " ", 
         RowBox[{"OptionValue", "[", "\"\<Negative Only\>\"", "]"}], ",", 
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"gNO", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ">", "ccthreshold"}], "]"}], 
         ",", " ", "True", ",", " ", 
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"gNO", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "]"}], ">", "ccthreshold"}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"ArrayRules", "[", "sigmat", "]"}], "]"}], "<", "2"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<no hits found\>\"", "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"adjustedmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"sigmat", "*", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
         RowBox[{"Dimensions", "[", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hits", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Keys", "[", 
           RowBox[{"Drop", "[", 
            RowBox[{
             RowBox[{"ArrayRules", "[", "adjustedmatrix", "]"}], ",", 
             RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"BoolEval", "[", 
         RowBox[{
          RowBox[{"adjustedmatrix", "\[LeftDoubleBracket]", 
           RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ">",
           "0"}], "]"}], ",", 
        RowBox[{"gNO", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "hits"}], "]"}], "]"}], ",", 
        RowBox[{"adjustedmatrix", "\[LeftDoubleBracket]", 
         RowBox[{"hits", ",", " ", "hits"}], "\[RightDoubleBracket]"}], ",", 
        " ", "\[IndentingNewLine]", 
        RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
            "\"\<From Expression Matrix\>\"", "\[Rule]", " ", 
             "\"\<Metadata\>\""}], "/.", 
            RowBox[{"Last", "[", "gNO", "]"}]}], ",", " ", 
           RowBox[{"\"\<Imposed Abs[cc] cutoff of \>\"", "<>", 
            RowBox[{"ToString", "[", "ccthreshold", "]"}]}]}], "}"}]}]}], 
       "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.871899684153799*^9, 3.871899692971012*^9}, {
  3.871899738886973*^9, 3.871899830514152*^9}, {3.871899878647283*^9, 
  3.871899885882637*^9}, {3.871899938636338*^9, 3.871899976053957*^9}, {
  3.871900015340189*^9, 3.871900015963457*^9}, {3.871900120189477*^9, 
  3.871900194121873*^9}, {3.871900312816313*^9, 3.871900560394291*^9}, {
  3.871900608796007*^9, 3.8719006450938168`*^9}, {3.871900676468605*^9, 
  3.871900781875923*^9}, {3.876391745124301*^9, 3.876391784090085*^9}, {
  3.876391827754765*^9, 3.8763919130697308`*^9}, {3.876392884089764*^9, 
  3.876392888617971*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[87]:=",ExpressionUUID->"f2497c7e-3f54-4e80-b936-fade3ed8735b"]
}, Closed]],

Cell[CellGroupData[{

Cell["GeneSubsetGNO", "Subsubsection",
 CellChangeTimes->{{3.8730367802817087`*^9, 
  3.8730367863244953`*^9}},ExpressionUUID->"7210b93a-9212-416e-bdd1-\
973bb555b6a5"],

Cell["\<\
This cuts down a GNO to contain only certain genes.  If the list contains \
genes that are not in the gNO they are ignored.  

We are adding an option to this:  When it is set to \
\[OpenCurlyDoubleQuote]Purge\[CloseCurlyDoubleQuote]-> True, it will purge \
from the gNO any genes for which there are no correlations.  Normally this is \
set to False, but for some applications, like NewPlot we need it set to True

Note that it was noticed on 3/13/23 that with the original form of this \
function, unless the genes were put in the same order as they appear in the \
gNO, the resulting matrix would come out not properly lower-triangularized.  \
All the data were present but sometimes whether it appeared in mainly in \
column or row varied.  This got fixed by restoring the symmetry and then \
lower triangularizing.  It didn\[CloseCurlyQuote]t seem to affect any \
downstream functions.  

If none of the genes in the subset are found in the gNO, then an error will \
occur the first time it reaches gNO[[1,hits, hits]].  To prevent this, we \
insert an IF statement at the beginning, that allows it to generate an empty \
matrix in this event.  \
\>", "Text",
 CellChangeTimes->{{3.873036788613863*^9, 3.873036803543167*^9}, {
   3.883497026556128*^9, 3.883497082969308*^9}, 3.883497136132945*^9, {
   3.884087440523278*^9, 3.884087453639999*^9}, {3.884089579614732*^9, 
   3.884089612266101*^9}, {3.884089956070779*^9, 3.88408997201604*^9}, {
   3.887740124488709*^9, 3.887740124899693*^9}, {3.8900882894289007`*^9, 
   3.8900883542193193`*^9}, {3.890088541074676*^9, 
   3.890088548292705*^9}},ExpressionUUID->"02acd957-e48f-4381-a288-\
20dc379afc80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GeneSubsetGNO", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Purge\>\"", "->", " ", "False"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GeneSubsetGNO", "[", 
   RowBox[{"gNO_", ",", " ", "genes_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Intersection", "[", 
      RowBox[{"genes", ",", " ", 
       RowBox[{"gNO", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "==", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"\"\<Metadata\>\"", "->", " ", "\"\<list was empty\>\""}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"hits", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"gNO", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@",
            "genes"}], "]"}]}], ",", "tempgNO", ",", " ", "newhits"}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tempgNO", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"LowerTriangularize", "[", 
           RowBox[{
            RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
             RowBox[{"gNO", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "hits", ",", " ", "hits"}], "]"}], "]"}], 
             "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}], ",", " ", 
          RowBox[{"gNO", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "hits"}], "]"}], "]"}], ",", 
          RowBox[{"LowerTriangularize", "[", 
           RowBox[{
            RowBox[{"RestoreSymmetryExceptDiagonal", "[", 
             RowBox[{"gNO", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", " ", "hits", ",", " ", "hits"}], "]"}], 
              "]"}], "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Purge\>\"", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"newhits", " ", "=", 
           RowBox[{"Union", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"tempgNO", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              "\"\<ExplicitPositions\>\"", "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"tempgNO", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "newhits", ",", " ", "newhits"}], "]"}], 
             "]"}], ",", " ", 
            RowBox[{"tempgNO", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "newhits"}], "]"}], "]"}], ",", " ", 
            RowBox[{"tempgNO", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", " ", "newhits", ",", " ", "newhits"}], "]"}], 
             "]"}], ",", 
            RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                "\"\<From GNO\>\"", "\[Rule]", " ", "\"\<Metadata\>\""}], "/.", 
                RowBox[{"gNO", "[", 
                 RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
               RowBox[{"\"\<Having subsetted \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"Length", "[", "newhits", "]"}], "]"}], "<>", 
                "\"\< genes\>\""}]}], "}"}]}]}], " ", "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Append", "[", 
          RowBox[{"tempgNO", ",", " ", 
           RowBox[{"\"\<Metadata\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
               "\"\<From GNO\>\"", "\[Rule]", " ", "\"\<Metadata\>\""}], "/.", 
               RowBox[{"gNO", "[", 
                RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
              RowBox[{"\"\<Having subsetted \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"Length", "[", "hits", "]"}], "]"}], "<>", 
               "\"\< genes\>\""}]}], "}"}]}]}], "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.873036806849183*^9, 3.873036893847172*^9}, {
   3.8834971029406767`*^9, 3.883497109222474*^9}, {3.883497143626514*^9, 
   3.8834971454330063`*^9}, {3.884089616245758*^9, 3.884089643212865*^9}, {
   3.884089696483109*^9, 3.884089844331859*^9}, {3.884089922501693*^9, 
   3.8840899403018303`*^9}, {3.88409000041*^9, 3.884090002426394*^9}, {
   3.884090484208825*^9, 3.8840904888815737`*^9}, {3.8840905396914454`*^9, 
   3.8840905490896053`*^9}, 3.884090597551406*^9, {3.8840906321221333`*^9, 
   3.884090637099958*^9}, {3.8840907294598837`*^9, 3.884090765054783*^9}, {
   3.88409080673379*^9, 3.884090808950274*^9}, {3.8840908776564198`*^9, 
   3.884090879029138*^9}, {3.884090933162221*^9, 3.884090960637547*^9}, {
   3.884091114231207*^9, 3.884091115049288*^9}, {3.88409117341733*^9, 
   3.884091184206601*^9}, {3.884091310941476*^9, 3.884091354612588*^9}, {
   3.884091474291045*^9, 3.884091698364012*^9}, {3.884091774717923*^9, 
   3.884091776688018*^9}, {3.8877399346788282`*^9, 3.887739940714711*^9}, {
   3.890088365077318*^9, 3.8900884533596773`*^9}, {3.890088503685046*^9, 
   3.890088522842605*^9}, {3.890088558442134*^9, 3.89008855942345*^9}, {
   3.890088639285305*^9, 3.890088655495171*^9}, {3.890088893949603*^9, 
   3.890088913539028*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[89]:=",ExpressionUUID->"c5a3569a-914f-4364-b8d2-382c6c69d76b"]
}, Closed]],

Cell[CellGroupData[{

Cell["FindBestC (older method for finding C)", "Subsubsection",
 CellChangeTimes->{{3.879868953114421*^9, 3.879868956161262*^9}, {
  3.891855236905321*^9, 
  3.891855244860392*^9}},ExpressionUUID->"44e3d5b2-3c39-46ab-bed0-\
dc35f1292f2c"],

Cell["\<\
This finds the best C-value to use for BigSur; it generates a plot, and where \
the plot crosses zero is typically the best choice.  The \
\[OpenCurlyDoubleQuote]depthscaling\[CloseCurlyDoubleQuote] argument can be \
\[OpenCurlyDoubleQuote]Auto\[CloseCurlyDoubleQuote] if one wants the \
depthlist calculated automatically.  
If this is used, then when using BigSur one can set the option \
\[OpenCurlyDoubleQuote]Interrupt\[CloseCurlyDoubleQuote] to False.
The second version of this allows one to give the resulting plot a title.  \
\>", "Text",
 CellChangeTimes->{{3.879868959000984*^9, 3.879869068225553*^9}, {
  3.8798691490787983`*^9, 3.879869163086461*^9}, {3.880380644948934*^9, 
  3.88038064556535*^9}},ExpressionUUID->"a52781ed-1905-4d85-972b-\
14bebb4e8bef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindBestC", "[", 
   RowBox[{"matpac_", ",", " ", "depthscaling_"}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "m", ",", " ", "mat", ",", "genetotals", ",", " ", "depthlist",
       ",", " ", "ematrix"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mat", "=", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"genetotals", " ", "=", " ", 
      RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"depthlist", " ", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
        RowBox[{"N", "[", "depthscaling", "]"}], ",", 
        FractionBox[
         RowBox[{"Total", "/@", 
          RowBox[{"N", "[", 
           RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
         RowBox[{"Total", "[", 
          RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ematrix", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"a", "/.", 
            RowBox[{"FindFit", "[", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"MapThread", "[", 
                 RowBox[{"List", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Log10", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{"Mean", "[", "#", "]"}], "]"}], "]"}], "&"}], "/@",
                     "mat"}], ",", "  ", 
                    RowBox[{
                    FractionBox["1", 
                    RowBox[{"n", "-", "1"}]], 
                    RowBox[{"Total", "/@", 
                    RowBox[{"(", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    FractionBox[
                    RowBox[{"(", 
                    RowBox[{"mat", "-", "ematrix"}], ")"}], 
                    SqrtBox[
                    RowBox[{"ematrix", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    SuperscriptBox["c", "2"], "ematrix"}]}], ")"}]}]]], ")"}],
                     "2"], ")"}]}]}]}], "}"}]}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "2"}], "<", 
                  RowBox[{"First", "[", "#", "]"}], "<", "1"}], "&"}]}], 
               "]"}], ",", 
              RowBox[{
               RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}]}], "}"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", "0", ",", "0.8", ",", "0.05"}], "}"}]}], "]"}], 
       ",", " ", 
       RowBox[{"GridLines", "->", " ", "Automatic"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.879865037257557*^9, 3.8798653189120417`*^9}, {
  3.879865414631887*^9, 3.87986547219226*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[91]:=",ExpressionUUID->"ec48a026-79b9-41e0-80e8-b6769cab106a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindBestC", "[", 
   RowBox[{"matpac_", ",", " ", "depthscaling_", ",", " ", "title_"}], "]"}], 
  ":=", " ", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "m", ",", " ", "mat", ",", "genetotals", ",", " ", "depthlist",
       ",", " ", "ematrix"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mat", "=", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"genetotals", " ", "=", " ", 
      RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"depthlist", " ", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
        RowBox[{"N", "[", "depthscaling", "]"}], ",", 
        FractionBox[
         RowBox[{"Total", "/@", 
          RowBox[{"N", "[", 
           RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
         RowBox[{"Total", "[", 
          RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ematrix", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"a", "/.", 
            RowBox[{"FindFit", "[", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"MapThread", "[", 
                 RowBox[{"List", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Log10", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{"Mean", "[", "#", "]"}], "]"}], "]"}], "&"}], "/@",
                     "mat"}], ",", "  ", 
                    RowBox[{
                    FractionBox["1", 
                    RowBox[{"n", "-", "1"}]], 
                    RowBox[{"Total", "/@", 
                    RowBox[{"(", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    FractionBox[
                    RowBox[{"(", 
                    RowBox[{"mat", "-", "ematrix"}], ")"}], 
                    SqrtBox[
                    RowBox[{"ematrix", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    SuperscriptBox["c", "2"], "ematrix"}]}], ")"}]}]]], ")"}],
                     "2"], ")"}]}]}]}], "}"}]}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "2"}], "<", 
                  RowBox[{"First", "[", "#", "]"}], "<", "1"}], "&"}]}], 
               "]"}], ",", 
              RowBox[{
               RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}]}], "}"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", "0", ",", "0.8", ",", "0.05"}], "}"}]}], "]"}], 
       ",", " ", 
       RowBox[{"GridLines", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"PlotLabel", "->", " ", "title"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.879865037257557*^9, 3.8798653189120417`*^9}, {
  3.879865414631887*^9, 3.87986547219226*^9}, {3.879869124167804*^9, 
  3.879869140910406*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[92]:=",ExpressionUUID->"89b4d69f-3718-48a9-bcfb-70a217ed5386"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
FindBestCAlt (added in Alt4, uses log-log space, probably better)\
\>", "Subsubsection",
 CellChangeTimes->{{3.891337921982739*^9, 3.8913379267233562`*^9}, {
  3.8918552472690983`*^9, 
  3.891855264352404*^9}},ExpressionUUID->"418f6e70-756e-4419-adb4-\
3e5caf927e1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindBestCAlt", "[", 
   RowBox[{"matpac_", ",", " ", "depthscaling_"}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "m", ",", " ", "mat", ",", "genetotals", ",", " ", "depthlist",
       ",", " ", "ematrix"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mat", "=", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"genetotals", " ", "=", " ", 
      RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"depthlist", " ", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
        RowBox[{"N", "[", "depthscaling", "]"}], ",", 
        FractionBox[
         RowBox[{"Total", "/@", 
          RowBox[{"N", "[", 
           RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
         RowBox[{"Total", "[", 
          RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ematrix", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"a", "/.", 
            RowBox[{"FindFit", "[", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"MapThread", "[", 
                 RowBox[{"List", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Log10", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{"Mean", "[", "#", "]"}], "]"}], "]"}], "&"}], "/@",
                     "mat"}], ",", " ", 
                    RowBox[{"Log10", "[", " ", 
                    RowBox[{
                    FractionBox["1", 
                    RowBox[{"n", "-", "1"}]], 
                    RowBox[{"Total", "/@", 
                    RowBox[{"(", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    FractionBox[
                    RowBox[{"(", 
                    RowBox[{"mat", "-", "ematrix"}], ")"}], 
                    SqrtBox[
                    RowBox[{"ematrix", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    SuperscriptBox["c", "2"], "ematrix"}]}], ")"}]}]]], ")"}],
                     "2"], ")"}]}]}], "]"}]}], "}"}]}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "1"}], "<", 
                  RowBox[{"First", "[", "#", "]"}], "<", "2"}], "&"}]}], 
               "]"}], ",", 
              RowBox[{
               RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}]}], "}"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", "0", ",", "0.8", ",", "0.05"}], "}"}]}], "]"}], 
       ",", " ", 
       RowBox[{"GridLines", "->", " ", "Automatic"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.879865037257557*^9, 3.8798653189120417`*^9}, {
  3.879865414631887*^9, 3.87986547219226*^9}, {3.879869124167804*^9, 
  3.879869140910406*^9}, {3.8913862732280893`*^9, 3.891386321200162*^9}, {
  3.891387009609383*^9, 3.8913870100634747`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[93]:=",ExpressionUUID->"289bf09a-ac70-4b8a-bfe1-94666ad3d21b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["BigSurAlt2", "Subsubsection",
 CellChangeTimes->{{3.8815261164675093`*^9, 3.88152611837564*^9}, 
   3.88395377437085*^9},ExpressionUUID->"146f59bf-b454-40f7-ba21-\
ac6ef3f9260c"],

Cell["\<\
CFthreshold sets a threshold for the zero order term of the Cornish Fisher \
Polynomial, enabling us to filter out cases where the CornishFisher gets it \
wrong by putting the y-intercept on the wrong side of the x-axis.  See \
FastFindX for details.  \
\>", "Text",
 CellChangeTimes->{{3.881526123137176*^9, 3.881526136431128*^9}, {
   3.881527094490391*^9, 3.88152719738078*^9}, 
   3.88400152639646*^9},ExpressionUUID->"ec2df2dc-f2c1-454c-bd94-\
d2b050f4f664"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "BigSurAlt2", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Correlations\>\"", "->", " ", "False"}], ",", " ", 
      RowBox[{"\"\<alpha\>\"", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"\"\<Pvalue\>\"", "->", " ", "\"\<BH\>\""}], ",", 
      RowBox[{"\"\<First Pass Cutoff\>\"", "->", " ", "2"}], ",", 
      RowBox[{"\"\<CFThreshold\>\"", "->", "0.026"}], ",", " ", 
      RowBox[{"\"\<SigBinWidth\>\"", "->", " ", "0.05"}], ",", 
      RowBox[{"\"\<Interrupt\>\"", "->", " ", "True"}]}], " ", "}"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BigSurAlt2", "[", 
    RowBox[{
    "matpac_", ",", " ", "c_", ",", " ", "filemarker_", ",", "depthscaling_", 
     ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "foldername", ",", "n", ",", "m", ",", "z", ",", "negccthreshold", ",", 
       " ", "mat", ",", " ", "depthlist", ",", " ", "genetotals", ",", " ", 
       "ematrix", ",", " ", "pmatrix", ",", " ", "mflist", ",", 
       "fanocorrectionmatrices", ",", " ", "pccmatrix", ",", "\[Kappa]lists", 
       ",", "ccmats", ",", "polylist", ",", " ", "polymatrix", ",", 
       "equationslist", ",", "logplist", ",", "pccSignmatrix", ",", 
       "augmentedParameters", ",", "xlist", ",", "logpmatrix", ",", 
       "equivalentPCCs", ",", " ", "rows", ",", "randomematrix", ",", 
       "randommat", ",", "randompmatrix", ",", " ", "randommflist", ",", 
       "randomfanocorrectionmatrices", ",", "randompolymatrix", ",", 
       "randompccmatrix", ",", "randomccmats", ",", "randompccSignmatrix", 
       ",", "randomaugmentedParameters", ",", "randomxlist", ",", 
       "randomlogpmatrix", ",", "cutoff", ",", " ", "bhcutoff", ",", " ", 
       "bonferroni", ",", "sigcutofflevel", ",", "sigcutofflist", ",", 
       "truesigdata", ",", "randomsigdata", ",", "significantPCCmatrix", ",", 
       "gno", ",", " ", "subsetgno", ",", "communities"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"genetotals", " ", "=", " ", 
       RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], ",",
         " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Tally", "[", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{"y", ">", "1"}]}]}], "]"}], ">", "0"}], ",", " ", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Matpac contains duplicated genes\>\"", "]"}], ";",
          " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"c", "<=", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<c must be greater than zero\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Started on\>\"", ",", 
        RowBox[{"CurrentDate", "[", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"foldername", "=", 
       RowBox[{"filemarker", "<>", 
        RowBox[{"DateString", "[", "]"}], "<>", "\"\< c=\>\"", "<>", 
        RowBox[{"ToString", "[", "c", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"CreateDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Folder name is\>\"", "]"}], ";", 
      RowBox[{"Print", "[", "foldername", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"depthlist", " ", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
         RowBox[{"N", "[", "depthscaling", "]"}], ",", 
         FractionBox[
          RowBox[{"Total", "/@", 
           RowBox[{"N", "[", 
            RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
          RowBox[{"Total", "[", 
           RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ematrix", " ", "=", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pmatrix", " ", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"mat", "-", "ematrix"}], ")"}], 
        SqrtBox[
         RowBox[{"ematrix", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             SuperscriptBox["c", "2"], "ematrix"}]}], ")"}]}]]]}], "  ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_cell-specific residuals.mx\>\""}], 
        ",", " ", "pmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"mflist", " ", "=", " ", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"n", "-", "1"}]], 
        RowBox[{"Total", "/@", 
         RowBox[{"(", 
          SuperscriptBox["pmatrix", "2"], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "filemarker", "<>", "\"\<_modified_corrected_Fano factors.mx\>\""}], 
        ",", " ", "mflist"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Modified, corrected Fano factors acquired and saved\>\"", ",", 
        " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<mcFano slope between 0.01 and 10 is \>\"", ",", 
        RowBox[{"a", "/.", 
         RowBox[{"FindFit", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"MapThread", "[", 
              RowBox[{"List", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Log10", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{"Mean", "[", "#", "]"}], "]"}], "]"}], "&"}], "/@",
                   "mat"}], ",", " ", "mflist"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "<", 
               RowBox[{"First", "[", "#", "]"}], "<", "1"}], "&"}]}], "]"}], 
           ",", 
           RowBox[{
            RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Interrupt\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Continue or try a different value of c?\>\"", 
          "]"}], ";", 
         RowBox[{"Interrupt", "[", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Kappa]lists", "=", 
       RowBox[{"FanoCumulants5CF", "[", 
        RowBox[{"ematrix", ",", "c", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polylist", "=", 
       RowBox[{"CornishFisherPolynomialCoefficientsforFano5CF", "[", 
        RowBox[{
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "mflist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"equationslist", " ", "=", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           SuperscriptBox["x", "k"], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
         "polylist"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"logplist", "=", 
       RowBox[{"FixedPosPValFunc", "/@", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", "#"}], "]"}], "&"}], ",", 
          RowBox[{"Min", "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "/.", 
                 RowBox[{"FindInstance", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "==", "0"}], "&&", 
                    RowBox[{"x", ">", "0"}]}], ",", "x", ",", "Reals", ",", 
                   "2"}], "]"}]}], ")"}], "/.", 
               RowBox[{"x", "->", 
                RowBox[{"{", "0", "}"}]}]}], "&"}], "/@", "equationslist"}], 
            ")"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_fanopvalues.mx\>\""}], ",", " ", 
        "logplist"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Fano p-values acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", " ", "\"\<Correlations\>\"", "]"}], "==",
          " ", "False"}], ",", " ", 
        RowBox[{"Goto", "[", "end", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pccmatrix", "=", 
       RowBox[{"DotProductCF", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          FractionBox["pmatrix", 
           SqrtBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "mflist"}]]], "]"}], ",", "n"}],
         "]"}]}], " ", ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_pccmatrix.mx\>\""}], ",", " ", 
        "pccmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<corrected modified correlations acquired and saved \>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fanocorrectionmatrices", "=", 
       RowBox[{"FanoCorrectionMatrices", "[", 
        RowBox[{"ematrix", ",", " ", "c"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Moment corrections for \!\(\*SqrtBox[\(\*SubscriptBox[\(\[Phi]\), \
\(a\)] \*SubscriptBox[\(\[Phi]\), \(b\)]\)]\) acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pccSignmatrix", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"LowerTriangularize", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{"pccmatrix", ">", "0"}], "]"}], "-", 
           RowBox[{"BoolEval", "[", 
            RowBox[{"pccmatrix", "<=", "0"}], "]"}]}], ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Matrix of PCC directions acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ccmats", "=", 
       RowBox[{"CorrelationCumulants5CF", "[", 
        RowBox[{"ematrix", ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", "c", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Adjusted cumulants of the correlations acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polymatrix", "=", 
       RowBox[{"CornishFisherPolynomialCoefficients5CF", "[", 
        RowBox[{
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "4", "]"}], "]"}], " ", ",", "pccmatrix"}], "]"}]}], 
      " ", ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Cornish Fisher Polynomial Coefficients acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"augmentedParameters", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"SymmetricMatrixToList", "/@", 
         RowBox[{"Append", "[", 
          RowBox[{"polymatrix", ",", " ", "pccSignmatrix"}], "]"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"Length", "[", "augmentedParameters", "]"}], "]"}], "<>", 
         "\"\< equations gathered\>\""}], ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xlist", "=", 
       RowBox[{"FastFindX", "[", 
        RowBox[{"augmentedParameters", ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<CFThreshold\>\"", "]"}]}], "]"}]}], 
      ";", " ", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<x-values acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"logpmatrix", "=", 
       RowBox[{"ListToSymmetricMatrix", "[", 
        RowBox[{"FixedPValFunc", "/@", "xlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_logpvalues.mx\>\""}], ",", 
        "logpmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<p-values acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"equivalentPCCs", " ", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"InferredPCCs", "[", 
         RowBox[{"logpmatrix", ",", "pccSignmatrix", ",", 
          RowBox[{"OptionValue", "[", "\"\<First Pass Cutoff\>\"", "]"}], ",",
           " ", "n"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_equivalentPCCs.mx\>\""}], ",", " ", 
        "equivalentPCCs"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<equivalent PCCs acquired and saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "]"}], ",", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], ",", 
           RowBox[{"2", "*", 
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}], ",", 
           RowBox[{"3", "*", 
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}]}], "}"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "==", 
