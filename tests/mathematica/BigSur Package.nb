Cell[CellGroupData[{

Cell["InverseSqrtMomentLists", "Subsubsection",
 CellChangeTimes->{{3.8900538722180443`*^9, 
  3.8900538776291647`*^9}},ExpressionUUID->"80ddc500-6426-4ce6-bba9-\
7fb5116d700f"],

Cell[TextData[{
 "This produces a list of moments 2,3,4 and 5 of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox["\[Phi]"]}], TraditionalForm]],ExpressionUUID->
  "4df7477b-6ebd-42ac-ac97-df2a346f924d"],
 " for a series of 8 cases of different expectation value.  The reason we don\
\[CloseCurlyQuote]t need moment 1 is because it will ultimately be multiplied \
by something with a first moment of zero, so the net moment will be zero \
regardless.  \n\nThe input requires \[OpenCurlyDoubleQuote]genetotals\
\[CloseCurlyDoubleQuote], which is the totals of the UMI for each gene, as \
previously calculated in an early step of BigSur\nLikewise depthlist is an \
early calculation of BigSur\n\nThe output is a series of four lists of \
datapoints, representing Moments 2, 3, 4 and 5, where the data points are in \
the form of {\[OpenCurlyDoubleQuote]genetotal\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]moment value\[CloseCurlyDoubleQuote]}"
}], "Text",
 CellChangeTimes->{{3.8900538812694883`*^9, 3.890053921093872*^9}, {
  3.890058645969697*^9, 3.890058689481082*^9}, {3.890058740728795*^9, 
  3.8900588073062143`*^9}, {3.8900588420916767`*^9, 3.890058936560288*^9}, {
  3.964779988333314*^9, 
  3.964779988412581*^9}},ExpressionUUID->"c5abbd02-d281-483d-82cf-\
42724c298e65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InverseSqrtFanoMoments", "[", 
   RowBox[{"elist_", ",", " ", "c_", ",", "n_", ",", " ", "trials_"}], "]"}], 
  ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"Moment", "[", 
       RowBox[{"#", ",", "2"}], "]"}], ",", 
      RowBox[{"Moment", "[", 
       RowBox[{"#", ",", "3"}], "]"}], ",", " ", 
      RowBox[{"Moment", "[", 
       RowBox[{"#", ",", "4"}], "]"}], ",", " ", 
      RowBox[{"Moment", "[", 
       RowBox[{"#", ",", "5"}], "]"}]}], "}"}], "&"}], "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"\[Sqrt]", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"n", "-", "1"}]], 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox["1", 
              RowBox[{"#", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{
                  SuperscriptBox["c", "2"], "#"}]}], ")"}]}]], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"RandomVariate", "[", 
                 RowBox[{"PoissonDistribution", "[", 
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{"LogNormalDistribution", "[", 
                    RowBox[{
                    RowBox[{"Log", "[", 
                    FractionBox["#", 
                    SqrtBox[
                    RowBox[{"1", "+", 
                    SuperscriptBox["c", "2"]}]]], "]"}], ",", 
                    SqrtBox[
