         RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], ",",
         " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Tally", "[", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{"y", ">", "1"}]}]}], "]"}], ">", "0"}], ",", " ", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Matpac contains duplicated genes\>\"", "]"}], ";",
          " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"clist", "=", 
       RowBox[{
        RowBox[{
         SqrtBox[
          RowBox[{
           FractionBox["\[Eta]", "#"], "+", " ", "\[Theta]"}]], "&"}], "/@", 
        RowBox[{"N", "[", 
         FractionBox["genetotals", "n"], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Started on\>\"", ",", 
        RowBox[{"CurrentDate", "[", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"foldername", "=", 
       RowBox[{"filemarker", "<>", 
        RowBox[{"DateString", "[", "]"}], "<>", "\"\< \[Eta]=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Round", "[", 
          RowBox[{"\[Eta]", ",", "0.001"}], "]"}], "]"}], "<>", 
        "\"\< \[Theta]=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Round", "[", 
          RowBox[{"\[Theta]", ",", "0.001"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"CreateDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Folder name is\>\"", "]"}], ";", 
      RowBox[{"Print", "[", "foldername", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_matpac metadata.mx\>\""}], ",", " ", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"depthlist", " ", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
         RowBox[{"N", "[", "depthscaling", "]"}], ",", 
         FractionBox[
          RowBox[{"Total", "/@", 
           RowBox[{"N", "[", 
            RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
          RowBox[{"Total", "[", 
           RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ematrix", " ", "=", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pmatrix", " ", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"mat", "-", "ematrix"}], ")"}], 
        SqrtBox[
         RowBox[{"ematrix", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             SuperscriptBox["clist", "2"], "ematrix"}]}], ")"}]}]]]}], "  ", 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_cell-specific residuals.mx\>\""}], 
        ",", " ", "pmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"mflist", " ", "=", " ", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"n", "-", "1"}]], 
        RowBox[{"Total", "/@", 
         RowBox[{"(", 
          SuperscriptBox["pmatrix", "2"], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "filemarker", "<>", "\"\<_modified_corrected_Fano factors.mx\>\""}], 
        ",", " ", "mflist"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Modified, corrected Fano factors acquired and saved\>\"", ",", 
        " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Kappa]lists", "=", 
       RowBox[{"FanoCumulantsNB5CF", "[", 
        RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polylist", "=", 
       RowBox[{"CornishFisherPolynomialCoefficientsforFano5CFAlt", "[", 
        RowBox[{
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "mflist", ",", "n"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"equationslist", " ", "=", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           SuperscriptBox["x", "k"], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
         "polylist"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"logplist", "=", 
       RowBox[{"FixedPosPValFunc", "/@", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", "#"}], "]"}], "&"}], ",", 
          RowBox[{"Min", "/@", 
           RowBox[{"Parallelize", "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "/.", 
                  RowBox[{"FindInstance", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", "==", "0"}], "&&", 
                    RowBox[{"x", ">", "0"}]}], ",", "x", ",", "Reals", ",", 
                    "2"}], "]"}]}], ")"}], "/.", 
                RowBox[{"x", "->", 
                 RowBox[{"{", "0", "}"}]}]}], "&"}], "/@", "equationslist"}], 
             ")"}], "]"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_fanopvalues.mx\>\""}], ",", " ", 
        "logplist"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Fano p-values acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", " ", "\"\<Correlations\>\"", "]"}], "==",
          " ", "False"}], ",", " ", 
        RowBox[{"Goto", "[", "end", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pccmatrix", "=", 
       RowBox[{"DotProductCF", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          FractionBox["pmatrix", 
           SqrtBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "mflist"}]]], "]"}], ",", "n"}],
         "]"}]}], " ", ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_pccmatrix.mx\>\""}], ",", " ", 
