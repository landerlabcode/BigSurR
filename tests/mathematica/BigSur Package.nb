Cell[BoxData[
 RowBox[{
  RowBox[{"TwoComponentCAlt3", "[", 
   RowBox[{"matpac_", ",", " ", "samplegoal_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mat", ",", "depthlist", ",", "n", ",", "genetotals", ",", " ", "bl", 
      ",", "genesample", ",", "newmat", ",", " ", "newgenetotals", ",", " ", 
