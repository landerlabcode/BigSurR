      Scaled[0.08090169943749476]}},
   Ticks->{
     Charting`ScaledTicks[{Log, Exp}, {Log, Exp}, "Nice", WorkingPrecision -> 
      MachinePrecision, RotateLabel -> 0], 
     Charting`ScaledTicks[{Log, Exp}, {Log, Exp}, "Nice", WorkingPrecision -> 
      MachinePrecision, RotateLabel -> 0]}]], "Output",
  CellChangeTimes->{{3.964780832138359*^9, 3.9647808493671713`*^9}, 
    3.9647808880171843`*^9, 3.964780920195561*^9, 3.96478095855118*^9},
  ExpressionUUID->"a9099be2-106b-4b0a-94b3-2d39b0e3aeed"],
 "\n\nsimEmatrix generates an expected distribution of UMI under the null \
hypothesis for the eight different gene expression levels in \
\[OpenCurlyDoubleQuote]glist\[CloseCurlyDoubleQuote], for every cell (8 x n \
matrix).  We then apply InverseSqrtFanoMoments to the rows of that \
simEmatrix.  InverseSqrtFanoMoments produces 4 numbers each time it is \
applied.  We gather those 4 numbers 8 times and then Transpose that, so each \
row consists of 8 simulations of moments 2, 3, 4, 5, respectively.  We then \
MapThread it with our list of eight gene expression levels, so we have eight \
pairs of g and m in each row, and each row corresponding to moments 2,3,4,5.  \
In this way applying an Interpolation function to each row produces an \
estimator to generate an estimate applicable to each gene based on its \
expression level.  "
}], "Text",
 CellChangeTimes->{{3.8900681059322166`*^9, 3.8900681665645227`*^9}, {
  3.890675279937449*^9, 3.890675286734149*^9}, {3.964782570110111*^9, 
  3.964782835969429*^9}, {3.964782874823339*^9, 3.964783039681521*^9}, {
  3.964783071164027*^9, 
  3.964783163816642*^9}},ExpressionUUID->"7a881f25-6c25-44fe-a959-\
16f0ea720906"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", "2."}], ",", 
       RowBox[{"e", "=", 
        RowBox[{"n", "/", "50"}]}], ",", " ", 
       RowBox[{"h", "=", "2000000."}]}], "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"glist", "=", 
         RowBox[{"{", 
          RowBox[{"a", ",", 
           RowBox[{"a", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"e", "/", "a"}], ")"}], 
             RowBox[{"1", "/", "4"}]]}], ",", 
           RowBox[{"a", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"e", "/", "a"}], ")"}], 
             RowBox[{"1", "/", "2"}]]}], ",", 
           RowBox[{"a", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"e", "/", "a"}], ")"}], 
             RowBox[{"3", "/", "4"}]]}], ",", "e", ",", " ", 
           RowBox[{"e", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"h", "/", "e"}], ")"}], 
             RowBox[{"1", "/", "3"}]]}], ",", 
           RowBox[{"e", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"h", "/", "e"}], ")"}], 
             RowBox[{"2", "/", "3"}]]}], ",", "h"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           FractionBox["18000000", 
            RowBox[{" ", 
             RowBox[{"Log10", "[", 
              RowBox[{"glist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}]}]], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}]}], "]"}], "]"}], "]"}]}], 
      "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "1000", ",", " ", "10000"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<n\>\"", ",", " ", "\"\<Total[n*t]\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.890677121096531*^9, 3.890677151451562*^9}, {
   3.8906771822504263`*^9, 3.890677208404831*^9}, {3.890677245047144*^9, 
   3.8906773336623583`*^9}, 3.890677609617374*^9, {3.890677828618147*^9, 
   3.8906778894865417`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"8aaeed9d-41f1-427a-8045-562d0e19322d"],

