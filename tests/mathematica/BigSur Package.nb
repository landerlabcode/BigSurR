     "\[IndentingNewLine]", 
     RowBox[{"fittedjvalues", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"j", "/.", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "@", 
             RowBox[{"(", 
              FractionBox[
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  FractionBox[
                   RowBox[{"newmat", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
