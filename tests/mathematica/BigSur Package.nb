Cell[CellGroupData[{

Cell["NewFindX and ImprovedFindX (added in Alt4)", "Subsubsection",
 CellChangeTimes->{{3.8909162808750143`*^9, 3.8909162975833893`*^9}, {
  3.9680003253414288`*^9, 
  3.968000329389353*^9}},ExpressionUUID->"564ff76e-8344-4072-a764-\
7bd6bd25b5dd"],

Cell[TextData[{
 "First we generate some code that NewFindX calls :\nBoth of them first \
identify x-boundary values equal to plus or minus ",
 Cell[BoxData[
  RowBox[{
   SqrtBox["2"], " ", 
   RowBox[{"InverseErfc", "[", 
    RowBox[{"2.", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "cutoff"}]]}], "]"}]}]],
  CellChangeTimes->{{3.891249415841803*^9, 3.891249430735777*^9}, {
   3.891249466189623*^9, 3.8912496107516193`*^9}, {3.891249672983032*^9, 
   3.891249693219081*^9}, {3.891249773268338*^9, 3.891249779132287*^9}, {
   3.89124983783641*^9, 3.891249839824669*^9}},ExpressionUUID->
  "2676a198-e49e-4630-85bb-5fa36b27f5c6"],
 ", which are the x-values corresponding to a particular p-value threshold.  \
"
}], "Text",
 CellChangeTimes->{{3.891249054512141*^9, 3.891249076328734*^9}, {
  3.893702315969306*^9, 3.89370236365781*^9}, {3.893702400315421*^9, 
  3.893702401870068*^9}},ExpressionUUID->"b609a851-4658-458f-8de5-\
5333f856ab6b"],

Cell["\<\
QuickTest6CF returns a zero if the signs at the xboundary values are \
different, or the sign at x=0 is different from at the positive x-boundary \
value, and 1 otherwise.  Note that the following function might run faster, \
provided that ContainsAll can be compiled.\
\>", "Text",
 CellChangeTimes->{{3.893702191529797*^9, 3.893702236455392*^9}, {
  3.893702287677101*^9, 3.8937023098009157`*^9}, {3.893702410889492*^9, 
  3.8937024725325737`*^9}, {3.893703570565008*^9, 
  3.893703605431726*^9}},ExpressionUUID->"c37f9927-86bc-4744-9ab8-\
ed0faf3eed14"],

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"ContainsAll", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sign", "[", 
        RowBox[{"a", "+", 
         RowBox[{"b", " ", "x"}], "+", 
         RowBox[{"c", " ", 
          SuperscriptBox["x", "2"]}], "+", 
         RowBox[{"d", " ", 
          SuperscriptBox["x", "3"]}], "+", 
         RowBox[{"e", " ", 
          SuperscriptBox["x", "4"]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "k"}], ",", 
           RowBox[{"-", " ", 
            FractionBox[
             RowBox[{"2", "k"}], "3"]}], ",", " ", 
           RowBox[{"-", 
            FractionBox["k", "3"]}], ",", " ", "0", ",", " ", 
           FractionBox["k", "3"], ",", " ", 
           FractionBox[
            RowBox[{"2", "k"}], "3"], ",", "k"}], "}"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", "0", ",", "1"}], 
  "]"}]], "Text",
 CellChangeTimes->{{3.893703304097807*^9, 3.893703309670455*^9}, {
  3.8937033636285343`*^9, 3.893703557351317*^9}, {3.893704543793229*^9, 
  3.8937045475161057`*^9}},ExpressionUUID->"882ef68a-f1b6-4c21-baf8-\
e5833029cd7b"],

Cell["\<\
If ContainsAll cannot be compiled we can simply apply this transformation to \
the table:
Multiply all the terms, sum all the terms, multiply that together, and take \
the absolute value.   If the answer if 6 (because there are six parts in the \
table) then the signs of all size were either 1 or -1 and  therefore there is \
no root  (so output 1), for example:\
\>", "Text",
 CellChangeTimes->{{3.893704550372349*^9, 3.893704661380171*^9}, {
   3.893704933943975*^9, 3.893704935914609*^9}, {3.893704969205336*^9, 
   3.893704979590445*^9}, 3.893705142498624*^9, {3.893705259025522*^9, 
   3.893705261261771*^9}},ExpressionUUID->"b2622d16-e817-4a09-b957-\
3f90aa11462a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuickTest6CF", " ", "=", "  ", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"c", ",", " ", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", "_Real"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"cutoff", ",", " ", "_Real"}], "}"}]}], "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", 
        RowBox[{
         SqrtBox["2"], " ", 
         RowBox[{"InverseErfc", "[", 
          RowBox[{"2.", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "cutoff"}]]}], "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "-", 
             RowBox[{"b", " ", "x"}], "+", 
             RowBox[{"c", " ", 
              SuperscriptBox["x", "2"]}], "-", 
             RowBox[{"d", " ", 
              SuperscriptBox["x", "3"]}], "+", 
             RowBox[{"e", " ", 
              SuperscriptBox["x", "4"]}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"a", "+", 
             RowBox[{"b", " ", "x"}], "+", 
             RowBox[{"c", " ", 
              SuperscriptBox["x", "2"]}], "+", 
             RowBox[{"d", " ", 
              SuperscriptBox["x", "3"]}], "+", 
             RowBox[{"e", " ", 
              SuperscriptBox["x", "4"]}]}], ")"}]}], "]"}], "==", " ", 
         RowBox[{"-", "1"}]}], ",", "0", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{"a", " ", 
           RowBox[{"(", 
            RowBox[{"a", "+", 
             RowBox[{"b", " ", "x"}], "+", 
             RowBox[{"c", " ", 
              SuperscriptBox["x", "2"]}], "+", 
             RowBox[{"d", " ", 
              SuperscriptBox["x", "3"]}], "+", 
             RowBox[{"e", " ", 
              SuperscriptBox["x", "4"]}]}], ")"}]}], "]"}], "==", " ", 
         RowBox[{"-", "1"}]}], ",", "0", ",", "True", ",", " ", "1"}], 
       "]"}]}], "]"}], ",", 
    RowBox[{"RuntimeAttributes", "->", 
     RowBox[{"{", "Listable", "}"}]}], ",", " ", 
    RowBox[{"Parallelization", "->", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.891249415841803*^9, 3.891249430735777*^9}, {
