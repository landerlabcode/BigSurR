   3.9679087736060543`*^9}, {3.9679090013815928`*^9, 3.967909006695292*^9}, {
   3.967909039522531*^9, 3.967909043459186*^9}, {3.96790913365495*^9, 
   3.967909145533299*^9}, {3.971873286307962*^9, 3.971873301795429*^9}, {
   3.971873346836566*^9, 3.971873348017638*^9}, {3.979985532072877*^9, 
   3.979985535086225*^9}, {3.980016756943943*^9, 3.98001675890452*^9}, {
   3.980016816228706*^9, 3.9800168185685263`*^9}, {3.980234828952331*^9, 
   3.980234880446824*^9}, {3.980235183401256*^9, 3.980235184623218*^9}, {
   3.980414990857095*^9, 3.980415030206102*^9}, {3.9804200218013983`*^9, 
   3.9804200312305317`*^9}, {3.983307840163073*^9, 3.9833078405384502`*^9}, 
   3.983547391917344*^9, {3.987549648100346*^9, 3.987549684589492*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[111]:=",ExpressionUUID->"d9233403-fbb0-4340-8faf-c88304670e8f"]
}, Closed]],

Cell[CellGroupData[{

Cell["PvalRestrictedBigSur", "Subsubsection",
 CellChangeTimes->{{3.9159766529365387`*^9, 
  3.9159766598879128`*^9}},ExpressionUUID->"e929737b-95e5-4170-845f-\
01d8c8d7c69b"],

Cell["\<\
If BigSur has been done on a matpac, but the pval cutoff was too generous, \
this allows one to redo it using a new, arbitrary pval cutoff.  It puts the \
new file in the same folder, which must be specified in the function.  \
\>", "Text",
 CellChangeTimes->{{3.915976671652359*^9, 
  3.915976738741459*^9}},ExpressionUUID->"6f91263c-4c03-45b2-9dce-\
649558cb7d3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PvalRestrictedBigSur", "[", 
    RowBox[{
    "matpac_", ",", "foldername_", ",", " ", "filemarker_", ",", " ", 
     "pval_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "m", ",", "logpmatrix", ",", " ", "significantPCCmatrix", ",", 
       "equivalentPCCs", ",", " ", "gno", ",", " ", "subsetgno", ",", 
       "communities"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SetDirectory", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], "<>", "foldername"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"logpmatrix", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"filemarker", "<>", "\"\<_logpvalues.mx\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"equivalentPCCs", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"filemarker", "<>", "\"\<_equivalentPCCs.mx\>\""}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "logpmatrix", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"significantPCCmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BoolEval", "[", 
           RowBox[{"logpmatrix", ">", 
            RowBox[{"-", 
             RowBox[{"Log10", "[", "pval", "]"}]}]}], "]"}], "*", 
          "equivalentPCCs"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", "m"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_restricted_PCCs_\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"-", 
           RowBox[{"Log10", "[", "pval", "]"}]}], "]"}], "<>", 
         "\"\<.mx\>\""}], ",", " ", "significantPCCmatrix"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gno", "=", 
       RowBox[{"CreateGNO", "[", 
        RowBox[{"matpac", ",", "significantPCCmatrix"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_gNO_R_\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"N", "[", 
           RowBox[{"-", 
            RowBox[{"Log10", "[", "pval", "]"}]}], "]"}], "]"}], "<>", 
         "\"\<mx\>\""}], ",", "gno"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"subsetgno", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"GeneSubsetGNO", "[", 
          RowBox[{
           RowBox[{"TruncateGNO", "[", 
            RowBox[{"gno", ",", "0", ",", " ", 
             RowBox[{"\"\<Positive Only\>\"", "->", " ", "True"}]}], "]"}], 
           ",", " ", "#"}], "]"}], "&"}], "/@", 
        RowBox[{"ReverseSortBy", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"FindCommunities", "[", "gno", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}], 
          ",", "Length"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"communities", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"ReverseSortBy", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{"#", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], 
               "]"}], "&"}], "/@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"FindCommunities", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"\"\<Timeout\>\"", "->", " ", "1200"}]}], "]"}], 
                "&"}], "/@", "subsetgno"}], ")"}]}], ",", "1"}], "]"}], ",", 
          "Length"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_significant communities_R_\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"N", "[", 
           RowBox[{"-", 
            RowBox[{"Log10", "[", "pval", "]"}]}], "]"}], "]"}], "<>", 
         "\"\<mx\>\""}], ",", "communities"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}]}], "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9159757572412*^9, 3.915975879118062*^9}, {
   3.915975918499363*^9, 3.915975951824531*^9}, {3.915976022975403*^9, 
   3.915976098936487*^9}, {3.915976147874392*^9, 3.915976327812585*^9}, {
   3.9159763877687473`*^9, 3.915976460380783*^9}, {3.9159764910562677`*^9, 
   3.91597649679587*^9}, {3.915976564465954*^9, 3.915976648604623*^9}, {
   3.915977686378096*^9, 3.915977694545183*^9}, {3.915977728491645*^9, 
   3.9159777397858562`*^9}, 3.915977807986985*^9, {3.91597804188111*^9, 
   3.915978062213821*^9}, {3.915978122084104*^9, 3.9159781253504763`*^9}, {
   3.9650680574733543`*^9, 3.965068060874846*^9}, {3.965068661609776*^9, 
   3.965068677210837*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[113]:=",ExpressionUUID->"f05ae63a-dac2-4f23-86ce-c931bb8c8925"]
}, Closed]],

Cell[CellGroupData[{

Cell["QuickSur", "Subsubsection",
 CellChangeTimes->{{3.9086673205896482`*^9, 
  3.90866732611059*^9}},ExpressionUUID->"583cbb47-35ee-4283-9e94-\
3d35fb679e0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuickFisherP", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "_Real"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "x", "]"}], "<", 
        RowBox[{"Tanh", "[", 
         FractionBox[
          RowBox[{"25", " ", 
           SqrtBox["2"]}], 
          SqrtBox[
           RowBox[{
            RowBox[{"-", "3"}], "+", "n"}]]], "]"}]}], ",", 
       RowBox[{"-", 
        RowBox[{"Log10", "[", 
         RowBox[{"Erfc", "[", 
          FractionBox[
           RowBox[{
            SqrtBox[
             RowBox[{
              RowBox[{"-", "3"}], "+", "n"}]], " ", 
            RowBox[{"ArcTanh", "[", 
             RowBox[{"Abs", "[", "x", "]"}], "]"}]}], 
           SqrtBox["2"]], "]"}], "]"}]}], ",", " ", 
       FractionBox[
        SuperscriptBox["x", "2"], 
        RowBox[{"Log", "[", "10", "]"}]]}], "]"}], ",", 
     RowBox[{"RuntimeAttributes", "\[Rule]", 
      RowBox[{"{", "Listable", "}"}]}], ",", 
     RowBox[{"Parallelization", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9089336164663963`*^9, 3.908933715811591*^9}, {
   3.908933756994276*^9, 3.908933809989271*^9}, 3.9089341385044327`*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[114]:=",ExpressionUUID->"dd2153a3-1155-45ce-bf5b-dbcf2c7e1392"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "QuickSur", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<alpha\>\"", "->", " ", "0.02"}], ",", " ", 
     RowBox[{"\"\<Interrupt\>\"", "->", " ", "True"}], " ", ",", 
     RowBox[{"\"\<Find Communities\>\"", "->", " ", "False"}], ",", 
     RowBox[{"\"\<Mean cutoff\>\"", "->", " ", "0.01"}], ",", " ", 
     RowBox[{"\"\<Max p-Threshold\>\"", "->", " ", "0.05"}], ",", " ", 
     RowBox[{"\"\<Quit After PCCs\>\"", "->", " ", "False"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QuickSur", "[", 
    RowBox[{
    "matpac_", ",", " ", "c_", ",", " ", "filemarker_", ",", "depthscaling_", 
     ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "matpac2", ",", "foldername", ",", "n", ",", "m", ",", " ", "mat", ",", 
       " ", "depthlist", ",", " ", "genetotals", ",", " ", "ematrix", ",", 
       " ", "pmatrix", ",", " ", "mflist", ",", "sigcutoff", ",", " ", 
       "fullpccmatrix", ",", "pccmatrix", ",", "threshold", ",", "logpmatrix",
        ",", " ", "significantPCCmatrix", ",", "gno", ",", " ", "subsetgno", 
       ",", "communities"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Tally", "[", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{"y", ">", "1"}]}]}], "]"}], ">", "0"}], ",", " ", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Matpac contains duplicated genes\>\"", "]"}], ";",
          " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"c", "<=", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<c must be greater than zero\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"depthlist", " ", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
         RowBox[{"N", "[", "depthscaling", "]"}], ",", 
         FractionBox[
          RowBox[{"Total", "/@", 
           RowBox[{"N", "[", 
            RowBox[{"Transpose", "[", 
             RowBox[{"matpac", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], 
          RowBox[{"Total", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"matpac2", " ", "=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"posns", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{"Mean", "/@", 
               RowBox[{"matpac", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"\[Mu]_", "/;", 
               RowBox[{"\[Mu]", ">", 
                RowBox[{
                "OptionValue", "[", "\"\<Mean cutoff\>\"", "]"}]}]}]}], "]"}],
             "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"matpac", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "posns"}], "]"}], "]"}], ",", " ", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "posns"}], "]"}], "]"}], ",", " ", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
           RowBox[{"matpac", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mat", "=", 
       RowBox[{"matpac2", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"genetotals", " ", "=", " ", 
       RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Started on\>\"", ",", 
        RowBox[{"CurrentDate", "[", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"foldername", "=", 
       RowBox[{"filemarker", "<>", 
        RowBox[{"DateString", "[", "]"}], "<>", "\"\< c=\>\"", "<>", 
        RowBox[{"ToString", "[", "c", "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"CreateDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"SetDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Print", "[", "\"\<Folder name is\>\"", "]"}], ";", 
      RowBox[{"Print", "[", "foldername", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ematrix", " ", "=", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pmatrix", " ", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"mat", "-", "ematrix"}], ")"}], 
        SqrtBox[
         RowBox[{"ematrix", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             SuperscriptBox["c", "2"], "ematrix"}]}], ")"}]}]]]}], "  ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mflist", " ", "=", " ", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"n", "-", "1"}]], 
        RowBox[{"Total", "/@", 
         RowBox[{"(", 
          SuperscriptBox["pmatrix", "2"], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "filemarker", "<>", "\"\<_modified_corrected_Fano factors.mx\>\""}], 
        ",", " ", "mflist"}], "]"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Modified, corrected Fano factors acquired and saved\>\"", ",", 
        " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<mcFano linear slope between 0.1 and 100 is \>\"", ",", 
        RowBox[{"a", "/.", 
         RowBox[{"FindFit", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"MapThread", "[", 
              RowBox[{"List", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"N", "[", 
                    RowBox[{"Mean", "[", "#", "]"}], "]"}], "&"}], "/@", 
                  "mat"}], ",", " ", "mflist"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"0.1", "<", 
               RowBox[{"First", "[", "#", "]"}], "<", "100"}], "&"}]}], "]"}],
            ",", 
           RowBox[{
            RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}]}], "]"}], ";",
       "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Interrupt\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Continue or try a different value of c?\>\"", 
          "]"}], ";", 
         RowBox[{"Interrupt", "[", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fullpccmatrix", "=", 
       RowBox[{"DotProductCF", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          FractionBox["pmatrix", 
           SqrtBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "mflist"}]]], "]"}], ",", "n"}],
         "]"}]}], " ", ";", "\[IndentingNewLine]", 
      RowBox[{"threshold", "=", 
       RowBox[{"x", "/.", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Erfc", "[", 
            FractionBox[
             RowBox[{
              SqrtBox[
               RowBox[{
                RowBox[{"-", "3"}], "+", "n"}]], " ", 
              RowBox[{"ArcTanh", "[", 
               RowBox[{"Abs", "[", "x", "]"}], "]"}]}], 
             SqrtBox["2"]], "]"}], "==", 
           RowBox[{"OptionValue", "[", "\"\<Max p-Threshold\>\"", "]"}]}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "0"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pccmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"LowerTriangularize", "[", 
          RowBox[{
           RowBox[{"fullpccmatrix", "*", 
            RowBox[{"BoolEval", "[", 
             RowBox[{
              RowBox[{"Abs", "[", "fullpccmatrix", "]"}], ">", "threshold"}], 
             "]"}]}], ",", 
           RowBox[{"-", "1"}]}], "]"}], ",", " ", 
         RowBox[{"Dimensions", "[", "fullpccmatrix", "]"}]}], "]"}]}], ";", 
      " ", "\[IndentingNewLine]", "\t", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_pccmatrix.mx\>\""}], ",", " ", 
        "pccmatrix"}], "]"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<corrected modified correlations acquired and saved \>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Quit After PCCs\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"filemarker", "<>", "\"\<_pccgenes.mx\>\""}], ",", " ", 
           RowBox[{"matpac2", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", " ", 
         RowBox[{"SetDirectory", "[", 
          RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"logpmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QuickFisherP", "[", 
             RowBox[{"#", ",", "n"}], "]"}], "&"}], ",", " ", "pccmatrix", 
           ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", "m"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"sigcutoff", "=", 
       RowBox[{"BHNew", "[", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"logpmatrix", "[", "\"\<ExplicitValues\>\"", "]"}], 
            ")"}]}]}], ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], ",", 
         RowBox[{"Binomial", "[", 
          RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"\"\<For FDR = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "]"}], "<>", 
         "\"\<, the significance level is p < \>\""}], ",", 
        RowBox[{"ScientificForm", "[", "sigcutoff", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"significantPCCmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BoolEval", "[", 
           RowBox[{"logpmatrix", ">", 
            RowBox[{"-", 
             RowBox[{"Log10", "[", "sigcutoff", "]"}]}]}], "]"}], "*", 
          "pccmatrix"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", "m"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_significantPCCs.mx\>\""}], ",", " ",
         "significantPCCmatrix"}], "]"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<significant PCCs identified and saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gno", "=", 
       RowBox[{"CreateGNO", "[", 
        RowBox[{"matpac2", ",", "significantPCCmatrix"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_gNO.mx\>\""}], ",", "gno"}], "]"}], 
      ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Gene Network Object saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Find Communities\>\"", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"subsetgno", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"GeneSubsetGNO", "[", 
             RowBox[{
              RowBox[{"TruncateGNO", "[", 
               RowBox[{"gno", ",", "0", ",", " ", 
                RowBox[{"\"\<Positive Only\>\"", "->", " ", "True"}]}], "]"}],
               ",", " ", "#"}], "]"}], "&"}], "/@", 
           RowBox[{"ReverseSortBy", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"FindCommunities", "[", "gno", "]"}], ",", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], 
              "]"}], ",", "Length"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"communities", "=", 
          RowBox[{"Quiet", "@", 
           RowBox[{"ReverseSortBy", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Select", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], 
                  "]"}], "&"}], "/@", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"FindCommunities", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"\"\<Timeout\>\"", "->", " ", "1200"}]}], "]"}], 
                   "&"}], "/@", "subsetgno"}], ")"}]}], ",", "1"}], "]"}], 
             ",", "Length"}], "]"}]}]}], ";", "\[IndentingNewLine]", "\t", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{
           "filemarker", "<>", "\"\<_significant communities.mx\>\""}], ",", 
           "communities"}], "]"}], ";", "\[IndentingNewLine]", "\t", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Communities Identified\>\"", ",", 
           RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}]}], ",", 
        RowBox[{
        "Print", "[", "\"\<Community Identification Skipped\>\"", "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Label", "[", "end", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<done\>\"", "]"}], ";", " ", 
      RowBox[{"Beep", "[", "]"}]}]}], "]"}]}], ";"}]}], "Input",
