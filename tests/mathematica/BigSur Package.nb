Cell["\<\
The code below should be used when we don\[CloseCurlyQuote]t have a constant \
\[OpenCurlyDoubleQuote]c\[CloseCurlyDoubleQuote] but rather a c that depends \
upon the value of \[Mu] and on parameters \[Eta] and \[Theta]\
\>", "Text",
 CellChangeTimes->{{3.964944552767227*^9, 
  3.964944597060666*^9}},ExpressionUUID->"fa02919c-bb39-4410-9eed-\
64ae530e1379"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InverseSqrtMomentListsAlt", "[", 
   RowBox[{
   "genetotals_", ",", "depthlist_", ",", " ", "\[Eta]_", ",", "\[Theta]_", 
    ",", " ", "n_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", " ", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"2", ",", 
         RowBox[{"Min", "[", "genetotals", "]"}]}], "]"}]}], ",", 
      RowBox[{"e", "=", 
       RowBox[{"n", "/", "50"}]}], ",", " ", 
      RowBox[{"h", "=", " ", 
       RowBox[{"Max", "[", "genetotals", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"glist", "=", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"1", "/", "4"}]]}], ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"1", "/", "2"}]]}], ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"3", "/", "4"}]]}], ",", "e", ",", " ", 
          RowBox[{"e", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"h", "/", "e"}], ")"}], 
            RowBox[{"1", "/", "3"}]]}], ",", 
          RowBox[{"e", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"h", "/", "e"}], ")"}], 
            RowBox[{"2", "/", "3"}]]}], ",", "h"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"simEmatrix", "=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"glist", ",", " ", "depthlist"}], "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{"List", ",", " ", 
            RowBox[{"{", 
             RowBox[{"glist", ",", " ", "#"}], "}"}]}], "]"}], "&"}], "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"InverseSqrtFanoMoments", "[", 
             RowBox[{
              RowBox[{"simEmatrix", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
              SqrtBox[
               RowBox[{
                FractionBox[
                 RowBox[{"\[Eta]", " ", "n"}], 
                 RowBox[{"glist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]], "+", " ", "\[Theta]"}]], 
              ",", "n", ",", 
              RowBox[{"Round", "[", 
               FractionBox["40000000.", 
                RowBox[{"n", 
                 RowBox[{"(", " ", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"Log10", "[", 
                    RowBox[{"glist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], 
                    RowBox[{"1", "/", "5"}]], "+", 
                   RowBox[{"0.5", " ", 
                    SuperscriptBox[
                    RowBox[{"Log10", "[", 
                    RowBox[{"glist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "3"]}]}], ")"}]}]],
                "]"}]}], "]"}], ",", "  ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", 
              RowBox[{"Length", "[", "simEmatrix", "]"}]}], "}"}]}], "]"}], 
          "]"}]}]}], "]"}]}], "]"}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.890051537067006*^9, 3.8900516764027653`*^9}, {
   3.890053542872484*^9, 3.8900536513093557`*^9}, {3.8900536840736094`*^9, 
   3.890053764053096*^9}, {3.8900540042007103`*^9, 3.89005403471698*^9}, {
   3.8900546096916857`*^9, 3.890054637432705*^9}, {3.890068050479712*^9, 
   3.890068054333262*^9}, {3.89006810123067*^9, 3.890068102101403*^9}, 
   3.890664518191127*^9, {3.890675080233337*^9, 3.890675113237733*^9}, {
   3.890675181905209*^9, 3.890675214489602*^9}, 3.8906752513697233`*^9, 
   3.890689621002775*^9, {3.96494407173279*^9, 3.964944107282*^9}, {
   3.964944178068527*^9, 3.964944178481887*^9}, {3.96494426263111*^9, 
   3.964944294932592*^9}, {3.964944668553607*^9, 3.964944672181682*^9}},
