Cell[BoxData[
 RowBox[{
  RowBox[{"SmallerInterval", "[", "list_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"If", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "list", "]"}], "]"}], "]"}], "<", 
     RowBox[{"Abs", "[", 
      RowBox[{"First", "[", 
       RowBox[{"Last", "[", "list", "]"}], "]"}], "]"}]}], ",", 
    RowBox[{"First", "[", "list", "]"}], ",", " ", 
    RowBox[{"Last", "[", "list", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.890847927840259*^9, 3.890847931347826*^9}, {
