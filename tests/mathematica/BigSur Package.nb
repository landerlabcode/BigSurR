     RowBox[{"depthlist", " ", "=", 
      FractionBox[
       RowBox[{"Total", "/@", 
        RowBox[{"N", "[", 
         RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
       RowBox[{"Total", "[", 
