Cell[TextData[{
 "This much faster version takes the whole parameters list as one argument, \
and the Table of ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "k"}], ",", 
       RowBox[{"-", " ", 
        FractionBox[
         RowBox[{"2", "k"}], "3"]}], ",", " ", 
       RowBox[{"-", 
        FractionBox["k", "3"]}], ",", " ", "0", ",", " ", 
       FractionBox["k", "3"], ",", " ", 
       FractionBox[
        RowBox[{"2", "k"}], "3"], ",", "k"}], "}"}]}], "}"}]}]],
  CellChangeTimes->{{3.8937268209499197`*^9, 3.8937268759658318`*^9}, {
    3.893726999836699*^9, 3.893727029458117*^9}, 3.893727998745921*^9, 
    3.893775374719207*^9, {3.893775445970804*^9, 3.893775460216476*^9}, 
    3.893775537201556*^9, 3.893775634472065*^9},
  Background->RGBColor[1, 1, 0],ExpressionUUID->
  "704f3c35-d2c7-4868-9d17-454a9541997a"],
 " as its second.  So one has to generate the table first;"
}], "Text",
 CellChangeTimes->{{3.9675630460640182`*^9, 
  3.967563097720446*^9}},ExpressionUUID->"20fba87f-ad23-4a7b-b530-\
04e989858108"],

