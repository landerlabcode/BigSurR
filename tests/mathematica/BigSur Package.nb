        RowBox[{"n", ",", "_Real"}], "}"}]}], " ", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         FractionBox["1", "n"], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "ematrix", "]"}], ",", " ", 
           RowBox[{"Length", "[", "ematrix", "]"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         FractionBox["1", 
