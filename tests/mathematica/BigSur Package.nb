               RowBox[{"(", 
                RowBox[{
                 FractionBox["1", 
                  RowBox[{"newematrix", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]], "+", "j"}], " ", ")"}]], 
              ")"}]}], " ", "+", "1", "-", "n"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1"}], "}"}], ",", " ", 
           RowBox[{"Method", "->", " ", "\"\<Secant\>\""}]}], "]"}]}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "newmat", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
