Cell[CellGroupData[{

Cell["DotProduct", "Subsubsection",
 CellChangeTimes->{{3.83665667765203*^9, 3.8366567034498262`*^9}, {
  3.854756448292412*^9, 3.854756455295392*^9}, {3.871323442386882*^9, 
  3.8713234432428637`*^9}},ExpressionUUID->"365d2e3e-0381-413f-a363-\
c9a1cb6752dc"],

Cell["\<\
This operates on a matrix, and generates a matrix of Absolute Correlations \
multiplied by the vector length, which comes out to simply be the dot product \
of each vector with each other.   The result is expressed in \
LowerTriangularized form.  If this is applied to a matrix that has been \
booleanized, then the entries represent a count of the number of positions \
where both vectors had a non-zero entry.  \
\>", "Text",
 CellChangeTimes->{{3.837043937816786*^9, 
  3.8370440728786077`*^9}},ExpressionUUID->"125639f0-80cb-4aa6-b86a-\
014c7d8f3da2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DotProduct", "[", "mat_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"LowerTriangularize", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Width", "[", "mat", "]"}], "*", 
     RowBox[{"AbsoluteCorrelation", "[", 
      RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], ",", 
    RowBox[{"-", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836656707771317*^9, 3.836656799738718*^9}, {
  3.836656846851975*^9, 3.836656852986064*^9}, {3.836656891886737*^9, 
  3.836656984206335*^9}, {3.837043934706648*^9, 3.83704393542091*^9}, {
  3.837044009278222*^9, 3.837044020371567*^9}, {3.8370441251016817`*^9, 
  3.8370441275513983`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[15]:=",ExpressionUUID->"1c4456de-160d-4691-988f-764f564953ac"]
}, Closed]],

Cell[CellGroupData[{

Cell["DotProductCF", "Subsubsection",
 CellChangeTimes->{{3.87132343532423*^9, 
  3.871323436761965*^9}},ExpressionUUID->"6fcc955a-e3d9-45af-bfbb-\
58a579f750ae"],

Cell["\<\
DotProductCF is a compiled version of DotProduct; it does not \
lowertriangularize, however.  It operates on a matrix, and generates a matrix \
of Absolute Correlations multiplied by the vector length, which comes out to \
simply be the dot product of each vector with each other.   If this is \
applied to a matrix that has been booleanized, then the entries represent a \
count of the number of positions where both vectors had a non-zero entry.  \
\>", "Text",
 CellChangeTimes->{{3.854540296355093*^9, 3.854540323992663*^9}, {
  3.871323455297773*^9, 
  3.871323472713579*^9}},ExpressionUUID->"ec75073f-83c4-4c7a-b621-\
8f19bad3abf8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DotProductCF", "=", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mat", ",", " ", "_Real", ",", " ", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "_Integer"}], "}"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"n", "*", 
     RowBox[{"AbsoluteCorrelation", "[", 
      RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], ",", " ", 
    RowBox[{"RuntimeAttributes", "\[Rule]", 
     RowBox[{"{", "Listable", "}"}]}], ",", 
    RowBox[{"Parallelization", "\[Rule]", "True"}]}], "]"}]}]], "Input",
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[16]:=",ExpressionUUID->"489dc2e9-01e9-4484-a037-53a3fd9bd597"],

