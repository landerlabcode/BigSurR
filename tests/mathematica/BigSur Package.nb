            RowBox[{"10", "^", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"logpmatrix", "[", "\"\<ExplicitValues\>\"", "]"}], 
               ")"}]}]}], ",", " ", 
            RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], ",", 
            RowBox[{"Binomial", "[", 
             RowBox[{"m", ",", "2"}], "]"}]}], " ", "]"}]}]}], ",", 
        "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
             RowBox[{"Binomial", "[", 
              RowBox[{"m", ",", "2"}], "]"}]}], "]"}], ",", 
           RowBox[{"2", "*", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"3", "*", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}]}], "}"}]}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"\"\<For FDR = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "]"}], "<>", 
         "\"\<, the significance level is p < \>\""}], ",", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"sigcutofflist", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"significantPCCmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BoolEval", "[", 
           RowBox[{"logpmatrix", ">", 
            RowBox[{"-", 
             RowBox[{"Log10", "[", 
