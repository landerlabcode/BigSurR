      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<significant PCCs identified and saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gno", "=", 
       RowBox[{"CreateGNO", "[", 
        RowBox[{"matpac", ",", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{"logpmatrix", ">", 
             RowBox[{"-", 
              RowBox[{"Log10", "[", 
               RowBox[{"sigcutofflist", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "]"}], "*", 
           "pccmatrix"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "gno", "]"}], "==", "0"}], ",", " ", 
        RowBox[{"Goto", "[", "end", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_gNOpccprime.mx\>\""}], ",", "gno"}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Gene Network Object saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Find Communities\>\"", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"subsetgno", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"GeneSubsetGNO", "[", 
             RowBox[{
              RowBox[{"TruncateGNO", "[", 
               RowBox[{"gno", ",", "0", ",", " ", 
                RowBox[{"\"\<Positive Only\>\"", "->", " ", "True"}]}], "]"}],
               ",", " ", "#"}], "]"}], "&"}], "/@", 
           RowBox[{"ReverseSortBy", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"FindCommunities", "[", "gno", "]"}], ",", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], 
              "]"}], ",", "Length"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"communities", "=", 
          RowBox[{"Quiet", "@", 
           RowBox[{"ReverseSortBy", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Select", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], 
                  "]"}], "&"}], "/@", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"FindCommunities", "[", 
