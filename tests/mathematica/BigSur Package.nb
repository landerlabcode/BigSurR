   3.895681563980618*^9}, {3.895686201440524*^9, 3.895686201836247*^9}, {
   3.8957471326106997`*^9, 3.895747132960764*^9}, {3.925783111221504*^9, 
   3.925783115725484*^9}, {3.925783178318585*^9, 3.92578320057281*^9}, 
   3.925783282187269*^9, {3.964815470160994*^9, 3.964815522922028*^9}, {
   3.964815561212552*^9, 3.9648156255312443`*^9}, {3.9648156739933*^9, 
   3.964815706048901*^9}, {3.964815747126768*^9, 3.964815747588249*^9}, {
