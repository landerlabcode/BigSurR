              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}]}], "}"}]}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
