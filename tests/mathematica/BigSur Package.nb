Cell[CellGroupData[{

Cell["FastFindX (to be dropped in Alt4)", "Subsubsection",
 CellChangeTimes->{{3.8815261892818537`*^9, 3.88152619710742*^9}, {
  3.890916253330764*^9, 
  3.890916259448098*^9}},ExpressionUUID->"2a50973e-b6cb-4a45-b304-\
ee7e05fe480e"],

Cell["\<\
The first part of the code, TestRoot, is just a version of FindRoot that \
looks only at positive numbers for positive correlations and negative numbers \
for negative correlations.  If the zero-order term of the CF polynomial is \
within \[OpenCurlyDoubleQuote]threshold\[CloseCurlyDoubleQuote] of zero, it \
just returns zero.  If FindRoot fails to find anything, or generates any \
error message at all, it returns \[OpenCurlyDoubleQuote]z\
\[CloseCurlyDoubleQuote].  

FastFindX  starts off by applying FindRoot to a whole set of CF parameters.  \
Then it locates those positions where z was returned. 
To those positions, it tries FindInstance.  This is necessary because there \
are some cases where FindRoot will generate an error message even though a \
root can be found, and thus a z will be returned instead of the actual root.  \
Where FindInstance fails, it returns \[OpenCurlyDoubleQuote]x\
\[CloseCurlyDoubleQuote].  The results of this step are then incorporated \
into the list of results replacing all the z\[CloseCurlyQuote]s. 

Finally, the code retrieves all the positions where \[OpenCurlyDoubleQuote]x\
\[CloseCurlyDoubleQuote] appears, and tries a version of FindInstance that \
checks for a location where the slope is zero and the curvature is either \
positive or negative, depending on whether the zero-order term of the \
polynomial is positive or negative.  Essentially this gives us locations \
where the CF curve comes close to the x-axis but doesn\[CloseCurlyQuote]t \
quite cross it.  These values are then used to replace all the x-values.  

We find empirically that, when all three steps are completed, no x-values \
remain.  \
\>", "Text",
 CellChangeTimes->{{3.881527498975069*^9, 3.881527740220592*^9}, {
  3.881527792231957*^9, 
  3.881528089469934*^9}},ExpressionUUID->"2deb83c4-82d4-4ac2-8ce8-\
e6e83d1b5768"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"TestRoot", "[", 
    RowBox[{"params_", ",", " ", "threshold_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"First", "[", "params", "]"}], "]"}], "<", "threshold"}], ",", 
     " ", "0.", ",", "\[IndentingNewLine]", 
     RowBox[{"Quiet", "[", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "[", "params", "]"}], "==", "1"}], ",", "\n", 
        "\t\t\t ", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"x", "/.", 
           RowBox[{"FindRoot", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"params", ".", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "x", ",", 
                 SuperscriptBox["x", "2"], ",", 
                 SuperscriptBox["x", "3"], ",", 
                 SuperscriptBox["x", "4"], ",", "0"}], "}"}]}], "==", "0"}], 
             ",", " ", 
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "0", ",", "0", ",", "\[Infinity]"}], " ",
               "}"}], ",", 
             RowBox[{"Method", "\[Rule]", "\"\<Secant\>\""}]}], "]"}]}], ",", 
          "z"}], "]"}], ",", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"x", "/.", 
           RowBox[{"FindRoot", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"params", ".", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "x", ",", 
                 SuperscriptBox["x", "2"], ",", 
                 SuperscriptBox["x", "3"], ",", 
                 SuperscriptBox["x", "4"], ",", "0"}], "}"}]}], "==", "0"}], 
             ",", " ", 
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "0", ",", 
               RowBox[{"-", "\[Infinity]"}], ",", "0"}], " ", "}"}], ",", 
             RowBox[{"Method", "\[Rule]", "\"\<Secant\>\""}]}], "]"}]}], ",", 
          "z"}], "]"}]}], "]"}], "]"}]}], "]"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.881343351203388*^9, 3.881343409581544*^9}, {
  3.881343489642108*^9, 3.881343566154272*^9}, {3.881343615831455*^9, 
  3.881343643570694*^9}, {3.881343730045981*^9, 3.8813438030467176`*^9}, {
  3.881343870991353*^9, 3.881343874822133*^9}, {3.881346168945456*^9, 
  3.881346183294935*^9}, {3.881552115575597*^9, 3.881552118855701*^9}, {
  3.890916266123831*^9, 3.890916268314781*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[61]:=",ExpressionUUID->"bb71a2ca-9752-4235-8cbc-3875f7840504"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"FastFindX", "[", 
    RowBox[{"paramset_", ",", " ", "threshold_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r1", " ", ",", "r2", ",", "failposns1", ",", "failposns2", ",", "  ", 
       "fixedfails1", ",", " ", "fixedfails2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"r1", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"TestRoot", "[", 
              RowBox[{"#", ",", " ", "threshold"}], "]"}], "&"}], "/@", 
            "paramset"}]}], ";", "\[IndentingNewLine]", 
          StyleBox[
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Stage 1 of FindX complete\>\"", ",", " ", 
             RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}],
           FontColor->RGBColor[1, 0, 1]], 
          StyleBox[";",
           FontColor->RGBColor[1, 0, 1]], "\[IndentingNewLine]", 
          RowBox[{"failposns1", "=", " ", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{"r1", ",", " ", "z"}], "]"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "this", " ", "gives", " ", "you", " ", "the", " ", "locations", 
            " ", "within", " ", "r1", " ", "where", " ", "TestRoot", " ", 
            "failed"}], ";", " ", 
           RowBox[{
           "r1", " ", "has", " ", "the", " ", "same", " ", "length", " ", 
            "as", " ", "paramset"}]}], "*)"}], ";", "\[IndentingNewLine]", 
         RowBox[{"fixedfails1", " ", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "/.", 
              RowBox[{"FindInstance", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Evaluate", "[", 
                  RowBox[{
                   RowBox[{"#", ".", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "x", ",", 
                    SuperscriptBox["x", "2"], ",", 
                    SuperscriptBox["x", "3"], ",", 
                    SuperscriptBox["x", "4"], ",", "0"}], "}"}]}], "==", 
                   "0"}], "]"}], "&&", 
                 RowBox[{
                  RowBox[{"Sign", "[", "x", "]"}], "==", " ", 
                  RowBox[{"Sign", "[", 
                   RowBox[{"Last", "[", "#", "]"}], "]"}]}]}], " ", ",", "x", 
                ",", "Reals"}], "]"}]}], "&"}], "/@", 
            RowBox[{"paramset", "[", 
             RowBox[{"[", "failposns1", "]"}], "]"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "this", " ", "gives", " ", "substitute", " ", "values", " ", "for", 
           " ", "each", " ", "of", " ", "the", " ", "failed", " ", 
           "positions", " ", "in", " ", "r1"}], ";", " ", 
          RowBox[{"where", " ", "it", " ", 
           RowBox[{"doesn", "'"}], "t", " ", "it", " ", "puts", " ", "an", 
           " ", 
           RowBox[{"x", ".", "  ", "we"}], " ", "can", " ", "thread", " ", 
           "failposns1", " ", "onto", " ", "fixedfails1", " ", "and", " ", 
           "generate", " ", "replacement", " ", "rules", " ", "for", " ", 
           "r1"}]}], "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"r2", " ", "=", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{"r1", ",", 
           RowBox[{"Thread", "[", 
            RowBox[{"failposns1", "->", " ", "fixedfails1"}], "]"}]}], 
          "]"}]}], " ", ";", "\[IndentingNewLine]", 
        StyleBox[
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Stage 2 of FindX complete\>\"", ",", " ", 
           RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}],
         FontColor->RGBColor[1, 0, 1]], 
        StyleBox[";",
         FontColor->RGBColor[1, 0, 1]], "\[IndentingNewLine]", 
        RowBox[{"failposns2", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{"r2", ",", " ", "x"}], "]"}], "]"}]}], ";"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "this", " ", "gives", " ", "the", " ", "positions", " ", "within", 
          " ", "r2"}], ",", " ", 
         RowBox[{"and", " ", "within", " ", "paramset"}], ",", " ", 
         RowBox[{
         "where", " ", "a", " ", "result", " ", "was", " ", "not", " ", "yet",
           " ", "found"}]}], "*)"}], ";", "\[IndentingNewLine]", 
       RowBox[{"fixedfails2", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "/.", 
            RowBox[{"FindInstance", "[", 
             RowBox[{
              RowBox[{"Evaluate", "[", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", ".", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", "1", ",", 
                    RowBox[{"2", "x"}], ",", 
                    RowBox[{"3", 
                    SuperscriptBox["x", "2"]}], ",", 
                    RowBox[{"4", 
                    SuperscriptBox["x", "3"]}], ",", "0"}], "}"}]}], "==", 
                  "0"}], "&&", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sign", "[", 
                    RowBox[{"First", "[", "#", "]"}], "]"}], "*", 
                   RowBox[{"#", ".", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", "2", ",", 
                    RowBox[{"6", "x"}], ",", 
                    RowBox[{"12", 
                    SuperscriptBox["x", "2"]}], ",", "0"}], "}"}]}]}], ">", 
                  "0"}]}], ")"}], "]"}], ",", " ", "x", ",", " ", "Reals"}], 
             "]"}]}], "&"}], "/@", 
          RowBox[{"paramset", "[", 
           RowBox[{"[", "failposns2", "]"}], "]"}]}], "]"}]}], ";"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "this", " ", "gives", " ", "substitute", " ", "values", " ", "for", 
         " ", "each", " ", "of", " ", "the", " ", "failed", " ", 
         "positions"}], ";", " ", 
        RowBox[{
        "however", " ", "we", " ", "need", " ", "to", " ", "know", " ", 
         "their", " ", "positions", " ", "in", " ", "r1"}]}], "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"r2", ",", 
        RowBox[{"Thread", "[", 
         RowBox[{"failposns2", "->", " ", "fixedfails2"}], "]"}]}], "]"}]}]}],
     "]"}]}], "*)"}]], "Input",
