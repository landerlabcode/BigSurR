           " ", "invsqrtmoments"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<inverse squareroot Fano moments acquired and saved \>\"", ",", 
           
           RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"fanocorrectionmatrices", "=", 
          RowBox[{"SqrtCorrectionmats", "[", 
           RowBox[{"invsqrtmoments", ",", "genetotals"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"fanocorrectionmatrices", "=", 
          RowBox[{"Table", "[", " ", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", "4"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<inverse squareroot Fano moments ignored \>\"", 
          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ccmats", "=", 
       RowBox[{"CorrelationCumulantsNewCF", "[", 
        RowBox[{"ematrix", ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "c", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Adjusted cumulants of the correlations acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polymatrix", "=", 
       RowBox[{"CornishFisherPolynomialCoefficients5CF", "[", 
        RowBox[{
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "4", "]"}], "]"}], " ", ",", "pccmatrix"}], "]"}]}], 
      " ", ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Cornish Fisher Polynomial Coefficients acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"augmentedParameters", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"SymmetricMatrixToListNew", "/@", 
         RowBox[{"Append", "[", 
          RowBox[{"polymatrix", ",", " ", "pccSignmatrix"}], "]"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"Length", "[", "augmentedParameters", "]"}], "]"}], "<>", 
         "\"\< equations gathered\>\""}], ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xlist", "=", 
       RowBox[{"ImprovedFindXAlt", "[", 
        RowBox[{"augmentedParameters", ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<First Pass Cutoff\>\"", "]"}], ",", 
         " ", "genetotals", ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}]}], "]"}]}], ";", 
      " ", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_xlist.mx\>\""}], ",", "xlist"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<x-values acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"logpmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"IntegerPart", "[", 
            RowBox[{"MatrixIndexCF", "/@", 
             RowBox[{"Flatten", "[", 
              RowBox[{"xlist", "[", "\"\<ExplicitPositions\>\"", "]"}], 
              "]"}]}], "]"}], "->", " ", 
           RowBox[{"FixedPValFunc", "/@", 
            RowBox[{"xlist", "[", "\"\<ExplicitValues\>\"", "]"}]}]}], "]"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_logpvalues.mx\>\""}], ",", 
        "logpmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<p-values acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"equivalentPCCs", " ", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"InferredPCCs2", "[", 
         RowBox[{"logpmatrix", ",", "pccSignmatrix", ",", 
          RowBox[{"OptionValue", "[", "\"\<First Pass Cutoff\>\"", "]"}], ",",
           " ", "n"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_equivalentPCCs.mx\>\""}], ",", " ", 
        "equivalentPCCs"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<equivalent PCCs acquired and saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "]"}], ",", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], ",", 
           RowBox[{"2", "*", 
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}], ",", 
           RowBox[{"3", "*", 
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}]}], "}"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "==", 
         "\"\<BH\>\""}], ",", "\[IndentingNewLine]", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{"2", "#"}], ",", " ", 
             RowBox[{"3", "#"}]}], "}"}], "&"}], "@", 
          RowBox[{"BHNew", "[", 
           RowBox[{
            RowBox[{"10", "^", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"logpmatrix", "[", "\"\<ExplicitValues\>\"", "]"}], 
               ")"}]}]}], ",", " ", 
            RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], ",", 
            RowBox[{"Binomial", "[", 
             RowBox[{"m", ",", "2"}], "]"}]}], " ", "]"}]}]}], ",", 
        "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
             RowBox[{"Binomial", "[", 
              RowBox[{"m", ",", "2"}], "]"}]}], "]"}], ",", 
           RowBox[{"2", "*", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"3", "*", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}]}], "}"}]}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"\"\<For FDR = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "]"}], "<>", 
