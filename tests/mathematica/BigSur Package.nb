Cell[TextData[{
 "Note the use of \[OpenCurlyDoubleQuote]Max[2,.]\[CloseCurlyDoubleQuote] \
which serve to avoid values of 1, which when logarithms are taken later \
produce values of infinity for Table\[CloseCurlyQuote]s iterator.  The \
expression ",
 Cell[BoxData[
  RowBox[{"Round", "[", 
   FractionBox["40000000.", 
    RowBox[{"n", 
     RowBox[{"(", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Log10", "[", 
         RowBox[{"glist", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], 
        RowBox[{"1", "/", "5"}]], "+", 
       RowBox[{"0.5", " ", 
        SuperscriptBox[
         RowBox[{"Log10", "[", 
          RowBox[{"glist", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "3"]}]}], ")"}]}]], "]"}]],
