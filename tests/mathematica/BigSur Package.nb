Cell[BoxData[
 RowBox[{
  RowBox[{"Foundroots", "[", "params_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn", " ", "=", 
      RowBox[{"params", ".", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "x", ",", " ", 
         SuperscriptBox["x", "2"], ",", " ", 
         SuperscriptBox["x", "3"], ",", " ", 
         SuperscriptBox["x", "4"], ",", "0"}], "}"}]}]}], " ", "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"list", "=", " ", 
        RowBox[{"N", "@", 
         RowBox[{"First", "[", 
          RowBox[{"RootIntervals", "[", "eqn", "]"}], "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"spanningset", " ", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"list", ",", "  ", 
            RowBox[{
             RowBox[{
              RowBox[{"Sign", "[", 
               RowBox[{"Times", "[", 
                RowBox[{
                 RowBox[{"First", "[", "#", "]"}], ",", 
                 RowBox[{"Last", "[", "#", "]"}]}], "]"}], "]"}], "==", 
              RowBox[{"-", "1"}]}], "&"}]}], "]"}]}], " ", "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Which", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "spanningset", "]"}], ">", "0"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"x", "/.", 
           RowBox[{"FindRoot", "[", 
            RowBox[{"eqn", ",", " ", 
             RowBox[{"Flatten", "[", 
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "spanningset"}], "}"}], "]"}], ",", " ", 
             RowBox[{"Method", "->", "\"\<Secant\>\""}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Length", "[", "list", "]"}], "==", "0"}], ",", " ", 
          "\[IndentingNewLine]", "z", ",", " ", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Length", "[", "list", "]"}], "==", "1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"x", "/.", 
           RowBox[{"FindRoot", "[", 
            RowBox[{"eqn", ",", " ", 
             RowBox[{"Flatten", "[", 
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "list"}], "}"}], "]"}], ",", " ", 
             RowBox[{"Method", "->", "\"\<Secant\>\""}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "True", ",", " ", "\[IndentingNewLine]", 
          RowBox[{"x", "/.", 
           RowBox[{"FindRoot", "[", 
            RowBox[{"eqn", ",", " ", 
             RowBox[{"Flatten", "[", 
              RowBox[{"{", 
               RowBox[{"x", ",", " ", 
                RowBox[{"Flatten", "@", 
                 RowBox[{"SmallerInterval", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"FixedLast", "@", 
                    RowBox[{"Select", "[", 
                    RowBox[{"list", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Last", "[", "#", "]"}], "<", "0"}], "&"}]}], 
                    "]"}]}], ",", 
                    RowBox[{"FixedFirst", "@", 
                    RowBox[{"Select", "[", 
                    RowBox[{"list", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&"}]}], 
                    "]"}]}]}], "}"}], "/.", 
                   RowBox[{"Null", "->", " ", "Nothing"}]}], "]"}]}]}], "}"}],
               "]"}], ",", " ", 
             RowBox[{"Method", "->", " ", "\"\<Secant\>\""}]}], "]"}]}]}], 
         " ", "]"}]}], "\[IndentingNewLine]", "]"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.890835433265136*^9, 3.890835456906057*^9}, {
   3.890835491317143*^9, 3.8908355775767803`*^9}, {3.890835721185355*^9, 
   3.890835723304747*^9}, 3.890836943580841*^9, {3.890837019909089*^9, 
   3.8908370253239727`*^9}, {3.890837529721693*^9, 3.8908376677074957`*^9}, {
   3.890837701063281*^9, 3.890837759846876*^9}, {3.8908378042585583`*^9, 
