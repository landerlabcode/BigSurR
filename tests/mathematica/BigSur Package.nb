         "&"}], "/@", "bl"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newmat", "=", 
      RowBox[{"mat", "[", 
       RowBox[{"[", "genesample", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"newgenetotals", "=", 
      RowBox[{"genetotals", "[", 
       RowBox[{"[", "genesample", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"newematrix", "=", " ", 
