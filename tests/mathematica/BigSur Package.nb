Cell[BoxData[
 RowBox[{
  RowBox[{"ImprovedFindXAlt", "[", 
   RowBox[{
   "augmentedParameters_", ",", "cutoff_", ",", " ", "genetotals_", ",", " ", 
    "alpha_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
     "table", ",", " ", "passedTest", ",", "survivingparams", ",", " ", 
      "trueroots", ",", "rootsComplete", ",", "logpcriterion", ",", " ", 
      "checkposns", ",", "additionalQuasirootsPosns", ",", " ", 
      "rootsFinal"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"table", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "x", ",", 
           SuperscriptBox["x", "2"], ",", 
           SuperscriptBox["x", "3"], ",", " ", 
           SuperscriptBox["x", "4"], ",", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "k"}], ",", 
             RowBox[{"-", " ", 
              FractionBox[
               RowBox[{"2", "k"}], "3"]}], ",", " ", 
             RowBox[{"-", 
              FractionBox["k", "3"]}], ",", " ", "0", ",", " ", 
             FractionBox["k", "3"], ",", " ", 
             FractionBox[
              RowBox[{"2", "k"}], "3"], ",", "k"}], "}"}]}], "}"}]}], "]"}], "/.", 
       RowBox[{"k", "->", " ", 
        RowBox[{
         SqrtBox["2"], " ", 
         RowBox[{"InverseErfc", "[", 
          RowBox[{"2.", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "cutoff"}]]}], "]"}]}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"passedTest", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"SparseArray", "[", 
         RowBox[{"BoolEval", "[", 
          RowBox[{
           RowBox[{"QuickTest6CFAltNew", "[", 
            RowBox[{"augmentedParameters", ",", " ", "table"}], "]"}], "==", 
           "7"}], "]"}], "]"}], "[", "\"\<ExplicitPositions\>\"", "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"survivingparams", "=", " ", 
      RowBox[{"augmentedParameters", "[", 
       RowBox[{"[", "passedTest", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Quick test complete.  Surviving parameter sets = \>\"", ",", " ", 
       RowBox[{"Length", "[", "passedTest", "]"}], ",", " ", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"trueroots", " ", "=", "  ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"TakeSmallestBy", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "/.", 
               RowBox[{"{", 
                RowBox[{"ToRules", "[", 
                 RowBox[{"NRoots", "[", 
                  RowBox[{"#", ",", "x"}], "]"}], "]"}], "}"}]}], "/.", 
              RowBox[{"_Complex", "->", " ", "z"}]}], ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{"z", "->", "Nothing"}], "}"}]}], ",", " ", "Abs", ",", 
           "1"}], "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", ".", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "x", ",", " ", 
               SuperscriptBox["x", "2"], ",", " ", 
               SuperscriptBox["x", "3"], ",", " ", 
               SuperscriptBox["x", "4"], ",", "0"}], "}"}]}], "==", "0"}], 
           "&"}], "/@", "survivingparams"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<True roots found\>\"", ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rootsComplete", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"trueroots", ",", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"trueroots", ",", " ", "z"}], "]"}], "]"}], "->", " ", 
          RowBox[{"FindZAlt", "[", 
           RowBox[{"survivingparams", "[", 
            RowBox[{"[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Position", "[", 
               RowBox[{"trueroots", ",", " ", "z"}], "]"}], "]"}], "]"}], 
            "]"}], "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Quasiroots found \>\"", ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"passedTest", "->", " ", "rootsComplete"}], "]"}], ",", " ", 
       RowBox[{"Length", "[", "augmentedParameters", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.893727055947524*^9, 3.893727060841234*^9}, {
   3.895691355041161*^9, 3.8956913583569202`*^9}, {3.967159093986676*^9, 
   3.967159107661145*^9}, {3.967369768229622*^9, 3.9673697841710033`*^9}, {
   3.967369866032178*^9, 3.967369884453267*^9}, {3.967369944035203*^9, 
   3.967369971162064*^9}, {3.967370117917665*^9, 3.967370126200614*^9}, {
   3.967370167433305*^9, 3.967370197326371*^9}, {3.96737024715031*^9, 
   3.967370247572404*^9}, 3.9673703773856916`*^9, {3.9673724261568947`*^9, 
   3.967372428105905*^9}, {3.9673725317152*^9, 3.967372572563097*^9}, 
   3.9673726229844227`*^9, {3.967373676782989*^9, 3.967373751962159*^9}, {
   3.967415651913752*^9, 3.9674156528905363`*^9}, {3.96741568930619*^9, 
   3.967415705253685*^9}, 3.967460742652629*^9, {3.9675638188269167`*^9, 
   3.967563847205934*^9}, {3.967563877241776*^9, 3.967563963586893*^9}, {
   3.9675735613048077`*^9, 3.967573574185624*^9}, {3.967574747680234*^9, 
   3.967574748600916*^9}, {3.967575040475416*^9, 3.967575053798881*^9}, {
   3.9675751877475653`*^9, 3.96757520741838*^9}, {3.999784850257563*^9, 
   3.999784853479734*^9}, {3.9997849539490223`*^9, 3.999784983473847*^9}},
 Background->RGBColor[
  1, 1, 0],ExpressionUUID->"1917538e-bb5b-461b-b57e-a8757f586c08"],

Cell[TextData[{
 "Here are the steps.\nWe begin with a list of augmented parameters of length \
Binomial[m,2].  Let use define -X and X as the X-positions corresponding to \
our p-value cutoff.  \n\nStep 1:  We apply QuickTest6CF to all the augmented \
parameters to generate a list of positions, \[OpenCurlyDoubleQuote]passedTest\
\[CloseCurlyDoubleQuote] where QuickTest6CF returns 1.  The indexing of \
passedTest runs from 1 to Binomial[m,2].   QuickTest6CF is a fast function \
that takes as input a list of augmented parameters, and a -logpvalue cutoff, \
and outputs 1 or 0 to indicate whether the values of the polynomial at x= -X \
and x=X are different, or whether the values at x= -X and x= X have the same \
sign, but one that is different from the value at x=0.   If they do then, by \
continuity we know that there is a root between -X and X, i.e. a root that \
will produce a -logp-value below the cutoff.   So our first step is to \
identify all the polynomials that cannot be excluded on these grounds.  \n\n\
Step 2:  We then apply NRoots to the surviving parameter sets \
(survivingparams), taking the Real one with the smallest absolute value. \
Where no true root exist it returns z.  \n\nStep 3: To those cases where z \
was  returned, we use FindZAlt to return a quasi-root.  We then replace the z\
\[CloseCurlyQuote]s with these quasiroots; the whole thing together is called \
",
 StyleBox["rootsComplete",
  FontSlant->"Italic"],
 ".  This list has the same length as passedTest.  Thus if we want to find \
out which augmented parameters go with which roots we match them up with \
survivingparams.\n\t\nStep 4:  We use Benjamini Hochberg to find the \
significance cutoff for FixedPValFunc/@rootsComplete, using Binomial[m,2] as \
our Array length.   We define ",
 StyleBox["checkposns",
  FontSlant->"Italic"],
 " as those locations within rootsComplete where the BH cutoff was exceeded, \
i.e. those positions that are significant given our choice of alpha.  ",
 StyleBox["\n",
  FontSlant->"Italic"],
 "\nStep5:  We no longer search for additional quasiroots, as analysis \
suggests there are few if any cases that appear clearly significant but aren\
\[CloseCurlyQuote]t because they have a quasiroot that falls in the \
insignificant zone.  "
}], "Text",
 CellChangeTimes->{{3.891174355305242*^9, 3.891174515343992*^9}, {
