   3.869333514558819*^9, 3.869333515532992*^9}, {3.871919891580082*^9, 
   3.871919930288948*^9}, {3.871920101897107*^9, 3.871920130567111*^9}, 
   3.871920635552514*^9, {3.871922365239132*^9, 3.8719224465848417`*^9}, 
   3.871922704889036*^9, {3.8719228942946577`*^9, 3.8719229066169043`*^9}, {
