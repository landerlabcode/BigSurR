 CellLabel->"In[50]:=",ExpressionUUID->"a29b80a1-ee92-4287-989a-2f41f1891728"],

Cell["\<\
This revision speeds things up considerably, and it doesn\[CloseCurlyQuote]t \
need to call a separate InverseSqrtFanoMoments.  It has two forms, the one \
with fewer arguments takes a constant c\
\>", "Text",
 CellChangeTimes->{{3.967369171854341*^9, 3.9673692242628937`*^9}, {
  3.967904067477429*^9, 
  3.967904080228486*^9}},ExpressionUUID->"3c8ac21a-5df5-4c3b-9b8b-\
7c5e66db5e56"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"InverseSqrtMomentListsAltNew", "[", 
     RowBox[{
     "genetotals_", ",", "depthlist_", ",", " ", "c_", ",", " ", "n_"}], 
     "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "iter", ",", "cellmeans", ",", " ", "simMat", ",", " ", "invFanoMat", 
        ",", 
        RowBox[{"a", " ", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"2", ",", 
           RowBox[{"Min", "[", "genetotals", "]"}]}], "]"}]}], ",", 
        RowBox[{"e", "=", 
         RowBox[{"n", "/", "50"}]}], ",", " ", 
        RowBox[{"h", "=", " ", 
         RowBox[{"Max", "[", "genetotals", "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"glist", "=", 
          RowBox[{"{", 
           RowBox[{"a", ",", 
            RowBox[{"a", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"e", "/", "a"}], ")"}], 
              RowBox[{"1", "/", "4"}]]}], ",", 
            RowBox[{"a", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"e", "/", "a"}], ")"}], 
              RowBox[{"1", "/", "2"}]]}], ",", 
            RowBox[{"a", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"e", "/", "a"}], ")"}], 
              RowBox[{"3", "/", "4"}]]}], ",", "e", ",", " ", 
            RowBox[{"e", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"h", "/", "e"}], ")"}], 
              RowBox[{"1", "/", "3"}]]}], ",", 
            RowBox[{"e", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"h", "/", "e"}], ")"}], 
              RowBox[{"2", "/", "3"}]]}], ",", "h"}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"iter", "=", 
             RowBox[{"Round", "[", 
              FractionBox["40000000.", 
               RowBox[{"n", 
                RowBox[{"(", " ", 
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"Log10", "[", 
                    RowBox[{"glist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], 
                   RowBox[{"1", "/", "5"}]], "+", 
                  RowBox[{"0.5", " ", 
                   SuperscriptBox[
                    RowBox[{"Log10", "[", 
                    RowBox[{"glist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "3"]}]}], ")"}]}]],
               "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"cellmeans", "=", 
             RowBox[{
              RowBox[{"glist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "*", "depthlist"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"simMat", "=", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"RandomVariate", "[", 
                 RowBox[{"PoissonDistribution", "[", "#", "]"}], "]"}], "&"}],
                ",", 
               RowBox[{"Transpose", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{
                    RowBox[{"LogNormalDistribution", "[", 
                    RowBox[{
                    RowBox[{"Log", "[", 
                    FractionBox["#", 
                    SqrtBox[
                    RowBox[{"1", "+", 
                    SuperscriptBox["c", "2"]}]]], "]"}], ",", " ", 
                    SqrtBox[
                    RowBox[{"Log", "[", 
                    RowBox[{"1", "+", 
                    SuperscriptBox["c", "2"]}], "]"}]]}], "]"}], ",", 
                    "iter"}], "]"}], "&"}], "/@", "cellmeans"}], "]"}], " ", 
               ",", 
               RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"invFanoMat", " ", "=", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  FractionBox["1", 
                   RowBox[{"n", "-", "1"}]], 
                  RowBox[{"Total", "[", " ", 
                   FractionBox[
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"#", "-", "cellmeans"}], ")"}], "2"], 
                    RowBox[{"cellmeans", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    SuperscriptBox["c", "2"], " ", "cellmeans"}]}], ")"}]}]], 
                   "]"}]}], "&"}], "/@", "simMat"}], ")"}], 
              RowBox[{
               RowBox[{"-", "1"}], "/", "2"}]]}], ";", "\[IndentingNewLine]", 
            
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{"glist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"Moment", "[", 
                   RowBox[{"#", ",", "2"}], "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"glist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"Moment", "[", 
                   RowBox[{"#", ",", "3"}], "]"}]}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"glist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"Moment", "[", 
                   RowBox[{"#", ",", "4"}], "]"}]}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"glist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"Moment", "[", 
                   RowBox[{"#", ",", "5"}], "]"}]}], "}"}]}], "}"}], "&"}], 
             "@", "invFanoMat"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "8"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
     " ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InverseSqrtMomentListsAltNew", "[", 
   RowBox[{
   "genetotals_", ",", "depthlist_", ",", " ", "\[Eta]_", ",", "\[Theta]_", 
    ",", " ", "n_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "j", ",", " ", "iter", ",", "cellmeans", ",", " ", "simMat", ",", " ", 
      "invFanoMat", ",", 
      RowBox[{"a", " ", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"2", ",", 
         RowBox[{"Min", "[", "genetotals", "]"}]}], "]"}]}], ",", 
      RowBox[{"e", "=", 
       RowBox[{"n", "/", "50"}]}], ",", " ", 
      RowBox[{"h", "=", " ", 
       RowBox[{"Max", "[", "genetotals", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"glist", "=", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"1", "/", "4"}]]}], ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"1", "/", "2"}]]}], ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"3", "/", "4"}]]}], ",", "e", ",", " ", 
          RowBox[{"e", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"h", "/", "e"}], ")"}], 
            RowBox[{"1", "/", "3"}]]}], ",", 
          RowBox[{"e", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"h", "/", "e"}], ")"}], 
            RowBox[{"2", "/", "3"}]]}], ",", "h"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"j", "=", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Eta]", " ", "n"}], 
              RowBox[{"glist", "[", 
               RowBox[{"[", "i", "]"}], "]"}]], "+", " ", "\[Theta]"}], 
            ")"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"iter", "=", 
           RowBox[{"Round", "[", 
            FractionBox["40000000.", 
             RowBox[{"n", 
              RowBox[{"(", " ", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"Log10", "[", 
                  RowBox[{"glist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], 
                 RowBox[{"1", "/", "5"}]], "+", 
                RowBox[{"0.5", " ", 
                 SuperscriptBox[
                  RowBox[{"Log10", "[", 
                   RowBox[{"glist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "3"]}]}], ")"}]}]],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"cellmeans", "=", 
           RowBox[{
            RowBox[{"glist", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "*", "depthlist"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"simMat", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"RandomVariate", "[", 
               RowBox[{"PoissonDistribution", "[", "#", "]"}], "]"}], "&"}], 
             ",", 
             RowBox[{"Transpose", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"RandomVariate", "[", 
                 RowBox[{
                  RowBox[{"LogNormalDistribution", "[", 
                   RowBox[{
                    RowBox[{"Log", "[", 
                    FractionBox["#", 
                    SqrtBox[
                    RowBox[{"1", "+", "j"}]]], "]"}], ",", " ", 
                    SqrtBox[
                    RowBox[{"Log", "[", 
                    RowBox[{"1", "+", "j"}], "]"}]]}], "]"}], ",", "iter"}], 
                 "]"}], "&"}], "/@", "cellmeans"}], "]"}], " ", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"invFanoMat", " ", "=", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                FractionBox["1", 
                 RowBox[{"n", "-", "1"}]], 
                RowBox[{"Total", "[", " ", 
                 FractionBox[
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"#", "-", "cellmeans"}], ")"}], "2"], 
                  RowBox[{"cellmeans", 
                   RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"j", " ", "cellmeans"}]}], ")"}]}]], "]"}]}], 
               "&"}], "/@", "simMat"}], ")"}], 
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}]]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{"glist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{"Moment", "[", 
                 RowBox[{"#", ",", "2"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"glist", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{"Moment", "[", 
