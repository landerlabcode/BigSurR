 CellLabel->"Out[66]=",ExpressionUUID->"cc612bec-e2a4-40d8-b471-247f9e71bc69"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FixedFirst", "[", "list_", "]"}], ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "list", "]"}], ">", "0"}], ",", " ", 
     RowBox[{"First", "[", "list", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FixedLast", "[", "list_", "]"}], ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "list", "]"}], ">", "0"}], ",", " ", 
     RowBox[{"Last", "[", "list", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8908472996262217`*^9, 3.890847335345818*^9}, {
