Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"TwoComponentCThetaOnly", "[", 
    RowBox[{"matpac_", ",", " ", "samplegoal_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mat", ",", "depthlist", ",", "n", ",", "genetotals", ",", " ", "bl", 
       ",", "genesample", ",", "newmat", ",", " ", "newgenetotals", ",", " ", 
       "newematrix", ",", " ", "fittedjvalues", ",", "data", ",", " ", 
       "params"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"depthlist", " ", "=", 
       FractionBox[
        RowBox[{"Total", "/@", 
         RowBox[{"N", "[", 
          RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
        RowBox[{"Total", "[", 
         RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"genetotals", "=", 
       RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bl", "=", 
       RowBox[{"BinLists", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "@", "genetotals"}], "->", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "genetotals", "]"}], "]"}]}], ",", " ", 
         "0.5"}], " ", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"genesample", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomSample", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], ",", " ", 
              RowBox[{"Ceiling", "[", 
               RowBox[{"samplegoal", "/", 
                RowBox[{"Length", "[", "bl", "]"}]}], "]"}]}], "]"}]}], "]"}],
           "&"}], "/@", "bl"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"newmat", "=", 
       RowBox[{"mat", "[", 
        RowBox[{"[", "genesample", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"newgenetotals", "=", 
       RowBox[{"genetotals", "[", 
        RowBox[{"[", "genesample", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"newematrix", "=", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"newgenetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fittedjvalues", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"j", "/.", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Total", "@", 
              RowBox[{"(", 
               FractionBox[
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   FractionBox[
                    RowBox[{"newmat", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                    RowBox[{"newematrix", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], "-", "1"}], ")"}], "2"], 
                
                RowBox[{"(", 
                 RowBox[{
                  FractionBox["1", 
                   RowBox[{"newematrix", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], "+", "j"}], " ", ")"}]], 
               ")"}]}], " ", "+", "1", "-", "n"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1"}], "}"}], ",", " ", 
            RowBox[{"Method", "->", " ", "\"\<Secant\>\""}]}], "]"}]}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "newmat", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             FractionBox["newgenetotals", "n"], ",", " ", 
             RowBox[{"1", "+", 
              RowBox[{"fittedjvalues", "*", 
               FractionBox["newgenetotals", "n"]}]}]}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"FindFit", "[", 
        RowBox[{
         RowBox[{"Log", "[", "data", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{"1", "+", " ", 
             RowBox[{"\[Theta]", "*", 
              SuperscriptBox["E", "x"]}]}], "]"}], ",", 
           RowBox[{"\[Theta]", ">", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", "0.1"}], "}"}], "}"}], ",", " ", "x", ",", 
         RowBox[{"NormFunction", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<HuberPenalty\>\"", ",", "0.01"}], "}"}]}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"ListLogLogPlot", "[", "data", "]"}], ",", 
         RowBox[{"LogLogPlot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", " ", 
              RowBox[{"\[Theta]", "*", "\[Mu]"}]}], ")"}], "/.", "params"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[Mu]", ",", " ", 
             RowBox[{"Min", "[", 
              RowBox[{"First", "/@", "data"}], "]"}], ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"First", "/@", "data"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"PlotRange", "->", " ", "All"}], ",", "  ", 
           RowBox[{"PlotStyle", "->", " ", "Red"}], ",", " ", 
           RowBox[{"Frame", "->", " ", "True"}], ",", " ", 
           RowBox[{"FrameLabel", "->", " ", 
            RowBox[{"{", 
             RowBox[{
             "\"\<mean expression (\[Mu])\>\"", ",", " ", 
              "\"\<1+\[Theta]\[Mu]\>\""}], "}"}]}]}], "]"}]}], "]"}], "]"}], 
      ";", "\[IndentingNewLine]", "params"}]}], "]"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.965029474711892*^9, 3.965029724114294*^9}, {
