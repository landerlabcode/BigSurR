Cell[TextData[{
 "But we know when x is large  ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    RowBox[{"Erfc", "[", "z", "]"}], "~", "  ", 
    SuperscriptBox["e", 
     RowBox[{"-", 
      SuperscriptBox["z", "2"]}]]}]}]],ExpressionUUID->
  "70fed1cf-d7be-412e-8fc8-4d99d7278a2c"],
 ", which enables us to approximate "
}], "Text",
 CellChangeTimes->{{3.891529156575451*^9, 3.891529162502592*^9}, {
  3.891529215456283*^9, 3.8915292225049677`*^9}, {3.891529651308838*^9, 
  3.891529657287539*^9}},ExpressionUUID->"4480e6b2-247c-4f04-8382-\
032b38c5db18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"f", " ", "==", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      SuperscriptBox["z", "2"]}]]}], ",", " ", "z"}], "]"}]], "Input",
