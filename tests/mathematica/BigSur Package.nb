                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"FindCommunities", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"\"\<Timeout\>\"", "->", " ", "1200"}]}], "]"}], 
                   "&"}], "/@", "subsetgno"}], ")"}]}], ",", "1"}], "]"}], 
             ",", "Length"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{
