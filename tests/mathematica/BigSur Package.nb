Cell[TextData[{
 "Here we are fitting the Pearson residuals differently.  We are treating the \
denominator of each Pearson residual as ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{" ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["x", "i"], "-", " ", "\[Mu]"}], ")"}], "2"], " "}], 
    SuperscriptBox["\[Sigma]", "2"]], TraditionalForm]],ExpressionUUID->
  "3781b3df-136a-49ba-8357-b86244d28c5d"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"=", 
     FractionBox[
      RowBox[{" ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", "i"], "-", " ", "\[Mu]"}], ")"}], "2"], " "}], 
      RowBox[{
       SuperscriptBox["c", "2"], 
       SuperscriptBox["\[Mu]", "2"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "4c2162a0-ed5e-4e94-be21-5806ba497ea4"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    FractionBox[
     RowBox[{" ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SubscriptBox["x", "i"], "\[Mu]"], "-", " ", "1"}], ")"}], "2"], 
      " "}], 
     SuperscriptBox["c", "2"]]}], TraditionalForm]],ExpressionUUID->
  "97fe1218-f2e2-48f5-a26c-0dbcf9df599f"],
 ", and finding the value of c that makes ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "8ba97ef0-fad3-4906-b9bb-50fa569ffda0"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sum]", 
    FractionBox[
     RowBox[{" ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SubscriptBox["x", "i"], "\[Mu]"], "-", " ", "1"}], ")"}], "2"], 
      " "}], 
     SuperscriptBox["c", "2"]]}], TraditionalForm]],ExpressionUUID->
  "9e6b0969-2572-4015-9029-f2d172d85f7a"],
 " equal to 1.   Since c can be factored out, we get an exact answer ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "2"], TraditionalForm]],ExpressionUUID->
  "4de2c1dc-1d23-45b4-99da-eec021842660"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "25196644-aaa2-4bf8-8ec1-bac7ae1b3995"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sum]", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SubscriptBox["x", "i"], "\[Mu]"], "-", " ", "1"}], ")"}], "2"], " "}],
    TraditionalForm]],ExpressionUUID->
  "1ff9d7e4-da41-46fb-a7e4-ba9364e1203a"],
 ".  This ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "2"], TraditionalForm]],ExpressionUUID->
  "14076e0e-aedc-4a21-a4ac-93d73dab0288"],
 " is just the fitted variance divided by the mean squared.  We use \
\[OpenCurlyDoubleQuote]j\[CloseCurlyDoubleQuote] to stand for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "2"], TraditionalForm]],ExpressionUUID->
  "25d6da21-0484-43f7-8205-c2dd0ca5659b"],
 ", for simplicity.  \nNext we are going to find values of \[Eta] and \
\[Theta] that fit the relationship  j = ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Eta]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "e96b7289-6159-4ea6-b9e2-e84c5b3c9e4d"],
 "+\[Theta].  Thus in the end, we will be fitting ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{" ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["x", "i"], "-", " ", "\[Mu]"}], ")"}], "2"], " "}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["\[Eta]", "\[Mu]"], "+", "\[Theta]"}], ")"}], 
     SuperscriptBox["\[Mu]", "2"]}]], TraditionalForm]],ExpressionUUID->
  "f09cb1da-7d92-49bc-afe5-2a72873fc28d"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{" ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["x", "i"], "-", " ", "\[Mu]"}], ")"}], "2"], " "}], 
    RowBox[{"\[Mu]", " ", 
     RowBox[{"(", 
      RowBox[{"\[Eta]", "+", 
       RowBox[{"\[Theta]", " ", "\[Mu]"}]}], ")"}]}]], TraditionalForm]],
  ExpressionUUID->"97be0358-501d-462d-bf4c-ebdc17895d4e"],
 ".  \nThe fit is done in unusual way.  \n\nNote this code returns for \[Eta] \
what, in previous code we would have called 1+\[Eta], so to use in in regular \
BigSur code we need to subtract 1 from \[Eta]"
}], "Text",
 CellChangeTimes->{{3.98432533240784*^9, 3.98432542674352*^9}, {
   3.984325465154313*^9, 3.9843255377380133`*^9}, {3.984325589112359*^9, 
   3.984325748137807*^9}, {3.98432578887232*^9, 3.984325805218214*^9}, {
   3.984325916151009*^9, 3.984326040774295*^9}, {3.984326082243984*^9, 
   3.984326083153345*^9}, {3.9843261468942127`*^9, 3.984326170846143*^9}, 
   3.984327103469137*^9, {3.9843289483585377`*^9, 3.984328973096509*^9}, {
   3.984329740798766*^9, 
   3.984329752133445*^9}},ExpressionUUID->"eeab1d51-2c29-4682-b890-\
51ef941ef012"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"IdealizedCFit", "[", 
     RowBox[{"matpac_", ",", " ", 
      RowBox[{"h_", ":", "0.5"}], ",", " ", 
      RowBox[{"maxIter_", ":", "50"}]}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mat", ",", "depthlist", ",", "n", ",", "genetotals", ",", 
        "genesample", ",", " ", "newematrix", ",", " ", "fittedjvalues", ",", 
        "data", ",", "thresh", ",", "means", ",", "fit", ",", "w", ",", 
        "residuals", ",", "exprs", ",", "cleanData", ",", "cleanpos", ",", 
        "\[Theta]p", ",", "\[Eta]p", ",", "\[Theta]n", ",", "\[Eta]n", ",", 
        "iter", ",", " ", "temp"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mat", "=", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"depthlist", " ", "=", 
        FractionBox[
         RowBox[{"Total", "/@", 
          RowBox[{"N", "[", 
           RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
         RowBox[{"Total", "[", 
          RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"genetotals", "=", 
        RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"means", " ", "=", " ", 
        RowBox[{"genetotals", "/", "n"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"newematrix", "=", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fittedjvalues", "=", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"n", "-", "1"}]], " ", 
         RowBox[{"Total", "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"mat", "-", "newematrix"}], ")"}], "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", "newematrix", ")"}], "^", "2"}], ")"}]}], 
           ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"means", ",", "fittedjvalues"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"temp", "=", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"ListLogLogPlot", "[", "data", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"w", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Length", "[", "means", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Eta]p", ",", "\[Theta]p"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"1.", ",", "0.1"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"iter", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"iter", "<", "maxIter"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"iter", " ", "=", " ", 
           RowBox[{"iter", "+", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"fit", " ", "=", " ", 
           RowBox[{"NonlinearModelFit", "[", 
            RowBox[{
             RowBox[{"Log", "[", "data", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{
                 FractionBox["\[Eta]", 
                  SuperscriptBox["E", "x"]], "+", " ", "\[Theta]"}], "]"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[Eta]", ">", "0"}], ",", " ", 
                 RowBox[{"\[Theta]", ">", "0"}]}], "}"}]}], "}"}], ",", "  ", 
             
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Eta]", ",", "1"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"\[Theta]", ",", "0.1"}], "}"}]}], "}"}], ",", " ", 
             "x", ",", 
             RowBox[{"Weights", "->", "w"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Eta]n", ",", " ", "\[Theta]n"}], "}"}], "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Eta]", ",", "\[Theta]"}], "}"}], "/.", 
            RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"\[Eta]n", "-", "\[Eta]p"}], "]"}], "<", 
              SuperscriptBox["10", 
               RowBox[{"-", "6"}]]}], "&&", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"\[Theta]n", "-", "\[Theta]p"}], "]"}], "<", 
              SuperscriptBox["10", 
               RowBox[{"-", "6"}]]}]}], ",", 
            RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Eta]p", ",", "\[Theta]p"}], "}"}], "=", 
           RowBox[{"{", 
            RowBox[{"\[Eta]n", ",", " ", "\[Theta]n"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"residuals", " ", "=", " ", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"fit", "[", "\"\<Function\>\"", "]"}], "[", "means", 
              "]"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"w", "=", 
           RowBox[{"PDF", "[", 
            RowBox[{
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"0", ",", "h"}], "]"}], ",", "residuals"}], "]"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"NotebookDelete", "[", "temp", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "@", 
        RowBox[{"Grid", "[", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Show", "[", 
             RowBox[{
              RowBox[{"ListLogLogPlot", "[", "data", "]"}], ",", 
              RowBox[{"LogLogPlot", "[", 
               RowBox[{
                RowBox[{"Evaluate", "[", 
                 RowBox[{"(", " ", 
                  RowBox[{
                   RowBox[{
                    FractionBox["\[Eta]", "\[Mu]"], "+", " ", "\[Theta]"}], "/.", 
                   RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
                  ")"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\[Mu]", ",", " ", 
                  RowBox[{"Min", "[", "means", "]"}], ",", " ", 
                  RowBox[{"Max", "[", "means", "]"}]}], "}"}], ",", 
                RowBox[{"PlotStyle", "->", " ", "Red"}]}], "]"}]}], "]"}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{"Show", "[", 
             RowBox[{
              RowBox[{"ListLogLogPlot", "[", 
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"means", ",", 
                  RowBox[{"fittedjvalues", "*", "means"}]}], " ", "}"}], 
                "]"}], "]"}], ",", 
              RowBox[{"LogLogPlot", "[", 
               RowBox[{
                RowBox[{"Evaluate", "[", 
                 RowBox[{"(", " ", 
                  RowBox[{
                   RowBox[{"\[Eta]", "+", " ", 
                    RowBox[{"\[Theta]", " ", "\[Mu]"}]}], "/.", 
                   RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
                  ")"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\[Mu]", ",", " ", 
                  RowBox[{"Min", "[", "means", "]"}], ",", " ", 
                  RowBox[{"Max", "[", "means", "]"}]}], "}"}], ",", 
                RowBox[{"PlotStyle", "->", " ", "Red"}]}], "]"}]}], "]"}]}], 
           "}"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"iter", " ", "==", "maxIter"}], ",", " ", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Did not converge after \>\"", "<>", 
           RowBox[{"ToString", "[", "maxIter", "]"}], "<>", 
           "\"\< iterations\>\""}], "]"}], ",", " ", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Converged after \>\"", "<>", 
           RowBox[{"ToString", "[", "iter", "]"}], "<>", 
           "\"\< iterations\>\""}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], "]"}]}], 
   ";"}], "*)"}]], "Input",
