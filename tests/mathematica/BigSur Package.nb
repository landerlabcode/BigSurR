        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"logpmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"IntegerPart", "[", 
            RowBox[{"MatrixIndexCF", "/@", 
             RowBox[{"Flatten", "[", 
              RowBox[{"xlist", "[", "\"\<ExplicitPositions\>\"", "]"}], 
              "]"}]}], "]"}], "->", " ", 
           RowBox[{"FixedPValFunc", "/@", 
            RowBox[{"xlist", "[", "\"\<ExplicitValues\>\"", "]"}]}]}], "]"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "m"}], "}"}], ",", " ", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_logpvalues.mx\>\""}], ",", 
