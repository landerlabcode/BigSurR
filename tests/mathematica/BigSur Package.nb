         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "genetotals", "]"}], "]"}]}], ",", " ", 
        "0.5"}], " ", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"genesample", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RandomSample", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"Length", "[", "#", "]"}], ",", " ", 
             RowBox[{"Ceiling", "[", 
              RowBox[{"samplegoal", "/", 
               RowBox[{"Length", "[", "bl", "]"}]}], "]"}]}], "]"}]}], "]"}], 
         "&"}], "/@", "bl"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newmat", "=", 
      RowBox[{"mat", "[", 
       RowBox[{"[", "genesample", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"newgenetotals", "=", 
      RowBox[{"genetotals", "[", 
       RowBox[{"[", "genesample", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"newematrix", "=", " ", 
