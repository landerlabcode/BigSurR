Cell[CellGroupData[{

Cell[TextData[StyleBox["CutDown",
 FontWeight->"Plain"]], "Subsubsection",
 CellChangeTimes->{{3.8322608202056723`*^9, 3.832260823043462*^9}},
 FontWeight->"Bold",ExpressionUUID->"7fa615f6-26d7-4c0d-8708-b152628ce6ad"],

Cell["\<\
This step eliminates rows where an insufficient number of cells (set by \
cellNumThresh) exceeds a value threshold (valThresh).  Default Value \
Threshold is zero, and Default Cell Number is 5.  So rows are cut out that \
have 5 or fewer non-zero entries.
It takes a matpac as its argument and returns a matpac.  
The code calls BoolEval, which is a loaded package that evaluates whether \
entries in arrays meet a criterion much more quickly than Mathematica \
normally does, by immediately reducing the problem to integer algebra.  
This was modified on 3/23/26 to add one more piece of information to the \
Metadata, namely the positions that were removed.  This information can be \
used later to restore matrices to their original dimensions.  \
\>", "Text",
 CellChangeTimes->{{3.832261109527128*^9, 3.832261203481318*^9}, {
  3.83227266066787*^9, 3.832272703742804*^9}, {3.83227412336261*^9, 
  3.832274136737713*^9}, {3.832330958719245*^9, 3.832330959112811*^9}, {
  3.983307562763932*^9, 
  3.983307616455349*^9}},ExpressionUUID->"5abeaeba-eb9e-4e86-a24b-\
37c1b1d9a20c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CutDown", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<ValueThresh\>\"", "\[Rule]", " ", "0"}], ",", " ", 
     RowBox[{"\"\<CellNumber\>\"", "\[Rule]", " ", "5"}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"CutDown", "[", 
    RowBox[{"matpac_", ",", " ", 
     RowBox[{"opt", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"posns", " ", "=", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"Total", "/@", 
           RowBox[{"BoolEval", "[", 
            RowBox[{
             RowBox[{"matpac", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">", 
             RowBox[{"OptionValue", "[", "\"\<ValueThresh\>\"", "]"}]}], 
            "]"}]}], ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", ">", 
            RowBox[{"OptionValue", "[", "\"\<CellNumber\>\"", "]"}]}]}]}], 
         "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"matpac", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "posns"}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"GetGeneNames", "[", "matpac", "]"}], "[", 
        RowBox[{"[", "posns", "]"}], "]"}], ",", 
       RowBox[{"GetCellNames", "[", "matpac", "]"}], ",", " ", 
       RowBox[{"\"\<Metadata\>\"", "\[Rule]", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<Metadata\>\"", "/.", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<CutDown_ValueThreshold\>\"", "\[Rule]", " ", 
             RowBox[{"OptionValue", "[", "\"\<ValueThresh\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<CutDown_CellNumber\>\"", "\[Rule]", " ", 
             RowBox[{"OptionValue", "[", "\"\<CellNumber\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<Removed\>\"", "->", " ", 
             RowBox[{"Complement", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"Length", "[", 
                 RowBox[{"matpac", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
               "posns"}], "]"}]}]}], "}"}]}], "]"}]}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQfeCLjEJp7xtHN5c/miB6RU2EAYjWPxRrA6LVlnl4
gOjPKcpeIPqk9eVYEP3mQFgKiK5tnbqvCkjb1s89AKLvCe88CqIPCe8+CaJ3
