Cell[BoxData[
 RowBox[{
  RowBox[{"NewFindXAlt", "[", 
   RowBox[{
   "augmentedParameters_", ",", "cutoff_", ",", " ", "genetotals_", ",", " ", 
    "alpha_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
     "passedTest", ",", "passedTest2", ",", "lowposns", ",", "posns1low", ",",
       " ", "posns1high", ",", "posns2", ",", "  ", "trueroots", ",", " ", 
      "rootsComplete", ",", "logpcriterion", ",", " ", "checkposns", ",", 
      "additionalQuasirootsPosns", ",", " ", "rootsFinal"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "step", " ", "1", " ", "generates", " ", "the", " ", "positions", " ", 
      "where", " ", "a", " ", "quick", " ", "test", " ", "is", " ", 
      "passed"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"passedTest", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QuickTest6CFAlt", "[", 
              RowBox[{
              "#1", ",", " ", "#2", ",", " ", "#3", ",", " ", "#4", ",", " ", 
               "#5", ",", " ", "cutoff"}], "]"}], "&"}], "@@", "#"}], "&"}], "/@",
           "augmentedParameters"}], "]"}], "[", "\"\<ExplicitPositions\>\"", 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<First quick test complete.  Surviving parameter sets = \>\"", ",", 
       " ", 
       RowBox[{"Length", "[", "passedTest", "]"}], ",", " ", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"step", " ", "2"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"lowposns", "=", 
      RowBox[{"ListIndex", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"LowerTriangularize", "[", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"SparseArray", "[", 
               RowBox[{"BoolEval", "[", 
                RowBox[{"genetotals", "<", "84"}], "]"}], "]"}], ",", " ", 
              RowBox[{"SparseArray", "[", 
               RowBox[{"BoolEval", "[", 
                RowBox[{"genetotals", "<", "84"}], "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
         "\"\<ExplicitPositions\>\"", "]"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"posns1low", " ", "=", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{"passedTest", ",", " ", "lowposns"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"posns1high", " ", "=", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{"passedTest", ",", " ", "lowposns"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"passedTest2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"SecondTestCF", "[", 
           RowBox[{
           "#1", ",", " ", "#2", ",", " ", "#3", ",", " ", "#4", ",", " ", 
            "#5", ",", " ", "cutoff"}], "]"}], "&"}], "@@", "#"}], "&"}], "/@", 
       RowBox[{"augmentedParameters", "[", 
        RowBox[{"[", "posns1low", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "step3", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"posns2", "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"passedTest2", "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"posns1low", "[", 
           RowBox[{"[", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"SparseArray", "[", "passedTest2", "]"}], "[", 
              "\"\<ExplicitPositions\>\"", "]"}], "]"}], "]"}], "]"}]}], 
         "]"}], ",", " ", "posns1high"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Second quick test complete.  Surviving parameter sets = \>\"", ",", 
       RowBox[{"Length", "[", "posns2", "]"}], ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"step", " ", "4"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"trueroots", " ", "=", "  ", 
      RowBox[{"Foundroots", "/@", 
       RowBox[{"augmentedParameters", "[", 
        RowBox[{"[", "posns2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<True roots found\>\"", ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rootsComplete", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"trueroots", ",", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"trueroots", ",", " ", "z"}], "]"}], "]"}], "->", " ", 
          RowBox[{"FindZ", "/@", 
           RowBox[{
            RowBox[{"augmentedParameters", "[", 
             RowBox[{"[", "posns2", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Position", "[", 
               RowBox[{"trueroots", ",", " ", "z"}], "]"}], "]"}], "]"}], 
            "]"}]}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"step", " ", "5"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"logpcriterion", "=", 
      RowBox[{"-", 
       RowBox[{"Log10", "@", 
        RowBox[{"BHNew", "[", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"FixedPValFunc", "/@", "rootsComplete"}], ")"}]}]}], ",",
           "alpha", ",", 
          RowBox[{"Binomial", "[", 
           RowBox[{
            RowBox[{"Length", "[", "genetotals", "]"}], ",", "2"}], "]"}]}], 
         " ", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<p criterion = \>\"", ",", 
       RowBox[{"ScientificForm", "[", 
        RowBox[{"10", "^", 
         RowBox[{"-", "logpcriterion"}]}], "]"}], ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"checkposns", "=", "\[IndentingNewLine]", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"FixedPValFunc", "/@", "rootsComplete"}], ",", " ", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", ">", " ", "logpcriterion"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"additionalQuasirootsPosns", "=", 
      RowBox[{"posns2", "[", 
       RowBox[{"[", 
        RowBox[{"checkposns", "[", 
         RowBox[{"[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"FixedPValFunc", "/@", 
              RowBox[{"(", 
               RowBox[{"FindZ", "/@", 
                RowBox[{"augmentedParameters", "[", 
                 RowBox[{"[", 
                  RowBox[{"posns2", "[", 
                   RowBox[{"[", "checkposns", "]"}], "]"}], "]"}], "]"}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "<", "logpcriterion"}]}]}], "]"}], "]"}], "]"}], 
         "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rootsFinal", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"rootsComplete", ",", 
        RowBox[{"additionalQuasirootsPosns", "->", " ", "0"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"posns2", "->", " ", "rootsFinal"}], "]"}], ",", " ", 
       RowBox[{"Length", "[", "augmentedParameters", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.893727055947524*^9, 3.893727060841234*^9}, {
  3.895691355041161*^9, 3.8956913583569202`*^9}, {3.967159093986676*^9, 
