Cell[TextData[{
 "To obtain a -Log10(p)-value from Cornish Fisher Polynomials, we solve for \
the root of the polynomial, and then feed the result into either ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"Erfc", "[", " ", 
      RowBox[{"-", 
       FractionBox["x", 
        SqrtBox["2"]]}], "]"}]}], "]"}]}]],
  CellChangeTimes->{{3.8700475469112167`*^9, 3.870047568712522*^9}, {
    3.8700476030026817`*^9, 3.870047708991929*^9}, {3.870047741012683*^9, 
    3.870047745102447*^9}, {3.8700485781233788`*^9, 3.8700486142781553`*^9}, 
    3.870048847563229*^9, {3.8700489433520308`*^9, 3.8700489435385942`*^9}, {
    3.870049412772532*^9, 3.870049413086034*^9}, {3.870050990613215*^9, 
    3.870050996012876*^9}, {3.8700511078109207`*^9, 3.8700511079492702`*^9}, {
    3.870249892781365*^9, 3.870249933063057*^9}, {3.8702502089155893`*^9, 
    3.87025032233055*^9}, 3.870250365083935*^9, {3.870250444277918*^9, 
    3.8702504500792093`*^9}, {3.870250545804749*^9, 3.870250561481617*^9}, {
    3.8702519091306257`*^9, 3.870251958936447*^9}, {3.870252260555236*^9, 
    3.870252265493534*^9}, {3.870252863132614*^9, 3.8702528951252527`*^9}, {
    3.870253366996611*^9, 3.870253422532565*^9}},ExpressionUUID->
  "1837a253-ed2b-4da4-9d8d-f0a2b8e77c8f"],
 " or ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"-", 
    RowBox[{"Log10", "[", 
     RowBox[{"1", "-", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"Erfc", "[", " ", 
        RowBox[{"-", 
         FractionBox["x", 
          SqrtBox["2"]]}], "]"}]}]}], "]"}], " "}],
   Background->None]],
  CellChangeTimes->{{3.8700475469112167`*^9, 3.870047568712522*^9}, {
    3.8700476030026817`*^9, 3.870047708991929*^9}, {3.870047741012683*^9, 
    3.870047745102447*^9}, {3.8700485781233788`*^9, 3.8700486142781553`*^9}, 
    3.870048847563229*^9, {3.8700489433520308`*^9, 3.8700489435385942`*^9}, {
    3.870049412772532*^9, 3.870049413086034*^9}, {3.870050990613215*^9, 
    3.870050996012876*^9}, {3.8700511078109207`*^9, 3.8700511079492702`*^9}, {
    3.870249892781365*^9, 3.870249933063057*^9}, {3.8702502089155893`*^9, 
    3.87025032233055*^9}, 3.870250365083935*^9, {3.870250444277918*^9, 
    3.8702504500792093`*^9}, {3.870250545804749*^9, 3.870250561481617*^9}, {
    3.8702519091306257`*^9, 3.870251958936447*^9}, {3.870252260555236*^9, 
    3.870252265493534*^9}, {3.870252863132614*^9, 3.8702528951252527`*^9}, {
    3.870253366996611*^9, 3.870253422532565*^9}},ExpressionUUID->
  "a2d5c7fa-fa4e-4f63-bd51-7ff60c21d857"],
 "depending on whether cc is negative, or positive, respectively.  \n\nNote \
that we can rewrite ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"Erfc", "[", " ", 
      RowBox[{"-", 
       FractionBox["x", 
        SqrtBox["2"]]}], "]"}]}], "]"}]}]],
  CellChangeTimes->{{3.8700475469112167`*^9, 3.870047568712522*^9}, {
    3.8700476030026817`*^9, 3.870047708991929*^9}, {3.870047741012683*^9, 
    3.870047745102447*^9}, {3.8700485781233788`*^9, 3.8700486142781553`*^9}, 
    3.870048847563229*^9, {3.8700489433520308`*^9, 3.8700489435385942`*^9}, {
    3.870049412772532*^9, 3.870049413086034*^9}, {3.870050990613215*^9, 
    3.870050996012876*^9}, {3.8700511078109207`*^9, 3.8700511079492702`*^9}, {
    3.870249892781365*^9, 3.870249933063057*^9}, {3.8702502089155893`*^9, 
    3.87025032233055*^9}, 3.870250365083935*^9, {3.870250444277918*^9, 
    3.8702504500792093`*^9}, {3.870250545804749*^9, 3.870250561481617*^9}, {
    3.8702519091306257`*^9, 3.870251958936447*^9}, {3.870252260555236*^9, 
    3.870252265493534*^9}, {3.870252863132614*^9, 3.8702528951252527`*^9}, {
    3.870253366996611*^9, 3.870253422532565*^9}},ExpressionUUID->
  "e5209a14-c1a5-4cab-b2fb-c5d539d8b948"],
 " as ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Erf", "[", 
        FractionBox["x", 
         SqrtBox["2"]], "]"}]}], ")"}]}], "]"}]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "6dbe6382-0d0a-4f0f-a61a-14cc7ae459be"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Erf", "[", 
        FractionBox[
         RowBox[{"-", "x"}], 
         SqrtBox["2"]], "]"}]}], ")"}]}]}]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "d8c2f10d-ee1b-4dbf-ba54-4ea1cbda449e"],
 ", respectively.  In fact if we are absolutely certain that all the roots of \
the polynomials corresponding to negative correlations are negative, we could \
even write a single function:  ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Erf", "[", 
        FractionBox[
         RowBox[{"Abs", "[", "x", "]"}], 
         SqrtBox["2"]], "]"}]}], ")"}]}], "]"}]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "8790b583-f148-46e1-8556-f7c403697c73"],
 ".  \nUnfortunately, Mathematica has trouble evaluating ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Erf", "[", 
    FractionBox["x", 
     SqrtBox["2"]], "]"}], TraditionalForm]],ExpressionUUID->
  "23572d28-5ad6-4c11-9502-1e5f420273ee"],
 " when x >8.3, giving zero instead of the necessary tiny number (at  x=8.3 \
the pvalue comes out to ",
 Cell[BoxData["1.1102230246251565`*^-16"],
  CellChangeTimes->{{3.8712984289127903`*^9, 3.871298462083086*^9}, 
    3.871298517386217*^9},ExpressionUUID->
  "4c1e5611-69a8-4174-949c-c71b9d9bd443"],
 ", so basically it sets all pvalue lower than that to 0, which is \
inconvenient as that makes our Log pvalues Indeterminate.  "
}], "Text",
 CellChangeTimes->{{3.871298200471325*^9, 3.871298412088491*^9}, 
   3.871298479876855*^9, {3.8712985281864643`*^9, 3.8712986421151943`*^9}, {
   3.871298675920639*^9, 3.871298727273505*^9}, 3.871299477659047*^9, {
   3.871299522315312*^9, 3.871299539376878*^9}, 3.871744006335431*^9, {
   3.8840017192810717`*^9, 
   3.884001719787032*^9}},ExpressionUUID->"00453bd6-d6e0-4c79-bfdc-\
2a4545e7626f"],

Cell[TextData[Cell[BoxData[
 RowBox[{"Fortunately", ",", 
  RowBox[{
   RowBox[{"as", "  ", "x"}], "\[Rule]", "\[Infinity]"}], ",", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"it", " ", "is", " ", "well", " ", "known", " ", "that"}], " ", "-", 
    RowBox[{"Log", "[", 
     RowBox[{"1", "-", 
      RowBox[{"Erf", "[", "z", "]"}]}], "]"}]}], "\[Rule]", " ", 
   SuperscriptBox["z", "2"]}], ",", " ", 
  RowBox[{
   RowBox[{"thus", "-", 
    RowBox[{"Log", "[", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Erf", "[", "z", "]"}]}], ")"}]}], "]"}]}], " ", "->", " ", 
   RowBox[{
    SuperscriptBox["z", "2"], "+", 
    RowBox[{"Log", "[", "2", "]"}]}]}], ",", " ", 
  RowBox[{"thus", " ", "-", 
   RowBox[{
    RowBox[{"Log10", "[", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Erf", "[", "z", "]"}]}], ")"}]}], "]"}], " ", "is", " ", 
    "just", "  ", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["z", "2"], "+", 
       RowBox[{"Log", "[", "2", "]"}]}], 
      RowBox[{"Log", "[", "10", "]"}]], ".", "  ", "Putting"}], " ", "in", " ", 
    FractionBox["x", 
     SqrtBox["2"]], " ", "for", " ", 
    SuperscriptBox["z", "2"], " ", "gives", " ", "us", " ", 
    FractionBox[
     RowBox[{
      FractionBox[
       SuperscriptBox["x", "2"], "2"], "+", 
      RowBox[{"Log", "[", "2", "]"}]}], 
     RowBox[{"Log", "[", "10", "]"}]]}]}]}]],
 CellChangeTimes->{{3.87005120083279*^9, 3.870051292939081*^9}, 
   3.8700513249813347`*^9, {3.870051724581292*^9, 3.870051772187804*^9}, {
   3.870051828569158*^9, 3.8700519140675087`*^9}, {3.8702500199267178`*^9, 
   3.870250053603877*^9}, {3.870276311163767*^9, 3.870276322733239*^9}, {
   3.871299264173748*^9, 3.871299408367174*^9}, {3.8712994417383223`*^9, 
   3.8712995128603477`*^9}},ExpressionUUID->"661176d1-88fa-43cb-b722-\
6009386d6a3e"]], "Text",
 CellChangeTimes->{{3.871299530389019*^9, 
  3.871299562202652*^9}},ExpressionUUID->"39a74cd3-235b-49cc-b065-\
2b9ce23779a9"],

Cell[TextData[{
 "The following functions fix that problem by replacing ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"Erf", "[", 
      FractionBox["x", 
       SqrtBox["2"]], "]"}]}], ")"}]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "3a69aa67-5756-40ee-b93c-d1b31576c392"],
 " with ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["e", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["x", "2"], "2"]}]]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "f702bbb9-e71d-4c4f-aeed-1e28e3c9ee5f"],
 ", which is an excellent approximation when x is large.  "
}], "Text",
 CellChangeTimes->{
  3.8712994856677227`*^9},ExpressionUUID->"1f433ca9-d3ad-43b6-bff2-\
227e50bfebdb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FixedPosPValFunc", "[", "x_", "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{
             FractionBox[
              SuperscriptBox["x", "2"], "2"], "+", 
             RowBox[{"Log", "[", "2", "]"}]}], 
            RowBox[{"Log", "[", "10", "]"}]]}], ",", "4"}], "]"}], ",", 
        RowBox[{"x", ">", "8.3"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Log10", "[", " ", 
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"Erf", "[", 
                FractionBox["x", 
                 SqrtBox["2"]], "]"}]}], ")"}]}], "]"}]}], ",", "4"}], "]"}], 
        ",", 
        RowBox[{"0", "<", "x", "<=", " ", "8.3"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "True"}], "}"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
   3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
   3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
   3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
   3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
   3.871298106364991*^9, {3.871298912400827*^9, 3.871298923467793*^9}, {
   3.871298956817916*^9, 3.871298958734498*^9}, {3.871299126828659*^9, 
   3.8712991299733477`*^9}, {3.871299586943132*^9, 3.871299613195212*^9}, {
   3.871299653485814*^9, 3.871299655768971*^9}, {3.871305490696916*^9, 
   3.871305512196278*^9}, {3.871866633445012*^9, 3.8718666373535023`*^9}, {
   3.884001684083181*^9, 3.884001684673579*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[23]:=",ExpressionUUID->"03eda70e-02d6-4766-aaaa-504a4999f62c"],

Cell["\<\
Actually, as we work with more of these equations, we realize that it will \
always be the case that roots of significant negative correlations are always \
negative, and roots of positive correlations always positive.  Thus, and \
compiling the function:\
\>", "Text",
 CellChangeTimes->{{3.87174400922841*^9, 
  3.871744066805294*^9}},ExpressionUUID->"6f57fcd9-4c00-4052-bfa1-\
ee6c05f1d5b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FixedPValFunc", "=", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "_Real"}], "}"}], "}"}], ",", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], ">", "8.3"}], ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{
           FractionBox[
            SuperscriptBox["x", "2"], "2"], "+", 
           RowBox[{"Log", "[", "2", "]"}]}], 
          RowBox[{"Log", "[", "10", "]"}]]}], ",", "4"}], "]"}], ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Log10", "[", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Erf", "[", 
              FractionBox[
               RowBox[{"Abs", "[", "x", "]"}], 
               SqrtBox["2"]], "]"}]}], ")"}]}], "]"}]}], ",", "4"}], "]"}]}], 
     "]"}], ",", " ", 
    RowBox[{"RuntimeAttributes", "->", 
     RowBox[{"{", "Listable", "}"}]}], ",", " ", 
    RowBox[{"Parallelization", "->", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8717440734933558`*^9, 3.871744148042828*^9}, {
  3.8717441856421213`*^9, 3.871744239719486*^9}, {3.871744270342936*^9, 
  3.871744379762495*^9}, {3.8718666162772818`*^9, 3.8718666188669643`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[24]:=",ExpressionUUID->"059c7544-fe29-4f8d-b1a2-ddf19323bf8a"],

