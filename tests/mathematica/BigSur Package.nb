   3.891268059187173*^9, {3.8913558539567003`*^9, 3.891355896651029*^9}, {
   3.891456046491762*^9, 3.8914560465911922`*^9}, {3.891456972956435*^9, 
   3.8914569913207073`*^9}, 3.891457604531654*^9, {3.891469573031376*^9, 
