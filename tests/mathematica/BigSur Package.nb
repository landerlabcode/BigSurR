Cell[BoxData[
 RowBox[{
  RowBox[{"InverseSqrtMomentLists", "[", 
   RowBox[{"genetotals_", ",", "depthlist_", ",", " ", "c_", ",", " ", "n_"}],
    "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", " ", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"2", ",", 
         RowBox[{"Min", "[", "genetotals", "]"}]}], "]"}]}], ",", 
      RowBox[{"e", "=", 
       RowBox[{"n", "/", "50"}]}], ",", " ", 
      RowBox[{"h", "=", " ", 
       RowBox[{"Max", "[", "genetotals", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"glist", "=", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"1", "/", "4"}]]}], ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"1", "/", "2"}]]}], ",", 
          RowBox[{"a", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"e", "/", "a"}], ")"}], 
            RowBox[{"3", "/", "4"}]]}], ",", "e", ",", " ", 
          RowBox[{"e", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"h", "/", "e"}], ")"}], 
            RowBox[{"1", "/", "3"}]]}], ",", 
          RowBox[{"e", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"h", "/", "e"}], ")"}], 
            RowBox[{"2", "/", "3"}]]}], ",", "h"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"simEmatrix", "=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"glist", ",", " ", "depthlist"}], "]"}]}], "}"}], ",", 
        RowBox[{
