Cell[BoxData[
 RowBox[{
  RowBox[{"NewFindX", "[", 
   RowBox[{
   "augmentedParameters_", ",", "cutoff_", ",", " ", "genetotals_", ",", " ", 
    "alpha_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
     "passedTest", ",", "passedTest2", ",", "lowposns", ",", "posns1low", ",",
       " ", "posns1high", ",", "posns2", ",", "  ", "trueroots", ",", " ", 
      "rootsComplete", ",", "logpcriterion", ",", " ", "checkposns", ",", 
      "additionalQuasirootsPosns", ",", " ", "rootsFinal"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"step", " ", "1"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"passedTest", "=", "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"table", "=", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "x", ",", 
               SuperscriptBox["x", "2"], ",", 
               SuperscriptBox["x", "3"], ",", " ", 
               SuperscriptBox["x", "4"], ",", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "k"}], ",", 
                 RowBox[{"-", " ", 
                  FractionBox[
                   RowBox[{"2", "k"}], "3"]}], ",", " ", 
                 RowBox[{"-", 
                  FractionBox["k", "3"]}], ",", " ", "0", ",", " ", 
                 FractionBox["k", "3"], ",", " ", 
                 FractionBox[
                  RowBox[{"2", "k"}], "3"], ",", "k"}], "}"}]}], "}"}]}], 
            "]"}], "/.", 
           RowBox[{"k", "->", " ", 
            RowBox[{
             SqrtBox["2"], " ", 
             RowBox[{"InverseErfc", "[", 
              RowBox[{"2.", " ", 
               SuperscriptBox["10", 
                RowBox[{"-", "cutoff"}]]}], "]"}]}]}]}]}], "}"}], ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"SparseArray", "[", 
           RowBox[{"BoolEval", "[", 
            RowBox[{
             RowBox[{"QuickTest6CFAltNew", "[", 
              RowBox[{"augmentedParameters", ",", " ", "table"}], "]"}], "==",
              "7"}], "]"}], "]"}], "[", "\"\<ExplicitPositions\>\"", "]"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"QuickTest6CF", "[", 
             RowBox[{
             "#1", ",", " ", "#2", ",", " ", "#3", ",", " ", "#4", ",", " ", 
              "#5", ",", " ", "cutoff"}], "]"}], "&"}], "@@", "#"}], "&"}], "/@",
          "augmentedParameters"}], "]"}], "[", "\"\<ExplicitPositions\>\"", 
       "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<First quick test complete.  Surviving parameter sets = \>\"", ",", 
       " ", 
       RowBox[{"Length", "[", "passedTest", "]"}], ",", " ", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"step", " ", "2"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"lowposns", "=", 
      RowBox[{"ListIndex", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"LowerTriangularize", "[", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"SparseArray", "[", 
               RowBox[{"BoolEval", "[", 
                RowBox[{"genetotals", "<", "84"}], "]"}], "]"}], ",", " ", 
              RowBox[{"SparseArray", "[", 
               RowBox[{"BoolEval", "[", 
                RowBox[{"genetotals", "<", "84"}], "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
         "\"\<ExplicitPositions\>\"", "]"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"posns1low", " ", "=", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{"passedTest", ",", " ", "lowposns"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"posns1high", " ", "=", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{"passedTest", ",", " ", "lowposns"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"passedTest2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"SecondTestCF", "[", 
           RowBox[{
           "#1", ",", " ", "#2", ",", " ", "#3", ",", " ", "#4", ",", " ", 
            "#5", ",", " ", "cutoff"}], "]"}], "&"}], "@@", "#"}], "&"}], "/@", 
       RowBox[{"augmentedParameters", "[", 
        RowBox[{"[", "posns1low", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "step3", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"posns2", "=", 
      RowBox[{"Union", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"passedTest2", "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"posns1low", "[", 
           RowBox[{"[", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"SparseArray", "[", "passedTest2", "]"}], "[", 
              "\"\<ExplicitPositions\>\"", "]"}], "]"}], "]"}], "]"}]}], 
         "]"}], ",", " ", "\[IndentingNewLine]", "posns1high"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Second quick test complete.  Surviving parameter sets = \>\"", ",", 
       RowBox[{"Length", "[", "posns2", "]"}], ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"step", " ", "4"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"trueroots", " ", "=", "  ", 
      RowBox[{"Foundroots", "/@", 
       RowBox[{"augmentedParameters", "[", 
        RowBox[{"[", "posns2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<True roots found\>\"", ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rootsComplete", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"trueroots", ",", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"trueroots", ",", " ", "z"}], "]"}], "]"}], "->", " ", 
          RowBox[{"FindZ", "/@", 
           RowBox[{
            RowBox[{"augmentedParameters", "[", 
             RowBox[{"[", "posns2", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Position", "[", 
               RowBox[{"trueroots", ",", " ", "z"}], "]"}], "]"}], "]"}], 
            "]"}]}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"step", " ", "5"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"logpcriterion", "=", 
      RowBox[{"-", 
       RowBox[{"Log10", "@", 
        RowBox[{"BHNew", "[", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"FixedPValFunc", "/@", "rootsComplete"}], ")"}]}]}], ",",
           "alpha", ",", 
          RowBox[{"Binomial", "[", 
           RowBox[{
            RowBox[{"Length", "[", "genetotals", "]"}], ",", "2"}], "]"}]}], 
         " ", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<p criterion = \>\"", ",", 
       RowBox[{"ScientificForm", "[", 
        RowBox[{"10", "^", 
         RowBox[{"-", "logpcriterion"}]}], "]"}], ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"checkposns", "=", "\[IndentingNewLine]", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"FixedPValFunc", "/@", "rootsComplete"}], ",", " ", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", ">", " ", "logpcriterion"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"additionalQuasirootsPosns", "=", 
      RowBox[{"posns2", "[", 
       RowBox[{"[", 
        RowBox[{"checkposns", "[", 
         RowBox[{"[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"FixedPValFunc", "/@", 
              RowBox[{"(", 
               RowBox[{"FindZ", "/@", 
                RowBox[{"augmentedParameters", "[", 
                 RowBox[{"[", 
                  RowBox[{"posns2", "[", 
                   RowBox[{"[", "checkposns", "]"}], "]"}], "]"}], "]"}]}], 
               ")"}]}], ",", " ", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "<", "logpcriterion"}]}]}], "]"}], "]"}], "]"}], 
         "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rootsFinal", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"rootsComplete", ",", 
        RowBox[{"additionalQuasirootsPosns", "->", " ", "0"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"posns2", "->", " ", "rootsFinal"}], "]"}], ",", " ", 
       RowBox[{"Length", "[", "augmentedParameters", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
