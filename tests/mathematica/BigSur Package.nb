                    SuperscriptBox["c", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"6", "+", "ematrix"}], ")"}]}], "+", 
                    RowBox[{
                    SuperscriptBox["c", "4"], " ", 
                    RowBox[{"(", 
                    RowBox[{"6", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"16", "+", 
                    RowBox[{"15", " ", 
                    SuperscriptBox["c", "2"]}], "+", 
                    RowBox[{"6", " ", 
                    SuperscriptBox["c", "4"]}], "+", 
                    SuperscriptBox["c", "6"]}], ")"}], " ", "ematrix"}]}], 
                    ")"}]}]}], ")"}]}]}], ")"}]}]}], ")"}]}]}], 
              RowBox[{"ematrix", " ", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   SuperscriptBox["c", "2"], " ", "ematrix"}]}], ")"}], 
                "2"]}]], ",", "n"}], "]"}]}]}], ")"}]}], ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"10", " "}], 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}], "3"], 
             SuperscriptBox["n", "2"], "\[ScriptCapitalJ]3"}]]}], " ", 
          RowBox[{"DotProductCF", "[", 
           RowBox[{
            FractionBox[
             RowBox[{"1", "+", 
              RowBox[{
               SuperscriptBox["c", "2"], " ", "ematrix", " ", 
               RowBox[{"(", 
                RowBox[{"3", "+", 
                 RowBox[{
                  SuperscriptBox["c", "2"], " ", 
                  RowBox[{"(", 
                   RowBox[{"3", "+", 
                    SuperscriptBox["c", "2"]}], ")"}], " ", "ematrix"}]}], 
                ")"}]}]}], 
