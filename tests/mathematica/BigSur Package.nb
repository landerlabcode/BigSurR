Cell["\<\
So the InverseErfc can be approximated, and now we can put this into Tanh\
\>", "Text",
 CellChangeTimes->{{3.8915299009659147`*^9, 3.891529902335997*^9}, {
  3.891529956055101*^9, 3.8915299697448187`*^9}, {3.891530170265895*^9, 
  3.891530175605047*^9}},ExpressionUUID->"1e78ba16-b6fc-4d03-b202-\
2884bce32c41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", "=", "4655"}], "}"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Tanh", "[", 
        FractionBox[
         RowBox[{
          SqrtBox["2"], " ", 
          RowBox[{"InverseErfc", "[", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "i"}]}], "]"}]}], 
         SqrtBox[
          RowBox[{
           RowBox[{"-", "3."}], "+", "n"}]]], "]"}], ",", 
       RowBox[{"Tanh", "[", 
        RowBox[{
         FractionBox[
          RowBox[{" ", 
           SqrtBox[
            RowBox[{"2", " ", 
             RowBox[{"Log", "[", " ", "10", "]"}]}]]}], 
          SqrtBox[
           RowBox[{
            RowBox[{"-", "3."}], "+", "n"}]]], 
         SqrtBox["i"]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", "800"}], "}"}], ",", " ", 
     RowBox[{"PlotLegends", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8915294805330677`*^9, 3.891529543208942*^9}, {
  3.891529575895143*^9, 3.891529587074527*^9}, {3.891530155577612*^9, 
