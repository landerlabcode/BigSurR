   3.881554128088975*^9}, {3.881555335383976*^9, 3.881555408172393*^9}, {
   3.883937841500136*^9, 3.8839379659938583`*^9}, 3.883938027046487*^9, {
   3.883938100565115*^9, 3.883938101024304*^9}, {3.883953776793572*^9, 
   3.8839537785566683`*^9}, 3.883954023574849*^9, {3.883954064699856*^9, 
   3.883954080398459*^9}, 3.883999970403126*^9, 3.884000005624308*^9, 
   3.884001106968151*^9, 3.884010005092977*^9, {3.884010058497488*^9, 
   3.884010127347176*^9}, {3.890065288023719*^9, 3.890065288825444*^9}, {
   3.890065337016765*^9, 3.890065441462584*^9}, {3.890065478459429*^9, 
   3.8900655370880203`*^9}, {3.890065570760741*^9, 3.890065591117587*^9}, {
   3.89006564456034*^9, 3.8900656592788982`*^9}, {3.890065739017153*^9, 
   3.8900657407806377`*^9}, {3.890065870262308*^9, 3.8900658720749083`*^9}, {
   3.8900659746123447`*^9, 3.890065996348762*^9}, {3.8900660271258287`*^9, 
   3.890066182694963*^9}, 3.8900682787273083`*^9, {3.890069695568976*^9, 
   3.890069697016452*^9}, {3.890089222303191*^9, 3.8900892302401114`*^9}, {
   3.8909160228803787`*^9, 3.8909160365137568`*^9}, {3.890921627985697*^9, 
   3.8909216927332706`*^9}, {3.890921943323616*^9, 3.890921962622365*^9}, {
   3.8909223338521223`*^9, 3.890922334640703*^9}, {3.891014411216383*^9, 
   3.8910145204751377`*^9}, {3.891014730471527*^9, 3.89101473160423*^9}, {
