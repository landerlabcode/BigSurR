          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{"logpmatrix", ">", 
             RowBox[{"-", 
              RowBox[{"Log10", "[", 
               RowBox[{"sigcutofflist", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "]"}], "*", 
