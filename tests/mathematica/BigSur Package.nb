Cell[BoxData[
 RowBox[{
  RowBox[{"InferredPCCs2", "[", 
   RowBox[{
   "logpvalmatrix_", ",", "pccSignmatrix_", ",", " ", "cutoff_", ",", " ", 
    "n_"}], "]"}], ":=", " ", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"logpvalmatrix", "*", 
          RowBox[{"BoolEval", "[", 
           RowBox[{"logpvalmatrix", ">", "cutoff"}], "]"}]}], ",", 
         RowBox[{"Dimensions", "[", "logpvalmatrix", "]"}]}], "]"}]}], ",", 
      " ", "sa", ",", "be", ",", " ", "mat2", ",", " ", "sa2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"pccSignmatrix", " ", "*", 
         RowBox[{"Tanh", "[", 
          FractionBox[
           RowBox[{
            SqrtBox["2"], " ", 
            RowBox[{"InverseErfc", "[", " ", 
             RowBox[{"10", "^", 
              RowBox[{"-", "mat"}]}], "]"}]}], 
           SqrtBox[
            RowBox[{
             RowBox[{"-", "3."}], "+", "n"}]]], "]"}]}], ",", " ", 
        RowBox[{"Dimensions", "[", "mat", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"be", "=", 
      RowBox[{"BoolEval", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "sa", "]"}], "==", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mat2", " ", "=", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"logpvalmatrix", "*", "be"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sa2", " ", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"pccSignmatrix", " ", "*", 
        RowBox[{"Tanh", "[", " ", 
         RowBox[{
          FractionBox[
           RowBox[{" ", 
            SqrtBox[
             RowBox[{"2", " ", 
              RowBox[{"Log", "[", " ", "10", "]"}]}]]}], 
           SqrtBox[
            RowBox[{
             RowBox[{"-", "3."}], "+", "n"}]]], 
          SqrtBox["mat2"]}], "]"}]}], "]"}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sa", "+", "sa2", "-", 
      RowBox[{"sa", "*", "be"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.868951469931706*^9, 3.868951543412952*^9}, {
