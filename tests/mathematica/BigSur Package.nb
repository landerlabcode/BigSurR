Cell[CellGroupData[{

Cell["CornishFisherPolynomialCoefficients 5CF", "Subsubsection",
 CellChangeTimes->{{3.8700475364394617`*^9, 3.870047541517067*^9}, {
  3.870252934927042*^9, 3.870252939566381*^9}, {3.8702804640395947`*^9, 
  3.870280465745631*^9}, {3.871907570108906*^9, 3.871907574359231*^9}, {
  3.883998681072283*^9, 
  3.883998682262457*^9}},ExpressionUUID->"35e6aa25-a8ea-4a80-bf71-\
2187ea257e09"],

Cell[TextData[{
 "Rather than try to generate the intact polynomials, this code just returns \
their coefficients as a list of matrices.  The matrices go in order from the \
coefficients of lowest to highest order, i.e. a+ bx ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"+", 
     SuperscriptBox["cx", "2"]}], "+", 
    SuperscriptBox["dx", "3"]}], TraditionalForm]],ExpressionUUID->
  "ce08b271-f964-45e0-85ef-5c8a45ae9a92"],
 ", etc.  \nNote, a small error in the code for 5CF was fixed on 10/30/2022"
}], "Text",
 CellChangeTimes->{{3.870280468020463*^9, 3.8702805890415*^9}, {
  3.876158851159306*^9, 
  3.876158879079381*^9}},ExpressionUUID->"0d1e8e17-d0d5-4e8c-9dcd-\
17bc20b2f334"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CornishFisherPolynomialCoefficients5CF", "=", "\[IndentingNewLine]", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Kappa]2", ",", " ", "_Real", ",", " ", "2"}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"\[Kappa]3", ",", " ", "_Real", ",", " ", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Kappa]4", ",", " ", "_Real", ",", " ", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Kappa]5", ",", " ", "_Real", ",", " ", "2"}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"cc", ",", " ", "_Real", ",", " ", "2"}], "}"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "cc"}], "-", 
       FractionBox["\[Kappa]3", 
        RowBox[{"6", " ", "\[Kappa]2"}]], "+", 
       FractionBox[
        RowBox[{"17", " ", 
         SuperscriptBox["\[Kappa]3", "3"]}], 
        RowBox[{"324", " ", 
         SuperscriptBox["\[Kappa]2", "4"]}]], "-", 
       FractionBox[
        RowBox[{"\[Kappa]3", " ", "\[Kappa]4"}], 
        RowBox[{"12", " ", 
         SuperscriptBox["\[Kappa]2", "3"]}]], "+", 
       FractionBox["\[Kappa]5", 
        RowBox[{"40", " ", 
         SuperscriptBox["\[Kappa]2", "2"]}]]}], ",", " ", 
      RowBox[{"(", 
       RowBox[{
        SqrtBox["\[Kappa]2"], "+", 
        FractionBox[
         RowBox[{"5", " ", 
          SuperscriptBox["\[Kappa]3", "2"]}], 
         RowBox[{"36", " ", 
          SuperscriptBox["\[Kappa]2", 
           RowBox[{"5", "/", "2"}]]}]], "-", 
        FractionBox["\[Kappa]4", 
         RowBox[{"8", " ", 
          SuperscriptBox["\[Kappa]2", 
           RowBox[{"3", "/", "2"}]]}]]}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["\[Kappa]3", 
         RowBox[{"6", " ", "\[Kappa]2"}]], "-", 
        FractionBox[
         RowBox[{"53", " ", 
          SuperscriptBox["\[Kappa]3", "3"]}], 
         RowBox[{"324", " ", 
          SuperscriptBox["\[Kappa]2", "4"]}]], "+", 
        FractionBox[
         RowBox[{"5", " ", "\[Kappa]3", " ", "\[Kappa]4"}], 
         RowBox[{"24", " ", 
          SuperscriptBox["\[Kappa]2", "3"]}]], "-", 
        FractionBox["\[Kappa]5", 
         RowBox[{"20", " ", 
          SuperscriptBox["\[Kappa]2", "2"]}]]}], ")"}], ",", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["\[Kappa]3", "2"], 
          RowBox[{"18", " ", 
           SuperscriptBox["\[Kappa]2", 
            RowBox[{"5", "/", "2"}]]}]]}], "+", 
        FractionBox["\[Kappa]4", 
         RowBox[{"24", " ", 
          SuperscriptBox["\[Kappa]2", 
           RowBox[{"3", "/", "2"}]]}]]}], ")"}], ",", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox["\[Kappa]3", "3"], 
         RowBox[{"27", " ", 
          SuperscriptBox["\[Kappa]2", "4"]}]], "-", 
        FractionBox[
         RowBox[{"\[Kappa]3", " ", "\[Kappa]4"}], 
         RowBox[{"24", " ", 
          SuperscriptBox["\[Kappa]2", "3"]}]], "+", 
        FractionBox["\[Kappa]5", 
         RowBox[{"120", " ", 
          SuperscriptBox["\[Kappa]2", "2"]}]]}], ")"}]}], "}"}], ",", " ", 
    RowBox[{"RuntimeAttributes", "\[Rule]", 
     RowBox[{"{", "Listable", "}"}]}], ",", " ", 
    RowBox[{"Parallelization", "\[Rule]", "True"}]}], "]"}]}]], "Input",
