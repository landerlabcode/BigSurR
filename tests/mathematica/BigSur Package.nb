   3.881461466871915*^9, {3.881553166148711*^9, 3.881553170747603*^9}, {
   3.881554044407885*^9, 3.881554051516906*^9}, {3.881554118901516*^9, 
   3.881554128088975*^9}, {3.881555335383976*^9, 3.881555408172393*^9}, {
   3.883937841500136*^9, 3.8839379659938583`*^9}, 3.883938027046487*^9, {
   3.883938100565115*^9, 3.883938101024304*^9}, {3.883953776793572*^9, 
   3.8839537785566683`*^9}, 3.883954023574849*^9, {3.883954064699856*^9, 
   3.883954080398459*^9}, 3.883999970403126*^9, 3.884000005624308*^9, 
   3.884001106968151*^9, 3.884010005092977*^9, {3.884010058497488*^9, 
   3.884010127347176*^9}, {3.890069673154447*^9, 3.890069675523652*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[94]:=",ExpressionUUID->"c200b400-fe9e-4701-a270-cc3c2c46aa40"]
}, Closed]],

Cell[CellGroupData[{

Cell["BigSurAlt3", "Subsubsection",
 CellChangeTimes->{{3.890065212137455*^9, 
  3.890065229611292*^9}},ExpressionUUID->"51f8bb2f-fe44-444d-b853-\
674ca1382b5a"],

Cell["\<\
Here we use the proper matrix corrections for the square roots of the Fano \
factors.  
We  add in an option, \[OpenCurlyDoubleQuote]Fano Inverse Sqrt Correction\
\[CloseCurlyDoubleQuote], however, to block the generation of these when we \
set it to False, in case we want to see whether the results come out the \
same.  \
\>", "Text",
 CellChangeTimes->{{3.890065232458729*^9, 3.890065250334845*^9}, {
  3.890065835904763*^9, 3.890065859641531*^9}, {3.8900662296333227`*^9, 
  3.89006624973251*^9}},ExpressionUUID->"e74889f8-c947-4885-ad7a-\
fefad877dadb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "BigSurAlt3", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Correlations\>\"", "->", " ", "False"}], ",", " ", 
      RowBox[{"\"\<alpha\>\"", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"\"\<Pvalue\>\"", "->", " ", "\"\<BH\>\""}], ",", 
      RowBox[{"\"\<First Pass Cutoff\>\"", "->", " ", "2"}], ",", 
      RowBox[{"\"\<Fano Inverse Sqrt Correction\>\"", "->", " ", "True"}], 
      ",", 
      RowBox[{"\"\<CFThreshold\>\"", "->", "0.026"}], ",", " ", 
      RowBox[{"\"\<SigBinWidth\>\"", "->", " ", "0.05"}], ",", 
      RowBox[{"\"\<Interrupt\>\"", "->", " ", "True"}]}], " ", "}"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BigSurAlt3", "[", 
    RowBox[{
    "matpac_", ",", " ", "c_", ",", " ", "filemarker_", ",", "depthscaling_", 
     ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "foldername", ",", "n", ",", "m", ",", "z", ",", "negccthreshold", ",", 
       " ", "mat", ",", " ", "depthlist", ",", " ", "genetotals", ",", " ", 
       "ematrix", ",", " ", "pmatrix", ",", " ", "mflist", ",", 
       "invsqrtmoments", ",", "fanocorrectionmatrices", ",", " ", "pccmatrix",
        ",", "\[Kappa]lists", ",", "ccmats", ",", "polylist", ",", " ", 
       "polymatrix", ",", "equationslist", ",", "logplist", ",", 
       "pccSignmatrix", ",", "augmentedParameters", ",", "xlist", ",", 
       "logpmatrix", ",", "equivalentPCCs", ",", " ", "rows", ",", 
       "randomematrix", ",", "randommat", ",", "randompmatrix", ",", " ", 
       "randommflist", ",", "randomfanocorrectionmatrices", ",", 
       "randompolymatrix", ",", "randompccmatrix", ",", "randomccmats", ",", 
       "randompccSignmatrix", ",", "randomaugmentedParameters", ",", 
       "randomxlist", ",", "randomlogpmatrix", ",", "cutoff", ",", " ", 
       "bhcutoff", ",", " ", "bonferroni", ",", "sigcutofflevel", ",", 
       "sigcutofflist", ",", "truesigdata", ",", "randomsigdata", ",", 
       "significantPCCmatrix", ",", "gno", ",", " ", "subsetgno", ",", 
       "communities"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"genetotals", " ", "=", " ", 
       RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], ",",
         " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Tally", "[", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{"y", ">", "1"}]}]}], "]"}], ">", "0"}], ",", " ", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Matpac contains duplicated genes\>\"", "]"}], ";",
          " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"c", "<=", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<c must be greater than zero\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Started on\>\"", ",", 
        RowBox[{"CurrentDate", "[", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"foldername", "=", 
       RowBox[{"filemarker", "<>", 
        RowBox[{"DateString", "[", "]"}], "<>", "\"\< c=\>\"", "<>", 
        RowBox[{"ToString", "[", "c", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"CreateDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", "foldername", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Folder name is\>\"", "]"}], ";", 
      RowBox[{"Print", "[", "foldername", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"depthlist", " ", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
         RowBox[{"N", "[", "depthscaling", "]"}], ",", 
         FractionBox[
          RowBox[{"Total", "/@", 
           RowBox[{"N", "[", 
            RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
          RowBox[{"Total", "[", 
           RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ematrix", " ", "=", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pmatrix", " ", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"mat", "-", "ematrix"}], ")"}], 
        SqrtBox[
         RowBox[{"ematrix", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             SuperscriptBox["c", "2"], "ematrix"}]}], ")"}]}]]]}], "  ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_cell-specific residuals.mx\>\""}], 
        ",", " ", "pmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"mflist", " ", "=", " ", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"n", "-", "1"}]], 
        RowBox[{"Total", "/@", 
         RowBox[{"(", 
          SuperscriptBox["pmatrix", "2"], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "filemarker", "<>", "\"\<_modified_corrected_Fano factors.mx\>\""}], 
        ",", " ", "mflist"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Modified, corrected Fano factors acquired and saved\>\"", ",", 
        " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<mcFano slope between 0.01 and 10 is \>\"", ",", 
        RowBox[{"a", "/.", 
         RowBox[{"FindFit", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"MapThread", "[", 
              RowBox[{"List", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Log10", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{"Mean", "[", "#", "]"}], "]"}], "]"}], "&"}], "/@",
                   "mat"}], ",", " ", "mflist"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "<", 
               RowBox[{"First", "[", "#", "]"}], "<", "1"}], "&"}]}], "]"}], 
           ",", 
           RowBox[{
            RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Interrupt\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Continue or try a different value of c?\>\"", 
          "]"}], ";", 
         RowBox[{"Interrupt", "[", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Kappa]lists", "=", 
       RowBox[{"FanoCumulants5CF", "[", 
        RowBox[{"ematrix", ",", "c", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polylist", "=", 
       RowBox[{"CornishFisherPolynomialCoefficientsforFano5CF", "[", 
        RowBox[{
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"\[Kappa]lists", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "mflist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"equationslist", " ", "=", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           SuperscriptBox["x", "k"], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
         "polylist"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"logplist", "=", 
       RowBox[{"FixedPosPValFunc", "/@", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", "#"}], "]"}], "&"}], ",", 
          RowBox[{"Min", "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "/.", 
                 RowBox[{"FindInstance", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "==", "0"}], "&&", 
                    RowBox[{"x", ">", "0"}]}], ",", "x", ",", "Reals", ",", 
                   "2"}], "]"}]}], ")"}], "/.", 
               RowBox[{"x", "->", 
                RowBox[{"{", "0", "}"}]}]}], "&"}], "/@", "equationslist"}], 
            ")"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_fanopvalues.mx\>\""}], ",", " ", 
        "logplist"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Fano p-values acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", " ", "\"\<Correlations\>\"", "]"}], "==",
          " ", "False"}], ",", " ", 
        RowBox[{"Goto", "[", "end", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pccmatrix", "=", 
       RowBox[{"DotProductCF", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          FractionBox["pmatrix", 
           SqrtBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "mflist"}]]], "]"}], ",", "n"}],
         "]"}]}], " ", ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_pccmatrix.mx\>\""}], ",", " ", 
        "pccmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<corrected modified correlations acquired and saved \>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pccSignmatrix", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"LowerTriangularize", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"BoolEval", "[", 
            RowBox[{"pccmatrix", ">", "0"}], "]"}], "-", 
           RowBox[{"BoolEval", "[", 
            RowBox[{"pccmatrix", "<=", "0"}], "]"}]}], ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
        "OptionValue", "[", "\"\<Fano Inverse Sqrt Correction\>\"", "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"invsqrtmoments", "=", 
          RowBox[{"InverseSqrtMomentLists", "[", 
           RowBox[{
           "genetotals", ",", "depthlist", ",", " ", "c", ",", " ", "n"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"filemarker", "<>", "\"\<_invsqrtmoments.mx\>\""}], ",", 
           " ", "invsqrtmoments"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<inverse squareroot Fano moments acquired and saved \>\"", ",", 
           
           RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"fanocorrectionmatrices", "=", 
          RowBox[{"SqrtCorrectionmats", "[", 
           RowBox[{"invsqrtmoments", ",", "genetotals"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"fanocorrectionmatrices", "=", 
          RowBox[{"Table", "[", " ", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", "4"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<inverse squareroot Fano moments ignored \>\"", 
          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Moment corrections for \
1/\!\(\*SqrtBox[\(\*SubscriptBox[\(\[Phi]\), \(a\)] \
\*SubscriptBox[\(\[Phi]\), \(b\)]\)]\) acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ccmats", "=", 
       RowBox[{"CorrelationCumulantsNewCF", "[", 
        RowBox[{"ematrix", ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"fanocorrectionmatrices", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "c", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Adjusted cumulants of the correlations acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polymatrix", "=", 
       RowBox[{"CornishFisherPolynomialCoefficients5CF", "[", 
        RowBox[{
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"ccmats", "[", 
          RowBox[{"[", "4", "]"}], "]"}], " ", ",", "pccmatrix"}], "]"}]}], 
      " ", ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Cornish Fisher Polynomial Coefficients acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"augmentedParameters", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"SymmetricMatrixToList", "/@", 
         RowBox[{"Append", "[", 
          RowBox[{"polymatrix", ",", " ", "pccSignmatrix"}], "]"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"Length", "[", "augmentedParameters", "]"}], "]"}], "<>", 
         "\"\< equations gathered\>\""}], ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xlist", "=", 
       RowBox[{"FastFindX", "[", 
        RowBox[{"augmentedParameters", ",", " ", 
         RowBox[{"OptionValue", "[", "\"\<CFThreshold\>\"", "]"}]}], "]"}]}], 
      ";", " ", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<x-values acquired\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"logpmatrix", "=", 
       RowBox[{"ListToSymmetricMatrix", "[", 
        RowBox[{"FixedPValFunc", "/@", "xlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_logpvalues.mx\>\""}], ",", 
        "logpmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<p-values acquired and saved\>\"", ",", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"equivalentPCCs", " ", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"InferredPCCs", "[", 
         RowBox[{"logpmatrix", ",", "pccSignmatrix", ",", 
          RowBox[{"OptionValue", "[", "\"\<First Pass Cutoff\>\"", "]"}], ",",
           " ", "n"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"filemarker", "<>", "\"\<_equivalentPCCs.mx\>\""}], ",", " ", 
        "equivalentPCCs"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<equivalent PCCs acquired and saved\>\"", ",", " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQ", "[", 
         RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "]"}], ",", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], ",", 
           RowBox[{"2", "*", 
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}], ",", 
           RowBox[{"3", "*", 
            RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}]}]}], "}"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<Pvalue\>\"", "]"}], "==", 
         "\"\<BH\>\""}], ",", "\[IndentingNewLine]", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{"2", "#"}], ",", " ", 
             RowBox[{"3", "#"}]}], "}"}], "&"}], "@", 
          RowBox[{"BHNew", "[", 
           RowBox[{
            RowBox[{"10", "^", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"logpmatrix", "[", "\"\<ExplicitValues\>\"", "]"}], 
               ")"}]}]}], ",", " ", 
            RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], ",", 
            RowBox[{"Binomial", "[", 
             RowBox[{"m", ",", "2"}], "]"}]}], " ", "]"}]}]}], ",", 
        "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
        RowBox[{"sigcutofflist", " ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
             RowBox[{"Binomial", "[", 
              RowBox[{"m", ",", "2"}], "]"}]}], "]"}], ",", 
           RowBox[{"2", "*", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"3", "*", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "/", 
              RowBox[{"Binomial", "[", 
               RowBox[{"m", ",", "2"}], "]"}]}], "]"}]}]}], "}"}]}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"\"\<For FDR = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"OptionValue", "[", "\"\<alpha\>\"", "]"}], "]"}], "<>", 
         "\"\<, the significance level is p < \>\""}], ",", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{"sigcutofflist", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"significantPCCmatrix", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BoolEval", "[", 
           RowBox[{"logpmatrix", ">", 
            RowBox[{"-", 
             RowBox[{"Log10", "[", 
              RowBox[{"sigcutofflist", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "]"}], "*", 
          "equivalentPCCs"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", "m"}], "}"}]}], "]"}]}], ";", 
