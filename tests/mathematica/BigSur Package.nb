Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"IdealizedCFitAlt2", "[", "matpac_", "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mat", ",", "depthlist", ",", "n", ",", "genetotals", ",", 
        "genesample", ",", " ", "newematrix", ",", " ", "fittedjvalues", ",", 
        "data", ",", "means", ",", "bounds", ",", "fit", ",", "temp", ",", 
        "skdist", ",", " ", "mediandata", ",", "xcutoff", ",", "ycutoff", ",",
         " ", "weights"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mat", "=", 
        RowBox[{"matpac", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"depthlist", " ", "=", 
        FractionBox[
         RowBox[{"Total", "/@", 
          RowBox[{"N", "[", 
           RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
         RowBox[{"Total", "[", 
          RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"genetotals", "=", 
        RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"means", " ", "=", " ", 
        RowBox[{"genetotals", "/", "n"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"newematrix", "=", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fittedjvalues", "=", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"n", "-", "1"}]], " ", 
         RowBox[{"Total", "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"mat", "-", "newematrix"}], ")"}], "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", "newematrix", ")"}], "^", "2"}], ")"}]}], 
           ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"means", ",", "fittedjvalues"}], "}"}], "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"mediandata", "=", 
        RowBox[{"MovingMedian", "[", 
         RowBox[{"data", ",", " ", "50"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"temp", "=", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"ListLogLogPlot", "[", "data", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"skdist", "=", 
        RowBox[{"SmoothKernelDistribution", "[", 
         RowBox[{
          RowBox[{"Log", "@", "means"}], ",", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ycutoff", ",", "xcutoff"}], "}"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], ",", 
            RowBox[{"x", "/.", 
             RowBox[{"Last", "[", "#", "]"}]}]}], "}"}], "&"}], "[", 
         RowBox[{"NMinimize", "[", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"PDF", "[", 
             RowBox[{"skdist", ",", "x"}], "]"}], 
            RowBox[{
             RowBox[{"-", "1"}], "/", "3"}]], ",", " ", "x"}], "]"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"weights", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{"ycutoff", ",", 
            RowBox[{"Count", "[", 
             RowBox[{
              RowBox[{"First", "/@", 
               RowBox[{"Log", "[", "mediandata", "]"}]}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "<", "xcutoff"}]}]}], "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"PDF", "[", 
              RowBox[{"skdist", ",", "#"}], "]"}], 
             RowBox[{
              RowBox[{"-", "1"}], "/", "3"}]], "&"}], "/@", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"First", "/@", 
              RowBox[{"Log", "[", "mediandata", "]"}]}], ",", " ", 
             RowBox[{
              RowBox[{"#", ">=", " ", "xcutoff"}], "&"}]}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fit", " ", "=", " ", 
        RowBox[{"NonlinearModelFit", "[", 
         RowBox[{
          RowBox[{"Log", "[", "mediandata", "]"}], ",", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{
              FractionBox["\[Eta]", 
               RowBox[{"E", "^", "x"}]], "+", " ", "\[Theta]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Eta]", ">", "0"}], ",", " ", 
              RowBox[{"\[Theta]", ">", "0"}]}], "}"}]}], "}"}], ",", "  ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Eta]", ",", "1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Theta]", ",", "0.1"}], "}"}]}], "}"}], ",", " ", "x", 
          ",", " ", 
          RowBox[{"Weights", "->", "weights"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"NotebookDelete", "[", "temp", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "@", 
        RowBox[{"Grid", "[", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Show", "[", 
             RowBox[{
              RowBox[{"ListLogLogPlot", "[", "data", "]"}], ",", 
              RowBox[{"LogLogPlot", "[", 
               RowBox[{
                RowBox[{"Evaluate", "[", 
                 RowBox[{"(", " ", 
                  RowBox[{
                   RowBox[{
                    FractionBox["\[Eta]", "\[Mu]"], "+", " ", "\[Theta]"}], "/.", 
                   RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
                  ")"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\[Mu]", ",", " ", 
                  RowBox[{"Min", "[", "means", "]"}], ",", " ", 
                  RowBox[{"Max", "[", "means", "]"}]}], "}"}], ",", 
                RowBox[{"PlotStyle", "->", " ", "Red"}]}], "]"}]}], "]"}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{"Show", "[", 
             RowBox[{
              RowBox[{"ListLogLogPlot", "[", 
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"means", ",", 
                  RowBox[{"fittedjvalues", "*", "means"}]}], " ", "}"}], 
                "]"}], "]"}], ",", 
              RowBox[{"LogLogPlot", "[", 
               RowBox[{
                RowBox[{"Evaluate", "[", 
                 RowBox[{"(", " ", 
                  RowBox[{
                   RowBox[{"\[Eta]", "+", " ", 
                    RowBox[{"\[Theta]", " ", "\[Mu]"}]}], "/.", 
                   RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], 
                  ")"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\[Mu]", ",", " ", 
                  RowBox[{"Min", "[", "means", "]"}], ",", " ", 
                  RowBox[{"Max", "[", "means", "]"}]}], "}"}], ",", 
                RowBox[{"PlotStyle", "->", " ", "Red"}]}], "]"}]}], "]"}]}], 
           "}"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], "]"}]}], 
   ";"}], "*)"}]], "Input",
