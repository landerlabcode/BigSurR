 CellLabel->"In[8]:=",ExpressionUUID->"5ab8c5b8-aaa4-493f-b7bc-55b8f495e143"]
}, Closed]],

Cell[CellGroupData[{

Cell["ListToSymmetricMatrix", "Subsubsection",
 CellChangeTimes->{{3.8718642519497757`*^9, 
  3.871864261075214*^9}},ExpressionUUID->"a7ad78eb-c4d3-4875-974b-\
74328bf0792a"],

Cell[TextData[{
 "This takes a matrix that has been converted to a list by ",
 StyleBox["SymmetricMatrixToList",
  FontWeight->"Bold"],
 ", and restores it to a Sparse Array of a strictly lower-triangularized \
matrix.  To do this, it must first detect that the length of the matrix is \
equal to Binomial[m,2] for some integer, and it uses that integer as the \
dimensions of the symmetric matrix.  The test for that is that ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     SqrtBox[
      RowBox[{"1", "+", 
       RowBox[{"8", " ", 
        RowBox[{"Length", "[", "list", "]"}]}]}]]}], ")"}]}]],
  CellChangeTimes->{{3.8718645072618427`*^9, 3.871864538589795*^9}, 
    3.8718645814521713`*^9},ExpressionUUID->
  "1742c9d1-e13a-4d4f-b527-d75fe8d55bb1"],
 " must come out to an integer.  "
}], "Text",
 CellChangeTimes->{{3.871864395970929*^9, 3.871864478135056*^9}, {
  3.871864595792633*^9, 3.871864624393455*^9}, {3.8836038957971487`*^9, 
  3.8836039124955177`*^9}},ExpressionUUID->"ae529151-1e07-43cb-9773-\
ec8931628f6a"],

Cell["The \[OpenCurlyDoubleQuote]Alt\[CloseCurlyDoubleQuote] version runs \
about three times faster", "Text",
 CellChangeTimes->{{3.967475081606536*^9, 
  3.9674750942077637`*^9}},ExpressionUUID->"11ce3631-51c1-4b66-a5ee-\
2aa0fa8c8123"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ListToSymmetricMatrixAlt", "[", "list_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", "=", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"8", " ", 
            RowBox[{"Length", "[", "list", "]"}]}]}]]}], ")"}]}]}], "}"}], 
    ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"IntegerQ", "[", "m", "]"}], ",", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"SparseArray", "[", 
            RowBox[{"LowerTriangularize", "[", 
             RowBox[{
              RowBox[{"ConstantArray", "[", 
               RowBox[{"1", ",", 
                RowBox[{"{", 
                 RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
           "\"\<ExplicitPositions\>\"", "]"}], "->", " ", "list"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<Dimensions incorrect for restoration to symmetric matrix\>\"", 
        "]"}], ";", " ", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.96747469033309*^9, 3.9674747329997463`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[9]:=",ExpressionUUID->"0b6e9d1b-fb05-45fb-80e7-f2197890b051"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ListToSymmetricMatrix", "[", "list_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", "=", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"8", " ", 
            RowBox[{"Length", "[", "list", "]"}]}]}]]}], ")"}]}]}], "}"}], 
    ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"IntegerQ", "[", "m", "]"}], ",", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2", ",", "m"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"y", ",", " ", "1", ",", " ", 
                RowBox[{"x", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], 
          "->", " ", "list"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<Dimensions incorrect for restoration to symmetric matrix\>\"", 
        "]"}], ";", " ", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.871864809863283*^9, 3.871864957302676*^9}, {
   3.87186499729932*^9, 3.87186502277293*^9}, 3.87186505820753*^9, {
   3.871865301406657*^9, 3.871865364283741*^9}, {3.871904343534956*^9, 
   3.871904348161562*^9}, 3.871905182960773*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[10]:=",ExpressionUUID->"445cbca9-f7e3-4edd-a566-3b8afe849fe4"]
}, Closed]],

Cell[CellGroupData[{

Cell["RestoreSymmetryExceptDiagonal", "Subsubsection",
 CellChangeTimes->{{3.833931563763345*^9, 3.833931569393667*^9}, {
  3.850272772232736*^9, 3.850272775904338*^9}, {3.8918614201647453`*^9, 
  3.89186142122263*^9}},ExpressionUUID->"07093697-dc72-4a1f-a355-\
b7b7fa2fd0ca"],

Cell["\<\
This takes a symmetric matrix that has been \
\[OpenCurlyDoubleQuote]lower-triangularized\[CloseCurlyDoubleQuote] and had \
its diagonal entries set to zero, and undoes these steps, restoring symmetry \
to the matrix and not affecting the diagonal.  The output is in the form of a \
normal array or sparse array, depending on the input SparseArray\
\>", "Text",
 CellChangeTimes->{{3.8339315733164053`*^9, 3.8339316420266314`*^9}, {
  3.8516113389210663`*^9, 3.8516113393145657`*^9}, {3.8824261744743137`*^9, 
  3.8824262096251593`*^9}},ExpressionUUID->"1180e559-f55a-4e34-abf9-\
400c7d668532"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RestoreSymmetryExceptDiagonal", "[", "mat_", "]"}], ":=", " ", 
  RowBox[{"mat", "+", 
   RowBox[{"Transpose", "[", "mat", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.833930686216305*^9, 3.833930784881845*^9}, {
  3.833931346441351*^9, 3.833931399358086*^9}, {3.8339314743565598`*^9, 
  3.8339314858511972`*^9}, {3.8502727784854183`*^9, 3.850272781831449*^9}, {
  3.850272822397153*^9, 3.850272827139298*^9}, {3.8824260291183777`*^9, 
  3.882426036583126*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[11]:=",ExpressionUUID->"8326772b-674a-4d43-bda7-0c91edc05897"]
}, Closed]],

Cell[CellGroupData[{

Cell["ListIndex", "Subsubsection",
 CellChangeTimes->{{3.8912040244277687`*^9, 3.891204029680873*^9}, {
  3.8912040692712717`*^9, 
  3.891204069427578*^9}},ExpressionUUID->"5b9e726a-07d4-424a-9305-\
532f425aab5b"],

Cell[TextData[{
 "This code takes any row-column coordinates from a strictly lower \
triangularized matrix and returns its position in the list generated by ",
 StyleBox["SymmetricMatrixToList",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.8912115090977993`*^9, 3.8912115529214783`*^9}, 
   3.891211604597986*^9},ExpressionUUID->"55d184b9-3d18-4c75-ba01-\
b486dce8c0b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ListIndex", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", " ", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"2", "-", 
     RowBox[{"3", " ", "x"}], "+", 
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"2", " ", "y"}]}], ")"}]}]}]], "Input",
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[12]:=",ExpressionUUID->"c16cfb78-d667-4961-a518-2b87cad5d8bb"]
}, Closed]],

Cell[CellGroupData[{

Cell["MatrixIndexCF", "Subsubsection",
 CellChangeTimes->{{3.891204017183824*^9, 
  3.89120402212778*^9}},ExpressionUUID->"1011fbb8-7da7-461f-b2e8-\
e6330f1b89ee"],

Cell[TextData[{
 "This code takes any list coordinate from a list that had been generated by ",
 StyleBox["SymmetricMatrixToList ",
  FontWeight->"Bold"],
 "and returns the row-column coordinates in the strictly lower triangularized \
matrix.  "
}], "Text",
 CellChangeTimes->{{3.8912115644792643`*^9, 
  3.891211640172118*^9}},ExpressionUUID->"f39c6a70-3f17-4c37-9fe7-\
9458c32029ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixIndexCF", "=", " ", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"z", ",", " ", "_Integer"}], "}"}], "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", " ", 
        RowBox[{"IntegerPart", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"3", "+", 
            SqrtBox[
             RowBox[{
              RowBox[{"-", "7"}], "+", 
              RowBox[{"8", " ", "z"}]}]]}], ")"}]}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           RowBox[{"3", " ", "x"}], "-", 
           SuperscriptBox["x", "2"], "+", 
           RowBox[{"2", " ", "z"}]}], ")"}]}]}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"RuntimeAttributes", "->", 
     RowBox[{"{", "Listable", "}"}]}], ",", " ", 
    RowBox[{"Parallelization", "->", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.89120376407161*^9, 3.891203779013588*^9}, {
  3.8912038236765823`*^9, 3.891203839242621*^9}, {3.891204040318527*^9, 
  3.8912040419815493`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[13]:=",ExpressionUUID->"4e13f17e-561f-42f4-b335-8368d4b57f82"],

