Cell[CellGroupData[{

Cell["InferredPCCs", "Subsubsection",
 CellChangeTimes->{
  3.868955847193919*^9, {3.869333504114781*^9, 
   3.8693335104520683`*^9}},ExpressionUUID->"6307cf1f-5748-4e29-9fc6-\
3ffc64d6b82f"],

Cell["\<\
This operates on a matpac and on the output matrix with negative log \
p-values.  It produces a matrix of p-value-correlated correlations.  It calls \
a code that uses the Fisher p-value formula to give an equivalent correlation \
coefficient based on the p-value and the vector length.  

Because it is relatively slow, it first prunes the pvalue matpac to set any \
values less than or equal to \[OpenCurlyDoubleQuote]cutoff\
\[CloseCurlyDoubleQuote] to zero.  If necessary we can adjust this to a lower \
number using an option.\
\>", "Text",
 CellChangeTimes->{{3.868955871517003*^9, 3.8689559365450172`*^9}, {
   3.868956010452351*^9, 3.868956046437635*^9}, {3.8689567398073606`*^9, 
   3.868956746968094*^9}, {3.871919962130529*^9, 3.8719199657830753`*^9}, {
   3.8719223252922792`*^9, 3.8719223537714777`*^9}, 3.8719224147440557`*^9, {
   3.87192287382121*^9, 3.871922902994214*^9}, {3.883999515828867*^9, 
   3.8839995214846992`*^9}},ExpressionUUID->"3d1ebf31-4806-4e33-8933-\
c1f9b0c96f20"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InferredPCCs", "[", 
   RowBox[{
   "logpvalmatrix_", ",", "pccSignmatrix_", ",", " ", "cutoff_", ",", " ", 
    "n_"}], "]"}], ":=", " ", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mat", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"logpvalmatrix", "*", 
         RowBox[{"BoolEval", "[", 
          RowBox[{"logpvalmatrix", ">", "cutoff"}], "]"}]}], ",", 
        RowBox[{"Dimensions", "[", "logpvalmatrix", "]"}]}], "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{"pccSignmatrix", " ", "*", 
       RowBox[{"Tanh", "[", 
        FractionBox[
         RowBox[{
          SqrtBox["2"], " ", 
          RowBox[{"InverseErfc", "[", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "mat"}]}], "]"}]}], 
         SqrtBox[
          RowBox[{
           RowBox[{"-", "3."}], "+", "n"}]]], "]"}]}], ",", " ", 
      RowBox[{"Dimensions", "[", "mat", "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.868951469931706*^9, 3.868951543412952*^9}, {
   3.868956350186864*^9, 3.868956350573113*^9}, {3.868956406361285*^9, 
   3.868956409787977*^9}, {3.868956485705392*^9, 3.868956601431829*^9}, {
   3.86895668520542*^9, 3.868956688749668*^9}, {3.86895693824614*^9, 
