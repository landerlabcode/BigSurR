Cell["\<\
We will call the list format produced by this function a \
\[OpenCurlyDoubleQuote]matpac\[CloseCurlyDoubleQuote] format.  \
\>", "Text",
 CellChangeTimes->{{3.832260203872623*^9, 
  3.832260219850449*^9}},ExpressionUUID->"54c39ef5-e650-460d-8385-\
4d886825fd7d"],

Cell["\<\
This creates triples by adding each of the elements of list to the end of \
{x,y}.  \
\>", "Text",
 CellChangeTimes->{{3.854582522016808*^9, 
  3.854582545526805*^9}},ExpressionUUID->"3ba36489-b984-47a7-b55d-\
091dd1a44cc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddThird", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], ",", "list_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "#"}], "}"}], "&"}], "/@", 
   "list"}]}]], "Input",
 CellChangeTimes->{{3.851565082491938*^9, 3.851565084300935*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[5]:=",ExpressionUUID->"5c5cb829-59b4-45d9-8172-1f42e8585bf4"]
}, Closed]],

Cell[CellGroupData[{

Cell["SymmetricMatrixToList", "Subsubsection",
 CellChangeTimes->{{3.871864248472568*^9, 
  3.871864250004983*^9}},ExpressionUUID->"2e547526-a0a6-4037-9625-\
d8148dbf0027"],

Cell["\<\
There are times when it is inconvenient to store a symmetric matrix as a \
matrix, and easier to store it as a flat list, especially when combining \
matrices, and when the have been lower-triangularized.  The following code \
replaces a symmetric matrix with the values of the Array Rules that would \
result from the Lower-triangularized version of the matrix.  Note that there \
should be Binomial[m,2] values, where m- is the common dimension or the \
original matrix\
\>", "Text",
 CellChangeTimes->{{3.871864263588213*^9, 
  3.871864386319517*^9}},ExpressionUUID->"c79159a3-7f9f-4a82-9a7c-\
78d0dccdfdc3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SymmetricMatrixToList", "[", "matrix_", "]"}], ":=", 
  RowBox[{"Values", "[", 
   RowBox[{"Drop", "[", 
    RowBox[{
     RowBox[{"ArrayRules", "[", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{"matrix", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"-", "1"}]}], "]"}], "]"}]}]], "Input",
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[6]:=",ExpressionUUID->"93f2928d-7bde-4581-9b12-491625014a31"],

Cell[TextData[{
 "Interestingly, this runs rather slowly for big matrices.  A faster code \
would be to just use ExplicitValues, ",
 StyleBox["but that assumes there are no default values",
  FontWeight->"Bold"],
 " within the lower-triangularized portion of the matrix; if there were it \
would skip them "
}], "Text",
 CellChangeTimes->{{3.871902112396345*^9, 3.871902134310823*^9}, {
  3.890915911480692*^9, 3.8909159584483147`*^9}, {3.967475505062499*^9, 
  3.96747551253424*^9}},ExpressionUUID->"db4fdc2f-7cb8-4eb3-b0eb-\
b9a1deb2cff0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SymmetricMatrixToListAlt", "[", "matrix_", "]"}], ":=", 
  RowBox[{
   RowBox[{"SparseArray", "[", 
    RowBox[{"LowerTriangularize", "[", 
     RowBox[{"matrix", ",", " ", 
      RowBox[{"-", "1"}]}], "]"}], "]"}], "[", "\"\<ExplicitValues\>\"", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.87186469042749*^9, 3.8718647381371183`*^9}, {
   3.8718647798665752`*^9, 3.8718647928023567`*^9}, 3.871903715504642*^9, {
   3.967473926869954*^9, 3.9674739333232203`*^9}, {3.967475635613378*^9, 
   3.967475636445874*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->"In[7]:=",ExpressionUUID->"6a573518-e41b-410b-8d2d-e334216fecf9"],

Cell["\<\
Actually it seems both codes will do that.  We need to check whether \
SymmetricMatrixToList is ever used on a matrix with zeros in the lower \
triangularized part.  Empirically it looks like that never happens, but we \
might want to insert some kind of a check, like the following.  In the event \
that there are zeros in the lower triangle of the matrix, the code will \
instead generate a constant array of the equivalent size, lowertriangularize \
it, enumerate all the positions, and retrieve all the values of the input \
matrix at those positions.  \
\>", "Text",
 CellChangeTimes->{{3.967475784862051*^9, 3.96747581487749*^9}, {
  3.967536969654531*^9, 3.967536996832508*^9}, {3.967548617119203*^9, 
  3.967548668382859*^9}, {3.967548710754484*^9, 3.967548720617807*^9}, {
  3.967548751139968*^9, 
  3.967548755470118*^9}},ExpressionUUID->"bc938fbf-1c59-4ba6-9d80-\
51eb127c3ae0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SymmetricMatrixToListNew", "[", "matrix_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"smat", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{"matrix", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"SquareMatrixQ", "[", "smat", "]"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"smat", "[", "\"\<ExplicitLength\>\"", "]"}], "==", 
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"Length", "[", "smat", "]"}], ",", "2"}], "]"}]}], ",", 
        RowBox[{"smat", "[", "\"\<ExplicitValues\>\"", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ca", "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Length", "[", "smat", "]"}], ",", 
                RowBox[{"Length", "[", "smat", "]"}]}], "}"}]}], "]"}]}], 
           "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Apply", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"smat", "[", 
                RowBox[{"[", 
                 RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "&"}], ",", "#"}], 
             "]"}], "&"}], "/@", 
           RowBox[{
            RowBox[{"SparseArray", "[", 
             RowBox[{"LowerTriangularize", "[", 
              RowBox[{"ca", ",", 
               RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
            "\"\<ExplicitPositions\>\"", "]"}]}]}], "]"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Coefficients Matrix Not Symmetric\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.967537180750977*^9, 3.967537421578678*^9}, {
  3.9675375031055183`*^9, 3.967537514898623*^9}, {3.967537576820849*^9, 
  3.967537622235982*^9}, {3.967548491281392*^9, 3.9675486054378242`*^9}, {
  3.967548696386573*^9, 3.967548696969873*^9}},
