         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"3", " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "n"}], ")"}], "4"]}], 
            SuperscriptBox["n", "3"]]}], "+", 
          RowBox[{
           FractionBox["1", "\[ScriptCapitalJ]4"], 
