                RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "]"}], "*", 
           "equivalentPCCs"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", "m"}], "}"}]}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
