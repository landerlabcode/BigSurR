          RowBox[{
           RowBox[{
           "filemarker", "<>", "\"\<_significant communities.mx\>\""}], ",", 
           "communities"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Communities Identified\>\"", ",", 
           RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}]}], ",", 
        RowBox[{
        "Print", "[", "\"\<Community Identification Skipped\>\"", "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Label", "[", "end", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"SetDirectory", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", 
