Cell[CellGroupData[{

Cell["What is a Matpac?", "Subsection",
 CellChangeTimes->{{3.906227202280979*^9, 
  3.906227205639752*^9}},ExpressionUUID->"b1d8be96-2171-475e-af7d-\
70f266f4c555"],

Cell[TextData[{
 "The matpac is just BigSur\[CloseCurlyQuote]s data structure for storing \
scRNAseq counts data.  It is a list with four elements.  The first element is \
a matrix where the rows correspond to genes and the columns correspond to \
cells and the entries are UMIs.  The second element is the list of gene names \
or IDs corresponding to the rows of the matrix.  The third element is a list \
of cell IDs corresponding to the columns of the matrix.  The fourth element \
is a list of metadata formated flexibly as an item, list or rule according to \
the needs of the user.  There are no further elements in a matpac beyond \
these four.  \n\nOften the matrix element of the matpac is saved in \
SparseArray form, which is a compressed matrix format, but  matpacs will work \
regardless of how the matrix is represented.  \n\nData that come from Scanpy \
are often saved as \[OpenCurlyDoubleQuote]anndata\[CloseCurlyDoubleQuote] \
objects.  It is possible to extract a matpac  from anndata objects, but \
because the formats of anndata objects are not always identical, it is \
helpful to double check that it is working correctly.  The biggest source of \
problems comes from generating the counts matrix.  This is because Scanpy \
saves the counts matrix as a one-dimensional vector in CSR (compressed sparse \
row) format.  The same CSR format actually lies behind Mathematica\
\[CloseCurlyQuote]s SparseArray format, but because python is a \
\[OpenCurlyDoubleQuote]0-indexed\[CloseCurlyDoubleQuote] language while \
Mathematica is \[OpenCurlyDoubleQuote]1-indexed\[CloseCurlyDoubleQuote] it is \
very easy to get the relationship between gene names and rows of counts \
mis-aligned.  The following code helps.  To use it, one needs to extract 5 \
things from the anndata.  \n\n",
 StyleBox["genes",
  FontWeight->"Bold"],
 ":  this is a list usually found at \[OpenCurlyDoubleQuote]raw/var/_index\
\[CloseCurlyDoubleQuote]\n",
 StyleBox["cells",
  FontWeight->"Bold"],
 ":  this is a list usually found at  \[OpenCurlyDoubleQuote]obs/index\
\[CloseCurlyDoubleQuote] \n",
 StyleBox["datavector",
  FontWeight->"Bold"],
 ":  this list is the CSR representation of raw (integer) counts, usually \
found at  \[OpenCurlyDoubleQuote]raw/X/data\[CloseCurlyDoubleQuote]\n",
 StyleBox["indices",
  FontWeight->"Bold"],
 ":  this list is part of the information required to convert the datavector \
to a full matrix and is usually found at \[OpenCurlyDoubleQuote]raw/X/indices\
\[CloseCurlyDoubleQuote].  \n",
 StyleBox["offsets",
  FontWeight->"Bold"],
 ": this list is additional information required, along with indcies, to \
convert the datavector to a full matrix\n\nThe first thing one needs to do is \
test whether the indices and offsets start with zero, and if they do, calls \
upon the user to add 1 to every element in each list.  In Mathematica one can \
just use the code 1+list to add 1 to each element of a list.  \n\nThen one \
can apply the following function to these five lists:"
}], "Text",
 CellChangeTimes->{{3.906227216554744*^9, 3.9062273436118*^9}, {
  3.998567282324638*^9, 3.99856753767061*^9}, {3.99856764267267*^9, 
  3.998567774430026*^9}, {3.9985678180663013`*^9, 3.998568082456402*^9}, {
  3.998568144280478*^9, 3.998568364187183*^9}, {3.998568400611177*^9, 
  3.9985686247052097`*^9}, {3.998568691567074*^9, 
  3.998568692824059*^9}},ExpressionUUID->"69b3c1d1-14c0-4b3e-bc4f-\
53b357393f79"],

Cell[CellGroupData[{

Cell["CSRtoSparseArray", "Subsubsection",
 CellChangeTimes->{{3.986429121152895*^9, 
  3.986429127697399*^9}},ExpressionUUID->"ea6c69b7-9d39-4308-ac72-\
1b0a2b6fa543"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CSRtoSparseArray", "[", 
   RowBox[{
   "datavector_", ",", " ", "indices_", ",", " ", "offsets_", ",", " ", 
    "genes_", ",", " ", "cells_"}], "]"}], ":=", " ", "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", "indices", "]"}], "==", "0"}], " ", "\[Or]", " ", 
     RowBox[{
      RowBox[{"First", "[", "offsets", "]"}], "==", "0"}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "Print", "[", 
      "\"\<Data are zero indexed; please add 1 to indices and offsets\>\"", 
      "]"}], ";", " ", 
     RowBox[{"Abort", "[", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "cells", "]"}], "!=", " ", 
       RowBox[{
        RowBox[{"Length", "[", "offsets", "]"}], "-", "1"}]}], ",", " ", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Length of offsets incorrect\>\"", "]"}], 
       ";", 
       RowBox[{"Abort", "[", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "indices", "]"}], "!=", " ", 
         RowBox[{"Length", "[", "datavector", "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<Length of indices incorrect\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"diff", "=", " ", 
            RowBox[{
             RowBox[{"Drop", "[", 
              RowBox[{"offsets", ",", "1"}], "]"}], "-", " ", 
             RowBox[{"Drop", "[", 
              RowBox[{"offsets", ",", " ", 
               RowBox[{"-", "1"}]}], "]"}]}]}], " ", "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Transpose", "[", 
           RowBox[{"SparseArray", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Flatten", "[", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Table", "[", 
                    RowBox[{"i", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"diff", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", " ", 
                    RowBox[{"Length", "[", "diff", "]"}]}], "}"}]}], "]"}], 
                   "]"}], ",", " ", "indices"}], "}"}], "]"}], "->", " ", 
               "datavector"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Length", "[", "cells", "]"}], ",", " ", 
               RowBox[{"Length", "[", "genes", "]"}]}], "}"}]}], "]"}], 
           "]"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.986428067444838*^9, 3.986428221438197*^9}, {
   3.986428257266951*^9, 3.986428311198395*^9}, {3.986428341211445*^9, 
   3.986428407998478*^9}, {3.9864284405808697`*^9, 3.986428531881064*^9}, 
   3.986428573846696*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[119]:=",ExpressionUUID->"6e5b2c4c-2865-4291-bbf6-65516f41304d"],

Cell["\<\
The code first coverts the datavector to Sparse Matrix Format, with genes on \
the columns and cells on the rows .  It then transposes the data so it is in \
our usual matpac format of genes on the rows and cells on the columns.  One \
may then combined this output with \[OpenCurlyDoubleQuote]genes\
\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]cells\[CloseCurlyDoubleQuote] and whatever Metadata \
one wishes to create a matpac.  \
\>", "Text",
 CellChangeTimes->{{3.986428935939671*^9, 3.986429012302387*^9}, {
  3.998568632969076*^9, 
  3.998568727185314*^9}},ExpressionUUID->"935f2488-2b76-4ad1-86fc-\
470400039eff"]
}, Open  ]]
}, Closed]],

