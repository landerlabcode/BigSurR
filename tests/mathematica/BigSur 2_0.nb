Cell[CellGroupData[{

Cell["DotProductCF", "Subsubsection",
 CellChangeTimes->{{3.87132343532423*^9, 
  3.871323436761965*^9}},ExpressionUUID->"490abe95-ba3c-42d6-88d6-\
f28a1036c856"],

Cell["\<\
DotProductCF is a compiled version of taking a DotProduct.  It operates on a \
matrix, and generates a matrix of Absolute Correlations multiplied by the \
vector length, which comes out to simply be the dot product of each vector \
with each other vector.   If this is applied to a matrix that has been \
unitized, then the entries represent a count of the numbers of positions \
where both vectors had a non-zero entry.  \
\>", "Text",
 CellChangeTimes->{{3.854540296355093*^9, 3.854540323992663*^9}, {
  3.871323455297773*^9, 3.871323472713579*^9}, {3.9062253813296413`*^9, 
  3.906225386148612*^9}, {3.906225418336906*^9, 3.906225419339851*^9}, {
  3.906225483327688*^9, 3.906225493933477*^9}, {3.9062255868345413`*^9, 
  3.906225592362259*^9}},ExpressionUUID->"49b524ad-8e0f-4710-ae38-\
c42b92662bda"],

