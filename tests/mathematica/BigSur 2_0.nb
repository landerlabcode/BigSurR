Cell[CellGroupData[{

Cell[TextData[{
 "Finding Modules in Graphs (",
 StyleBox["FindCommunities",
  FontColor->GrayLevel[0]],
 ")"
}], "Subsection",
 CellChangeTimes->{{3.832290212440884*^9, 3.832290222106847*^9}, {
  3.8323308090147543`*^9, 3.8323308179339237`*^9}, {3.833557156907448*^9, 
  3.833557167399817*^9}, {3.834969265597715*^9, 3.834969271562804*^9}, {
  3.835009275208762*^9, 3.835009277583952*^9}, {3.8416045723165083`*^9, 
  3.841604590042267*^9}, {3.847647335957295*^9, 3.847647374394497*^9}, {
  3.848666722662307*^9, 3.848666724087916*^9}, {3.84866676368736*^9, 
