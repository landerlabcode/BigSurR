   "]"}]}]], "Input",
 CellChangeTimes->{{3.850562848529936*^9, 3.850562910247088*^9}, {
   3.8505630436453876`*^9, 3.8505630727093*^9}, {3.8505632523192263`*^9, 
   3.850563281028738*^9}, {3.850564141008479*^9, 3.850564164062584*^9}, 
   3.850574426632821*^9, {3.895746741475947*^9, 3.89574676422565*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[130]:=",ExpressionUUID->"c0c014b6-ba7f-48a7-b985-be4764cf3d79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BHNew", "[", 
   RowBox[{"pvals_", ",", " ", "\[Alpha]_", ",", " ", "altlength_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"list", "=", 
      RowBox[{"Sort", "[", "pvals", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"list", "\[LeftDoubleBracket]", "\[IndentingNewLine]", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Length", "[", "list", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"1", "+", 
        RowBox[{"LengthWhile", "[", 
         RowBox[{
          RowBox[{"BHCF", "[", 
           RowBox[{"list", ",", " ", "altlength"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"#", "\[LessEqual]", " ", "\[Alpha]"}], "&"}]}], "]"}]}]}],
       "]"}], "\[IndentingNewLine]", "\[RightDoubleBracket]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.850562848529936*^9, 3.850562910247088*^9}, {
   3.8505630436453876`*^9, 3.8505630727093*^9}, {3.8505632523192263`*^9, 
   3.850563281028738*^9}, 3.850564166395883*^9, 3.85057442806168*^9, {
   3.895746886611857*^9, 3.895746908351851*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[131]:=",ExpressionUUID->"ac74ffd2-d2e3-4778-a2e0-9f042ad4fd15"]
}, Closed]],

Cell[CellGroupData[{

Cell["FixedPValFunc", "Subsubsection",
 CellChangeTimes->{{3.871298168416596*^9, 3.871298184231979*^9}, {
   3.883953700356196*^9, 3.883953704627043*^9}, {3.8839998561648607`*^9, 
   3.8839998601754627`*^9}, 3.88400170811432*^9, 
   3.891857790478454*^9},ExpressionUUID->"ba3f5ef1-d427-4e87-86b0-\
4a03a12195c2"],

Cell[TextData[{
 "To obtain a -Log10(p)-value from Cornish Fisher Polynomials, we solve for \
the root of the polynomial, and then feed the result into either ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"Erfc", "[", " ", 
      RowBox[{"-", 
       FractionBox["x", 
        SqrtBox["2"]]}], "]"}]}], "]"}]}]],
  CellChangeTimes->{{3.8700475469112167`*^9, 3.870047568712522*^9}, {
    3.8700476030026817`*^9, 3.870047708991929*^9}, {3.870047741012683*^9, 
    3.870047745102447*^9}, {3.8700485781233788`*^9, 3.8700486142781553`*^9}, 
    3.870048847563229*^9, {3.8700489433520308`*^9, 3.8700489435385942`*^9}, {
    3.870049412772532*^9, 3.870049413086034*^9}, {3.870050990613215*^9, 
    3.870050996012876*^9}, {3.8700511078109207`*^9, 3.8700511079492702`*^9}, {
    3.870249892781365*^9, 3.870249933063057*^9}, {3.8702502089155893`*^9, 
    3.87025032233055*^9}, 3.870250365083935*^9, {3.870250444277918*^9, 
    3.8702504500792093`*^9}, {3.870250545804749*^9, 3.870250561481617*^9}, {
    3.8702519091306257`*^9, 3.870251958936447*^9}, {3.870252260555236*^9, 
    3.870252265493534*^9}, {3.870252863132614*^9, 3.8702528951252527`*^9}, {
    3.870253366996611*^9, 3.870253422532565*^9}},ExpressionUUID->
  "67c6111c-d76d-451d-935e-5b717415a22b"],
 " or ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"-", 
    RowBox[{"Log10", "[", 
     RowBox[{"1", "-", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"Erfc", "[", " ", 
        RowBox[{"-", 
         FractionBox["x", 
          SqrtBox["2"]]}], "]"}]}]}], "]"}], " "}],
   Background->None]],
  CellChangeTimes->{{3.8700475469112167`*^9, 3.870047568712522*^9}, {
    3.8700476030026817`*^9, 3.870047708991929*^9}, {3.870047741012683*^9, 
    3.870047745102447*^9}, {3.8700485781233788`*^9, 3.8700486142781553`*^9}, 
    3.870048847563229*^9, {3.8700489433520308`*^9, 3.8700489435385942`*^9}, {
    3.870049412772532*^9, 3.870049413086034*^9}, {3.870050990613215*^9, 
    3.870050996012876*^9}, {3.8700511078109207`*^9, 3.8700511079492702`*^9}, {
    3.870249892781365*^9, 3.870249933063057*^9}, {3.8702502089155893`*^9, 
    3.87025032233055*^9}, 3.870250365083935*^9, {3.870250444277918*^9, 
    3.8702504500792093`*^9}, {3.870250545804749*^9, 3.870250561481617*^9}, {
    3.8702519091306257`*^9, 3.870251958936447*^9}, {3.870252260555236*^9, 
    3.870252265493534*^9}, {3.870252863132614*^9, 3.8702528951252527`*^9}, {
    3.870253366996611*^9, 3.870253422532565*^9}},ExpressionUUID->
  "c3e23303-440a-46b9-af66-f21d3c6cf3b7"],
 "depending on whether the observed modified corrected correlation \
coefficient is negative, or positive, respectively.  \n\nNote that we can \
rewrite ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"Erfc", "[", " ", 
      RowBox[{"-", 
       FractionBox["x", 
        SqrtBox["2"]]}], "]"}]}], "]"}]}]],
  CellChangeTimes->{{3.8700475469112167`*^9, 3.870047568712522*^9}, {
    3.8700476030026817`*^9, 3.870047708991929*^9}, {3.870047741012683*^9, 
    3.870047745102447*^9}, {3.8700485781233788`*^9, 3.8700486142781553`*^9}, 
    3.870048847563229*^9, {3.8700489433520308`*^9, 3.8700489435385942`*^9}, {
    3.870049412772532*^9, 3.870049413086034*^9}, {3.870050990613215*^9, 
    3.870050996012876*^9}, {3.8700511078109207`*^9, 3.8700511079492702`*^9}, {
    3.870249892781365*^9, 3.870249933063057*^9}, {3.8702502089155893`*^9, 
    3.87025032233055*^9}, 3.870250365083935*^9, {3.870250444277918*^9, 
    3.8702504500792093`*^9}, {3.870250545804749*^9, 3.870250561481617*^9}, {
    3.8702519091306257`*^9, 3.870251958936447*^9}, {3.870252260555236*^9, 
    3.870252265493534*^9}, {3.870252863132614*^9, 3.8702528951252527`*^9}, {
    3.870253366996611*^9, 3.870253422532565*^9}},ExpressionUUID->
  "d30f550b-bfe2-4463-a152-d66b763d369b"],
 " as ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Erf", "[", 
        FractionBox["x", 
         SqrtBox["2"]], "]"}]}], ")"}]}], "]"}]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "cc4c06dc-1d30-4e06-b778-efc642180a0b"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Erf", "[", 
        FractionBox[
         RowBox[{"-", "x"}], 
         SqrtBox["2"]], "]"}]}], ")"}]}]}]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "8f7a6905-397d-4a66-91a6-d2001ab5aff3"],
 ", respectively.  In fact if we are absolutely certain that all the roots of \
the polynomials corresponding to negative correlations are negative, we could \
even write a single function:  ",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Log10", "[", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Erf", "[", 
        FractionBox[
         RowBox[{"Abs", "[", "x", "]"}], 
         SqrtBox["2"]], "]"}]}], ")"}]}], "]"}]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "715e503d-8170-4464-ae1e-f40c60f6d8b7"],
 ".  \nUnfortunately, there are numerical issues with evaluating ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Erf", "[", 
    FractionBox["x", 
     SqrtBox["2"]], "]"}], TraditionalForm]],ExpressionUUID->
  "9984cce4-6353-42f8-a792-174aa7172aa0"],
 " when x >8.3, giving zero instead of the necessary tiny number (at  x=8.3 \
the pvalue comes out to ",
 Cell[BoxData["1.1102230246251565`*^-16"],
  CellChangeTimes->{{3.8712984289127903`*^9, 3.871298462083086*^9}, 
    3.871298517386217*^9},ExpressionUUID->
  "da2421aa-3c1f-41ca-90a7-ac6aef61e09e"],
 ", so basically it sets all pvalues lower than ",
 Cell[BoxData["1.1102230246251565`*^-16"],
  CellChangeTimes->{{3.8712984289127903`*^9, 3.871298462083086*^9}, 
    3.871298517386217*^9},ExpressionUUID->
  "8e9fa2fd-6a50-46c2-8e7a-9ea0d28b5dc4"],
 " to 0, which is inconvenient as that makes our Log pvalues Indeterminate.  \
"
}], "Text",
 CellChangeTimes->{{3.871298200471325*^9, 3.871298412088491*^9}, 
   3.871298479876855*^9, {3.8712985281864643`*^9, 3.8712986421151943`*^9}, {
   3.871298675920639*^9, 3.871298727273505*^9}, 3.871299477659047*^9, {
   3.871299522315312*^9, 3.871299539376878*^9}, 3.871744006335431*^9, {
   3.8840017192810717`*^9, 3.884001719787032*^9}, {3.906225983007155*^9, 
   3.906226039180664*^9}},ExpressionUUID->"76d0dfec-7f5d-445b-a413-\
1c3231e8dc19"],

Cell[TextData[Cell[BoxData[
 RowBox[{"Fortunately", ",", 
  RowBox[{
   RowBox[{"as", "  ", "x"}], "\[Rule]", "\[Infinity]"}], ",", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"it", " ", "is", " ", "well", " ", "known", " ", "that"}], " ", "-", 
    RowBox[{"Log", "[", 
     RowBox[{"1", "-", 
      RowBox[{"Erf", "[", "z", "]"}]}], "]"}]}], "\[Rule]", " ", 
   SuperscriptBox["z", "2"]}], ",", " ", 
  RowBox[{
   RowBox[{"thus", "-", 
    RowBox[{"Log", "[", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Erf", "[", "z", "]"}]}], ")"}]}], "]"}]}], " ", "->", " ", 
   RowBox[{
    SuperscriptBox["z", "2"], "+", 
    RowBox[{"Log", "[", "2", "]"}]}]}], ",", " ", 
  RowBox[{"thus", " ", "-", 
   RowBox[{
    RowBox[{"Log10", "[", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Erf", "[", "z", "]"}]}], ")"}]}], "]"}], " ", "is", " ", 
    "just", "  ", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["z", "2"], "+", 
       RowBox[{"Log", "[", "2", "]"}]}], 
      RowBox[{"Log", "[", "10", "]"}]], ".", "  ", "Putting"}], " ", "in", " ", 
    FractionBox["x", 
     SqrtBox["2"]], " ", "for", " ", 
    SuperscriptBox["z", "2"], " ", "gives", " ", "us", " ", 
    FractionBox[
     RowBox[{
      FractionBox[
       SuperscriptBox["x", "2"], "2"], "+", 
      RowBox[{"Log", "[", "2", "]"}]}], 
     RowBox[{"Log", "[", "10", "]"}]]}]}]}]],
 CellChangeTimes->{{3.87005120083279*^9, 3.870051292939081*^9}, 
   3.8700513249813347`*^9, {3.870051724581292*^9, 3.870051772187804*^9}, {
   3.870051828569158*^9, 3.8700519140675087`*^9}, {3.8702500199267178`*^9, 
   3.870250053603877*^9}, {3.870276311163767*^9, 3.870276322733239*^9}, {
   3.871299264173748*^9, 3.871299408367174*^9}, {3.8712994417383223`*^9, 
   3.8712995128603477`*^9}},ExpressionUUID->"b586ecd4-9a0d-43b9-9982-\
de10d6157128"]], "Text",
 CellChangeTimes->{{3.871299530389019*^9, 
  3.871299562202652*^9}},ExpressionUUID->"954fbafa-73cb-4e9e-b9ef-\
d82a6bcc56b4"],

Cell[TextData[{
 "The following functions therefore replace ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"Erf", "[", 
      FractionBox["x", 
       SqrtBox["2"]], "]"}]}], ")"}]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "2afbb90e-7cad-4436-b6ed-c6c8be7545d9"],
 " with ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["e", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["x", "2"], "2"]}]]}]],
  CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
    3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
    3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
    3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
    3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
    3.871298106364991*^9},ExpressionUUID->
  "952d758a-a47b-4a93-9fc7-60b8d5bce5c6"],
 ",  when x is large, which is an excellent approximation.  "
}], "Text",
 CellChangeTimes->{
  3.8712994856677227`*^9, {3.9062260625058613`*^9, 
   3.906226077990753*^9}},ExpressionUUID->"1691488a-2cc1-4564-8491-\
963a5a3dde5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"1", "+", 
          FractionBox[
           RowBox[{
            FractionBox[
             SuperscriptBox["x", "2"], "2"], "+", 
            RowBox[{"Log", "[", "2", "]"}]}], 
           RowBox[{"Log", "[", "10", "]"}]]}], ",", "4"}], "]"}], ",", 
       RowBox[{"x", ">", "8.3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Log10", "[", " ", 
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"Erf", "[", 
               FractionBox["x", 
                SqrtBox["2"]], "]"}]}], ")"}]}], "]"}]}], ",", "4"}], "]"}], ",", 
       RowBox[{"0", "<", "x", "<=", " ", "8.3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "True"}], "}"}]}], "}"}], "]"}], ";"}]], "Text",
 CellChangeTimes->{{3.871297218666194*^9, 3.871297313247724*^9}, {
   3.871297345242454*^9, 3.871297374397523*^9}, {3.871297427908176*^9, 
   3.871297456008738*^9}, {3.871297552262533*^9, 3.871297571148984*^9}, {
   3.871297766919338*^9, 3.871297771273108*^9}, {3.871297984948242*^9, 
   3.871298020363028*^9}, {3.871298068344198*^9, 3.871298070856275*^9}, 
   3.871298106364991*^9, {3.871298912400827*^9, 3.871298923467793*^9}, {
   3.871298956817916*^9, 3.871298958734498*^9}, {3.871299126828659*^9, 
   3.8712991299733477`*^9}, {3.871299586943132*^9, 3.871299613195212*^9}, {
   3.871299653485814*^9, 3.871299655768971*^9}, {3.871305490696916*^9, 
   3.871305512196278*^9}, {3.871866633445012*^9, 3.8718666373535023`*^9}, {
   3.884001684083181*^9, 3.884001684673579*^9}, {3.8918577643869553`*^9, 
   3.891857769953334*^9}},ExpressionUUID->"2ba66af1-3926-4367-af6f-\
044ad314531a"],

Cell["\<\
Since the roots of significant negative correlations are always negative, and \
roots of positive correlations always positive.  we may use the following \
compiled function for all cases:\
\>", "Text",
 CellChangeTimes->{{3.87174400922841*^9, 3.871744066805294*^9}, {
  3.906226107318039*^9, 
  3.906226140598011*^9}},ExpressionUUID->"b4ea1ddd-2b5c-4a89-8021-\
e9798c38be3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FixedPValFunc", "=", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "_Real"}], "}"}], "}"}], ",", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], ">", "8.3"}], ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{
           FractionBox[
            SuperscriptBox["x", "2"], "2"], "+", 
           RowBox[{"Log", "[", "2", "]"}]}], 
          RowBox[{"Log", "[", "10", "]"}]]}], ",", "4"}], "]"}], ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Log10", "[", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Erf", "[", 
              FractionBox[
               RowBox[{"Abs", "[", "x", "]"}], 
               SqrtBox["2"]], "]"}]}], ")"}]}], "]"}]}], ",", "4"}], "]"}]}], 
     "]"}], ",", " ", 
    RowBox[{"RuntimeAttributes", "->", 
     RowBox[{"{", "Listable", "}"}]}], ",", " ", 
    RowBox[{"Parallelization", "->", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8717440734933558`*^9, 3.871744148042828*^9}, {
