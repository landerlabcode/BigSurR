Cell[CellGroupData[{

Cell["SymmetricMatrixToList", "Subsubsection",
 CellChangeTimes->{{3.871864248472568*^9, 
  3.871864250004983*^9}},ExpressionUUID->"95cff4e1-2502-4def-b5b2-\
321e9eb9477f"],

Cell["\<\
There are times when it is inconvenient to store a symmetric matrix as a \
matrix, and easier to store it as a flat list, for example when they have \
been strictly lower-triangularized (i.e. zeros on the diagonal and in the \
upper triangle).  The following code replaces a symmetric matrix with the \
values of the Array Rules that would result from the strictly \
lower-triangularized version of the matrix.  Note that there should be \
Binomial[m,2] values, where m- is the common dimension or the original matrix\
\
\>", "Text",
 CellChangeTimes->{{3.871864263588213*^9, 3.871864386319517*^9}, 
   3.906225072998094*^9, {3.906225121864771*^9, 3.90622514011729*^9}, {
   3.906225203366879*^9, 
   3.906225229585189*^9}},ExpressionUUID->"94a55e42-c80c-4b93-9a12-\
e09238219ab1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SymmetricMatrixToList", "[", "matrix_", "]"}], ":=", 
  RowBox[{"Values", "[", 
   RowBox[{"Drop", "[", 
    RowBox[{
     RowBox[{"ArrayRules", "[", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{"matrix", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"-", "1"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.87186469042749*^9, 3.8718647381371183`*^9}, {
   3.8718647798665752`*^9, 3.8718647928023567`*^9}, 3.871903715504642*^9},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[121]:=",ExpressionUUID->"91592132-9318-4b5e-ad5b-75924154d6fe"]
}, Closed]],

Cell[CellGroupData[{

Cell["RestoreSymmetryExceptDiagonal", "Subsubsection",
 CellChangeTimes->{{3.833931563763345*^9, 3.833931569393667*^9}, {
  3.850272772232736*^9, 
  3.850272775904338*^9}},ExpressionUUID->"87e161b2-552f-4c69-ae33-\
465ac7b4c0ca"],

Cell["\<\
This takes a symmetric matrix that has been \
\[OpenCurlyDoubleQuote]lower-triangularized\[CloseCurlyDoubleQuote] and had \
its diagonal entries set to zero, and undoes these steps, restoring symmetry \
to the matrix and not affecting the diagonal.  The output is in the form of a \
normal array or sparse array, depending on the input\
\>", "Text",
 CellChangeTimes->{{3.8339315733164053`*^9, 3.8339316420266314`*^9}, {
  3.8516113389210663`*^9, 3.8516113393145657`*^9}, {3.8824261744743137`*^9, 
  3.8824262096251593`*^9}, {3.906225283550861*^9, 
  3.906225284385395*^9}},ExpressionUUID->"000dc7dd-d9df-4c23-aee6-\
b29d0839709b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RestoreSymmetryExceptDiagonal", "[", "mat_", "]"}], ":=", " ", 
  RowBox[{"mat", "+", 
   RowBox[{"Transpose", "[", "mat", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.833930686216305*^9, 3.833930784881845*^9}, {
  3.833931346441351*^9, 3.833931399358086*^9}, {3.8339314743565598`*^9, 
  3.8339314858511972`*^9}, {3.8502727784854183`*^9, 3.850272781831449*^9}, {
  3.850272822397153*^9, 3.850272827139298*^9}, {3.8824260291183777`*^9, 
  3.882426036583126*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[122]:=",ExpressionUUID->"bd532cba-e3be-4cbd-96ee-d588b05fead3"]
}, Closed]],

Cell[CellGroupData[{

Cell["ListIndex", "Subsubsection",
 CellChangeTimes->{{3.8912040244277687`*^9, 3.891204029680873*^9}, {
  3.8912040692712717`*^9, 
  3.891204069427578*^9}},ExpressionUUID->"8997567b-b7fa-407f-92f5-\
81e5be39cf5f"],

Cell[TextData[{
 "This code takes any row-column coordinates from a strictly lower \
triangularized matrix and returns its position in the list generated by ",
 StyleBox["SymmetricMatrixToList",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.8912115090977993`*^9, 3.8912115529214783`*^9}, 
   3.891211604597986*^9},ExpressionUUID->"0d486a45-95e0-4dfe-940e-\
f7f4153c6e45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ListIndex", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", " ", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"2", "-", 
     RowBox[{"3", " ", "x"}], "+", 
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"2", " ", "y"}]}], ")"}]}]}]], "Input",
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[123]:=",ExpressionUUID->"f66af0b4-b101-4b3d-8a3b-fcbe9e1882ba"]
}, Closed]],

Cell[CellGroupData[{

Cell["MatrixIndexCF", "Subsubsection",
 CellChangeTimes->{{3.891204017183824*^9, 
  3.89120402212778*^9}},ExpressionUUID->"a3c06d12-924b-4aae-a1e4-\
07a319a71a21"],

Cell[TextData[{
 "This compiled code takes any list coordinate from a list that had been \
generated by ",
 StyleBox["SymmetricMatrixToList ",
  FontWeight->"Bold"],
 "and returns the row-column coordinates in the corresponding strictly lower \
triangularized matrix.  "
}], "Text",
 CellChangeTimes->{{3.8912115644792643`*^9, 3.891211640172118*^9}, {
  3.906225334783372*^9, 
  3.906225351822809*^9}},ExpressionUUID->"f11cc5ca-a55a-40ac-b00b-\
58fdb424b57c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixIndexCF", "=", " ", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"z", ",", " ", "_Integer"}], "}"}], "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", " ", 
        RowBox[{"IntegerPart", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"3", "+", 
            SqrtBox[
             RowBox[{
              RowBox[{"-", "7"}], "+", 
              RowBox[{"8", " ", "z"}]}]]}], ")"}]}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           RowBox[{"3", " ", "x"}], "-", 
           SuperscriptBox["x", "2"], "+", 
           RowBox[{"2", " ", "z"}]}], ")"}]}]}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"RuntimeAttributes", "->", 
     RowBox[{"{", "Listable", "}"}]}], ",", " ", 
    RowBox[{"Parallelization", "->", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.89120376407161*^9, 3.891203779013588*^9}, {
  3.8912038236765823`*^9, 3.891203839242621*^9}, {3.891204040318527*^9, 
  3.8912040419815493`*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[124]:=",ExpressionUUID->"707aee6f-f3e1-4f70-a0b8-90fb1687461d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["CompiledFunction",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
