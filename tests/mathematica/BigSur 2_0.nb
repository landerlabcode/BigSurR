        RowBox[{"filemarker", "<>", "\"\<_significantPCCs.mx\>\""}], ",", " ",
         "significantPCCmatrix"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
