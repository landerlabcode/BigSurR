     RowBox[{
      RowBox[{"{", 
       RowBox[{"mat", ",", " ", "_Real", ",", " ", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "_Integer"}], "}"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"n", "*", 
     RowBox[{"AbsoluteCorrelation", "[", 
      RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], ",", " ", 
    RowBox[{"RuntimeAttributes", "\[Rule]", 
     RowBox[{"{", "Listable", "}"}]}], ",", 
