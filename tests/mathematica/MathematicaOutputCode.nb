                  RowBox[{"PlotStyle", "->", " ", "Red"}], ",", " ", 
                  RowBox[{"Frame", "->", " ", "True"}], ",", " ", 
                  RowBox[{"FrameLabel", "->", " ", 
                   RowBox[{"{", 
                    RowBox[{
