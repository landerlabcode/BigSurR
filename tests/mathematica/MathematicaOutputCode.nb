                RowBox[{"{", 
                 RowBox[{"\"\<HuberPenalty\>\"", ",", "0.01"}], "}"}]}]}], 
              "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"params", "=", 
           RowBox[{"FindFit", "[", 
            RowBox[{
             RowBox[{"Log", "[", "data", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"1", "+", " ", "\[Eta]", " ", "+", " ", 
                 RowBox[{"\[Theta]", "*", 
                  SuperscriptBox["E", "x"]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[Eta]", ">", "0"}], ",", " ", 
                 RowBox[{"\[Theta]", ">", "0"}]}], "}"}]}], "}"}], ",", "  ", 
             
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Eta]", ",", "0"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"\[Theta]", ",", "0.1"}], "}"}]}], "}"}], ",", " ", 
             "x", ",", 
             RowBox[{"NormFunction", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<HuberPenalty\>\"", ",", "0.01"}], "}"}]}]}], 
            "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"\[Theta]list", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"\[Theta]", "/.", "params"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "t1", "]"}], ";", 
        RowBox[{"NotebookDelete", "[", "stop", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"t1", "=", 
         RowBox[{"PrintTemporary", "[", 
          RowBox[{"Last", "/@", "\[Theta]list"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "temp", "]"}], ";", 
        "\[IndentingNewLine]", 
