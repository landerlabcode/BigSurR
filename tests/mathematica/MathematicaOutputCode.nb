     RowBox[{"genesample", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RandomSample", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"Length", "[", "#", "]"}], ",", " ", 
             RowBox[{"Ceiling", "[", 
              RowBox[{
               RowBox[{"OptionValue", "[", "\"\<Sample Goal\>\"", "]"}], "/", 
               
               RowBox[{"Length", "[", "bl", "]"}]}], "]"}]}], "]"}]}], "]"}], 
         "&"}], "/@", "bl"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newmat", "=", 
      RowBox[{"mat", "[", 
