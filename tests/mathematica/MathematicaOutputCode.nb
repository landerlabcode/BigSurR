Cell[BoxData[
 RowBox[{
  RowBox[{"TwoComponentCL1AllThetaOnly", "[", "matpac_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mat", ",", "depthlist", ",", "n", ",", "genetotals", ",", " ", "bl", 
      ",", "genesample", ",", "newmat", ",", " ", "newgenetotals", ",", " ", 
      "newematrix", ",", " ", "fittedjvalues", ",", "data", ",", " ", 
      "params", ",", "params2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mat", "=", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"depthlist", " ", "=", 
      FractionBox[
       RowBox[{"Total", "/@", 
        RowBox[{"N", "[", 
         RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"genetotals", "=", 
      RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bl", "=", 
      RowBox[{"BinLists", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Log", "@", "genetotals"}], "->", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "genetotals", "]"}], "]"}]}], ",", " ", 
        "0.5"}], " ", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newmat", "=", "mat"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newgenetotals", "=", "genetotals"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newematrix", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"newgenetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fittedjvalues", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"j", "/.", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{"#", "==", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "n"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1"}], "}"}], ",", " ", 
           RowBox[{"Method", "->", " ", "\"\<Secant\>\""}]}], "]"}]}], "&"}], 
       "/@", 
       RowBox[{"Total", "/@", 
        RowBox[{"(", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"newmat", "-", "newematrix"}], ")"}], "2"], 
          RowBox[{"newematrix", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"j", " ", "newematrix"}]}], ")"}]}]], ")"}]}]}]}], ";", 
     " ", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           FractionBox["newgenetotals", "n"], ",", " ", 
           RowBox[{"1", "+", 
            RowBox[{"fittedjvalues", "*", 
             FractionBox["newgenetotals", "n"]}]}]}], "}"}], "]"}], ",", " ", 
        
        RowBox[{
         RowBox[{
          RowBox[{"Last", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Length", "[", "data", "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"params", "=", 
      RowBox[{"FindFit", "[", 
       RowBox[{
        RowBox[{"Log", "[", "data", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"1", "+", " ", 
            RowBox[{"\[Theta]", "*", 
             SuperscriptBox["E", "x"]}]}], "]"}], ",", 
          RowBox[{"{", " ", 
           RowBox[{"\[Theta]", ">", "0"}], "}"}]}], "}"}], ",", "  ", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "0.1"}], "}"}], "}"}], ",", " ", "x", ",", 
        " ", 
        RowBox[{"NormFunction", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Total", "@", 
            RowBox[{"Abs", "[", "#", "]"}]}], "&"}], ")"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"ListLogLogPlot", "[", "data", "]"}], ",", 
        RowBox[{"LogLogPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", " ", 
             RowBox[{"\[Theta]", "*", "\[Mu]"}]}], ")"}], "/.", "params"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", " ", 
            SuperscriptBox["10", 
             RowBox[{"-", "6"}]], ",", " ", 
            SuperscriptBox["10", "6"]}], "}"}], ",", " ", 
          RowBox[{"PlotStyle", "->", " ", "Red"}]}], "]"}]}], "]"}], "]"}], 
     ";", "\[IndentingNewLine]", "params"}]}], "]"}]}]], "Input",
