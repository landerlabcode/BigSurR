                    "\"\<1+\[Eta]+\[Theta]\[Mu]\>\""}], "}"}]}]}], "]"}]}], 
               "]"}]}], "\[IndentingNewLine]", "}"}], "}"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
