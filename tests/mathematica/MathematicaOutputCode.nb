                    RowBox[{"1", ",", 
                    RowBox[{"Length", "[", "indices", "]"}]}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "Automatic"}], "}"}]}], "}"}]}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Show", "[", 
