    RowBox[{"Reverse", "[", 
     RowBox[{"FoldList", "[", 
      RowBox[{"Min", ",", 
       RowBox[{"Reverse", "[", "adj", "]"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{";;", "nn"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Count", "[", 
  RowBox[{"adj", ",", 
