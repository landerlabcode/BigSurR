                 RowBox[{"Log", "[", 
                  RowBox[{"1", "+", " ", 
                   RowBox[{"\[Theta]", "*", 
                    SuperscriptBox["E", "x"]}]}], "]"}], ",", 
                 RowBox[{"\[Theta]", ">", "0"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"\[Theta]", ",", "0.1"}], "}"}], "}"}], ",", " ", 
