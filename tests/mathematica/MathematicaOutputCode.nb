Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lowcRows", "[", 
    RowBox[{"l_", ",", "min_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", "=", 
       RowBox[{"Transpose", "[", "l", "]"}]}], "}"}], ",", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "x", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"x", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "]"}], ">=", "min"}], "&"}]}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lowExRows", "[", 
    RowBox[{"mat_", ",", " ", "x_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "means", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"means", " ", "=", " ", 
       RowBox[{"Mean", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "means", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"means", "[", 
           RowBox[{"[", "#", "]"}], "]"}], ">=", "x"}], "&"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"9b200a1c-587e-40a6-9c38-879eaa103100"]
}, Open  ]],

