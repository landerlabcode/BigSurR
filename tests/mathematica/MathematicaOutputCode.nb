Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "BigSurAlt7Test", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Correlations\>\"", "->", " ", "False"}], ",", " ", 
      RowBox[{"\"\<alpha\>\"", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"\"\<Pvalue\>\"", "->", " ", "\"\<BH\>\""}], ",", 
      RowBox[{"\"\<First Pass Cutoff\>\"", "->", " ", "2"}], ",", 
      RowBox[{"\"\<Fano Inverse Sqrt Moments\>\"", "->", " ", "True"}], ",", 
      " ", 
      RowBox[{"\"\<Find Communities\>\"", "->", " ", "True"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BigSurAlt7Test", "[", 
   RowBox[{
   "matpac_", ",", " ", "\[Eta]_", ",", " ", "\[Theta]_", ",", "filemarker_", 
    ",", "depthscaling_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "foldername", ",", "n", ",", "m", ",", "z", ",", "clist", ",", " ", 
      "negccthreshold", ",", " ", "mat", ",", " ", "depthlist", ",", " ", 
      "genetotals", ",", " ", "ematrix", ",", " ", "pmatrix", ",", " ", 
      "mflist", ",", "fanocorrectionmatrices", ",", " ", "pccmatrix", ",", 
      "\[Kappa]lists", ",", "ccmats", ",", "polylist", ",", " ", "polymatrix",
       ",", "equationslist", ",", "logplist", ",", "pccSignmatrix", ",", 
      "augmentedParameters", ",", "xlist", ",", "equivalentPCCs", ",", 
      "logpmatrix", ",", " ", "rows", ",", "randomematrix", ",", "randommat", 
      ",", "randompmatrix", ",", " ", "randommflist", ",", 
      "randomfanocorrectionmatrices", ",", "invsqrtmoments", ",", 
      "randompolymatrix", ",", "randompccmatrix", ",", "randomccmats", ",", 
      "randompccSignmatrix", ",", "randomaugmentedParameters", ",", 
      "randomxlist", ",", "randomlogpmatrix", ",", "cutoff", ",", " ", 
      "bhcutoff", ",", " ", "bonferroni", ",", "sigcutofflevel", ",", 
      "sigcutofflist", ",", "truesigdata", ",", "randomsigdata", ",", 
      "significantPCCmatrix", ",", "gno", ",", " ", "subsetgno", ",", 
      "communities", ",", "\[Kappa]1", ",", "\[Kappa]2", ",", "\[Kappa]3", 
      ",", "\[Kappa]4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"matpac", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"genetotals", " ", "=", " ", 
       RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", "genetotals", "]"}], " ", "\[Equal]", "0"}], ",",
         " ", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<Some genes have no counts\>\"", "]"}], 
         ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Tally", "[", 
            RowBox[{"matpac", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{"y", ">", "1"}]}]}], "]"}], ">", "0"}], ",", " ", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Matpac contains duplicated genes\>\"", "]"}], ";",
          " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "genetotals", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"clist", "=", 
       RowBox[{
        RowBox[{
         SqrtBox[
          RowBox[{
           FractionBox["\[Eta]", "#"], "+", " ", "\[Theta]"}]], "&"}], "/@", 
        RowBox[{"N", "[", 
         FractionBox["genetotals", "n"], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Started on\>\"", ",", 
        RowBox[{"CurrentDate", "[", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Folder name is\>\"", "]"}], ";", 
      RowBox[{"Print", "[", "foldername", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"depthlist", " ", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ListQ", "[", "depthscaling", "]"}], ",", 
         RowBox[{"N", "[", "depthscaling", "]"}], ",", 
         FractionBox[
          RowBox[{"Total", "/@", 
           RowBox[{"N", "[", 
            RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
          RowBox[{"Total", "[", 
           RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Share", "[", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ematrix", " ", "=", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"genetotals", ",", " ", "depthlist"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Share", "[", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pmatrix", " ", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"mat", "-", "ematrix"}], ")"}], 
        SqrtBox[
         RowBox[{"ematrix", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             SuperscriptBox["clist", "2"], "ematrix"}]}], ")"}]}]]]}], "  ", 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{"\"\<residuals.csv\>\"", ",", " ", "pmatrix"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mflist", " ", "=", " ", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"n", "-", "1"}]], 
        RowBox[{"Total", "/@", 
         RowBox[{"(", 
          SuperscriptBox["pmatrix", "2"], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Share", "[", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{"\"\<mcfanos.csv\>\"", ",", " ", "mflist"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Modified, corrected Fano factors acquired and saved\>\"", ",", 
        " ", 
        RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Kappa]1", "=", 
       RowBox[{"FanoCum1", "[", 
        RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}]}], ";", 
      RowBox[{"Share", "[", "]"}], ";", "\n", "\t", 
      RowBox[{"\[Kappa]2", "=", 
       RowBox[{"FanoCum2", "[", 
        RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}]}], ";", 
      RowBox[{"Share", "[", "]"}], ";", "\n", "\t", 
      RowBox[{"\[Kappa]3", "=", 
       RowBox[{"FanoCum3", "[", 
        RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}]}], ";", 
      RowBox[{"Share", "[", "]"}], ";", "\n", "\t", 
      RowBox[{"\[Kappa]4", "=", 
       RowBox[{"FanoCum4", "[", 
        RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}]}], ";", 
      RowBox[{"Share", "[", "]"}], ";", "\n", "\t", 
      RowBox[{"\[Kappa]lists", "=", 
       RowBox[{"{", 
        RowBox[{
        "\[Kappa]1", ",", "\[Kappa]2", ",", "\[Kappa]3", ",", "\[Kappa]4"}], 
        "}"}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[Kappa]lists", "=", 
        RowBox[{"FanoCumulants5CFAlt", "[", 
         RowBox[{"ematrix", ",", "clist", ",", "n"}], "]"}]}], ";"}], "*)"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FK1.csv\>\"", ",", "\[Kappa]1"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FK2.csv\>\"", ",", "\[Kappa]2"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FK3.csv\>\"", ",", "\[Kappa]3"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FK4.csv\>\"", ",", "\[Kappa]4"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Share", "[", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Fano cumulants calculated\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"polylist", "=", 
      RowBox[{"CornishFisherPolynomialCoefficientsforFano5CF", "[", 
       RowBox[{
        RowBox[{"\[Kappa]lists", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"\[Kappa]lists", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"\[Kappa]lists", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", 
        RowBox[{"\[Kappa]lists", "[", 
         RowBox[{"[", "4", "]"}], "]"}], ",", "mflist"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Share", "[", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", "\"\<Cornish-Fisher coefficients calculated\>\"", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FCF1.csv\>\"", ",", 
       RowBox[{"polylist", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FCF2.csv\>\"", ",", 
       RowBox[{"polylist", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FCF3.csv\>\"", ",", 
       RowBox[{"polylist", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FCF4.csv\>\"", ",", 
       RowBox[{"polylist", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<FCF5.csv\>\"", ",", 
       RowBox[{"polylist", "[", 
        RowBox[{"[", "5", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Share", "[", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pccmatrix", "=", 
      RowBox[{"DotProductCF", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         FractionBox["pmatrix", 
          SqrtBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}], "mflist"}]]], "]"}], ",", "n"}], 
       "]"}]}], " ", ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<pccmatrix.csv\>\"", ",", " ", "pccmatrix"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Modified corrected correlations acquired and saved \>\"", ",", 
       RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pccSignmatrix", " ", "=", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"LowerTriangularize", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BoolEval", "[", 
           RowBox[{"pccmatrix", ">", "0"}], "]"}], "-", 
          RowBox[{"BoolEval", "[", 
           RowBox[{"pccmatrix", "<=", "0"}], "]"}]}], ",", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
        "OptionValue", "[", "\"\<Fano Inverse Sqrt Moments\>\"", "]"}], "==", 
        "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"invsqrtmoments", "=", 
         RowBox[{"InverseSqrtMomentListsAltNew", "[", 
          RowBox[{
          "genetotals", ",", "depthlist", ",", " ", "\[Eta]", ",", " ", 
           "\[Theta]", ",", " ", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{"\"\<invsqrtmoments.mx\>\"", ",", " ", "invsqrtmoments"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<inverse squareroot Fano moments acquired and saved \>\"", ",", 
          RowBox[{"TimeObject", "[", "Now", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Share", "[", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"fanocorrectionmatrices", "=", 
         RowBox[{"SqrtCorrectionmats", "[", 
          RowBox[{"invsqrtmoments", ",", "genetotals"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fanocorrectionmatrices", "=", 
         RowBox[{"Table", "[", " ", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "m"}], "}"}]}], "]"}], ",", "4"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<inverse squareroot Fano moments ignored \>\"", 
         "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccmats", "=", 
      RowBox[{"CorrelationCumulantsNewCFAlt", "[", 
       RowBox[{"ematrix", ",", 
        RowBox[{"fanocorrectionmatrices", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
