      ",", "genesample", ",", "newmat", ",", " ", "newgenetotals", ",", " ", 
      "newematrix", ",", " ", "fittedjvalues", ",", "data", ",", "stop", ",", 
      "indices", ",", "\[Theta]list", ",", "temp", ",", " ", "params", ",", 
      " ", "t1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mat", "=", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"depthlist", " ", "=", 
      FractionBox[
       RowBox[{"Total", "/@", 
        RowBox[{"N", "[", 
         RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], 
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", "mat", "]"}], "]"}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"genetotals", "=", 
      RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
