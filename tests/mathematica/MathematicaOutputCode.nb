         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "newgenetotals", "]"}], "]"}], "]"}], ",", 
        " ", 
        RowBox[{"UpTo", "[", "200", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newematrix", "=", " ", 
