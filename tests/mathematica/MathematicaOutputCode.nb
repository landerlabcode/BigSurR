Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lp", "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Log", "[", "10", "]"}]}], "*", 
     RowBox[{"logpmatrix", "[", "\"\<ExplicitValues\>\"", "]"}]}]}], ";"}], 
  "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"natural", " ", "log", " ", "p"}], ",", "negative"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"nn", "=", 
   RowBox[{"Length", "[", "lp", "]"}]}], ";", 
  RowBox[{"o", "=", 
   RowBox[{"Ordering", "[", "lp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"adj", "=", 
   RowBox[{
    RowBox[{"lp", "[", 
     RowBox[{"[", "o", "]"}], "]"}], "+", 
    RowBox[{"Log", "[", "nn", "]"}], "-", 
