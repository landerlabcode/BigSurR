Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "TwoComponentCThetaOnlyVec", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<zero eta\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<Tolerance\>\"", "->", "1.*^-12"}], ",", 
      RowBox[{"\"\<Max Iterations\>\"", "->", "100"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TwoComponentCThetaOnlyVec", "[", 
   RowBox[{"matpac_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mat", ",", "depthlist", ",", "n", ",", "genetotals", ",", "ematrix", 
      ",", "a", ",", "b", ",", "lo", ",", "j", ",", "f", ",", "fp", ",", 
      "jnew", ",", "bad", ",", "tol", ",", "maxit", ",", "k", ",", "data", 
      ",", "params", ",", " ", "keep", ",", " ", "bin", ",", " ", "counts", 
      ",", " ", "w"}], "}"}], ",", 
    RowBox[{
     RowBox[{"mat", "=", 
      RowBox[{"matpac", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"depthlist", "=", 
      RowBox[{
       RowBox[{"Total", "/@", 
        RowBox[{"N", "[", 
         RowBox[{"Transpose", "[", "mat", "]"}], "]"}]}], "/", 
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", "mat", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"genetotals", "=", 
      RowBox[{"Total", "/@", "mat"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Width", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ematrix", "=", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"genetotals", ",", "depthlist"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"mat", "/", "ematrix"}], "-", "1"}], ")"}], "^", "2"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"1", "/", "ematrix"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lo", "=", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"Min", "/@", "b"}], ")"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "j", " ", "must", " ", "exceed", " ", "this", " ", "per", " ", "gene"}],
       "*)"}], 
     RowBox[{"tol", "=", 
      RowBox[{"OptionValue", "[", "\"\<Tolerance\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxit", "=", 
      RowBox[{"OptionValue", "[", "\"\<Max Iterations\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"j", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"1.", ",", 
        RowBox[{"Length", "[", "genetotals", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Total", "/@", 
            RowBox[{"(", 
             RowBox[{"a", "/", 
              RowBox[{"(", 
               RowBox[{"b", "+", "j"}], ")"}]}], ")"}]}], ")"}], "-", 
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fp", "=", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"Total", "/@", 
            RowBox[{"(", 
             RowBox[{"a", "/", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"b", "+", "j"}], ")"}], "^", "2"}]}], ")"}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"jnew", "=", 
         RowBox[{"j", "-", 
          RowBox[{"f", "/", "fp"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bad", "=", 
         RowBox[{"UnitStep", "[", 
          RowBox[{"lo", "-", "jnew"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "1", " ", "where", " ", "the", " ", "step", " ", "leaves", " ", 
          "the", " ", "domain"}], "*)"}], 
        RowBox[{"jnew", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "bad"}], ")"}], " ", "jnew"}], "+", 
          RowBox[{"bad", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"j", "+", "lo"}], ")"}], "/", "2"}]}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "bisect", " ", "toward", " ", "the", " ", "pole", " ", "instead"}], 
         "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"jnew", "-", "j"}], "]"}], "]"}], "<", "tol"}], ",", 
          RowBox[{
           RowBox[{"j", "=", "jnew"}], ";", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"j", "=", "jnew"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "maxit"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"genetotals", "/", "n"}], ",", 
         RowBox[{"1", "+", 
          RowBox[{"j", "*", 
           RowBox[{"genetotals", "/", "n"}]}]}]}], "}"}], "]"}]}], ";", 
     RowBox[{"keep", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"Last", "/@", "data"}], ",", 
         RowBox[{"_", "?", "Positive"}]}], "]"}]}]}], ";", 
     RowBox[{"data", "=", 
      RowBox[{"N", "[", 
       RowBox[{"data", "[", 
        RowBox[{"[", "keep", "]"}], "]"}], "]"}]}], ";", 
     RowBox[{"bin", "=", 
      RowBox[{"Floor", "[", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"genetotals", "[", 
          RowBox[{"[", "keep", "]"}], "]"}], "]"}], "/", "0.5"}], "]"}]}], 
     ";", 
     RowBox[{"counts", "=", 
      RowBox[{"Counts", "[", "bin", "]"}]}], ";", 
     RowBox[{"w", "=", 
      RowBox[{"1.", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"counts", ",", "bin"}], "]"}], "]"}]}]}], ";", 
     "               ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"each", " ", "half"}], "-", 
       RowBox[{"log", " ", "bin", " ", "contributes", " ", "equally"}]}], 
      "*)"}], "\n", "\[IndentingNewLine]", 
     RowBox[{"params", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Eta]", "->", "0"}], "}"}], ",", 
        RowBox[{"FindFit", "[", 
         RowBox[{
          RowBox[{"Log", "[", "data", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"1", "+", 
              RowBox[{"\[Theta]", "*", 
               RowBox[{"E", "^", "x"}]}]}], "]"}], ",", 
            RowBox[{"\[Theta]", ">", "0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\[Theta]", ",", "0.1"}], "}"}], "}"}], ",", "x", ",", 
          RowBox[{"NormFunction", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"w", "*", 
               RowBox[{"Abs", "[", "#", "]"}]}], "]"}], "&"}], ")"}]}], ",", 
          " ", 
          RowBox[{"MaxIterations", "->", "1000"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"ListLogLogPlot", "[", "data", "]"}], ",", 
        RowBox[{"LogLogPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Eta]", "+", 
             RowBox[{"\[Theta]", "*", "\[Mu]"}]}], ")"}], "/.", " ", 
           "params"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", 
            RowBox[{"Min", "[", 
             RowBox[{"First", "/@", "data"}], "]"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{"First", "/@", "data"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotStyle", "->", "Red"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
            "\"\<mean expression (\[Mu])\>\"", ",", 
             "\"\<1+\[Eta]+\[Theta]\[Mu]\>\""}], "}"}]}]}], "]"}]}], "]"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "genetotals", "]"}], " ", 
        "\"\<genes tested\>\""}], ",", "params"}], "}"}]}]}], 
   "]"}]}]}], "Input",
