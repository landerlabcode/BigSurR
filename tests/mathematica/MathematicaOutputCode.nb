      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", "=", "1"}], ",", 
       RowBox[{"k", "<=", " ", 
        RowBox[{"Length", "[", "indices", "]"}]}], ",", 
       RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fittedjvalues", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"fittedjvalues", ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"j", "/.", 
              RowBox[{"FindRoot", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Total", "@", 
                  RowBox[{"(", 
                   FractionBox[
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"newmat", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                    RowBox[{"newematrix", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], "-", "1"}], ")"}], "2"], 
                    
                    RowBox[{"(", 
                    RowBox[{
                    FractionBox["1", 
                    RowBox[{"newematrix", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], "+", "j"}], " ", ")"}]], 
                   ")"}]}], " ", "+", "1", "-", "n"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1"}], "}"}], ",", " ", 
                RowBox[{"Method", "->", " ", "\"\<Secant\>\""}]}], "]"}]}], 
